{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Optional BibleLens study relationship metadata",
  "type": "object",
  "description": "Additive navigation metadata for evidence records and UI studies; existing source-critical fields are preserved.",
  "properties": {
    "relatedPassages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["book", "chapter", "verse", "label", "relationship", "group"],
        "properties": {
          "book": {"type": "integer", "minimum": 0},
          "chapter": {"type": "integer", "minimum": 1},
          "verse": {"type": "integer", "minimum": 1},
          "label": {"type": "string", "minLength": 1},
          "relationship": {"const": "narrative-doublet"},
          "group": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
