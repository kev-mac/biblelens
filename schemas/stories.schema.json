{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Book stories",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "book",
      "stories"
    ],
    "properties": {
      "book": {
        "type": "string",
        "minLength": 1
      },
      "stories": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "passage",
            "summary",
            "cross_references"
          ],
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            },
            "passage": {
              "type": "string",
              "minLength": 1
            },
            "summary": {
              "type": "string",
              "minLength": 1
            },
            "cross_references": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "topics": {
              "type": "array",
              "maxItems": 5,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
