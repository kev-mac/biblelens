{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Commandment evidence record",
  "type": "object",
  "required": ["id", "mode", "ref", "title", "status", "summary", "text", "scope", "refs", "sources", "checked", "theme", "wordsOfJesus"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "ref": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "text": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "checked": {"type": "string", "format": "date"},
    "refs": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["book", "chapter", "verse", "label"]}},
    "sources": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["label", "url"]}},
    "mode": {"const": "commandments"},
    "status": {"const": "Context"},
    "tag": false,
    "tags": {"type": "array", "maxItems": 0},
    "theme": {"enum": ["Worship of God", "Sabbath and rest", "Family", "Life and violence", "Marriage and sexual conduct", "Property and economics", "Truth and justice", "Food and purity", "Festivals and sacrifice", "Care for the poor and the stranger", "Love of God and neighbor", "Prayer and fasting", "Baptism and the Lord's Supper", "Church life and order"]},
    "commandmentType": {"enum": ["moral", "civil", "ritual"], "description": "Optional editorial browsing aid, not a ruling on applicability."},
    "tenCommandments": {"type": "boolean"},
    "wordsOfJesus": {"type": "boolean", "description": "Derived from KJV ranges in src/red-letters.js for this record's own refs, excluding repeatedIn."},
    "repeatedIn": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^.+ [0-9]+:[0-9]+(-[0-9]+)?$"}, "description": "Restatements or parallels; wording and context may differ."},
    "relatedRecords": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}, "description": "Reserved evidence IDs for phase two; no link UI in version one."}
  }
}
