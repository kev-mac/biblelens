[{"pk": 2895890, "verse": 1, "text": "\u05d0 \u05d5\u05e9\u05dc\u05de\u05d4 \u05d4\u05d9\u05d4 \u05de\u05d5\u05e9\u05dc \u05d1\u05db\u05dc \u05d4\u05de\u05de\u05dc\u05db\u05d5\u05ea--\u05de\u05df \u05d4\u05e0\u05d4\u05e8 \u05d0\u05e8\u05e5 \u05e4\u05dc\u05e9\u05ea\u05d9\u05dd \u05d5\u05e2\u05d3 \u05d2\u05d1\u05d5\u05dc \u05de\u05e6\u05e8\u05d9\u05dd\u00a0 \u05de\u05d2\u05e9\u05d9\u05dd \u05de\u05e0\u05d7\u05d4 \u05d5\u05e2\u05d1\u05d3\u05d9\u05dd \u05d0\u05ea \u05e9\u05dc\u05de\u05d4 \u05db\u05dc \u05d9\u05de\u05d9 \u05d7\u05d9\u05d9\u05d5\u00a0 {\u05e4}"}, {"pk": 2895891, "verse": 2, "text": "\u05d1 \u05d5\u05d9\u05d4\u05d9 \u05dc\u05d7\u05dd \u05e9\u05dc\u05de\u05d4 \u05dc\u05d9\u05d5\u05dd \u05d0\u05d7\u05d3\u00a0 \u05e9\u05dc\u05e9\u05d9\u05dd \u05db\u05e8 \u05e1\u05dc\u05ea \u05d5\u05e9\u05e9\u05d9\u05dd \u05db\u05e8 \u05e7\u05de\u05d7"}, {"pk": 2895892, "verse": 3, "text": "\u05d2 \u05e2\u05e9\u05e8\u05d4 \u05d1\u05e7\u05e8 \u05d1\u05e8\u05d0\u05d9\u05dd \u05d5\u05e2\u05e9\u05e8\u05d9\u05dd \u05d1\u05e7\u05e8 \u05e8\u05e2\u05d9--\u05d5\u05de\u05d0\u05d4 \u05e6\u05d0\u05df \u05dc\u05d1\u05d3 \u05de\u05d0\u05d9\u05dc \u05d5\u05e6\u05d1\u05d9 \u05d5\u05d9\u05d7\u05de\u05d5\u05e8 \u05d5\u05d1\u05e8\u05d1\u05e8\u05d9\u05dd \u05d0\u05d1\u05d5\u05e1\u05d9\u05dd"}, {"pk": 2895893, "verse": 4, "text": "\u05d3 \u05db\u05d9 \u05d4\u05d5\u05d0 \u05e8\u05d3\u05d4 \u05d1\u05db\u05dc \u05e2\u05d1\u05e8 \u05d4\u05e0\u05d4\u05e8 \u05de\u05ea\u05e4\u05e1\u05d7 \u05d5\u05e2\u05d3 \u05e2\u05d6\u05d4--\u05d1\u05db\u05dc \u05de\u05dc\u05db\u05d9 \u05e2\u05d1\u05e8 \u05d4\u05e0\u05d4\u05e8 \u05d5\u05e9\u05dc\u05d5\u05dd \u05d4\u05d9\u05d4 \u05dc\u05d5 \u05de\u05db\u05dc \u05e2\u05d1\u05e8\u05d9\u05d5--\u05de\u05e1\u05d1\u05d9\u05d1"}, {"pk": 2895894, "verse": 5, "text": "\u05d4 \u05d5\u05d9\u05e9\u05d1 \u05d9\u05d4\u05d5\u05d3\u05d4 \u05d5\u05d9\u05e9\u05e8\u05d0\u05dc \u05dc\u05d1\u05d8\u05d7 \u05d0\u05d9\u05e9 \u05ea\u05d7\u05ea \u05d2\u05e4\u05e0\u05d5 \u05d5\u05ea\u05d7\u05ea \u05ea\u05d0\u05e0\u05ea\u05d5 \u05de\u05d3\u05df \u05d5\u05e2\u05d3 \u05d1\u05d0\u05e8 \u05e9\u05d1\u05e2--\u05db\u05dc \u05d9\u05de\u05d9 \u05e9\u05dc\u05de\u05d4\u00a0 {\u05e1}"}, {"pk": 2895895, "verse": 6, "text": "\u05d5 \u05d5\u05d9\u05d4\u05d9 \u05dc\u05e9\u05dc\u05de\u05d4 \u05d0\u05e8\u05d1\u05e2\u05d9\u05dd \u05d0\u05dc\u05e3 \u05d0\u05e8\u05d5\u05ea \u05e1\u05d5\u05e1\u05d9\u05dd--\u05dc\u05de\u05e8\u05db\u05d1\u05d5 \u05d5\u05e9\u05e0\u05d9\u05dd \u05e2\u05e9\u05e8 \u05d0\u05dc\u05e3 \u05e4\u05e8\u05e9\u05d9\u05dd"}, {"pk": 2895896, "verse": 7, "text": "\u05d6 \u05d5\u05db\u05dc\u05db\u05dc\u05d5 \u05d4\u05e0\u05e6\u05d1\u05d9\u05dd \u05d4\u05d0\u05dc\u05d4 \u05d0\u05ea \u05d4\u05de\u05dc\u05da \u05e9\u05dc\u05de\u05d4 \u05d5\u05d0\u05ea \u05db\u05dc \u05d4\u05e7\u05e8\u05d1 \u05d0\u05dc \u05e9\u05dc\u05d7\u05df \u05d4\u05de\u05dc\u05da \u05e9\u05dc\u05de\u05d4--\u05d0\u05d9\u05e9 \u05d7\u05d3\u05e9\u05d5\u00a0 \u05dc\u05d0 \u05d9\u05e2\u05d3\u05e8\u05d5 \u05d3\u05d1\u05e8"}, {"pk": 2895897, "verse": 8, "text": "\u05d7 \u05d5\u05d4\u05e9\u05e2\u05e8\u05d9\u05dd \u05d5\u05d4\u05ea\u05d1\u05df \u05dc\u05e1\u05d5\u05e1\u05d9\u05dd \u05d5\u05dc\u05e8\u05db\u05e9--\u05d9\u05d1\u05d0\u05d5 \u05d0\u05dc \u05d4\u05de\u05e7\u05d5\u05dd \u05d0\u05e9\u05e8 \u05d9\u05d4\u05d9\u05d4 \u05e9\u05dd \u05d0\u05d9\u05e9 \u05db\u05de\u05e9\u05e4\u05d8\u05d5\u00a0 {\u05e1}"}, {"pk": 2895898, "verse": 9, "text": "\u05d8 \u05d5\u05d9\u05ea\u05df \u05d0\u05dc\u05d4\u05d9\u05dd \u05d7\u05db\u05de\u05d4 \u05dc\u05e9\u05dc\u05de\u05d4 \u05d5\u05ea\u05d1\u05d5\u05e0\u05d4 \u05d4\u05e8\u05d1\u05d4 \u05de\u05d0\u05d3 \u05d5\u05e8\u05d7\u05d1 \u05dc\u05d1--\u05db\u05d7\u05d5\u05dc \u05d0\u05e9\u05e8 \u05e2\u05dc \u05e9\u05e4\u05ea \u05d4\u05d9\u05dd"}, {"pk": 2895899, "verse": 10, "text": "\u05d9 \u05d5\u05ea\u05e8\u05d1 \u05d7\u05db\u05de\u05ea \u05e9\u05dc\u05de\u05d4 \u05de\u05d7\u05db\u05de\u05ea \u05db\u05dc \u05d1\u05e0\u05d9 \u05e7\u05d3\u05dd \u05d5\u05de\u05db\u05dc \u05d7\u05db\u05de\u05ea \u05de\u05e6\u05e8\u05d9\u05dd"}, {"pk": 2895900, "verse": 11, "text": "\u05d9\u05d0 \u05d5\u05d9\u05d7\u05db\u05dd \u05de\u05db\u05dc \u05d4\u05d0\u05d3\u05dd \u05de\u05d0\u05d9\u05ea\u05df \u05d4\u05d0\u05d6\u05e8\u05d7\u05d9 \u05d5\u05d4\u05d9\u05de\u05df \u05d5\u05db\u05dc\u05db\u05dc \u05d5\u05d3\u05e8\u05d3\u05e2 \u05d1\u05e0\u05d9 \u05de\u05d7\u05d5\u05dc \u05d5\u05d9\u05d4\u05d9 \u05e9\u05de\u05d5 \u05d1\u05db\u05dc \u05d4\u05d2\u05d5\u05d9\u05dd \u05e1\u05d1\u05d9\u05d1"}, {"pk": 2895901, "verse": 12, "text": "\u05d9\u05d1 \u05d5\u05d9\u05d3\u05d1\u05e8 \u05e9\u05dc\u05e9\u05ea \u05d0\u05dc\u05e4\u05d9\u05dd \u05de\u05e9\u05dc \u05d5\u05d9\u05d4\u05d9 \u05e9\u05d9\u05e8\u05d5 \u05d7\u05de\u05e9\u05d4 \u05d5\u05d0\u05dc\u05e3"}, {"pk": 2895902, "verse": 13, "text": "\u05d9\u05d2 \u05d5\u05d9\u05d3\u05d1\u05e8 \u05e2\u05dc \u05d4\u05e2\u05e6\u05d9\u05dd \u05de\u05df \u05d4\u05d0\u05e8\u05d6 \u05d0\u05e9\u05e8 \u05d1\u05dc\u05d1\u05e0\u05d5\u05df \u05d5\u05e2\u05d3 \u05d4\u05d0\u05d6\u05d5\u05d1 \u05d0\u05e9\u05e8 \u05d9\u05e6\u05d0 \u05d1\u05e7\u05d9\u05e8 \u05d5\u05d9\u05d3\u05d1\u05e8 \u05e2\u05dc \u05d4\u05d1\u05d4\u05de\u05d4 \u05d5\u05e2\u05dc \u05d4\u05e2\u05d5\u05e3 \u05d5\u05e2\u05dc \u05d4\u05e8\u05de\u05e9 \u05d5\u05e2\u05dc \u05d4\u05d3\u05d2\u05d9\u05dd"}, {"pk": 2895903, "verse": 14, "text": "\u05d9\u05d3 \u05d5\u05d9\u05d1\u05d0\u05d5 \u05de\u05db\u05dc \u05d4\u05e2\u05de\u05d9\u05dd \u05dc\u05e9\u05de\u05e2 \u05d0\u05ea \u05d7\u05db\u05de\u05ea \u05e9\u05dc\u05de\u05d4--\u05de\u05d0\u05ea \u05db\u05dc \u05de\u05dc\u05db\u05d9 \u05d4\u05d0\u05e8\u05e5 \u05d0\u05e9\u05e8 \u05e9\u05de\u05e2\u05d5 \u05d0\u05ea \u05d7\u05db\u05de\u05ea\u05d5\u00a0 {\u05e1}"}, {"pk": 2895904, "verse": 15, "text": "\u05d8\u05d5 \u05d5\u05d9\u05e9\u05dc\u05d7 \u05d7\u05d9\u05e8\u05dd \u05de\u05dc\u05da \u05e6\u05d5\u05e8 \u05d0\u05ea \u05e2\u05d1\u05d3\u05d9\u05d5 \u05d0\u05dc \u05e9\u05dc\u05de\u05d4 \u05db\u05d9 \u05e9\u05de\u05e2 \u05db\u05d9 \u05d0\u05ea\u05d5 \u05de\u05e9\u05d7\u05d5 \u05dc\u05de\u05dc\u05da \u05ea\u05d7\u05ea \u05d0\u05d1\u05d9\u05d4\u05d5\u00a0 \u05db\u05d9 \u05d0\u05d4\u05d1 \u05d4\u05d9\u05d4 \u05d7\u05d9\u05e8\u05dd \u05dc\u05d3\u05d5\u05d3--\u05db\u05dc \u05d4\u05d9\u05de\u05d9\u05dd\u00a0 {\u05e1}"}, {"pk": 2895905, "verse": 16, "text": "\u05d8\u05d6 \u05d5\u05d9\u05e9\u05dc\u05d7 \u05e9\u05dc\u05de\u05d4 \u05d0\u05dc \u05d7\u05d9\u05e8\u05dd \u05dc\u05d0\u05de\u05e8"}, {"pk": 2895906, "verse": 17, "text": "\u05d9\u05d6 \u05d0\u05ea\u05d4 \u05d9\u05d3\u05e2\u05ea \u05d0\u05ea \u05d3\u05d5\u05d3 \u05d0\u05d1\u05d9 \u05db\u05d9 \u05dc\u05d0 \u05d9\u05db\u05dc \u05dc\u05d1\u05e0\u05d5\u05ea \u05d1\u05d9\u05ea \u05dc\u05e9\u05dd \u05d9\u05d4\u05d5\u05d4 \u05d0\u05dc\u05d4\u05d9\u05d5 \u05de\u05e4\u05e0\u05d9 \u05d4\u05de\u05dc\u05d7\u05de\u05d4 \u05d0\u05e9\u05e8 \u05e1\u05d1\u05d1\u05d4\u05d5--\u05e2\u05d3 \u05ea\u05ea \u05d9\u05d4\u05d5\u05d4 \u05d0\u05ea\u05dd \u05ea\u05d7\u05ea \u05db\u05e4\u05d5\u05ea \u05e8\u05d2\u05dc\u05d5 (\u05e8\u05d2\u05dc\u05d9)"}, {"pk": 2895907, "verse": 18, "text": "\u05d9\u05d7 \u05d5\u05e2\u05ea\u05d4 \u05d4\u05e0\u05d9\u05d7 \u05d9\u05d4\u05d5\u05d4 \u05d0\u05dc\u05d4\u05d9 \u05dc\u05d9 \u05de\u05e1\u05d1\u05d9\u05d1\u00a0 \u05d0\u05d9\u05df \u05e9\u05d8\u05df \u05d5\u05d0\u05d9\u05df \u05e4\u05d2\u05e2 \u05e8\u05e2 [ (I Kings 5:19) \u05d9\u05d8 \u05d5\u05d4\u05e0\u05e0\u05d9 \u05d0\u05de\u05e8--\u05dc\u05d1\u05e0\u05d5\u05ea \u05d1\u05d9\u05ea \u05dc\u05e9\u05dd \u05d9\u05d4\u05d5\u05d4 \u05d0\u05dc\u05d4\u05d9\u00a0 \u05db\u05d0\u05e9\u05e8 \u05d3\u05d1\u05e8 \u05d9\u05d4\u05d5\u05d4 \u05d0\u05dc \u05d3\u05d5\u05d3 \u05d0\u05d1\u05d9 \u05dc\u05d0\u05de\u05e8 \u05d1\u05e0\u05da \u05d0\u05e9\u05e8 \u05d0\u05ea\u05df \u05ea\u05d7\u05ea\u05d9\u05da \u05e2\u05dc \u05db\u05e1\u05d0\u05da \u05d4\u05d5\u05d0 \u05d9\u05d1\u05e0\u05d4 \u05d4\u05d1\u05d9\u05ea \u05dc\u05e9\u05de\u05d9 ] [ (I Kings 5:20) \u05db \u05d5\u05e2\u05ea\u05d4 \u05e6\u05d5\u05d4 \u05d5\u05d9\u05db\u05e8\u05ea\u05d5 \u05dc\u05d9 \u05d0\u05e8\u05d6\u05d9\u05dd \u05de\u05df \u05d4\u05dc\u05d1\u05e0\u05d5\u05df \u05d5\u05e2\u05d1\u05d3\u05d9 \u05d9\u05d4\u05d9\u05d5 \u05e2\u05dd \u05e2\u05d1\u05d3\u05d9\u05da \u05d5\u05e9\u05db\u05e8 \u05e2\u05d1\u05d3\u05d9\u05da \u05d0\u05ea\u05df \u05dc\u05da \u05db\u05db\u05dc \u05d0\u05e9\u05e8 \u05ea\u05d0\u05de\u05e8\u00a0 \u05db\u05d9 \u05d0\u05ea\u05d4 \u05d9\u05d3\u05e2\u05ea \u05db\u05d9 \u05d0\u05d9\u05df \u05d1\u05e0\u05d5 \u05d0\u05d9\u05e9 \u05d9\u05d3\u05e2 \u05dc\u05db\u05e8\u05ea \u05e2\u05e6\u05d9\u05dd--\u05db\u05e6\u05d3\u05e0\u05d9\u05dd ] [ (I Kings 5:21) \u05db\u05d0 \u05d5\u05d9\u05d4\u05d9 \u05db\u05e9\u05de\u05e2 \u05d7\u05d9\u05e8\u05dd \u05d0\u05ea \u05d3\u05d1\u05e8\u05d9 \u05e9\u05dc\u05de\u05d4--\u05d5\u05d9\u05e9\u05de\u05d7 \u05de\u05d0\u05d3 \u05d5\u05d9\u05d0\u05de\u05e8 \u05d1\u05e8\u05d5\u05da \u05d9\u05d4\u05d5\u05d4 \u05d4\u05d9\u05d5\u05dd \u05d0\u05e9\u05e8 \u05e0\u05ea\u05df \u05dc\u05d3\u05d5\u05d3 \u05d1\u05df \u05d7\u05db\u05dd \u05e2\u05dc \u05d4\u05e2\u05dd \u05d4\u05e8\u05d1 \u05d4\u05d6\u05d4 ] [ (I Kings 5:22) \u05db\u05d1 \u05d5\u05d9\u05e9\u05dc\u05d7 \u05d7\u05d9\u05e8\u05dd \u05d0\u05dc \u05e9\u05dc\u05de\u05d4 \u05dc\u05d0\u05de\u05e8 \u05e9\u05de\u05e2\u05ea\u05d9 \u05d0\u05ea \u05d0\u05e9\u05e8 \u05e9\u05dc\u05d7\u05ea \u05d0\u05dc\u05d9 \u05d0\u05e0\u05d9 \u05d0\u05e2\u05e9\u05d4 \u05d0\u05ea \u05db\u05dc \u05d7\u05e4\u05e6\u05da \u05d1\u05e2\u05e6\u05d9 \u05d0\u05e8\u05d6\u05d9\u05dd \u05d5\u05d1\u05e2\u05e6\u05d9 \u05d1\u05e8\u05d5\u05e9\u05d9\u05dd ] [ (I Kings 5:23) \u05db\u05d2 \u05e2\u05d1\u05d3\u05d9 \u05d9\u05e8\u05d3\u05d5 \u05de\u05df \u05d4\u05dc\u05d1\u05e0\u05d5\u05df \u05d9\u05de\u05d4 \u05d5\u05d0\u05e0\u05d9 \u05d0\u05e9\u05d9\u05de\u05dd \u05d3\u05d1\u05e8\u05d5\u05ea \u05d1\u05d9\u05dd \u05e2\u05d3 \u05d4\u05de\u05e7\u05d5\u05dd \u05d0\u05e9\u05e8 \u05ea\u05e9\u05dc\u05d7 \u05d0\u05dc\u05d9 \u05d5\u05e0\u05e4\u05e6\u05ea\u05d9\u05dd \u05e9\u05dd--\u05d5\u05d0\u05ea\u05d4 \u05ea\u05e9\u05d0 \u05d5\u05d0\u05ea\u05d4 \u05ea\u05e2\u05e9\u05d4 \u05d0\u05ea \u05d7\u05e4\u05e6\u05d9 \u05dc\u05ea\u05ea \u05dc\u05d7\u05dd \u05d1\u05d9\u05ea\u05d9 ] [ (I Kings 5:24) \u05db\u05d3 \u05d5\u05d9\u05d4\u05d9 \u05d7\u05d9\u05e8\u05d5\u05dd \u05e0\u05ea\u05df \u05dc\u05e9\u05dc\u05de\u05d4 \u05e2\u05e6\u05d9 \u05d0\u05e8\u05d6\u05d9\u05dd \u05d5\u05e2\u05e6\u05d9 \u05d1\u05e8\u05d5\u05e9\u05d9\u05dd--\u05db\u05dc \u05d7\u05e4\u05e6\u05d5 ] [ (I Kings 5:25) \u05db\u05d4 \u05d5\u05e9\u05dc\u05de\u05d4 \u05e0\u05ea\u05df \u05dc\u05d7\u05d9\u05e8\u05dd \u05e2\u05e9\u05e8\u05d9\u05dd \u05d0\u05dc\u05e3 \u05db\u05e8 \u05d7\u05d8\u05d9\u05dd \u05de\u05db\u05dc\u05ea \u05dc\u05d1\u05d9\u05ea\u05d5 \u05d5\u05e2\u05e9\u05e8\u05d9\u05dd \u05db\u05e8 \u05e9\u05de\u05df \u05db\u05ea\u05d9\u05ea\u00a0 \u05db\u05d4 \u05d9\u05ea\u05df \u05e9\u05dc\u05de\u05d4 \u05dc\u05d7\u05d9\u05e8\u05dd \u05e9\u05e0\u05d4 \u05d1\u05e9\u05e0\u05d4\u00a0 {\u05e4} ] [ (I Kings 5:26) \u05db\u05d5 \u05d5\u05d9\u05d4\u05d5\u05d4 \u05e0\u05ea\u05df \u05d7\u05db\u05de\u05d4 \u05dc\u05e9\u05dc\u05de\u05d4 \u05db\u05d0\u05e9\u05e8 \u05d3\u05d1\u05e8 \u05dc\u05d5 \u05d5\u05d9\u05d4\u05d9 \u05e9\u05dc\u05dd \u05d1\u05d9\u05df \u05d7\u05d9\u05e8\u05dd \u05d5\u05d1\u05d9\u05df \u05e9\u05dc\u05de\u05d4 \u05d5\u05d9\u05db\u05e8\u05ea\u05d5 \u05d1\u05e8\u05d9\u05ea \u05e9\u05e0\u05d9\u05d4\u05dd ] [ (I Kings 5:27) \u05db\u05d6 \u05d5\u05d9\u05e2\u05dc \u05d4\u05de\u05dc\u05da \u05e9\u05dc\u05de\u05d4 \u05de\u05e1 \u05de\u05db\u05dc \u05d9\u05e9\u05e8\u05d0\u05dc \u05d5\u05d9\u05d4\u05d9 \u05d4\u05de\u05e1 \u05e9\u05dc\u05e9\u05d9\u05dd \u05d0\u05dc\u05e3 \u05d0\u05d9\u05e9 ] [ (I Kings 5:28) \u05db\u05d7 \u05d5\u05d9\u05e9\u05dc\u05d7\u05dd \u05dc\u05d1\u05e0\u05d5\u05e0\u05d4 \u05e2\u05e9\u05e8\u05ea \u05d0\u05dc\u05e4\u05d9\u05dd \u05d1\u05d7\u05d3\u05e9 \u05d7\u05dc\u05d9\u05e4\u05d5\u05ea--\u05d7\u05d3\u05e9 \u05d9\u05d4\u05d9\u05d5 \u05d1\u05dc\u05d1\u05e0\u05d5\u05df \u05e9\u05e0\u05d9\u05dd \u05d7\u05d3\u05e9\u05d9\u05dd \u05d1\u05d1\u05d9\u05ea\u05d5 \u05d5\u05d0\u05d3\u05e0\u05d9\u05e8\u05dd \u05e2\u05dc \u05d4\u05de\u05e1\u00a0 {\u05e1} ] [ (I Kings 5:29) \u05db\u05d8 \u05d5\u05d9\u05d4\u05d9 \u05dc\u05e9\u05dc\u05de\u05d4 \u05e9\u05d1\u05e2\u05d9\u05dd \u05d0\u05dc\u05e3 \u05e0\u05e9\u05d0 \u05e1\u05d1\u05dc \u05d5\u05e9\u05de\u05e0\u05d9\u05dd \u05d0\u05dc\u05e3 \u05d7\u05e6\u05d1 \u05d1\u05d4\u05e8 ] [ (I Kings 5:30) \u05dc \u05dc\u05d1\u05d3 \u05de\u05e9\u05e8\u05d9 \u05d4\u05e0\u05e6\u05d1\u05d9\u05dd \u05dc\u05e9\u05dc\u05de\u05d4 \u05d0\u05e9\u05e8 \u05e2\u05dc \u05d4\u05de\u05dc\u05d0\u05db\u05d4 \u05e9\u05dc\u05e9\u05ea \u05d0\u05dc\u05e4\u05d9\u05dd \u05d5\u05e9\u05dc\u05e9 \u05de\u05d0\u05d5\u05ea--\u05d4\u05e8\u05d3\u05d9\u05dd \u05d1\u05e2\u05dd \u05d4\u05e2\u05e9\u05d9\u05dd \u05d1\u05de\u05dc\u05d0\u05db\u05d4\u00a0 {\u05e1} ] [ (I Kings 5:31) \u05dc\u05d0 \u05d5\u05d9\u05e6\u05d5 \u05d4\u05de\u05dc\u05da \u05d5\u05d9\u05e1\u05e2\u05d5 \u05d0\u05d1\u05e0\u05d9\u05dd \u05d2\u05d3\u05dc\u05d5\u05ea \u05d0\u05d1\u05e0\u05d9\u05dd \u05d9\u05e7\u05e8\u05d5\u05ea \u05dc\u05d9\u05e1\u05d3 \u05d4\u05d1\u05d9\u05ea--\u05d0\u05d1\u05e0\u05d9 \u05d2\u05d6\u05d9\u05ea ] [ (I Kings 5:32) \u05dc\u05d1 \u05d5\u05d9\u05e4\u05e1\u05dc\u05d5 \u05d1\u05e0\u05d9 \u05e9\u05dc\u05de\u05d4 \u05d5\u05d1\u05e0\u05d9 \u05d7\u05d9\u05e8\u05d5\u05dd--\u05d5\u05d4\u05d2\u05d1\u05dc\u05d9\u05dd \u05d5\u05d9\u05db\u05d9\u05e0\u05d5 \u05d4\u05e2\u05e6\u05d9\u05dd \u05d5\u05d4\u05d0\u05d1\u05e0\u05d9\u05dd \u05dc\u05d1\u05e0\u05d5\u05ea \u05d4\u05d1\u05d9\u05ea\u00a0 {\u05e4} ]"}]