[{"pk": 2895997, "verse": 1, "text": "\u05d0 \u05d0\u05d6 \u05d9\u05e7\u05d4\u05dc \u05e9\u05dc\u05de\u05d4 \u05d0\u05ea \u05d6\u05e7\u05e0\u05d9 \u05d9\u05e9\u05e8\u05d0\u05dc \u05d0\u05ea \u05db\u05dc \u05e8\u05d0\u05e9\u05d9 \u05d4\u05de\u05d8\u05d5\u05ea \u05e0\u05e9\u05d9\u05d0\u05d9 \u05d4\u05d0\u05d1\u05d5\u05ea \u05dc\u05d1\u05e0\u05d9 \u05d9\u05e9\u05e8\u05d0\u05dc \u05d0\u05dc \u05d4\u05de\u05dc\u05da \u05e9\u05dc\u05de\u05d4--\u05d9\u05e8\u05d5\u05e9\u05dc\u05dd\u00a0 \u05dc\u05d4\u05e2\u05dc\u05d5\u05ea \u05d0\u05ea \u05d0\u05e8\u05d5\u05df \u05d1\u05e8\u05d9\u05ea \u05d9\u05d4\u05d5\u05d4 \u05de\u05e2\u05d9\u05e8 \u05d3\u05d5\u05d3--\u05d4\u05d9\u05d0 \u05e6\u05d9\u05d5\u05df"}, {"pk": 2895998, "verse": 2, "text": "\u05d1 \u05d5\u05d9\u05e7\u05d4\u05dc\u05d5 \u05d0\u05dc \u05d4\u05de\u05dc\u05da \u05e9\u05dc\u05de\u05d4 \u05db\u05dc \u05d0\u05d9\u05e9 \u05d9\u05e9\u05e8\u05d0\u05dc \u05d1\u05d9\u05e8\u05d7 \u05d4\u05d0\u05ea\u05e0\u05d9\u05dd \u05d1\u05d7\u05d2--\u05d4\u05d5\u05d0 \u05d4\u05d7\u05d3\u05e9 \u05d4\u05e9\u05d1\u05d9\u05e2\u05d9"}, {"pk": 2895999, "verse": 3, "text": "\u05d2 \u05d5\u05d9\u05d1\u05d0\u05d5 \u05db\u05dc \u05d6\u05e7\u05e0\u05d9 \u05d9\u05e9\u05e8\u05d0\u05dc \u05d5\u05d9\u05e9\u05d0\u05d5 \u05d4\u05db\u05d4\u05e0\u05d9\u05dd \u05d0\u05ea \u05d4\u05d0\u05e8\u05d5\u05df"}, {"pk": 2896000, "verse": 4, "text": "\u05d3 \u05d5\u05d9\u05e2\u05dc\u05d5 \u05d0\u05ea \u05d0\u05e8\u05d5\u05df \u05d9\u05d4\u05d5\u05d4 \u05d5\u05d0\u05ea \u05d0\u05d4\u05dc \u05de\u05d5\u05e2\u05d3 \u05d5\u05d0\u05ea \u05db\u05dc \u05db\u05dc\u05d9 \u05d4\u05e7\u05d3\u05e9 \u05d0\u05e9\u05e8 \u05d1\u05d0\u05d4\u05dc \u05d5\u05d9\u05e2\u05dc\u05d5 \u05d0\u05ea\u05dd \u05d4\u05db\u05d4\u05e0\u05d9\u05dd \u05d5\u05d4\u05dc\u05d5\u05d9\u05dd"}, {"pk": 2896001, "verse": 5, "text": "\u05d4 \u05d5\u05d4\u05de\u05dc\u05da \u05e9\u05dc\u05de\u05d4 \u05d5\u05db\u05dc \u05e2\u05d3\u05ea \u05d9\u05e9\u05e8\u05d0\u05dc \u05d4\u05e0\u05d5\u05e2\u05d3\u05d9\u05dd \u05e2\u05dc\u05d9\u05d5 \u05d0\u05ea\u05d5 \u05dc\u05e4\u05e0\u05d9 \u05d4\u05d0\u05e8\u05d5\u05df--\u05de\u05d6\u05d1\u05d7\u05d9\u05dd \u05e6\u05d0\u05df \u05d5\u05d1\u05e7\u05e8 \u05d0\u05e9\u05e8 \u05dc\u05d0 \u05d9\u05e1\u05e4\u05e8\u05d5 \u05d5\u05dc\u05d0 \u05d9\u05de\u05e0\u05d5 \u05de\u05e8\u05d1"}, {"pk": 2896002, "verse": 6, "text": "\u05d5 \u05d5\u05d9\u05d1\u05d0\u05d5 \u05d4\u05db\u05d4\u05e0\u05d9\u05dd \u05d0\u05ea \u05d0\u05e8\u05d5\u05df \u05d1\u05e8\u05d9\u05ea \u05d9\u05d4\u05d5\u05d4 \u05d0\u05dc \u05de\u05e7\u05d5\u05de\u05d5 \u05d0\u05dc \u05d3\u05d1\u05d9\u05e8 \u05d4\u05d1\u05d9\u05ea--\u05d0\u05dc \u05e7\u05d3\u05e9 \u05d4\u05e7\u05d3\u05e9\u05d9\u05dd\u00a0 \u05d0\u05dc \u05ea\u05d7\u05ea \u05db\u05e0\u05e4\u05d9 \u05d4\u05db\u05e8\u05d5\u05d1\u05d9\u05dd"}, {"pk": 2896003, "verse": 7, "text": "\u05d6 \u05db\u05d9 \u05d4\u05db\u05e8\u05d5\u05d1\u05d9\u05dd \u05e4\u05e8\u05e9\u05d9\u05dd \u05db\u05e0\u05e4\u05d9\u05dd \u05d0\u05dc \u05de\u05e7\u05d5\u05dd \u05d4\u05d0\u05e8\u05d5\u05df \u05d5\u05d9\u05e1\u05db\u05d5 \u05d4\u05db\u05e8\u05d1\u05d9\u05dd \u05e2\u05dc \u05d4\u05d0\u05e8\u05d5\u05df \u05d5\u05e2\u05dc \u05d1\u05d3\u05d9\u05d5 \u05de\u05dc\u05de\u05e2\u05dc\u05d4"}, {"pk": 2896004, "verse": 8, "text": "\u05d7 \u05d5\u05d9\u05d0\u05e8\u05db\u05d5 \u05d4\u05d1\u05d3\u05d9\u05dd \u05d5\u05d9\u05e8\u05d0\u05d5 \u05e8\u05d0\u05e9\u05d9 \u05d4\u05d1\u05d3\u05d9\u05dd \u05de\u05df \u05d4\u05e7\u05d3\u05e9 \u05e2\u05dc \u05e4\u05e0\u05d9 \u05d4\u05d3\u05d1\u05d9\u05e8 \u05d5\u05dc\u05d0 \u05d9\u05e8\u05d0\u05d5 \u05d4\u05d7\u05d5\u05e6\u05d4 \u05d5\u05d9\u05d4\u05d9\u05d5 \u05e9\u05dd \u05e2\u05d3 \u05d4\u05d9\u05d5\u05dd \u05d4\u05d6\u05d4"}, {"pk": 2896005, "verse": 9, "text": "\u05d8 \u05d0\u05d9\u05df \u05d1\u05d0\u05e8\u05d5\u05df \u05e8\u05e7 \u05e9\u05e0\u05d9 \u05dc\u05d7\u05d5\u05ea \u05d4\u05d0\u05d1\u05e0\u05d9\u05dd \u05d0\u05e9\u05e8 \u05d4\u05e0\u05d7 \u05e9\u05dd \u05de\u05e9\u05d4 \u05d1\u05d7\u05e8\u05d1--\u05d0\u05e9\u05e8 \u05db\u05e8\u05ea \u05d9\u05d4\u05d5\u05d4 \u05e2\u05dd \u05d1\u05e0\u05d9 \u05d9\u05e9\u05e8\u05d0\u05dc \u05d1\u05e6\u05d0\u05ea\u05dd \u05de\u05d0\u05e8\u05e5 \u05de\u05e6\u05e8\u05d9\u05dd"}, {"pk": 2896006, "verse": 10, "text": "\u05d9 \u05d5\u05d9\u05d4\u05d9 \u05d1\u05e6\u05d0\u05ea \u05d4\u05db\u05d4\u05e0\u05d9\u05dd \u05de\u05df \u05d4\u05e7\u05d3\u05e9 \u05d5\u05d4\u05e2\u05e0\u05df \u05de\u05dc\u05d0 \u05d0\u05ea \u05d1\u05d9\u05ea \u05d9\u05d4\u05d5\u05d4"}, {"pk": 2896007, "verse": 11, "text": "\u05d9\u05d0 \u05d5\u05dc\u05d0 \u05d9\u05db\u05dc\u05d5 \u05d4\u05db\u05d4\u05e0\u05d9\u05dd \u05dc\u05e2\u05de\u05d3 \u05dc\u05e9\u05e8\u05ea \u05de\u05e4\u05e0\u05d9 \u05d4\u05e2\u05e0\u05df\u00a0 \u05db\u05d9 \u05de\u05dc\u05d0 \u05db\u05d1\u05d5\u05d3 \u05d9\u05d4\u05d5\u05d4 \u05d0\u05ea \u05d1\u05d9\u05ea \u05d9\u05d4\u05d5\u05d4\u00a0 {\u05e4}"}, {"pk": 2896008, "verse": 12, "text": "\u05d9\u05d1 \u05d0\u05d6 \u05d0\u05de\u05e8 \u05e9\u05dc\u05de\u05d4\u00a0 \u05d9\u05d4\u05d5\u05d4 \u05d0\u05de\u05e8 \u05dc\u05e9\u05db\u05df \u05d1\u05e2\u05e8\u05e4\u05dc"}, {"pk": 2896009, "verse": 13, "text": "\u05d9\u05d2 \u05d1\u05e0\u05d4 \u05d1\u05e0\u05d9\u05ea\u05d9 \u05d1\u05d9\u05ea \u05d6\u05d1\u05dc \u05dc\u05da--\u05de\u05db\u05d5\u05df \u05dc\u05e9\u05d1\u05ea\u05da \u05e2\u05d5\u05dc\u05de\u05d9\u05dd"}, {"pk": 2896010, "verse": 14, "text": "\u05d9\u05d3 \u05d5\u05d9\u05e1\u05d1 \u05d4\u05de\u05dc\u05da \u05d0\u05ea \u05e4\u05e0\u05d9\u05d5 \u05d5\u05d9\u05d1\u05e8\u05da \u05d0\u05ea \u05db\u05dc \u05e7\u05d4\u05dc \u05d9\u05e9\u05e8\u05d0\u05dc \u05d5\u05db\u05dc \u05e7\u05d4\u05dc \u05d9\u05e9\u05e8\u05d0\u05dc \u05e2\u05de\u05d3"}, {"pk": 2896011, "verse": 15, "text": "\u05d8\u05d5 \u05d5\u05d9\u05d0\u05de\u05e8 \u05d1\u05e8\u05d5\u05da \u05d9\u05d4\u05d5\u05d4 \u05d0\u05dc\u05d4\u05d9 \u05d9\u05e9\u05e8\u05d0\u05dc \u05d0\u05e9\u05e8 \u05d3\u05d1\u05e8 \u05d1\u05e4\u05d9\u05d5 \u05d0\u05ea \u05d3\u05d5\u05d3 \u05d0\u05d1\u05d9 \u05d5\u05d1\u05d9\u05d3\u05d5 \u05de\u05dc\u05d0 \u05dc\u05d0\u05de\u05e8"}, {"pk": 2896012, "verse": 16, "text": "\u05d8\u05d6 \u05de\u05df \u05d4\u05d9\u05d5\u05dd \u05d0\u05e9\u05e8 \u05d4\u05d5\u05e6\u05d0\u05ea\u05d9 \u05d0\u05ea \u05e2\u05de\u05d9 \u05d0\u05ea \u05d9\u05e9\u05e8\u05d0\u05dc \u05de\u05de\u05e6\u05e8\u05d9\u05dd \u05dc\u05d0 \u05d1\u05d7\u05e8\u05ea\u05d9 \u05d1\u05e2\u05d9\u05e8 \u05de\u05db\u05dc \u05e9\u05d1\u05d8\u05d9 \u05d9\u05e9\u05e8\u05d0\u05dc \u05dc\u05d1\u05e0\u05d5\u05ea \u05d1\u05d9\u05ea \u05dc\u05d4\u05d9\u05d5\u05ea \u05e9\u05de\u05d9 \u05e9\u05dd \u05d5\u05d0\u05d1\u05d7\u05e8 \u05d1\u05d3\u05d5\u05d3 \u05dc\u05d4\u05d9\u05d5\u05ea \u05e2\u05dc \u05e2\u05de\u05d9 \u05d9\u05e9\u05e8\u05d0\u05dc"}, {"pk": 2896013, "verse": 17, "text": "\u05d9\u05d6 \u05d5\u05d9\u05d4\u05d9 \u05e2\u05dd \u05dc\u05d1\u05d1 \u05d3\u05d5\u05d3 \u05d0\u05d1\u05d9--\u05dc\u05d1\u05e0\u05d5\u05ea \u05d1\u05d9\u05ea \u05dc\u05e9\u05dd \u05d9\u05d4\u05d5\u05d4 \u05d0\u05dc\u05d4\u05d9 \u05d9\u05e9\u05e8\u05d0\u05dc"}, {"pk": 2896014, "verse": 18, "text": "\u05d9\u05d7 \u05d5\u05d9\u05d0\u05de\u05e8 \u05d9\u05d4\u05d5\u05d4 \u05d0\u05dc \u05d3\u05d5\u05d3 \u05d0\u05d1\u05d9 \u05d9\u05e2\u05df \u05d0\u05e9\u05e8 \u05d4\u05d9\u05d4 \u05e2\u05dd \u05dc\u05d1\u05d1\u05da \u05dc\u05d1\u05e0\u05d5\u05ea \u05d1\u05d9\u05ea \u05dc\u05e9\u05de\u05d9--\u05d4\u05d8\u05d9\u05d1\u05ea \u05db\u05d9 \u05d4\u05d9\u05d4 \u05e2\u05dd \u05dc\u05d1\u05d1\u05da"}, {"pk": 2896015, "verse": 19, "text": "\u05d9\u05d8 \u05e8\u05e7 \u05d0\u05ea\u05d4 \u05dc\u05d0 \u05ea\u05d1\u05e0\u05d4 \u05d4\u05d1\u05d9\u05ea\u00a0 \u05db\u05d9 \u05d0\u05dd \u05d1\u05e0\u05da \u05d4\u05d9\u05e6\u05d0 \u05de\u05d7\u05dc\u05e6\u05d9\u05da \u05d4\u05d5\u05d0 \u05d9\u05d1\u05e0\u05d4 \u05d4\u05d1\u05d9\u05ea \u05dc\u05e9\u05de\u05d9"}, {"pk": 2896016, "verse": 20, "text": "\u05db \u05d5\u05d9\u05e7\u05dd \u05d9\u05d4\u05d5\u05d4 \u05d0\u05ea \u05d3\u05d1\u05e8\u05d5 \u05d0\u05e9\u05e8 \u05d3\u05d1\u05e8 \u05d5\u05d0\u05e7\u05dd \u05ea\u05d7\u05ea \u05d3\u05d5\u05d3 \u05d0\u05d1\u05d9 \u05d5\u05d0\u05e9\u05d1 \u05e2\u05dc \u05db\u05e1\u05d0 \u05d9\u05e9\u05e8\u05d0\u05dc \u05db\u05d0\u05e9\u05e8 \u05d3\u05d1\u05e8 \u05d9\u05d4\u05d5\u05d4 \u05d5\u05d0\u05d1\u05e0\u05d4 \u05d4\u05d1\u05d9\u05ea \u05dc\u05e9\u05dd \u05d9\u05d4\u05d5\u05d4 \u05d0\u05dc\u05d4\u05d9 \u05d9\u05e9\u05e8\u05d0\u05dc"}, {"pk": 2896017, "verse": 21, "text": "\u05db\u05d0 \u05d5\u05d0\u05e9\u05dd \u05e9\u05dd \u05de\u05e7\u05d5\u05dd \u05dc\u05d0\u05e8\u05d5\u05df \u05d0\u05e9\u05e8 \u05e9\u05dd \u05d1\u05e8\u05d9\u05ea \u05d9\u05d4\u05d5\u05d4 \u05d0\u05e9\u05e8 \u05db\u05e8\u05ea \u05e2\u05dd \u05d0\u05d1\u05ea\u05d9\u05e0\u05d5 \u05d1\u05d4\u05d5\u05e6\u05d9\u05d0\u05d5 \u05d0\u05ea\u05dd \u05de\u05d0\u05e8\u05e5 \u05de\u05e6\u05e8\u05d9\u05dd\u00a0 {\u05e1}"}, {"pk": 2896018, "verse": 22, "text": "\u05db\u05d1 \u05d5\u05d9\u05e2\u05de\u05d3 \u05e9\u05dc\u05de\u05d4 \u05dc\u05e4\u05e0\u05d9 \u05de\u05d6\u05d1\u05d7 \u05d9\u05d4\u05d5\u05d4 \u05e0\u05d2\u05d3 \u05db\u05dc \u05e7\u05d4\u05dc \u05d9\u05e9\u05e8\u05d0\u05dc \u05d5\u05d9\u05e4\u05e8\u05e9 \u05db\u05e4\u05d9\u05d5 \u05d4\u05e9\u05de\u05d9\u05dd"}, {"pk": 2896019, "verse": 23, "text": "\u05db\u05d2 \u05d5\u05d9\u05d0\u05de\u05e8 \u05d9\u05d4\u05d5\u05d4 \u05d0\u05dc\u05d4\u05d9 \u05d9\u05e9\u05e8\u05d0\u05dc \u05d0\u05d9\u05df \u05db\u05de\u05d5\u05da \u05d0\u05dc\u05d4\u05d9\u05dd \u05d1\u05e9\u05de\u05d9\u05dd \u05de\u05de\u05e2\u05dc \u05d5\u05e2\u05dc \u05d4\u05d0\u05e8\u05e5 \u05de\u05ea\u05d7\u05ea\u00a0 \u05e9\u05de\u05e8 \u05d4\u05d1\u05e8\u05d9\u05ea \u05d5\u05d4\u05d7\u05e1\u05d3 \u05dc\u05e2\u05d1\u05d3\u05d9\u05da \u05d4\u05d4\u05dc\u05db\u05d9\u05dd \u05dc\u05e4\u05e0\u05d9\u05da \u05d1\u05db\u05dc \u05dc\u05d1\u05dd"}, {"pk": 2896020, "verse": 24, "text": "\u05db\u05d3 \u05d0\u05e9\u05e8 \u05e9\u05de\u05e8\u05ea \u05dc\u05e2\u05d1\u05d3\u05da \u05d3\u05d5\u05d3 \u05d0\u05d1\u05d9 \u05d0\u05ea \u05d0\u05e9\u05e8 \u05d3\u05d1\u05e8\u05ea \u05dc\u05d5 \u05d5\u05ea\u05d3\u05d1\u05e8 \u05d1\u05e4\u05d9\u05da \u05d5\u05d1\u05d9\u05d3\u05da \u05de\u05dc\u05d0\u05ea \u05db\u05d9\u05d5\u05dd \u05d4\u05d6\u05d4"}, {"pk": 2896021, "verse": 25, "text": "\u05db\u05d4 \u05d5\u05e2\u05ea\u05d4 \u05d9\u05d4\u05d5\u05d4 \u05d0\u05dc\u05d4\u05d9 \u05d9\u05e9\u05e8\u05d0\u05dc \u05e9\u05de\u05e8 \u05dc\u05e2\u05d1\u05d3\u05da \u05d3\u05d5\u05d3 \u05d0\u05d1\u05d9 \u05d0\u05ea \u05d0\u05e9\u05e8 \u05d3\u05d1\u05e8\u05ea \u05dc\u05d5 \u05dc\u05d0\u05de\u05e8 \u05dc\u05d0 \u05d9\u05db\u05e8\u05ea \u05dc\u05da \u05d0\u05d9\u05e9 \u05de\u05dc\u05e4\u05e0\u05d9 \u05d9\u05e9\u05d1 \u05e2\u05dc \u05db\u05e1\u05d0 \u05d9\u05e9\u05e8\u05d0\u05dc\u00a0 \u05e8\u05e7 \u05d0\u05dd \u05d9\u05e9\u05de\u05e8\u05d5 \u05d1\u05e0\u05d9\u05da \u05d0\u05ea \u05d3\u05e8\u05db\u05dd \u05dc\u05dc\u05db\u05ea \u05dc\u05e4\u05e0\u05d9 \u05db\u05d0\u05e9\u05e8 \u05d4\u05dc\u05db\u05ea \u05dc\u05e4\u05e0\u05d9"}, {"pk": 2896022, "verse": 26, "text": "\u05db\u05d5 \u05d5\u05e2\u05ea\u05d4 \u05d0\u05dc\u05d4\u05d9 \u05d9\u05e9\u05e8\u05d0\u05dc--\u05d9\u05d0\u05de\u05df \u05e0\u05d0 \u05d3\u05d1\u05e8\u05d9\u05da (\u05d3\u05d1\u05e8\u05da) \u05d0\u05e9\u05e8 \u05d3\u05d1\u05e8\u05ea \u05dc\u05e2\u05d1\u05d3\u05da \u05d3\u05d5\u05d3 \u05d0\u05d1\u05d9"}, {"pk": 2896023, "verse": 27, "text": "\u05db\u05d6 \u05db\u05d9 \u05d4\u05d0\u05de\u05e0\u05dd \u05d9\u05e9\u05d1 \u05d0\u05dc\u05d4\u05d9\u05dd \u05e2\u05dc \u05d4\u05d0\u05e8\u05e5 \u05d4\u05e0\u05d4 \u05d4\u05e9\u05de\u05d9\u05dd \u05d5\u05e9\u05de\u05d9 \u05d4\u05e9\u05de\u05d9\u05dd \u05dc\u05d0 \u05d9\u05db\u05dc\u05db\u05dc\u05d5\u05da--\u05d0\u05e3 \u05db\u05d9 \u05d4\u05d1\u05d9\u05ea \u05d4\u05d6\u05d4 \u05d0\u05e9\u05e8 \u05d1\u05e0\u05d9\u05ea\u05d9"}, {"pk": 2896024, "verse": 28, "text": "\u05db\u05d7 \u05d5\u05e4\u05e0\u05d9\u05ea \u05d0\u05dc \u05ea\u05e4\u05dc\u05ea \u05e2\u05d1\u05d3\u05da \u05d5\u05d0\u05dc \u05ea\u05d7\u05e0\u05ea\u05d5--\u05d9\u05d4\u05d5\u05d4 \u05d0\u05dc\u05d4\u05d9\u00a0 \u05dc\u05e9\u05de\u05e2 \u05d0\u05dc \u05d4\u05e8\u05e0\u05d4 \u05d5\u05d0\u05dc \u05d4\u05ea\u05e4\u05dc\u05d4 \u05d0\u05e9\u05e8 \u05e2\u05d1\u05d3\u05da \u05de\u05ea\u05e4\u05dc\u05dc \u05dc\u05e4\u05e0\u05d9\u05da \u05d4\u05d9\u05d5\u05dd"}, {"pk": 2896025, "verse": 29, "text": "\u05db\u05d8 \u05dc\u05d4\u05d9\u05d5\u05ea \u05e2\u05d9\u05e0\u05da \u05e4\u05ea\u05d7\u05ea \u05d0\u05dc \u05d4\u05d1\u05d9\u05ea \u05d4\u05d6\u05d4 \u05dc\u05d9\u05dc\u05d4 \u05d5\u05d9\u05d5\u05dd \u05d0\u05dc \u05d4\u05de\u05e7\u05d5\u05dd \u05d0\u05e9\u05e8 \u05d0\u05de\u05e8\u05ea \u05d9\u05d4\u05d9\u05d4 \u05e9\u05de\u05d9 \u05e9\u05dd--\u05dc\u05e9\u05de\u05e2 \u05d0\u05dc \u05d4\u05ea\u05e4\u05dc\u05d4 \u05d0\u05e9\u05e8 \u05d9\u05ea\u05e4\u05dc\u05dc \u05e2\u05d1\u05d3\u05da \u05d0\u05dc \u05d4\u05de\u05e7\u05d5\u05dd \u05d4\u05d6\u05d4"}, {"pk": 2896026, "verse": 30, "text": "\u05dc \u05d5\u05e9\u05de\u05e2\u05ea \u05d0\u05dc \u05ea\u05d7\u05e0\u05ea \u05e2\u05d1\u05d3\u05da \u05d5\u05e2\u05de\u05da \u05d9\u05e9\u05e8\u05d0\u05dc \u05d0\u05e9\u05e8 \u05d9\u05ea\u05e4\u05dc\u05dc\u05d5 \u05d0\u05dc \u05d4\u05de\u05e7\u05d5\u05dd \u05d4\u05d6\u05d4 \u05d5\u05d0\u05ea\u05d4 \u05ea\u05e9\u05de\u05e2 \u05d0\u05dc \u05de\u05e7\u05d5\u05dd \u05e9\u05d1\u05ea\u05da \u05d0\u05dc \u05d4\u05e9\u05de\u05d9\u05dd \u05d5\u05e9\u05de\u05e2\u05ea \u05d5\u05e1\u05dc\u05d7\u05ea"}, {"pk": 2896027, "verse": 31, "text": "\u05dc\u05d0 \u05d0\u05ea \u05d0\u05e9\u05e8 \u05d9\u05d7\u05d8\u05d0 \u05d0\u05d9\u05e9 \u05dc\u05e8\u05e2\u05d4\u05d5 \u05d5\u05e0\u05e9\u05d0 \u05d1\u05d5 \u05d0\u05dc\u05d4 \u05dc\u05d4\u05d0\u05dc\u05ea\u05d5 \u05d5\u05d1\u05d0 \u05d0\u05dc\u05d4 \u05dc\u05e4\u05e0\u05d9 \u05de\u05d6\u05d1\u05d7\u05da--\u05d1\u05d1\u05d9\u05ea \u05d4\u05d6\u05d4"}, {"pk": 2896028, "verse": 32, "text": "\u05dc\u05d1 \u05d5\u05d0\u05ea\u05d4 \u05ea\u05e9\u05de\u05e2 \u05d4\u05e9\u05de\u05d9\u05dd \u05d5\u05e2\u05e9\u05d9\u05ea \u05d5\u05e9\u05e4\u05d8\u05ea \u05d0\u05ea \u05e2\u05d1\u05d3\u05d9\u05da--\u05dc\u05d4\u05e8\u05e9\u05d9\u05e2 \u05e8\u05e9\u05e2 \u05dc\u05ea\u05ea \u05d3\u05e8\u05db\u05d5 \u05d1\u05e8\u05d0\u05e9\u05d5 \u05d5\u05dc\u05d4\u05e6\u05d3\u05d9\u05e7 \u05e6\u05d3\u05d9\u05e7 \u05dc\u05ea\u05ea \u05dc\u05d5 \u05db\u05e6\u05d3\u05e7\u05ea\u05d5"}, {"pk": 2896029, "verse": 33, "text": "\u05dc\u05d2 \u05d1\u05d4\u05e0\u05d2\u05e3 \u05e2\u05de\u05da \u05d9\u05e9\u05e8\u05d0\u05dc \u05dc\u05e4\u05e0\u05d9 \u05d0\u05d5\u05d9\u05d1--\u05d0\u05e9\u05e8 \u05d9\u05d7\u05d8\u05d0\u05d5 \u05dc\u05da \u05d5\u05e9\u05d1\u05d5 \u05d0\u05dc\u05d9\u05da \u05d5\u05d4\u05d5\u05d3\u05d5 \u05d0\u05ea \u05e9\u05de\u05da \u05d5\u05d4\u05ea\u05e4\u05dc\u05dc\u05d5 \u05d5\u05d4\u05ea\u05d7\u05e0\u05e0\u05d5 \u05d0\u05dc\u05d9\u05da \u05d1\u05d1\u05d9\u05ea \u05d4\u05d6\u05d4"}, {"pk": 2896030, "verse": 34, "text": "\u05dc\u05d3 \u05d5\u05d0\u05ea\u05d4 \u05ea\u05e9\u05de\u05e2 \u05d4\u05e9\u05de\u05d9\u05dd \u05d5\u05e1\u05dc\u05d7\u05ea \u05dc\u05d7\u05d8\u05d0\u05ea \u05e2\u05de\u05da \u05d9\u05e9\u05e8\u05d0\u05dc \u05d5\u05d4\u05e9\u05d1\u05ea\u05dd \u05d0\u05dc \u05d4\u05d0\u05d3\u05de\u05d4 \u05d0\u05e9\u05e8 \u05e0\u05ea\u05ea \u05dc\u05d0\u05d1\u05d5\u05ea\u05dd\u00a0 {\u05e1}"}, {"pk": 2896031, "verse": 35, "text": "\u05dc\u05d4 \u05d1\u05d4\u05e2\u05e6\u05e8 \u05e9\u05de\u05d9\u05dd \u05d5\u05dc\u05d0 \u05d9\u05d4\u05d9\u05d4 \u05de\u05d8\u05e8 \u05db\u05d9 \u05d9\u05d7\u05d8\u05d0\u05d5 \u05dc\u05da \u05d5\u05d4\u05ea\u05e4\u05dc\u05dc\u05d5 \u05d0\u05dc \u05d4\u05de\u05e7\u05d5\u05dd \u05d4\u05d6\u05d4 \u05d5\u05d4\u05d5\u05d3\u05d5 \u05d0\u05ea \u05e9\u05de\u05da \u05d5\u05de\u05d7\u05d8\u05d0\u05ea\u05dd \u05d9\u05e9\u05d5\u05d1\u05d5\u05df \u05db\u05d9 \u05ea\u05e2\u05e0\u05dd"}, {"pk": 2896032, "verse": 36, "text": "\u05dc\u05d5 \u05d5\u05d0\u05ea\u05d4 \u05ea\u05e9\u05de\u05e2 \u05d4\u05e9\u05de\u05d9\u05dd \u05d5\u05e1\u05dc\u05d7\u05ea \u05dc\u05d7\u05d8\u05d0\u05ea \u05e2\u05d1\u05d3\u05d9\u05da \u05d5\u05e2\u05de\u05da \u05d9\u05e9\u05e8\u05d0\u05dc--\u05db\u05d9 \u05ea\u05d5\u05e8\u05dd \u05d0\u05ea \u05d4\u05d3\u05e8\u05da \u05d4\u05d8\u05d5\u05d1\u05d4 \u05d0\u05e9\u05e8 \u05d9\u05dc\u05db\u05d5 \u05d1\u05d4 \u05d5\u05e0\u05ea\u05ea\u05d4 \u05de\u05d8\u05e8 \u05e2\u05dc \u05d0\u05e8\u05e6\u05da \u05d0\u05e9\u05e8 \u05e0\u05ea\u05ea\u05d4 \u05dc\u05e2\u05de\u05da \u05dc\u05e0\u05d7\u05dc\u05d4\u00a0 {\u05e1}"}, {"pk": 2896033, "verse": 37, "text": "\u05dc\u05d6 \u05e8\u05e2\u05d1 \u05db\u05d9 \u05d9\u05d4\u05d9\u05d4 \u05d1\u05d0\u05e8\u05e5 \u05d3\u05d1\u05e8 \u05db\u05d9 \u05d9\u05d4\u05d9\u05d4 \u05e9\u05d3\u05e4\u05d5\u05df \u05d9\u05e8\u05e7\u05d5\u05df \u05d0\u05e8\u05d1\u05d4 \u05d7\u05e1\u05d9\u05dc \u05db\u05d9 \u05d9\u05d4\u05d9\u05d4 \u05db\u05d9 \u05d9\u05e6\u05e8 \u05dc\u05d5 \u05d0\u05d9\u05d1\u05d5 \u05d1\u05d0\u05e8\u05e5 \u05e9\u05e2\u05e8\u05d9\u05d5--\u05db\u05dc \u05e0\u05d2\u05e2 \u05db\u05dc \u05de\u05d7\u05dc\u05d4"}, {"pk": 2896034, "verse": 38, "text": "\u05dc\u05d7 \u05db\u05dc \u05ea\u05e4\u05dc\u05d4 \u05db\u05dc \u05ea\u05d7\u05e0\u05d4 \u05d0\u05e9\u05e8 \u05ea\u05d4\u05d9\u05d4 \u05dc\u05db\u05dc \u05d4\u05d0\u05d3\u05dd \u05dc\u05db\u05dc \u05e2\u05de\u05da \u05d9\u05e9\u05e8\u05d0\u05dc--\u05d0\u05e9\u05e8 \u05d9\u05d3\u05e2\u05d5\u05df \u05d0\u05d9\u05e9 \u05e0\u05d2\u05e2 \u05dc\u05d1\u05d1\u05d5 \u05d5\u05e4\u05e8\u05e9 \u05db\u05e4\u05d9\u05d5 \u05d0\u05dc \u05d4\u05d1\u05d9\u05ea \u05d4\u05d6\u05d4"}, {"pk": 2896035, "verse": 39, "text": "\u05dc\u05d8 \u05d5\u05d0\u05ea\u05d4 \u05ea\u05e9\u05de\u05e2 \u05d4\u05e9\u05de\u05d9\u05dd \u05de\u05db\u05d5\u05df \u05e9\u05d1\u05ea\u05da \u05d5\u05e1\u05dc\u05d7\u05ea \u05d5\u05e2\u05e9\u05d9\u05ea \u05d5\u05e0\u05ea\u05ea \u05dc\u05d0\u05d9\u05e9 \u05db\u05db\u05dc \u05d3\u05e8\u05db\u05d9\u05d5 \u05d0\u05e9\u05e8 \u05ea\u05d3\u05e2 \u05d0\u05ea \u05dc\u05d1\u05d1\u05d5\u00a0 \u05db\u05d9 \u05d0\u05ea\u05d4 \u05d9\u05d3\u05e2\u05ea \u05dc\u05d1\u05d3\u05da \u05d0\u05ea \u05dc\u05d1\u05d1 \u05db\u05dc \u05d1\u05e0\u05d9 \u05d4\u05d0\u05d3\u05dd"}, {"pk": 2896036, "verse": 40, "text": "\u05de \u05dc\u05de\u05e2\u05df \u05d9\u05e8\u05d0\u05d5\u05da \u05db\u05dc \u05d4\u05d9\u05de\u05d9\u05dd \u05d0\u05e9\u05e8 \u05d4\u05dd \u05d7\u05d9\u05d9\u05dd \u05e2\u05dc \u05e4\u05e0\u05d9 \u05d4\u05d0\u05d3\u05de\u05d4--\u05d0\u05e9\u05e8 \u05e0\u05ea\u05ea\u05d4 \u05dc\u05d0\u05d1\u05ea\u05d9\u05e0\u05d5"}, {"pk": 2896037, "verse": 41, "text": "\u05de\u05d0 \u05d5\u05d2\u05dd \u05d0\u05dc \u05d4\u05e0\u05db\u05e8\u05d9 \u05d0\u05e9\u05e8 \u05dc\u05d0 \u05de\u05e2\u05de\u05da \u05d9\u05e9\u05e8\u05d0\u05dc \u05d4\u05d5\u05d0 \u05d5\u05d1\u05d0 \u05de\u05d0\u05e8\u05e5 \u05e8\u05d7\u05d5\u05e7\u05d4 \u05dc\u05de\u05e2\u05df \u05e9\u05de\u05da"}, {"pk": 2896038, "verse": 42, "text": "\u05de\u05d1 \u05db\u05d9 \u05d9\u05e9\u05de\u05e2\u05d5\u05df \u05d0\u05ea \u05e9\u05de\u05da \u05d4\u05d2\u05d3\u05d5\u05dc \u05d5\u05d0\u05ea \u05d9\u05d3\u05da \u05d4\u05d7\u05d6\u05e7\u05d4 \u05d5\u05d6\u05e8\u05e2\u05da \u05d4\u05e0\u05d8\u05d5\u05d9\u05d4 \u05d5\u05d1\u05d0 \u05d5\u05d4\u05ea\u05e4\u05dc\u05dc \u05d0\u05dc \u05d4\u05d1\u05d9\u05ea \u05d4\u05d6\u05d4"}, {"pk": 2896039, "verse": 43, "text": "\u05de\u05d2 \u05d0\u05ea\u05d4 \u05ea\u05e9\u05de\u05e2 \u05d4\u05e9\u05de\u05d9\u05dd \u05de\u05db\u05d5\u05df \u05e9\u05d1\u05ea\u05da \u05d5\u05e2\u05e9\u05d9\u05ea \u05db\u05db\u05dc \u05d0\u05e9\u05e8 \u05d9\u05e7\u05e8\u05d0 \u05d0\u05dc\u05d9\u05da \u05d4\u05e0\u05db\u05e8\u05d9--\u05dc\u05de\u05e2\u05df \u05d9\u05d3\u05e2\u05d5\u05df \u05db\u05dc \u05e2\u05de\u05d9 \u05d4\u05d0\u05e8\u05e5 \u05d0\u05ea \u05e9\u05de\u05da \u05dc\u05d9\u05e8\u05d0\u05d4 \u05d0\u05ea\u05da \u05db\u05e2\u05de\u05da \u05d9\u05e9\u05e8\u05d0\u05dc \u05d5\u05dc\u05d3\u05e2\u05ea \u05db\u05d9 \u05e9\u05de\u05da \u05e0\u05e7\u05e8\u05d0 \u05e2\u05dc \u05d4\u05d1\u05d9\u05ea \u05d4\u05d6\u05d4 \u05d0\u05e9\u05e8 \u05d1\u05e0\u05d9\u05ea\u05d9"}, {"pk": 2896040, "verse": 44, "text": "\u05de\u05d3 \u05db\u05d9 \u05d9\u05e6\u05d0 \u05e2\u05de\u05da \u05dc\u05de\u05dc\u05d7\u05de\u05d4 \u05e2\u05dc \u05d0\u05d9\u05d1\u05d5 \u05d1\u05d3\u05e8\u05da \u05d0\u05e9\u05e8 \u05ea\u05e9\u05dc\u05d7\u05dd \u05d5\u05d4\u05ea\u05e4\u05dc\u05dc\u05d5 \u05d0\u05dc \u05d9\u05d4\u05d5\u05d4 \u05d3\u05e8\u05da \u05d4\u05e2\u05d9\u05e8 \u05d0\u05e9\u05e8 \u05d1\u05d7\u05e8\u05ea \u05d1\u05d4 \u05d5\u05d4\u05d1\u05d9\u05ea \u05d0\u05e9\u05e8 \u05d1\u05e0\u05ea\u05d9 \u05dc\u05e9\u05de\u05da"}, {"pk": 2896041, "verse": 45, "text": "\u05de\u05d4 \u05d5\u05e9\u05de\u05e2\u05ea \u05d4\u05e9\u05de\u05d9\u05dd \u05d0\u05ea \u05ea\u05e4\u05dc\u05ea\u05dd \u05d5\u05d0\u05ea \u05ea\u05d7\u05e0\u05ea\u05dd \u05d5\u05e2\u05e9\u05d9\u05ea \u05de\u05e9\u05e4\u05d8\u05dd"}, {"pk": 2896042, "verse": 46, "text": "\u05de\u05d5 \u05db\u05d9 \u05d9\u05d7\u05d8\u05d0\u05d5 \u05dc\u05da \u05db\u05d9 \u05d0\u05d9\u05df \u05d0\u05d3\u05dd \u05d0\u05e9\u05e8 \u05dc\u05d0 \u05d9\u05d7\u05d8\u05d0 \u05d5\u05d0\u05e0\u05e4\u05ea \u05d1\u05dd \u05d5\u05e0\u05ea\u05ea\u05dd \u05dc\u05e4\u05e0\u05d9 \u05d0\u05d5\u05d9\u05d1 \u05d5\u05e9\u05d1\u05d5\u05dd \u05e9\u05d1\u05d9\u05d4\u05dd \u05d0\u05dc \u05d0\u05e8\u05e5 \u05d4\u05d0\u05d5\u05d9\u05d1 \u05e8\u05d7\u05d5\u05e7\u05d4 \u05d0\u05d5 \u05e7\u05e8\u05d5\u05d1\u05d4"}, {"pk": 2896043, "verse": 47, "text": "\u05de\u05d6 \u05d5\u05d4\u05e9\u05d9\u05d1\u05d5 \u05d0\u05dc \u05dc\u05d1\u05dd \u05d1\u05d0\u05e8\u05e5 \u05d0\u05e9\u05e8 \u05e0\u05e9\u05d1\u05d5 \u05e9\u05dd \u05d5\u05e9\u05d1\u05d5 \u05d5\u05d4\u05ea\u05d7\u05e0\u05e0\u05d5 \u05d0\u05dc\u05d9\u05da \u05d1\u05d0\u05e8\u05e5 \u05e9\u05d1\u05d9\u05d4\u05dd \u05dc\u05d0\u05de\u05e8 \u05d7\u05d8\u05d0\u05e0\u05d5 \u05d5\u05d4\u05e2\u05d5\u05d9\u05e0\u05d5 \u05e8\u05e9\u05e2\u05e0\u05d5"}, {"pk": 2896044, "verse": 48, "text": "\u05de\u05d7 \u05d5\u05e9\u05d1\u05d5 \u05d0\u05dc\u05d9\u05da \u05d1\u05db\u05dc \u05dc\u05d1\u05d1\u05dd \u05d5\u05d1\u05db\u05dc \u05e0\u05e4\u05e9\u05dd \u05d1\u05d0\u05e8\u05e5 \u05d0\u05d9\u05d1\u05d9\u05d4\u05dd \u05d0\u05e9\u05e8 \u05e9\u05d1\u05d5 \u05d0\u05ea\u05dd \u05d5\u05d4\u05ea\u05e4\u05dc\u05dc\u05d5 \u05d0\u05dc\u05d9\u05da \u05d3\u05e8\u05da \u05d0\u05e8\u05e6\u05dd \u05d0\u05e9\u05e8 \u05e0\u05ea\u05ea\u05d4 \u05dc\u05d0\u05d1\u05d5\u05ea\u05dd \u05d4\u05e2\u05d9\u05e8 \u05d0\u05e9\u05e8 \u05d1\u05d7\u05e8\u05ea \u05d5\u05d4\u05d1\u05d9\u05ea \u05d0\u05e9\u05e8 \u05d1\u05e0\u05d9\u05ea (\u05d1\u05e0\u05d9\u05ea\u05d9) \u05dc\u05e9\u05de\u05da"}, {"pk": 2896045, "verse": 49, "text": "\u05de\u05d8 \u05d5\u05e9\u05de\u05e2\u05ea \u05d4\u05e9\u05de\u05d9\u05dd \u05de\u05db\u05d5\u05df \u05e9\u05d1\u05ea\u05da \u05d0\u05ea \u05ea\u05e4\u05dc\u05ea\u05dd \u05d5\u05d0\u05ea \u05ea\u05d7\u05e0\u05ea\u05dd \u05d5\u05e2\u05e9\u05d9\u05ea \u05de\u05e9\u05e4\u05d8\u05dd"}, {"pk": 2896046, "verse": 50, "text": "\u05e0 \u05d5\u05e1\u05dc\u05d7\u05ea \u05dc\u05e2\u05de\u05da \u05d0\u05e9\u05e8 \u05d7\u05d8\u05d0\u05d5 \u05dc\u05da \u05d5\u05dc\u05db\u05dc \u05e4\u05e9\u05e2\u05d9\u05d4\u05dd \u05d0\u05e9\u05e8 \u05e4\u05e9\u05e2\u05d5 \u05d1\u05da \u05d5\u05e0\u05ea\u05ea\u05dd \u05dc\u05e8\u05d7\u05de\u05d9\u05dd \u05dc\u05e4\u05e0\u05d9 \u05e9\u05d1\u05d9\u05d4\u05dd \u05d5\u05e8\u05d7\u05de\u05d5\u05dd"}, {"pk": 2896047, "verse": 51, "text": "\u05e0\u05d0 \u05db\u05d9 \u05e2\u05de\u05da \u05d5\u05e0\u05d7\u05dc\u05ea\u05da \u05d4\u05dd \u05d0\u05e9\u05e8 \u05d4\u05d5\u05e6\u05d0\u05ea \u05de\u05de\u05e6\u05e8\u05d9\u05dd \u05de\u05ea\u05d5\u05da \u05db\u05d5\u05e8 \u05d4\u05d1\u05e8\u05d6\u05dc"}, {"pk": 2896048, "verse": 52, "text": "\u05e0\u05d1 \u05dc\u05d4\u05d9\u05d5\u05ea \u05e2\u05d9\u05e0\u05d9\u05da \u05e4\u05ea\u05d7\u05ea \u05d0\u05dc \u05ea\u05d7\u05e0\u05ea \u05e2\u05d1\u05d3\u05da \u05d5\u05d0\u05dc \u05ea\u05d7\u05e0\u05ea \u05e2\u05de\u05da \u05d9\u05e9\u05e8\u05d0\u05dc \u05dc\u05e9\u05de\u05e2 \u05d0\u05dc\u05d9\u05d4\u05dd \u05d1\u05db\u05dc \u05e7\u05e8\u05d0\u05dd \u05d0\u05dc\u05d9\u05da"}, {"pk": 2896049, "verse": 53, "text": "\u05e0\u05d2 \u05db\u05d9 \u05d0\u05ea\u05d4 \u05d4\u05d1\u05d3\u05dc\u05ea\u05dd \u05dc\u05da \u05dc\u05e0\u05d7\u05dc\u05d4 \u05de\u05db\u05dc \u05e2\u05de\u05d9 \u05d4\u05d0\u05e8\u05e5\u00a0 \u05db\u05d0\u05e9\u05e8 \u05d3\u05d1\u05e8\u05ea \u05d1\u05d9\u05d3 \u05de\u05e9\u05d4 \u05e2\u05d1\u05d3\u05da \u05d1\u05d4\u05d5\u05e6\u05d9\u05d0\u05da \u05d0\u05ea \u05d0\u05d1\u05ea\u05d9\u05e0\u05d5 \u05de\u05de\u05e6\u05e8\u05d9\u05dd--\u05d0\u05d3\u05e0\u05d9 \u05d9\u05d4\u05d5\u05d4\u00a0 {\u05e4}"}, {"pk": 2896050, "verse": 54, "text": "\u05e0\u05d3 \u05d5\u05d9\u05d4\u05d9 \u05db\u05db\u05dc\u05d5\u05ea \u05e9\u05dc\u05de\u05d4 \u05dc\u05d4\u05ea\u05e4\u05dc\u05dc \u05d0\u05dc \u05d9\u05d4\u05d5\u05d4 \u05d0\u05ea \u05db\u05dc \u05d4\u05ea\u05e4\u05dc\u05d4 \u05d5\u05d4\u05ea\u05d7\u05e0\u05d4 \u05d4\u05d6\u05d0\u05ea \u05e7\u05dd \u05de\u05dc\u05e4\u05e0\u05d9 \u05de\u05d6\u05d1\u05d7 \u05d9\u05d4\u05d5\u05d4 \u05de\u05db\u05e8\u05e2 \u05e2\u05dc \u05d1\u05e8\u05db\u05d9\u05d5 \u05d5\u05db\u05e4\u05d9\u05d5 \u05e4\u05e8\u05e9\u05d5\u05ea \u05d4\u05e9\u05de\u05d9\u05dd"}, {"pk": 2896051, "verse": 55, "text": "\u05e0\u05d4 \u05d5\u05d9\u05e2\u05de\u05d3--\u05d5\u05d9\u05d1\u05e8\u05da \u05d0\u05ea \u05db\u05dc \u05e7\u05d4\u05dc \u05d9\u05e9\u05e8\u05d0\u05dc\u00a0 \u05e7\u05d5\u05dc \u05d2\u05d3\u05d5\u05dc \u05dc\u05d0\u05de\u05e8"}, {"pk": 2896052, "verse": 56, "text": "\u05e0\u05d5 \u05d1\u05e8\u05d5\u05da \u05d9\u05d4\u05d5\u05d4 \u05d0\u05e9\u05e8 \u05e0\u05ea\u05df \u05de\u05e0\u05d5\u05d7\u05d4 \u05dc\u05e2\u05de\u05d5 \u05d9\u05e9\u05e8\u05d0\u05dc \u05db\u05db\u05dc \u05d0\u05e9\u05e8 \u05d3\u05d1\u05e8\u00a0 \u05dc\u05d0 \u05e0\u05e4\u05dc \u05d3\u05d1\u05e8 \u05d0\u05d7\u05d3 \u05de\u05db\u05dc \u05d3\u05d1\u05e8\u05d5 \u05d4\u05d8\u05d5\u05d1 \u05d0\u05e9\u05e8 \u05d3\u05d1\u05e8 \u05d1\u05d9\u05d3 \u05de\u05e9\u05d4 \u05e2\u05d1\u05d3\u05d5"}, {"pk": 2896053, "verse": 57, "text": "\u05e0\u05d6 \u05d9\u05d4\u05d9 \u05d9\u05d4\u05d5\u05d4 \u05d0\u05dc\u05d4\u05d9\u05e0\u05d5 \u05e2\u05de\u05e0\u05d5 \u05db\u05d0\u05e9\u05e8 \u05d4\u05d9\u05d4 \u05e2\u05dd \u05d0\u05d1\u05ea\u05d9\u05e0\u05d5\u00a0 \u05d0\u05dc \u05d9\u05e2\u05d6\u05d1\u05e0\u05d5 \u05d5\u05d0\u05dc \u05d9\u05d8\u05e9\u05e0\u05d5"}, {"pk": 2896054, "verse": 58, "text": "\u05e0\u05d7 \u05dc\u05d4\u05d8\u05d5\u05ea \u05dc\u05d1\u05d1\u05e0\u05d5 \u05d0\u05dc\u05d9\u05d5--\u05dc\u05dc\u05db\u05ea \u05d1\u05db\u05dc \u05d3\u05e8\u05db\u05d9\u05d5 \u05d5\u05dc\u05e9\u05de\u05e8 \u05de\u05e6\u05d5\u05ea\u05d9\u05d5 \u05d5\u05d7\u05e7\u05d9\u05d5 \u05d5\u05de\u05e9\u05e4\u05d8\u05d9\u05d5 \u05d0\u05e9\u05e8 \u05e6\u05d5\u05d4 \u05d0\u05ea \u05d0\u05d1\u05ea\u05d9\u05e0\u05d5"}, {"pk": 2896055, "verse": 59, "text": "\u05e0\u05d8 \u05d5\u05d9\u05d4\u05d9\u05d5 \u05d3\u05d1\u05e8\u05d9 \u05d0\u05dc\u05d4 \u05d0\u05e9\u05e8 \u05d4\u05ea\u05d7\u05e0\u05e0\u05ea\u05d9 \u05dc\u05e4\u05e0\u05d9 \u05d9\u05d4\u05d5\u05d4 \u05e7\u05e8\u05d1\u05d9\u05dd \u05d0\u05dc \u05d9\u05d4\u05d5\u05d4 \u05d0\u05dc\u05d4\u05d9\u05e0\u05d5 \u05d9\u05d5\u05de\u05dd \u05d5\u05dc\u05d9\u05dc\u05d4\u00a0 \u05dc\u05e2\u05e9\u05d5\u05ea \u05de\u05e9\u05e4\u05d8 \u05e2\u05d1\u05d3\u05d5 \u05d5\u05de\u05e9\u05e4\u05d8 \u05e2\u05de\u05d5 \u05d9\u05e9\u05e8\u05d0\u05dc--\u05d3\u05d1\u05e8 \u05d9\u05d5\u05dd \u05d1\u05d9\u05d5\u05de\u05d5"}, {"pk": 2896056, "verse": 60, "text": "\u05e1 \u05dc\u05de\u05e2\u05df \u05d3\u05e2\u05ea \u05db\u05dc \u05e2\u05de\u05d9 \u05d4\u05d0\u05e8\u05e5 \u05db\u05d9 \u05d9\u05d4\u05d5\u05d4 \u05d4\u05d5\u05d0 \u05d4\u05d0\u05dc\u05d4\u05d9\u05dd\u00a0 \u05d0\u05d9\u05df \u05e2\u05d5\u05d3"}, {"pk": 2896057, "verse": 61, "text": "\u05e1\u05d0 \u05d5\u05d4\u05d9\u05d4 \u05dc\u05d1\u05d1\u05db\u05dd \u05e9\u05dc\u05dd \u05e2\u05dd \u05d9\u05d4\u05d5\u05d4 \u05d0\u05dc\u05d4\u05d9\u05e0\u05d5 \u05dc\u05dc\u05db\u05ea \u05d1\u05d7\u05e7\u05d9\u05d5 \u05d5\u05dc\u05e9\u05de\u05e8 \u05de\u05e6\u05d5\u05ea\u05d9\u05d5 \u05db\u05d9\u05d5\u05dd \u05d4\u05d6\u05d4"}, {"pk": 2896058, "verse": 62, "text": "\u05e1\u05d1 \u05d5\u05d4\u05de\u05dc\u05da \u05d5\u05db\u05dc \u05d9\u05e9\u05e8\u05d0\u05dc \u05e2\u05de\u05d5 \u05d6\u05d1\u05d7\u05d9\u05dd \u05d6\u05d1\u05d7 \u05dc\u05e4\u05e0\u05d9 \u05d9\u05d4\u05d5\u05d4"}, {"pk": 2896059, "verse": 63, "text": "\u05e1\u05d2 \u05d5\u05d9\u05d6\u05d1\u05d7 \u05e9\u05dc\u05de\u05d4 \u05d0\u05ea \u05d6\u05d1\u05d7 \u05d4\u05e9\u05dc\u05de\u05d9\u05dd \u05d0\u05e9\u05e8 \u05d6\u05d1\u05d7 \u05dc\u05d9\u05d4\u05d5\u05d4 \u05d1\u05e7\u05e8 \u05e2\u05e9\u05e8\u05d9\u05dd \u05d5\u05e9\u05e0\u05d9\u05dd \u05d0\u05dc\u05e3 \u05d5\u05e6\u05d0\u05df \u05de\u05d0\u05d4 \u05d5\u05e2\u05e9\u05e8\u05d9\u05dd \u05d0\u05dc\u05e3 \u05d5\u05d9\u05d7\u05e0\u05db\u05d5 \u05d0\u05ea \u05d1\u05d9\u05ea \u05d9\u05d4\u05d5\u05d4 \u05d4\u05de\u05dc\u05da \u05d5\u05db\u05dc \u05d1\u05e0\u05d9 \u05d9\u05e9\u05e8\u05d0\u05dc"}, {"pk": 2896060, "verse": 64, "text": "\u05e1\u05d3 \u05d1\u05d9\u05d5\u05dd \u05d4\u05d4\u05d5\u05d0 \u05e7\u05d3\u05e9 \u05d4\u05de\u05dc\u05da \u05d0\u05ea \u05ea\u05d5\u05da \u05d4\u05d7\u05e6\u05e8 \u05d0\u05e9\u05e8 \u05dc\u05e4\u05e0\u05d9 \u05d1\u05d9\u05ea \u05d9\u05d4\u05d5\u05d4--\u05db\u05d9 \u05e2\u05e9\u05d4 \u05e9\u05dd \u05d0\u05ea \u05d4\u05e2\u05dc\u05d4 \u05d5\u05d0\u05ea \u05d4\u05de\u05e0\u05d7\u05d4 \u05d5\u05d0\u05ea \u05d7\u05dc\u05d1\u05d9 \u05d4\u05e9\u05dc\u05de\u05d9\u05dd\u00a0 \u05db\u05d9 \u05de\u05d6\u05d1\u05d7 \u05d4\u05e0\u05d7\u05e9\u05ea \u05d0\u05e9\u05e8 \u05dc\u05e4\u05e0\u05d9 \u05d9\u05d4\u05d5\u05d4 \u05e7\u05d8\u05df \u05de\u05d4\u05db\u05d9\u05dc \u05d0\u05ea \u05d4\u05e2\u05dc\u05d4 \u05d5\u05d0\u05ea \u05d4\u05de\u05e0\u05d7\u05d4 \u05d5\u05d0\u05ea \u05d7\u05dc\u05d1\u05d9 \u05d4\u05e9\u05dc\u05de\u05d9\u05dd"}, {"pk": 2896061, "verse": 65, "text": "\u05e1\u05d4 \u05d5\u05d9\u05e2\u05e9 \u05e9\u05dc\u05de\u05d4 \u05d1\u05e2\u05ea \u05d4\u05d4\u05d9\u05d0 \u05d0\u05ea \u05d4\u05d7\u05d2 \u05d5\u05db\u05dc \u05d9\u05e9\u05e8\u05d0\u05dc \u05e2\u05de\u05d5 \u05e7\u05d4\u05dc \u05d2\u05d3\u05d5\u05dc \u05de\u05dc\u05d1\u05d5\u05d0 \u05d7\u05de\u05ea \u05e2\u05d3 \u05e0\u05d7\u05dc \u05de\u05e6\u05e8\u05d9\u05dd \u05dc\u05e4\u05e0\u05d9 \u05d9\u05d4\u05d5\u05d4 \u05d0\u05dc\u05d4\u05d9\u05e0\u05d5 \u05e9\u05d1\u05e2\u05ea \u05d9\u05de\u05d9\u05dd \u05d5\u05e9\u05d1\u05e2\u05ea \u05d9\u05de\u05d9\u05dd--\u05d0\u05e8\u05d1\u05e2\u05d4 \u05e2\u05e9\u05e8 \u05d9\u05d5\u05dd"}, {"pk": 2896062, "verse": 66, "text": "\u05e1\u05d5 \u05d1\u05d9\u05d5\u05dd \u05d4\u05e9\u05de\u05d9\u05e0\u05d9 \u05e9\u05dc\u05d7 \u05d0\u05ea \u05d4\u05e2\u05dd \u05d5\u05d9\u05d1\u05e8\u05db\u05d5 \u05d0\u05ea \u05d4\u05de\u05dc\u05da \u05d5\u05d9\u05dc\u05db\u05d5 \u05dc\u05d0\u05d4\u05dc\u05d9\u05d4\u05dd \u05e9\u05de\u05d7\u05d9\u05dd \u05d5\u05d8\u05d5\u05d1\u05d9 \u05dc\u05d1 \u05e2\u05dc \u05db\u05dc \u05d4\u05d8\u05d5\u05d1\u05d4 \u05d0\u05e9\u05e8 \u05e2\u05e9\u05d4 \u05d9\u05d4\u05d5\u05d4 \u05dc\u05d3\u05d5\u05d3 \u05e2\u05d1\u05d3\u05d5 \u05d5\u05dc\u05d9\u05e9\u05e8\u05d0\u05dc \u05e2\u05de\u05d5"}]