[{"pk": 2896295, "verse": 1, "text": "\u05d0 \u05d5\u05d9\u05d4\u05d9 \u05d3\u05d1\u05e8 \u05d9\u05d4\u05d5\u05d4 \u05d0\u05dc \u05d9\u05d4\u05d5\u05d0 \u05d1\u05df \u05d7\u05e0\u05e0\u05d9 \u05e2\u05dc \u05d1\u05e2\u05e9\u05d0 \u05dc\u05d0\u05de\u05e8"}, {"pk": 2896296, "verse": 2, "text": "\u05d1 \u05d9\u05e2\u05df \u05d0\u05e9\u05e8 \u05d4\u05e8\u05d9\u05de\u05ea\u05d9\u05da \u05de\u05df \u05d4\u05e2\u05e4\u05e8 \u05d5\u05d0\u05ea\u05e0\u05da \u05e0\u05d2\u05d9\u05d3 \u05e2\u05dc \u05e2\u05de\u05d9 \u05d9\u05e9\u05e8\u05d0\u05dc \u05d5\u05ea\u05dc\u05da \u05d1\u05d3\u05e8\u05da \u05d9\u05e8\u05d1\u05e2\u05dd \u05d5\u05ea\u05d7\u05d8\u05d0 \u05d0\u05ea \u05e2\u05de\u05d9 \u05d9\u05e9\u05e8\u05d0\u05dc \u05dc\u05d4\u05db\u05e2\u05d9\u05e1\u05e0\u05d9 \u05d1\u05d7\u05d8\u05d0\u05ea\u05dd"}, {"pk": 2896297, "verse": 3, "text": "\u05d2 \u05d4\u05e0\u05e0\u05d9 \u05de\u05d1\u05e2\u05d9\u05e8 \u05d0\u05d7\u05e8\u05d9 \u05d1\u05e2\u05e9\u05d0 \u05d5\u05d0\u05d7\u05e8\u05d9 \u05d1\u05d9\u05ea\u05d5 \u05d5\u05e0\u05ea\u05ea\u05d9 \u05d0\u05ea \u05d1\u05d9\u05ea\u05da \u05db\u05d1\u05d9\u05ea \u05d9\u05e8\u05d1\u05e2\u05dd \u05d1\u05df \u05e0\u05d1\u05d8"}, {"pk": 2896298, "verse": 4, "text": "\u05d3 \u05d4\u05de\u05ea \u05dc\u05d1\u05e2\u05e9\u05d0 \u05d1\u05e2\u05d9\u05e8 \u05d9\u05d0\u05db\u05dc\u05d5 \u05d4\u05db\u05dc\u05d1\u05d9\u05dd \u05d5\u05d4\u05de\u05ea \u05dc\u05d5 \u05d1\u05e9\u05d3\u05d4 \u05d9\u05d0\u05db\u05dc\u05d5 \u05e2\u05d5\u05e3 \u05d4\u05e9\u05de\u05d9\u05dd"}, {"pk": 2896299, "verse": 5, "text": "\u05d4 \u05d5\u05d9\u05ea\u05e8 \u05d3\u05d1\u05e8\u05d9 \u05d1\u05e2\u05e9\u05d0 \u05d5\u05d0\u05e9\u05e8 \u05e2\u05e9\u05d4 \u05d5\u05d2\u05d1\u05d5\u05e8\u05ea\u05d5\u00a0 \u05d4\u05dc\u05d0 \u05d4\u05dd \u05db\u05ea\u05d5\u05d1\u05d9\u05dd \u05e2\u05dc \u05e1\u05e4\u05e8 \u05d3\u05d1\u05e8\u05d9 \u05d4\u05d9\u05de\u05d9\u05dd--\u05dc\u05de\u05dc\u05db\u05d9 \u05d9\u05e9\u05e8\u05d0\u05dc"}, {"pk": 2896300, "verse": 6, "text": "\u05d5 \u05d5\u05d9\u05e9\u05db\u05d1 \u05d1\u05e2\u05e9\u05d0 \u05e2\u05dd \u05d0\u05d1\u05ea\u05d9\u05d5 \u05d5\u05d9\u05e7\u05d1\u05e8 \u05d1\u05ea\u05e8\u05e6\u05d4 \u05d5\u05d9\u05de\u05dc\u05da \u05d0\u05dc\u05d4 \u05d1\u05e0\u05d5 \u05ea\u05d7\u05ea\u05d9\u05d5"}, {"pk": 2896301, "verse": 7, "text": "\u05d6 \u05d5\u05d2\u05dd \u05d1\u05d9\u05d3 \u05d9\u05d4\u05d5\u05d0 \u05d1\u05df \u05d7\u05e0\u05e0\u05d9 \u05d4\u05e0\u05d1\u05d9\u05d0 \u05d3\u05d1\u05e8 \u05d9\u05d4\u05d5\u05d4 \u05d4\u05d9\u05d4 \u05d0\u05dc \u05d1\u05e2\u05e9\u05d0 \u05d5\u05d0\u05dc \u05d1\u05d9\u05ea\u05d5 \u05d5\u05e2\u05dc \u05db\u05dc \u05d4\u05e8\u05e2\u05d4 \u05d0\u05e9\u05e8 \u05e2\u05e9\u05d4 \u05d1\u05e2\u05d9\u05e0\u05d9 \u05d9\u05d4\u05d5\u05d4 \u05dc\u05d4\u05db\u05e2\u05d9\u05e1\u05d5 \u05d1\u05de\u05e2\u05e9\u05d4 \u05d9\u05d3\u05d9\u05d5 \u05dc\u05d4\u05d9\u05d5\u05ea \u05db\u05d1\u05d9\u05ea \u05d9\u05e8\u05d1\u05e2\u05dd \u05d5\u05e2\u05dc \u05d0\u05e9\u05e8 \u05d4\u05db\u05d4 \u05d0\u05ea\u05d5\u00a0 {\u05e4}"}, {"pk": 2896302, "verse": 8, "text": "\u05d7 \u05d1\u05e9\u05e0\u05ea \u05e2\u05e9\u05e8\u05d9\u05dd \u05d5\u05e9\u05e9 \u05e9\u05e0\u05d4 \u05dc\u05d0\u05e1\u05d0 \u05de\u05dc\u05da \u05d9\u05d4\u05d5\u05d3\u05d4\u00a0 \u05de\u05dc\u05da \u05d0\u05dc\u05d4 \u05d1\u05df \u05d1\u05e2\u05e9\u05d0 \u05e2\u05dc \u05d9\u05e9\u05e8\u05d0\u05dc \u05d1\u05ea\u05e8\u05e6\u05d4--\u05e9\u05e0\u05ea\u05d9\u05dd"}, {"pk": 2896303, "verse": 9, "text": "\u05d8 \u05d5\u05d9\u05e7\u05e9\u05e8 \u05e2\u05dc\u05d9\u05d5 \u05e2\u05d1\u05d3\u05d5 \u05d6\u05de\u05e8\u05d9 \u05e9\u05e8 \u05de\u05d7\u05e6\u05d9\u05ea \u05d4\u05e8\u05db\u05d1 \u05d5\u05d4\u05d5\u05d0 \u05d1\u05ea\u05e8\u05e6\u05d4 \u05e9\u05ea\u05d4 \u05e9\u05db\u05d5\u05e8 \u05d1\u05d9\u05ea \u05d0\u05e8\u05e6\u05d0 \u05d0\u05e9\u05e8 \u05e2\u05dc \u05d4\u05d1\u05d9\u05ea \u05d1\u05ea\u05e8\u05e6\u05d4"}, {"pk": 2896304, "verse": 10, "text": "\u05d9 \u05d5\u05d9\u05d1\u05d0 \u05d6\u05de\u05e8\u05d9 \u05d5\u05d9\u05db\u05d4\u05d5 \u05d5\u05d9\u05de\u05d9\u05ea\u05d4\u05d5 \u05d1\u05e9\u05e0\u05ea \u05e2\u05e9\u05e8\u05d9\u05dd \u05d5\u05e9\u05d1\u05e2 \u05dc\u05d0\u05e1\u05d0 \u05de\u05dc\u05da \u05d9\u05d4\u05d5\u05d3\u05d4 \u05d5\u05d9\u05de\u05dc\u05da \u05ea\u05d7\u05ea\u05d9\u05d5"}, {"pk": 2896305, "verse": 11, "text": "\u05d9\u05d0 \u05d5\u05d9\u05d4\u05d9 \u05d1\u05de\u05dc\u05db\u05d5 \u05db\u05e9\u05d1\u05ea\u05d5 \u05e2\u05dc \u05db\u05e1\u05d0\u05d5 \u05d4\u05db\u05d4 \u05d0\u05ea \u05db\u05dc \u05d1\u05d9\u05ea \u05d1\u05e2\u05e9\u05d0--\u05dc\u05d0 \u05d4\u05e9\u05d0\u05d9\u05e8 \u05dc\u05d5 \u05de\u05e9\u05ea\u05d9\u05df \u05d1\u05e7\u05d9\u05e8 \u05d5\u05d2\u05d0\u05dc\u05d9\u05d5 \u05d5\u05e8\u05e2\u05d4\u05d5"}, {"pk": 2896306, "verse": 12, "text": "\u05d9\u05d1 \u05d5\u05d9\u05e9\u05de\u05d3 \u05d6\u05de\u05e8\u05d9 \u05d0\u05ea \u05db\u05dc \u05d1\u05d9\u05ea \u05d1\u05e2\u05e9\u05d0 \u05db\u05d3\u05d1\u05e8 \u05d9\u05d4\u05d5\u05d4 \u05d0\u05e9\u05e8 \u05d3\u05d1\u05e8 \u05d0\u05dc \u05d1\u05e2\u05e9\u05d0 \u05d1\u05d9\u05d3 \u05d9\u05d4\u05d5\u05d0 \u05d4\u05e0\u05d1\u05d9\u05d0"}, {"pk": 2896307, "verse": 13, "text": "\u05d9\u05d2 \u05d0\u05dc \u05db\u05dc \u05d7\u05d8\u05d0\u05d5\u05ea \u05d1\u05e2\u05e9\u05d0 \u05d5\u05d7\u05d8\u05d0\u05d5\u05ea \u05d0\u05dc\u05d4 \u05d1\u05e0\u05d5--\u05d0\u05e9\u05e8 \u05d7\u05d8\u05d0\u05d5 \u05d5\u05d0\u05e9\u05e8 \u05d4\u05d7\u05d8\u05d9\u05d0\u05d5 \u05d0\u05ea \u05d9\u05e9\u05e8\u05d0\u05dc \u05dc\u05d4\u05db\u05e2\u05d9\u05e1 \u05d0\u05ea \u05d9\u05d4\u05d5\u05d4 \u05d0\u05dc\u05d4\u05d9 \u05d9\u05e9\u05e8\u05d0\u05dc \u05d1\u05d4\u05d1\u05dc\u05d9\u05d4\u05dd"}, {"pk": 2896308, "verse": 14, "text": "\u05d9\u05d3 \u05d5\u05d9\u05ea\u05e8 \u05d3\u05d1\u05e8\u05d9 \u05d0\u05dc\u05d4 \u05d5\u05db\u05dc \u05d0\u05e9\u05e8 \u05e2\u05e9\u05d4\u00a0 \u05d4\u05dc\u05d5\u05d0 \u05d4\u05dd \u05db\u05ea\u05d5\u05d1\u05d9\u05dd \u05e2\u05dc \u05e1\u05e4\u05e8 \u05d3\u05d1\u05e8\u05d9 \u05d4\u05d9\u05de\u05d9\u05dd--\u05dc\u05de\u05dc\u05db\u05d9 \u05d9\u05e9\u05e8\u05d0\u05dc\u00a0 {\u05e4}"}, {"pk": 2896309, "verse": 15, "text": "\u05d8\u05d5 \u05d1\u05e9\u05e0\u05ea \u05e2\u05e9\u05e8\u05d9\u05dd \u05d5\u05e9\u05d1\u05e2 \u05e9\u05e0\u05d4 \u05dc\u05d0\u05e1\u05d0 \u05de\u05dc\u05da \u05d9\u05d4\u05d5\u05d3\u05d4 \u05de\u05dc\u05da \u05d6\u05de\u05e8\u05d9 \u05e9\u05d1\u05e2\u05ea \u05d9\u05de\u05d9\u05dd \u05d1\u05ea\u05e8\u05e6\u05d4 \u05d5\u05d4\u05e2\u05dd \u05d7\u05e0\u05d9\u05dd \u05e2\u05dc \u05d2\u05d1\u05ea\u05d5\u05df \u05d0\u05e9\u05e8 \u05dc\u05e4\u05dc\u05e9\u05ea\u05d9\u05dd"}, {"pk": 2896310, "verse": 16, "text": "\u05d8\u05d6 \u05d5\u05d9\u05e9\u05de\u05e2 \u05d4\u05e2\u05dd \u05d4\u05d7\u05e0\u05d9\u05dd \u05dc\u05d0\u05de\u05e8 \u05e7\u05e9\u05e8 \u05d6\u05de\u05e8\u05d9 \u05d5\u05d2\u05dd \u05d4\u05db\u05d4 \u05d0\u05ea \u05d4\u05de\u05dc\u05da \u05d5\u05d9\u05de\u05dc\u05db\u05d5 \u05db\u05dc \u05d9\u05e9\u05e8\u05d0\u05dc \u05d0\u05ea \u05e2\u05de\u05e8\u05d9 \u05e9\u05e8 \u05e6\u05d1\u05d0 \u05e2\u05dc \u05d9\u05e9\u05e8\u05d0\u05dc \u05d1\u05d9\u05d5\u05dd \u05d4\u05d4\u05d5\u05d0--\u05d1\u05de\u05d7\u05e0\u05d4"}, {"pk": 2896311, "verse": 17, "text": "\u05d9\u05d6 \u05d5\u05d9\u05e2\u05dc\u05d4 \u05e2\u05de\u05e8\u05d9 \u05d5\u05db\u05dc \u05d9\u05e9\u05e8\u05d0\u05dc \u05e2\u05de\u05d5 \u05de\u05d2\u05d1\u05ea\u05d5\u05df \u05d5\u05d9\u05e6\u05e8\u05d5 \u05e2\u05dc \u05ea\u05e8\u05e6\u05d4"}, {"pk": 2896312, "verse": 18, "text": "\u05d9\u05d7 \u05d5\u05d9\u05d4\u05d9 \u05db\u05e8\u05d0\u05d5\u05ea \u05d6\u05de\u05e8\u05d9 \u05db\u05d9 \u05e0\u05dc\u05db\u05d3\u05d4 \u05d4\u05e2\u05d9\u05e8 \u05d5\u05d9\u05d1\u05d0 \u05d0\u05dc \u05d0\u05e8\u05de\u05d5\u05df \u05d1\u05d9\u05ea \u05d4\u05de\u05dc\u05da \u05d5\u05d9\u05e9\u05e8\u05e3 \u05e2\u05dc\u05d9\u05d5 \u05d0\u05ea \u05d1\u05d9\u05ea \u05de\u05dc\u05da \u05d1\u05d0\u05e9 \u05d5\u05d9\u05de\u05ea"}, {"pk": 2896313, "verse": 19, "text": "\u05d9\u05d8 \u05e2\u05dc \u05d7\u05d8\u05d0\u05ea\u05d9\u05d5 \u05d0\u05e9\u05e8 \u05d7\u05d8\u05d0 \u05dc\u05e2\u05e9\u05d5\u05ea \u05d4\u05e8\u05e2 \u05d1\u05e2\u05d9\u05e0\u05d9 \u05d9\u05d4\u05d5\u05d4--\u05dc\u05dc\u05db\u05ea \u05d1\u05d3\u05e8\u05da \u05d9\u05e8\u05d1\u05e2\u05dd \u05d5\u05d1\u05d7\u05d8\u05d0\u05ea\u05d5 \u05d0\u05e9\u05e8 \u05e2\u05e9\u05d4 \u05dc\u05d4\u05d7\u05d8\u05d9\u05d0 \u05d0\u05ea \u05d9\u05e9\u05e8\u05d0\u05dc"}, {"pk": 2896314, "verse": 20, "text": "\u05db \u05d5\u05d9\u05ea\u05e8 \u05d3\u05d1\u05e8\u05d9 \u05d6\u05de\u05e8\u05d9 \u05d5\u05e7\u05e9\u05e8\u05d5 \u05d0\u05e9\u05e8 \u05e7\u05e9\u05e8\u00a0 \u05d4\u05dc\u05d0 \u05d4\u05dd \u05db\u05ea\u05d5\u05d1\u05d9\u05dd \u05e2\u05dc \u05e1\u05e4\u05e8 \u05d3\u05d1\u05e8\u05d9 \u05d4\u05d9\u05de\u05d9\u05dd--\u05dc\u05de\u05dc\u05db\u05d9 \u05d9\u05e9\u05e8\u05d0\u05dc\u00a0 {\u05e4}"}, {"pk": 2896315, "verse": 21, "text": "\u05db\u05d0 \u05d0\u05d6 \u05d9\u05d7\u05dc\u05e7 \u05d4\u05e2\u05dd \u05d9\u05e9\u05e8\u05d0\u05dc \u05dc\u05d7\u05e6\u05d9\u00a0 \u05d7\u05e6\u05d9 \u05d4\u05e2\u05dd \u05d4\u05d9\u05d4 \u05d0\u05d7\u05e8\u05d9 \u05ea\u05d1\u05e0\u05d9 \u05d1\u05df \u05d2\u05d9\u05e0\u05ea \u05dc\u05d4\u05de\u05dc\u05d9\u05db\u05d5 \u05d5\u05d4\u05d7\u05e6\u05d9 \u05d0\u05d7\u05e8\u05d9 \u05e2\u05de\u05e8\u05d9"}, {"pk": 2896316, "verse": 22, "text": "\u05db\u05d1 \u05d5\u05d9\u05d7\u05d6\u05e7 \u05d4\u05e2\u05dd \u05d0\u05e9\u05e8 \u05d0\u05d7\u05e8\u05d9 \u05e2\u05de\u05e8\u05d9 \u05d0\u05ea \u05d4\u05e2\u05dd \u05d0\u05e9\u05e8 \u05d0\u05d7\u05e8\u05d9 \u05ea\u05d1\u05e0\u05d9 \u05d1\u05df \u05d2\u05d9\u05e0\u05ea \u05d5\u05d9\u05de\u05ea \u05ea\u05d1\u05e0\u05d9 \u05d5\u05d9\u05de\u05dc\u05da \u05e2\u05de\u05e8\u05d9\u00a0 {\u05e4}"}, {"pk": 2896317, "verse": 23, "text": "\u05db\u05d2 \u05d1\u05e9\u05e0\u05ea \u05e9\u05dc\u05e9\u05d9\u05dd \u05d5\u05d0\u05d7\u05ea \u05e9\u05e0\u05d4 \u05dc\u05d0\u05e1\u05d0 \u05de\u05dc\u05da \u05d9\u05d4\u05d5\u05d3\u05d4 \u05de\u05dc\u05da \u05e2\u05de\u05e8\u05d9 \u05e2\u05dc \u05d9\u05e9\u05e8\u05d0\u05dc \u05e9\u05ea\u05d9\u05dd \u05e2\u05e9\u05e8\u05d4 \u05e9\u05e0\u05d4 \u05d1\u05ea\u05e8\u05e6\u05d4 \u05de\u05dc\u05da \u05e9\u05e9 \u05e9\u05e0\u05d9\u05dd"}, {"pk": 2896318, "verse": 24, "text": "\u05db\u05d3 \u05d5\u05d9\u05e7\u05df \u05d0\u05ea \u05d4\u05d4\u05e8 \u05e9\u05de\u05e8\u05d5\u05df \u05de\u05d0\u05ea \u05e9\u05de\u05e8--\u05d1\u05db\u05db\u05e8\u05d9\u05dd \u05db\u05e1\u05e3 \u05d5\u05d9\u05d1\u05df \u05d0\u05ea \u05d4\u05d4\u05e8 \u05d5\u05d9\u05e7\u05e8\u05d0 \u05d0\u05ea \u05e9\u05dd \u05d4\u05e2\u05d9\u05e8 \u05d0\u05e9\u05e8 \u05d1\u05e0\u05d4 \u05e2\u05dc \u05e9\u05dd \u05e9\u05de\u05e8 \u05d0\u05d3\u05e0\u05d9 \u05d4\u05d4\u05e8 \u05e9\u05de\u05e8\u05d5\u05df"}, {"pk": 2896319, "verse": 25, "text": "\u05db\u05d4 \u05d5\u05d9\u05e2\u05e9\u05d4 \u05e2\u05de\u05e8\u05d9 \u05d4\u05e8\u05e2 \u05d1\u05e2\u05d9\u05e0\u05d9 \u05d9\u05d4\u05d5\u05d4 \u05d5\u05d9\u05e8\u05e2 \u05de\u05db\u05dc \u05d0\u05e9\u05e8 \u05dc\u05e4\u05e0\u05d9\u05d5"}, {"pk": 2896320, "verse": 26, "text": "\u05db\u05d5 \u05d5\u05d9\u05dc\u05da \u05d1\u05db\u05dc \u05d3\u05e8\u05da \u05d9\u05e8\u05d1\u05e2\u05dd \u05d1\u05df \u05e0\u05d1\u05d8 \u05d5\u05d1\u05d7\u05d8\u05d0\u05ea\u05d9\u05d5 (\u05d5\u05d1\u05d7\u05d8\u05d0\u05ea\u05d5) \u05d0\u05e9\u05e8 \u05d4\u05d7\u05d8\u05d9\u05d0 \u05d0\u05ea \u05d9\u05e9\u05e8\u05d0\u05dc\u00a0 \u05dc\u05d4\u05db\u05e2\u05d9\u05e1 \u05d0\u05ea \u05d9\u05d4\u05d5\u05d4 \u05d0\u05dc\u05d4\u05d9 \u05d9\u05e9\u05e8\u05d0\u05dc--\u05d1\u05d4\u05d1\u05dc\u05d9\u05d4\u05dd"}, {"pk": 2896321, "verse": 27, "text": "\u05db\u05d6 \u05d5\u05d9\u05ea\u05e8 \u05d3\u05d1\u05e8\u05d9 \u05e2\u05de\u05e8\u05d9 \u05d0\u05e9\u05e8 \u05e2\u05e9\u05d4 \u05d5\u05d2\u05d1\u05d5\u05e8\u05ea\u05d5 \u05d0\u05e9\u05e8 \u05e2\u05e9\u05d4\u00a0 \u05d4\u05dc\u05d0 \u05d4\u05dd \u05db\u05ea\u05d5\u05d1\u05d9\u05dd \u05e2\u05dc \u05e1\u05e4\u05e8 \u05d3\u05d1\u05e8\u05d9 \u05d4\u05d9\u05de\u05d9\u05dd--\u05dc\u05de\u05dc\u05db\u05d9 \u05d9\u05e9\u05e8\u05d0\u05dc"}, {"pk": 2896322, "verse": 28, "text": "\u05db\u05d7 \u05d5\u05d9\u05e9\u05db\u05d1 \u05e2\u05de\u05e8\u05d9 \u05e2\u05dd \u05d0\u05d1\u05ea\u05d9\u05d5 \u05d5\u05d9\u05e7\u05d1\u05e8 \u05d1\u05e9\u05de\u05e8\u05d5\u05df \u05d5\u05d9\u05de\u05dc\u05da \u05d0\u05d7\u05d0\u05d1 \u05d1\u05e0\u05d5 \u05ea\u05d7\u05ea\u05d9\u05d5\u00a0 {\u05e4}"}, {"pk": 2896323, "verse": 29, "text": "\u05db\u05d8 \u05d5\u05d0\u05d7\u05d0\u05d1 \u05d1\u05df \u05e2\u05de\u05e8\u05d9 \u05de\u05dc\u05da \u05e2\u05dc \u05d9\u05e9\u05e8\u05d0\u05dc \u05d1\u05e9\u05e0\u05ea \u05e9\u05dc\u05e9\u05d9\u05dd \u05d5\u05e9\u05de\u05e0\u05d4 \u05e9\u05e0\u05d4 \u05dc\u05d0\u05e1\u05d0 \u05de\u05dc\u05da \u05d9\u05d4\u05d5\u05d3\u05d4 \u05d5\u05d9\u05de\u05dc\u05da \u05d0\u05d7\u05d0\u05d1 \u05d1\u05df \u05e2\u05de\u05e8\u05d9 \u05e2\u05dc \u05d9\u05e9\u05e8\u05d0\u05dc \u05d1\u05e9\u05de\u05e8\u05d5\u05df \u05e2\u05e9\u05e8\u05d9\u05dd \u05d5\u05e9\u05ea\u05d9\u05dd \u05e9\u05e0\u05d4"}, {"pk": 2896324, "verse": 30, "text": "\u05dc \u05d5\u05d9\u05e2\u05e9 \u05d0\u05d7\u05d0\u05d1 \u05d1\u05df \u05e2\u05de\u05e8\u05d9 \u05d4\u05e8\u05e2 \u05d1\u05e2\u05d9\u05e0\u05d9 \u05d9\u05d4\u05d5\u05d4--\u05de\u05db\u05dc \u05d0\u05e9\u05e8 \u05dc\u05e4\u05e0\u05d9\u05d5"}, {"pk": 2896325, "verse": 31, "text": "\u05dc\u05d0 \u05d5\u05d9\u05d4\u05d9 \u05d4\u05e0\u05e7\u05dc \u05dc\u05db\u05ea\u05d5 \u05d1\u05d7\u05d8\u05d0\u05d5\u05ea \u05d9\u05e8\u05d1\u05e2\u05dd \u05d1\u05df \u05e0\u05d1\u05d8 \u05d5\u05d9\u05e7\u05d7 \u05d0\u05e9\u05d4 \u05d0\u05ea \u05d0\u05d9\u05d6\u05d1\u05dc \u05d1\u05ea \u05d0\u05ea\u05d1\u05e2\u05dc \u05de\u05dc\u05da \u05e6\u05d9\u05d3\u05e0\u05d9\u05dd \u05d5\u05d9\u05dc\u05da \u05d5\u05d9\u05e2\u05d1\u05d3 \u05d0\u05ea \u05d4\u05d1\u05e2\u05dc \u05d5\u05d9\u05e9\u05ea\u05d7\u05d5 \u05dc\u05d5"}, {"pk": 2896326, "verse": 32, "text": "\u05dc\u05d1 \u05d5\u05d9\u05e7\u05dd \u05de\u05d6\u05d1\u05d7 \u05dc\u05d1\u05e2\u05dc \u05d1\u05d9\u05ea \u05d4\u05d1\u05e2\u05dc \u05d0\u05e9\u05e8 \u05d1\u05e0\u05d4 \u05d1\u05e9\u05de\u05e8\u05d5\u05df"}, {"pk": 2896327, "verse": 33, "text": "\u05dc\u05d2 \u05d5\u05d9\u05e2\u05e9 \u05d0\u05d7\u05d0\u05d1 \u05d0\u05ea \u05d4\u05d0\u05e9\u05e8\u05d4 \u05d5\u05d9\u05d5\u05e1\u05e3 \u05d0\u05d7\u05d0\u05d1 \u05dc\u05e2\u05e9\u05d5\u05ea \u05dc\u05d4\u05db\u05e2\u05d9\u05e1 \u05d0\u05ea \u05d9\u05d4\u05d5\u05d4 \u05d0\u05dc\u05d4\u05d9 \u05d9\u05e9\u05e8\u05d0\u05dc \u05de\u05db\u05dc \u05de\u05dc\u05db\u05d9 \u05d9\u05e9\u05e8\u05d0\u05dc \u05d0\u05e9\u05e8 \u05d4\u05d9\u05d5 \u05dc\u05e4\u05e0\u05d9\u05d5"}, {"pk": 2896328, "verse": 34, "text": "\u05dc\u05d3 \u05d1\u05d9\u05de\u05d9\u05d5 \u05d1\u05e0\u05d4 \u05d7\u05d9\u05d0\u05dc \u05d1\u05d9\u05ea \u05d4\u05d0\u05dc\u05d9--\u05d0\u05ea \u05d9\u05e8\u05d9\u05d7\u05d4\u00a0 \u05d1\u05d0\u05d1\u05d9\u05e8\u05dd \u05d1\u05db\u05e8\u05d5 \u05d9\u05e1\u05d3\u05d4 \u05d5\u05d1\u05e9\u05d2\u05d9\u05d1 (\u05d5\u05d1\u05e9\u05d2\u05d5\u05d1) \u05e6\u05e2\u05d9\u05e8\u05d5 \u05d4\u05e6\u05d9\u05d1 \u05d3\u05dc\u05ea\u05d9\u05d4 \u05db\u05d3\u05d1\u05e8 \u05d9\u05d4\u05d5\u05d4 \u05d0\u05e9\u05e8 \u05d3\u05d1\u05e8 \u05d1\u05d9\u05d3 \u05d9\u05d4\u05d5\u05e9\u05e2 \u05d1\u05df \u05e0\u05d5\u05df\u00a0 {\u05e1}"}]