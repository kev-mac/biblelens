[{"pk": 2896196, "verse": 1, "text": "\u05d0 \u05d5\u05d4\u05e0\u05d4 \u05d0\u05d9\u05e9 \u05d0\u05dc\u05d4\u05d9\u05dd \u05d1\u05d0 \u05de\u05d9\u05d4\u05d5\u05d3\u05d4 \u05d1\u05d3\u05d1\u05e8 \u05d9\u05d4\u05d5\u05d4--\u05d0\u05dc \u05d1\u05d9\u05ea \u05d0\u05dc \u05d5\u05d9\u05e8\u05d1\u05e2\u05dd \u05e2\u05de\u05d3 \u05e2\u05dc \u05d4\u05de\u05d6\u05d1\u05d7 \u05dc\u05d4\u05e7\u05d8\u05d9\u05e8"}, {"pk": 2896197, "verse": 2, "text": "\u05d1 \u05d5\u05d9\u05e7\u05e8\u05d0 \u05e2\u05dc \u05d4\u05de\u05d6\u05d1\u05d7 \u05d1\u05d3\u05d1\u05e8 \u05d9\u05d4\u05d5\u05d4 \u05d5\u05d9\u05d0\u05de\u05e8 \u05de\u05d6\u05d1\u05d7 \u05de\u05d6\u05d1\u05d7 \u05db\u05d4 \u05d0\u05de\u05e8 \u05d9\u05d4\u05d5\u05d4\u00a0 \u05d4\u05e0\u05d4 \u05d1\u05df \u05e0\u05d5\u05dc\u05d3 \u05dc\u05d1\u05d9\u05ea \u05d3\u05d5\u05d3 \u05d9\u05d0\u05e9\u05d9\u05d4\u05d5 \u05e9\u05de\u05d5 \u05d5\u05d6\u05d1\u05d7 \u05e2\u05dc\u05d9\u05da \u05d0\u05ea \u05db\u05d4\u05e0\u05d9 \u05d4\u05d1\u05de\u05d5\u05ea \u05d4\u05de\u05e7\u05d8\u05e8\u05d9\u05dd \u05e2\u05dc\u05d9\u05da \u05d5\u05e2\u05e6\u05de\u05d5\u05ea \u05d0\u05d3\u05dd \u05d9\u05e9\u05e8\u05e4\u05d5 \u05e2\u05dc\u05d9\u05da"}, {"pk": 2896198, "verse": 3, "text": "\u05d2 \u05d5\u05e0\u05ea\u05df \u05d1\u05d9\u05d5\u05dd \u05d4\u05d4\u05d5\u05d0 \u05de\u05d5\u05e4\u05ea \u05dc\u05d0\u05de\u05e8 \u05d6\u05d4 \u05d4\u05de\u05d5\u05e4\u05ea \u05d0\u05e9\u05e8 \u05d3\u05d1\u05e8 \u05d9\u05d4\u05d5\u05d4\u00a0 \u05d4\u05e0\u05d4 \u05d4\u05de\u05d6\u05d1\u05d7 \u05e0\u05e7\u05e8\u05e2 \u05d5\u05e0\u05e9\u05e4\u05da \u05d4\u05d3\u05e9\u05df \u05d0\u05e9\u05e8 \u05e2\u05dc\u05d9\u05d5"}, {"pk": 2896199, "verse": 4, "text": "\u05d3 \u05d5\u05d9\u05d4\u05d9 \u05db\u05e9\u05de\u05e2 \u05d4\u05de\u05dc\u05da \u05d0\u05ea \u05d3\u05d1\u05e8 \u05d0\u05d9\u05e9 \u05d4\u05d0\u05dc\u05d4\u05d9\u05dd \u05d0\u05e9\u05e8 \u05e7\u05e8\u05d0 \u05e2\u05dc \u05d4\u05de\u05d6\u05d1\u05d7 \u05d1\u05d1\u05d9\u05ea \u05d0\u05dc \u05d5\u05d9\u05e9\u05dc\u05d7 \u05d9\u05e8\u05d1\u05e2\u05dd \u05d0\u05ea \u05d9\u05d3\u05d5 \u05de\u05e2\u05dc \u05d4\u05de\u05d6\u05d1\u05d7 \u05dc\u05d0\u05de\u05e8 \u05ea\u05e4\u05e9\u05d4\u05d5 \u05d5\u05ea\u05d9\u05d1\u05e9 \u05d9\u05d3\u05d5 \u05d0\u05e9\u05e8 \u05e9\u05dc\u05d7 \u05e2\u05dc\u05d9\u05d5 \u05d5\u05dc\u05d0 \u05d9\u05db\u05dc \u05dc\u05d4\u05e9\u05d9\u05d1\u05d4 \u05d0\u05dc\u05d9\u05d5"}, {"pk": 2896200, "verse": 5, "text": "\u05d4 \u05d5\u05d4\u05de\u05d6\u05d1\u05d7 \u05e0\u05e7\u05e8\u05e2 \u05d5\u05d9\u05e9\u05e4\u05da \u05d4\u05d3\u05e9\u05df \u05de\u05df \u05d4\u05de\u05d6\u05d1\u05d7\u00a0 \u05db\u05de\u05d5\u05e4\u05ea \u05d0\u05e9\u05e8 \u05e0\u05ea\u05df \u05d0\u05d9\u05e9 \u05d4\u05d0\u05dc\u05d4\u05d9\u05dd--\u05d1\u05d3\u05d1\u05e8 \u05d9\u05d4\u05d5\u05d4"}, {"pk": 2896201, "verse": 6, "text": "\u05d5 \u05d5\u05d9\u05e2\u05df \u05d4\u05de\u05dc\u05da \u05d5\u05d9\u05d0\u05de\u05e8 \u05d0\u05dc \u05d0\u05d9\u05e9 \u05d4\u05d0\u05dc\u05d4\u05d9\u05dd \u05d7\u05dc \u05e0\u05d0 \u05d0\u05ea \u05e4\u05e0\u05d9 \u05d9\u05d4\u05d5\u05d4 \u05d0\u05dc\u05d4\u05d9\u05da \u05d5\u05d4\u05ea\u05e4\u05dc\u05dc \u05d1\u05e2\u05d3\u05d9 \u05d5\u05ea\u05e9\u05d1 \u05d9\u05d3\u05d9 \u05d0\u05dc\u05d9 \u05d5\u05d9\u05d7\u05dc \u05d0\u05d9\u05e9 \u05d4\u05d0\u05dc\u05d4\u05d9\u05dd \u05d0\u05ea \u05e4\u05e0\u05d9 \u05d9\u05d4\u05d5\u05d4 \u05d5\u05ea\u05e9\u05d1 \u05d9\u05d3 \u05d4\u05de\u05dc\u05da \u05d0\u05dc\u05d9\u05d5 \u05d5\u05ea\u05d4\u05d9 \u05db\u05d1\u05e8\u05d0\u05e9\u05e0\u05d4"}, {"pk": 2896202, "verse": 7, "text": "\u05d6 \u05d5\u05d9\u05d3\u05d1\u05e8 \u05d4\u05de\u05dc\u05da \u05d0\u05dc \u05d0\u05d9\u05e9 \u05d4\u05d0\u05dc\u05d4\u05d9\u05dd \u05d1\u05d0\u05d4 \u05d0\u05ea\u05d9 \u05d4\u05d1\u05d9\u05ea\u05d4 \u05d5\u05e1\u05e2\u05d3\u05d4 \u05d5\u05d0\u05ea\u05e0\u05d4 \u05dc\u05da \u05de\u05ea\u05ea"}, {"pk": 2896203, "verse": 8, "text": "\u05d7 \u05d5\u05d9\u05d0\u05de\u05e8 \u05d0\u05d9\u05e9 \u05d4\u05d0\u05dc\u05d4\u05d9\u05dd \u05d0\u05dc \u05d4\u05de\u05dc\u05da \u05d0\u05dd \u05ea\u05ea\u05df \u05dc\u05d9 \u05d0\u05ea \u05d7\u05e6\u05d9 \u05d1\u05d9\u05ea\u05da \u05dc\u05d0 \u05d0\u05d1\u05d0 \u05e2\u05de\u05da \u05d5\u05dc\u05d0 \u05d0\u05db\u05dc \u05dc\u05d7\u05dd \u05d5\u05dc\u05d0 \u05d0\u05e9\u05ea\u05d4 \u05de\u05d9\u05dd \u05d1\u05de\u05e7\u05d5\u05dd \u05d4\u05d6\u05d4"}, {"pk": 2896204, "verse": 9, "text": "\u05d8 \u05db\u05d9 \u05db\u05df \u05e6\u05d5\u05d4 \u05d0\u05ea\u05d9 \u05d1\u05d3\u05d1\u05e8 \u05d9\u05d4\u05d5\u05d4 \u05dc\u05d0\u05de\u05e8 \u05dc\u05d0 \u05ea\u05d0\u05db\u05dc \u05dc\u05d7\u05dd \u05d5\u05dc\u05d0 \u05ea\u05e9\u05ea\u05d4 \u05de\u05d9\u05dd \u05d5\u05dc\u05d0 \u05ea\u05e9\u05d5\u05d1 \u05d1\u05d3\u05e8\u05da \u05d0\u05e9\u05e8 \u05d4\u05dc\u05db\u05ea"}, {"pk": 2896205, "verse": 10, "text": "\u05d9 \u05d5\u05d9\u05dc\u05da \u05d1\u05d3\u05e8\u05da \u05d0\u05d7\u05e8 \u05d5\u05dc\u05d0 \u05e9\u05d1 \u05d1\u05d3\u05e8\u05da \u05d0\u05e9\u05e8 \u05d1\u05d0 \u05d1\u05d4 \u05d0\u05dc \u05d1\u05d9\u05ea \u05d0\u05dc\u00a0 {\u05e4}"}, {"pk": 2896206, "verse": 11, "text": "\u05d9\u05d0 \u05d5\u05e0\u05d1\u05d9\u05d0 \u05d0\u05d7\u05d3 \u05d6\u05e7\u05df \u05d9\u05e9\u05d1 \u05d1\u05d1\u05d9\u05ea \u05d0\u05dc \u05d5\u05d9\u05d1\u05d5\u05d0 \u05d1\u05e0\u05d5 \u05d5\u05d9\u05e1\u05e4\u05e8 \u05dc\u05d5 \u05d0\u05ea \u05db\u05dc \u05d4\u05de\u05e2\u05e9\u05d4 \u05d0\u05e9\u05e8 \u05e2\u05e9\u05d4 \u05d0\u05d9\u05e9 \u05d4\u05d0\u05dc\u05d4\u05d9\u05dd \u05d4\u05d9\u05d5\u05dd \u05d1\u05d1\u05d9\u05ea \u05d0\u05dc \u05d0\u05ea \u05d4\u05d3\u05d1\u05e8\u05d9\u05dd \u05d0\u05e9\u05e8 \u05d3\u05d1\u05e8 \u05d0\u05dc \u05d4\u05de\u05dc\u05da \u05d5\u05d9\u05e1\u05e4\u05e8\u05d5\u05dd \u05dc\u05d0\u05d1\u05d9\u05d4\u05dd"}, {"pk": 2896207, "verse": 12, "text": "\u05d9\u05d1 \u05d5\u05d9\u05d3\u05d1\u05e8 \u05d0\u05dc\u05d4\u05dd \u05d0\u05d1\u05d9\u05d4\u05dd \u05d0\u05d9 \u05d6\u05d4 \u05d4\u05d3\u05e8\u05da \u05d4\u05dc\u05da \u05d5\u05d9\u05e8\u05d0\u05d5 \u05d1\u05e0\u05d9\u05d5 \u05d0\u05ea \u05d4\u05d3\u05e8\u05da \u05d0\u05e9\u05e8 \u05d4\u05dc\u05da \u05d0\u05d9\u05e9 \u05d4\u05d0\u05dc\u05d4\u05d9\u05dd \u05d0\u05e9\u05e8 \u05d1\u05d0 \u05de\u05d9\u05d4\u05d5\u05d3\u05d4"}, {"pk": 2896208, "verse": 13, "text": "\u05d9\u05d2 \u05d5\u05d9\u05d0\u05de\u05e8 \u05d0\u05dc \u05d1\u05e0\u05d9\u05d5 \u05d7\u05d1\u05e9\u05d5 \u05dc\u05d9 \u05d4\u05d7\u05de\u05d5\u05e8 \u05d5\u05d9\u05d7\u05d1\u05e9\u05d5 \u05dc\u05d5 \u05d4\u05d7\u05de\u05d5\u05e8 \u05d5\u05d9\u05e8\u05db\u05d1 \u05e2\u05dc\u05d9\u05d5"}, {"pk": 2896209, "verse": 14, "text": "\u05d9\u05d3 \u05d5\u05d9\u05dc\u05da \u05d0\u05d7\u05e8\u05d9 \u05d0\u05d9\u05e9 \u05d4\u05d0\u05dc\u05d4\u05d9\u05dd \u05d5\u05d9\u05de\u05e6\u05d0\u05d4\u05d5 \u05d9\u05e9\u05d1 \u05ea\u05d7\u05ea \u05d4\u05d0\u05dc\u05d4 \u05d5\u05d9\u05d0\u05de\u05e8 \u05d0\u05dc\u05d9\u05d5 \u05d4\u05d0\u05ea\u05d4 \u05d0\u05d9\u05e9 \u05d4\u05d0\u05dc\u05d4\u05d9\u05dd \u05d0\u05e9\u05e8 \u05d1\u05d0\u05ea \u05de\u05d9\u05d4\u05d5\u05d3\u05d4--\u05d5\u05d9\u05d0\u05de\u05e8 \u05d0\u05e0\u05d9"}, {"pk": 2896210, "verse": 15, "text": "\u05d8\u05d5 \u05d5\u05d9\u05d0\u05de\u05e8 \u05d0\u05dc\u05d9\u05d5 \u05dc\u05da \u05d0\u05ea\u05d9 \u05d4\u05d1\u05d9\u05ea\u05d4 \u05d5\u05d0\u05db\u05dc \u05dc\u05d7\u05dd"}, {"pk": 2896211, "verse": 16, "text": "\u05d8\u05d6 \u05d5\u05d9\u05d0\u05de\u05e8 \u05dc\u05d0 \u05d0\u05d5\u05db\u05dc \u05dc\u05e9\u05d5\u05d1 \u05d0\u05ea\u05da--\u05d5\u05dc\u05d1\u05d5\u05d0 \u05d0\u05ea\u05da \u05d5\u05dc\u05d0 \u05d0\u05db\u05dc \u05dc\u05d7\u05dd \u05d5\u05dc\u05d0 \u05d0\u05e9\u05ea\u05d4 \u05d0\u05ea\u05da \u05de\u05d9\u05dd \u05d1\u05de\u05e7\u05d5\u05dd \u05d4\u05d6\u05d4"}, {"pk": 2896212, "verse": 17, "text": "\u05d9\u05d6 \u05db\u05d9 \u05d3\u05d1\u05e8 \u05d0\u05dc\u05d9 \u05d1\u05d3\u05d1\u05e8 \u05d9\u05d4\u05d5\u05d4 \u05dc\u05d0 \u05ea\u05d0\u05db\u05dc \u05dc\u05d7\u05dd \u05d5\u05dc\u05d0 \u05ea\u05e9\u05ea\u05d4 \u05e9\u05dd \u05de\u05d9\u05dd \u05dc\u05d0 \u05ea\u05e9\u05d5\u05d1 \u05dc\u05dc\u05db\u05ea \u05d1\u05d3\u05e8\u05da \u05d0\u05e9\u05e8 \u05d4\u05dc\u05db\u05ea \u05d1\u05d4"}, {"pk": 2896213, "verse": 18, "text": "\u05d9\u05d7 \u05d5\u05d9\u05d0\u05de\u05e8 \u05dc\u05d5 \u05d2\u05dd \u05d0\u05e0\u05d9 \u05e0\u05d1\u05d9\u05d0 \u05db\u05de\u05d5\u05da \u05d5\u05de\u05dc\u05d0\u05da \u05d3\u05d1\u05e8 \u05d0\u05dc\u05d9 \u05d1\u05d3\u05d1\u05e8 \u05d9\u05d4\u05d5\u05d4 \u05dc\u05d0\u05de\u05e8 \u05d4\u05e9\u05d1\u05d4\u05d5 \u05d0\u05ea\u05da \u05d0\u05dc \u05d1\u05d9\u05ea\u05da \u05d5\u05d9\u05d0\u05db\u05dc \u05dc\u05d7\u05dd \u05d5\u05d9\u05e9\u05ea \u05de\u05d9\u05dd \u05db\u05d7\u05e9 \u05dc\u05d5"}, {"pk": 2896214, "verse": 19, "text": "\u05d9\u05d8 \u05d5\u05d9\u05e9\u05d1 \u05d0\u05ea\u05d5 \u05d5\u05d9\u05d0\u05db\u05dc \u05dc\u05d7\u05dd \u05d1\u05d1\u05d9\u05ea\u05d5--\u05d5\u05d9\u05e9\u05ea \u05de\u05d9\u05dd"}, {"pk": 2896215, "verse": 20, "text": "\u05db \u05d5\u05d9\u05d4\u05d9 \u05d4\u05dd \u05d9\u05e9\u05d1\u05d9\u05dd \u05d0\u05dc \u05d4\u05e9\u05dc\u05d7\u05df\u00a0 {\u05e4} \u00a0 \u05d5\u05d9\u05d4\u05d9 \u05d3\u05d1\u05e8 \u05d9\u05d4\u05d5\u05d4 \u05d0\u05dc \u05d4\u05e0\u05d1\u05d9\u05d0 \u05d0\u05e9\u05e8 \u05d4\u05e9\u05d9\u05d1\u05d5"}, {"pk": 2896216, "verse": 21, "text": "\u05db\u05d0 \u05d5\u05d9\u05e7\u05e8\u05d0 \u05d0\u05dc \u05d0\u05d9\u05e9 \u05d4\u05d0\u05dc\u05d4\u05d9\u05dd \u05d0\u05e9\u05e8 \u05d1\u05d0 \u05de\u05d9\u05d4\u05d5\u05d3\u05d4 \u05dc\u05d0\u05de\u05e8 \u05db\u05d4 \u05d0\u05de\u05e8 \u05d9\u05d4\u05d5\u05d4\u00a0 \u05d9\u05e2\u05df \u05db\u05d9 \u05de\u05e8\u05d9\u05ea \u05e4\u05d9 \u05d9\u05d4\u05d5\u05d4 \u05d5\u05dc\u05d0 \u05e9\u05de\u05e8\u05ea \u05d0\u05ea \u05d4\u05de\u05e6\u05d5\u05d4 \u05d0\u05e9\u05e8 \u05e6\u05d5\u05da \u05d9\u05d4\u05d5\u05d4 \u05d0\u05dc\u05d4\u05d9\u05da"}, {"pk": 2896217, "verse": 22, "text": "\u05db\u05d1 \u05d5\u05ea\u05e9\u05d1 \u05d5\u05ea\u05d0\u05db\u05dc \u05dc\u05d7\u05dd \u05d5\u05ea\u05e9\u05ea \u05de\u05d9\u05dd \u05d1\u05de\u05e7\u05d5\u05dd \u05d0\u05e9\u05e8 \u05d3\u05d1\u05e8 \u05d0\u05dc\u05d9\u05da \u05d0\u05dc \u05ea\u05d0\u05db\u05dc \u05dc\u05d7\u05dd \u05d5\u05d0\u05dc \u05ea\u05e9\u05ea \u05de\u05d9\u05dd--\u05dc\u05d0 \u05ea\u05d1\u05d5\u05d0 \u05e0\u05d1\u05dc\u05ea\u05da \u05d0\u05dc \u05e7\u05d1\u05e8 \u05d0\u05d1\u05ea\u05d9\u05da"}, {"pk": 2896218, "verse": 23, "text": "\u05db\u05d2 \u05d5\u05d9\u05d4\u05d9 \u05d0\u05d7\u05e8\u05d9 \u05d0\u05db\u05dc\u05d5 \u05dc\u05d7\u05dd--\u05d5\u05d0\u05d7\u05e8\u05d9 \u05e9\u05ea\u05d5\u05ea\u05d5 \u05d5\u05d9\u05d7\u05d1\u05e9 \u05dc\u05d5 \u05d4\u05d7\u05de\u05d5\u05e8 \u05dc\u05e0\u05d1\u05d9\u05d0 \u05d0\u05e9\u05e8 \u05d4\u05e9\u05d9\u05d1\u05d5"}, {"pk": 2896219, "verse": 24, "text": "\u05db\u05d3 \u05d5\u05d9\u05dc\u05da \u05d5\u05d9\u05de\u05e6\u05d0\u05d4\u05d5 \u05d0\u05e8\u05d9\u05d4 \u05d1\u05d3\u05e8\u05da \u05d5\u05d9\u05de\u05d9\u05ea\u05d4\u05d5 \u05d5\u05ea\u05d4\u05d9 \u05e0\u05d1\u05dc\u05ea\u05d5 \u05de\u05e9\u05dc\u05db\u05ea \u05d1\u05d3\u05e8\u05da \u05d5\u05d4\u05d7\u05de\u05d5\u05e8 \u05e2\u05de\u05d3 \u05d0\u05e6\u05dc\u05d4 \u05d5\u05d4\u05d0\u05e8\u05d9\u05d4 \u05e2\u05de\u05d3 \u05d0\u05e6\u05dc \u05d4\u05e0\u05d1\u05dc\u05d4"}, {"pk": 2896220, "verse": 25, "text": "\u05db\u05d4 \u05d5\u05d4\u05e0\u05d4 \u05d0\u05e0\u05e9\u05d9\u05dd \u05e2\u05d1\u05e8\u05d9\u05dd \u05d5\u05d9\u05e8\u05d0\u05d5 \u05d0\u05ea \u05d4\u05e0\u05d1\u05dc\u05d4 \u05de\u05e9\u05dc\u05db\u05ea \u05d1\u05d3\u05e8\u05da \u05d5\u05d0\u05ea \u05d4\u05d0\u05e8\u05d9\u05d4 \u05e2\u05de\u05d3 \u05d0\u05e6\u05dc \u05d4\u05e0\u05d1\u05dc\u05d4 \u05d5\u05d9\u05d1\u05d0\u05d5 \u05d5\u05d9\u05d3\u05d1\u05e8\u05d5 \u05d1\u05e2\u05d9\u05e8 \u05d0\u05e9\u05e8 \u05d4\u05e0\u05d1\u05d9\u05d0 \u05d4\u05d6\u05e7\u05df \u05d9\u05e9\u05d1 \u05d1\u05d4"}, {"pk": 2896221, "verse": 26, "text": "\u05db\u05d5 \u05d5\u05d9\u05e9\u05de\u05e2 \u05d4\u05e0\u05d1\u05d9\u05d0 \u05d0\u05e9\u05e8 \u05d4\u05e9\u05d9\u05d1\u05d5 \u05de\u05df \u05d4\u05d3\u05e8\u05da \u05d5\u05d9\u05d0\u05de\u05e8 \u05d0\u05d9\u05e9 \u05d4\u05d0\u05dc\u05d4\u05d9\u05dd \u05d4\u05d5\u05d0 \u05d0\u05e9\u05e8 \u05de\u05e8\u05d4 \u05d0\u05ea \u05e4\u05d9 \u05d9\u05d4\u05d5\u05d4 \u05d5\u05d9\u05ea\u05e0\u05d4\u05d5 \u05d9\u05d4\u05d5\u05d4 \u05dc\u05d0\u05e8\u05d9\u05d4 \u05d5\u05d9\u05e9\u05d1\u05e8\u05d4\u05d5 \u05d5\u05d9\u05de\u05ea\u05d4\u05d5 \u05db\u05d3\u05d1\u05e8 \u05d9\u05d4\u05d5\u05d4 \u05d0\u05e9\u05e8 \u05d3\u05d1\u05e8 \u05dc\u05d5"}, {"pk": 2896222, "verse": 27, "text": "\u05db\u05d6 \u05d5\u05d9\u05d3\u05d1\u05e8 \u05d0\u05dc \u05d1\u05e0\u05d9\u05d5 \u05dc\u05d0\u05de\u05e8 \u05d7\u05d1\u05e9\u05d5 \u05dc\u05d9 \u05d0\u05ea \u05d4\u05d7\u05de\u05d5\u05e8 \u05d5\u05d9\u05d7\u05d1\u05e9\u05d5"}, {"pk": 2896223, "verse": 28, "text": "\u05db\u05d7 \u05d5\u05d9\u05dc\u05da \u05d5\u05d9\u05de\u05e6\u05d0 \u05d0\u05ea \u05e0\u05d1\u05dc\u05ea\u05d5 \u05de\u05e9\u05dc\u05db\u05ea \u05d1\u05d3\u05e8\u05da \u05d5\u05d7\u05de\u05d5\u05e8 \u05d5\u05d4\u05d0\u05e8\u05d9\u05d4 \u05e2\u05de\u05d3\u05d9\u05dd \u05d0\u05e6\u05dc \u05d4\u05e0\u05d1\u05dc\u05d4\u00a0 \u05dc\u05d0 \u05d0\u05db\u05dc \u05d4\u05d0\u05e8\u05d9\u05d4 \u05d0\u05ea \u05d4\u05e0\u05d1\u05dc\u05d4 \u05d5\u05dc\u05d0 \u05e9\u05d1\u05e8 \u05d0\u05ea \u05d4\u05d7\u05de\u05d5\u05e8"}, {"pk": 2896224, "verse": 29, "text": "\u05db\u05d8 \u05d5\u05d9\u05e9\u05d0 \u05d4\u05e0\u05d1\u05d9\u05d0 \u05d0\u05ea \u05e0\u05d1\u05dc\u05ea \u05d0\u05d9\u05e9 \u05d4\u05d0\u05dc\u05d4\u05d9\u05dd \u05d5\u05d9\u05e0\u05d7\u05d4\u05d5 \u05d0\u05dc \u05d4\u05d7\u05de\u05d5\u05e8--\u05d5\u05d9\u05e9\u05d9\u05d1\u05d4\u05d5 \u05d5\u05d9\u05d1\u05d0 \u05d0\u05dc \u05e2\u05d9\u05e8 \u05d4\u05e0\u05d1\u05d9\u05d0 \u05d4\u05d6\u05e7\u05df \u05dc\u05e1\u05e4\u05d3 \u05d5\u05dc\u05e7\u05d1\u05e8\u05d5"}, {"pk": 2896225, "verse": 30, "text": "\u05dc \u05d5\u05d9\u05e0\u05d7 \u05d0\u05ea \u05e0\u05d1\u05dc\u05ea\u05d5 \u05d1\u05e7\u05d1\u05e8\u05d5 \u05d5\u05d9\u05e1\u05e4\u05d3\u05d5 \u05e2\u05dc\u05d9\u05d5 \u05d4\u05d5\u05d9 \u05d0\u05d7\u05d9"}, {"pk": 2896226, "verse": 31, "text": "\u05dc\u05d0 \u05d5\u05d9\u05d4\u05d9 \u05d0\u05d7\u05e8\u05d9 \u05e7\u05d1\u05e8\u05d5 \u05d0\u05ea\u05d5 \u05d5\u05d9\u05d0\u05de\u05e8 \u05d0\u05dc \u05d1\u05e0\u05d9\u05d5 \u05dc\u05d0\u05de\u05e8 \u05d1\u05de\u05d5\u05ea\u05d9 \u05d5\u05e7\u05d1\u05e8\u05ea\u05dd \u05d0\u05ea\u05d9 \u05d1\u05e7\u05d1\u05e8 \u05d0\u05e9\u05e8 \u05d0\u05d9\u05e9 \u05d4\u05d0\u05dc\u05d4\u05d9\u05dd \u05e7\u05d1\u05d5\u05e8 \u05d1\u05d5\u00a0 \u05d0\u05e6\u05dc \u05e2\u05e6\u05de\u05ea\u05d9\u05d5 \u05d4\u05e0\u05d9\u05d7\u05d5 \u05d0\u05ea \u05e2\u05e6\u05de\u05ea\u05d9"}, {"pk": 2896227, "verse": 32, "text": "\u05dc\u05d1 \u05db\u05d9 \u05d4\u05d9\u05d4 \u05d9\u05d4\u05d9\u05d4 \u05d4\u05d3\u05d1\u05e8 \u05d0\u05e9\u05e8 \u05e7\u05e8\u05d0 \u05d1\u05d3\u05d1\u05e8 \u05d9\u05d4\u05d5\u05d4 \u05e2\u05dc \u05d4\u05de\u05d6\u05d1\u05d7 \u05d0\u05e9\u05e8 \u05d1\u05d1\u05d9\u05ea \u05d0\u05dc \u05d5\u05e2\u05dc \u05db\u05dc \u05d1\u05ea\u05d9 \u05d4\u05d1\u05de\u05d5\u05ea \u05d0\u05e9\u05e8 \u05d1\u05e2\u05e8\u05d9 \u05e9\u05de\u05e8\u05d5\u05df\u00a0 {\u05e4}"}, {"pk": 2896228, "verse": 33, "text": "\u05dc\u05d2 \u05d0\u05d7\u05e8 \u05d4\u05d3\u05d1\u05e8 \u05d4\u05d6\u05d4 \u05dc\u05d0 \u05e9\u05d1 \u05d9\u05e8\u05d1\u05e2\u05dd \u05de\u05d3\u05e8\u05db\u05d5 \u05d4\u05e8\u05e2\u05d4 \u05d5\u05d9\u05e9\u05d1 \u05d5\u05d9\u05e2\u05e9 \u05de\u05e7\u05e6\u05d5\u05ea \u05d4\u05e2\u05dd \u05db\u05d4\u05e0\u05d9 \u05d1\u05de\u05d5\u05ea--\u05d4\u05d7\u05e4\u05e5 \u05d9\u05de\u05dc\u05d0 \u05d0\u05ea \u05d9\u05d3\u05d5 \u05d5\u05d9\u05d4\u05d9 \u05db\u05d4\u05e0\u05d9 \u05d1\u05de\u05d5\u05ea"}, {"pk": 2896229, "verse": 34, "text": "\u05dc\u05d3 \u05d5\u05d9\u05d4\u05d9 \u05d1\u05d3\u05d1\u05e8 \u05d4\u05d6\u05d4 \u05dc\u05d7\u05d8\u05d0\u05ea \u05d1\u05d9\u05ea \u05d9\u05e8\u05d1\u05e2\u05dd \u05d5\u05dc\u05d4\u05db\u05d7\u05d9\u05d3 \u05d5\u05dc\u05d4\u05e9\u05de\u05d9\u05d3 \u05de\u05e2\u05dc \u05e4\u05e0\u05d9 \u05d4\u05d0\u05d3\u05de\u05d4\u00a0 {\u05e4}"}]