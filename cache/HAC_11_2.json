[{"pk": 2895796, "verse": 1, "text": "\u05d0 \u05d5\u05d9\u05e7\u05e8\u05d1\u05d5 \u05d9\u05de\u05d9 \u05d3\u05d5\u05d3 \u05dc\u05de\u05d5\u05ea \u05d5\u05d9\u05e6\u05d5 \u05d0\u05ea \u05e9\u05dc\u05de\u05d4 \u05d1\u05e0\u05d5 \u05dc\u05d0\u05de\u05e8"}, {"pk": 2895797, "verse": 2, "text": "\u05d1 \u05d0\u05e0\u05db\u05d9 \u05d4\u05dc\u05da \u05d1\u05d3\u05e8\u05da \u05db\u05dc \u05d4\u05d0\u05e8\u05e5 \u05d5\u05d7\u05d6\u05e7\u05ea \u05d5\u05d4\u05d9\u05d9\u05ea \u05dc\u05d0\u05d9\u05e9"}, {"pk": 2895798, "verse": 3, "text": "\u05d2 \u05d5\u05e9\u05de\u05e8\u05ea \u05d0\u05ea \u05de\u05e9\u05de\u05e8\u05ea \u05d9\u05d4\u05d5\u05d4 \u05d0\u05dc\u05d4\u05d9\u05da \u05dc\u05dc\u05db\u05ea \u05d1\u05d3\u05e8\u05db\u05d9\u05d5 \u05dc\u05e9\u05de\u05e8 \u05d7\u05e7\u05ea\u05d9\u05d5 \u05de\u05e6\u05d5\u05ea\u05d9\u05d5 \u05d5\u05de\u05e9\u05e4\u05d8\u05d9\u05d5 \u05d5\u05e2\u05d3\u05d5\u05ea\u05d9\u05d5 \u05db\u05db\u05ea\u05d5\u05d1 \u05d1\u05ea\u05d5\u05e8\u05ea \u05de\u05e9\u05d4--\u05dc\u05de\u05e2\u05df \u05ea\u05e9\u05db\u05d9\u05dc \u05d0\u05ea \u05db\u05dc \u05d0\u05e9\u05e8 \u05ea\u05e2\u05e9\u05d4 \u05d5\u05d0\u05ea \u05db\u05dc \u05d0\u05e9\u05e8 \u05ea\u05e4\u05e0\u05d4 \u05e9\u05dd"}, {"pk": 2895799, "verse": 4, "text": "\u05d3 \u05dc\u05de\u05e2\u05df \u05d9\u05e7\u05d9\u05dd \u05d9\u05d4\u05d5\u05d4 \u05d0\u05ea \u05d3\u05d1\u05e8\u05d5 \u05d0\u05e9\u05e8 \u05d3\u05d1\u05e8 \u05e2\u05dc\u05d9 \u05dc\u05d0\u05de\u05e8 \u05d0\u05dd \u05d9\u05e9\u05de\u05e8\u05d5 \u05d1\u05e0\u05d9\u05da \u05d0\u05ea \u05d3\u05e8\u05db\u05dd \u05dc\u05dc\u05db\u05ea \u05dc\u05e4\u05e0\u05d9 \u05d1\u05d0\u05de\u05ea \u05d1\u05db\u05dc \u05dc\u05d1\u05d1\u05dd \u05d5\u05d1\u05db\u05dc \u05e0\u05e4\u05e9\u05dd\u00a0 \u05dc\u05d0\u05de\u05e8--\u05dc\u05d0 \u05d9\u05db\u05e8\u05ea \u05dc\u05da \u05d0\u05d9\u05e9 \u05de\u05e2\u05dc \u05db\u05e1\u05d0 \u05d9\u05e9\u05e8\u05d0\u05dc"}, {"pk": 2895800, "verse": 5, "text": "\u05d4 \u05d5\u05d2\u05dd \u05d0\u05ea\u05d4 \u05d9\u05d3\u05e2\u05ea \u05d0\u05ea \u05d0\u05e9\u05e8 \u05e2\u05e9\u05d4 \u05dc\u05d9 \u05d9\u05d5\u05d0\u05d1 \u05d1\u05df \u05e6\u05e8\u05d5\u05d9\u05d4 \u05d0\u05e9\u05e8 \u05e2\u05e9\u05d4 \u05dc\u05e9\u05e0\u05d9 \u05e9\u05e8\u05d9 \u05e6\u05d1\u05d0\u05d5\u05ea \u05d9\u05e9\u05e8\u05d0\u05dc \u05dc\u05d0\u05d1\u05e0\u05e8 \u05d1\u05df \u05e0\u05e8 \u05d5\u05dc\u05e2\u05de\u05e9\u05d0 \u05d1\u05df \u05d9\u05ea\u05e8 \u05d5\u05d9\u05d4\u05e8\u05d2\u05dd \u05d5\u05d9\u05e9\u05dd \u05d3\u05de\u05d9 \u05de\u05dc\u05d7\u05de\u05d4 \u05d1\u05e9\u05dc\u05dd \u05d5\u05d9\u05ea\u05df \u05d3\u05de\u05d9 \u05de\u05dc\u05d7\u05de\u05d4 \u05d1\u05d7\u05d2\u05e8\u05ea\u05d5 \u05d0\u05e9\u05e8 \u05d1\u05de\u05ea\u05e0\u05d9\u05d5 \u05d5\u05d1\u05e0\u05e2\u05dc\u05d5 \u05d0\u05e9\u05e8 \u05d1\u05e8\u05d2\u05dc\u05d9\u05d5"}, {"pk": 2895801, "verse": 6, "text": "\u05d5 \u05d5\u05e2\u05e9\u05d9\u05ea \u05db\u05d7\u05db\u05de\u05ea\u05da \u05d5\u05dc\u05d0 \u05ea\u05d5\u05e8\u05d3 \u05e9\u05d9\u05d1\u05ea\u05d5 \u05d1\u05e9\u05dc\u05dd \u05e9\u05d0\u05dc"}, {"pk": 2895802, "verse": 7, "text": "\u05d6 \u05d5\u05dc\u05d1\u05e0\u05d9 \u05d1\u05e8\u05d6\u05dc\u05d9 \u05d4\u05d2\u05dc\u05e2\u05d3\u05d9 \u05ea\u05e2\u05e9\u05d4 \u05d7\u05e1\u05d3 \u05d5\u05d4\u05d9\u05d5 \u05d1\u05d0\u05db\u05dc\u05d9 \u05e9\u05dc\u05d7\u05e0\u05da\u00a0 \u05db\u05d9 \u05db\u05df \u05e7\u05e8\u05d1\u05d5 \u05d0\u05dc\u05d9 \u05d1\u05d1\u05e8\u05d7\u05d9 \u05de\u05e4\u05e0\u05d9 \u05d0\u05d1\u05e9\u05dc\u05d5\u05dd \u05d0\u05d7\u05d9\u05da"}, {"pk": 2895803, "verse": 8, "text": "\u05d7 \u05d5\u05d4\u05e0\u05d4 \u05e2\u05de\u05da \u05e9\u05de\u05e2\u05d9 \u05d1\u05df \u05d2\u05e8\u05d0 \u05d1\u05df \u05d4\u05d9\u05de\u05d9\u05e0\u05d9 \u05de\u05d1\u05d7\u05e8\u05d9\u05dd \u05d5\u05d4\u05d5\u05d0 \u05e7\u05dc\u05dc\u05e0\u05d9 \u05e7\u05dc\u05dc\u05d4 \u05e0\u05de\u05e8\u05e6\u05ea \u05d1\u05d9\u05d5\u05dd \u05dc\u05db\u05ea\u05d9 \u05de\u05d7\u05e0\u05d9\u05dd \u05d5\u05d4\u05d5\u05d0 \u05d9\u05e8\u05d3 \u05dc\u05e7\u05e8\u05d0\u05ea\u05d9 \u05d4\u05d9\u05e8\u05d3\u05df \u05d5\u05d0\u05e9\u05d1\u05e2 \u05dc\u05d5 \u05d1\u05d9\u05d4\u05d5\u05d4 \u05dc\u05d0\u05de\u05e8 \u05d0\u05dd \u05d0\u05de\u05d9\u05ea\u05da \u05d1\u05d7\u05e8\u05d1"}, {"pk": 2895804, "verse": 9, "text": "\u05d8 \u05d5\u05e2\u05ea\u05d4 \u05d0\u05dc \u05ea\u05e0\u05e7\u05d4\u05d5 \u05db\u05d9 \u05d0\u05d9\u05e9 \u05d7\u05db\u05dd \u05d0\u05ea\u05d4 \u05d5\u05d9\u05d3\u05e2\u05ea \u05d0\u05ea \u05d0\u05e9\u05e8 \u05ea\u05e2\u05e9\u05d4 \u05dc\u05d5 \u05d5\u05d4\u05d5\u05e8\u05d3\u05ea \u05d0\u05ea \u05e9\u05d9\u05d1\u05ea\u05d5 \u05d1\u05d3\u05dd \u05e9\u05d0\u05d5\u05dc"}, {"pk": 2895805, "verse": 10, "text": "\u05d9 \u05d5\u05d9\u05e9\u05db\u05d1 \u05d3\u05d5\u05d3 \u05e2\u05dd \u05d0\u05d1\u05ea\u05d9\u05d5 \u05d5\u05d9\u05e7\u05d1\u05e8 \u05d1\u05e2\u05d9\u05e8 \u05d3\u05d5\u05d3\u00a0 {\u05e4}"}, {"pk": 2895806, "verse": 11, "text": "\u05d9\u05d0 \u05d5\u05d4\u05d9\u05de\u05d9\u05dd \u05d0\u05e9\u05e8 \u05de\u05dc\u05da \u05d3\u05d5\u05d3 \u05e2\u05dc \u05d9\u05e9\u05e8\u05d0\u05dc \u05d0\u05e8\u05d1\u05e2\u05d9\u05dd \u05e9\u05e0\u05d4\u00a0 \u05d1\u05d7\u05d1\u05e8\u05d5\u05df \u05de\u05dc\u05da \u05e9\u05d1\u05e2 \u05e9\u05e0\u05d9\u05dd \u05d5\u05d1\u05d9\u05e8\u05d5\u05e9\u05dc\u05dd \u05de\u05dc\u05da \u05e9\u05dc\u05e9\u05d9\u05dd \u05d5\u05e9\u05dc\u05e9 \u05e9\u05e0\u05d9\u05dd"}, {"pk": 2895807, "verse": 12, "text": "\u05d9\u05d1 \u05d5\u05e9\u05dc\u05de\u05d4--\u05d9\u05e9\u05d1 \u05e2\u05dc \u05db\u05e1\u05d0 \u05d3\u05d5\u05d3 \u05d0\u05d1\u05d9\u05d5 \u05d5\u05ea\u05db\u05df \u05de\u05dc\u05db\u05ea\u05d5 \u05de\u05d0\u05d3\u00a0 {\u05e1}"}, {"pk": 2895808, "verse": 13, "text": "\u05d9\u05d2 \u05d5\u05d9\u05d1\u05d0 \u05d0\u05d3\u05e0\u05d9\u05d4\u05d5 \u05d1\u05df \u05d7\u05d2\u05d9\u05ea \u05d0\u05dc \u05d1\u05ea \u05e9\u05d1\u05e2 \u05d0\u05dd \u05e9\u05dc\u05de\u05d4 \u05d5\u05ea\u05d0\u05de\u05e8 \u05d4\u05e9\u05dc\u05d5\u05dd \u05d1\u05d0\u05da \u05d5\u05d9\u05d0\u05de\u05e8 \u05e9\u05dc\u05d5\u05dd"}, {"pk": 2895809, "verse": 14, "text": "\u05d9\u05d3 \u05d5\u05d9\u05d0\u05de\u05e8 \u05d3\u05d1\u05e8 \u05dc\u05d9 \u05d0\u05dc\u05d9\u05da \u05d5\u05ea\u05d0\u05de\u05e8 \u05d3\u05d1\u05e8"}, {"pk": 2895810, "verse": 15, "text": "\u05d8\u05d5 \u05d5\u05d9\u05d0\u05de\u05e8 \u05d0\u05ea \u05d9\u05d3\u05e2\u05ea \u05db\u05d9 \u05dc\u05d9 \u05d4\u05d9\u05ea\u05d4 \u05d4\u05de\u05dc\u05d5\u05db\u05d4 \u05d5\u05e2\u05dc\u05d9 \u05e9\u05de\u05d5 \u05db\u05dc \u05d9\u05e9\u05e8\u05d0\u05dc \u05e4\u05e0\u05d9\u05d4\u05dd \u05dc\u05de\u05dc\u05da \u05d5\u05ea\u05e1\u05d1 \u05d4\u05de\u05dc\u05d5\u05db\u05d4 \u05d5\u05ea\u05d4\u05d9 \u05dc\u05d0\u05d7\u05d9 \u05db\u05d9 \u05de\u05d9\u05d4\u05d5\u05d4 \u05d4\u05d9\u05ea\u05d4 \u05dc\u05d5"}, {"pk": 2895811, "verse": 16, "text": "\u05d8\u05d6 \u05d5\u05e2\u05ea\u05d4 \u05e9\u05d0\u05dc\u05d4 \u05d0\u05d7\u05ea \u05d0\u05e0\u05db\u05d9 \u05e9\u05d0\u05dc \u05de\u05d0\u05ea\u05da--\u05d0\u05dc \u05ea\u05e9\u05d1\u05d9 \u05d0\u05ea \u05e4\u05e0\u05d9 \u05d5\u05ea\u05d0\u05de\u05e8 \u05d0\u05dc\u05d9\u05d5 \u05d3\u05d1\u05e8"}, {"pk": 2895812, "verse": 17, "text": "\u05d9\u05d6 \u05d5\u05d9\u05d0\u05de\u05e8 \u05d0\u05de\u05e8\u05d9 \u05e0\u05d0 \u05dc\u05e9\u05dc\u05de\u05d4 \u05d4\u05de\u05dc\u05da \u05db\u05d9 \u05dc\u05d0 \u05d9\u05e9\u05d9\u05d1 \u05d0\u05ea \u05e4\u05e0\u05d9\u05da \u05d5\u05d9\u05ea\u05df \u05dc\u05d9 \u05d0\u05ea \u05d0\u05d1\u05d9\u05e9\u05d2 \u05d4\u05e9\u05d5\u05e0\u05de\u05d9\u05ea \u05dc\u05d0\u05e9\u05d4"}, {"pk": 2895813, "verse": 18, "text": "\u05d9\u05d7 \u05d5\u05ea\u05d0\u05de\u05e8 \u05d1\u05ea \u05e9\u05d1\u05e2 \u05d8\u05d5\u05d1 \u05d0\u05e0\u05db\u05d9 \u05d0\u05d3\u05d1\u05e8 \u05e2\u05dc\u05d9\u05da \u05d0\u05dc \u05d4\u05de\u05dc\u05da"}, {"pk": 2895814, "verse": 19, "text": "\u05d9\u05d8 \u05d5\u05ea\u05d1\u05d0 \u05d1\u05ea \u05e9\u05d1\u05e2 \u05d0\u05dc \u05d4\u05de\u05dc\u05da \u05e9\u05dc\u05de\u05d4 \u05dc\u05d3\u05d1\u05e8 \u05dc\u05d5 \u05e2\u05dc \u05d0\u05d3\u05e0\u05d9\u05d4\u05d5 \u05d5\u05d9\u05e7\u05dd \u05d4\u05de\u05dc\u05da \u05dc\u05e7\u05e8\u05d0\u05ea\u05d4 \u05d5\u05d9\u05e9\u05ea\u05d7\u05d5 \u05dc\u05d4 \u05d5\u05d9\u05e9\u05d1 \u05e2\u05dc \u05db\u05e1\u05d0\u05d5 \u05d5\u05d9\u05e9\u05dd \u05db\u05e1\u05d0 \u05dc\u05d0\u05dd \u05d4\u05de\u05dc\u05da \u05d5\u05ea\u05e9\u05d1 \u05dc\u05d9\u05de\u05d9\u05e0\u05d5"}, {"pk": 2895815, "verse": 20, "text": "\u05db \u05d5\u05ea\u05d0\u05de\u05e8 \u05e9\u05d0\u05dc\u05d4 \u05d0\u05d7\u05ea \u05e7\u05d8\u05e0\u05d4 \u05d0\u05e0\u05db\u05d9 \u05e9\u05d0\u05dc\u05ea \u05de\u05d0\u05ea\u05da--\u05d0\u05dc \u05ea\u05e9\u05d1 \u05d0\u05ea \u05e4\u05e0\u05d9 \u05d5\u05d9\u05d0\u05de\u05e8 \u05dc\u05d4 \u05d4\u05de\u05dc\u05da \u05e9\u05d0\u05dc\u05d9 \u05d0\u05de\u05d9 \u05db\u05d9 \u05dc\u05d0 \u05d0\u05e9\u05d9\u05d1 \u05d0\u05ea \u05e4\u05e0\u05d9\u05da"}, {"pk": 2895816, "verse": 21, "text": "\u05db\u05d0 \u05d5\u05ea\u05d0\u05de\u05e8 \u05d9\u05ea\u05df \u05d0\u05ea \u05d0\u05d1\u05d9\u05e9\u05d2 \u05d4\u05e9\u05e0\u05de\u05d9\u05ea \u05dc\u05d0\u05d3\u05e0\u05d9\u05d4\u05d5 \u05d0\u05d7\u05d9\u05da \u05dc\u05d0\u05e9\u05d4"}, {"pk": 2895817, "verse": 22, "text": "\u05db\u05d1 \u05d5\u05d9\u05e2\u05df \u05d4\u05de\u05dc\u05da \u05e9\u05dc\u05de\u05d4 \u05d5\u05d9\u05d0\u05de\u05e8 \u05dc\u05d0\u05de\u05d5 \u05d5\u05dc\u05de\u05d4 \u05d0\u05ea \u05e9\u05d0\u05dc\u05ea \u05d0\u05ea \u05d0\u05d1\u05d9\u05e9\u05d2 \u05d4\u05e9\u05e0\u05de\u05d9\u05ea \u05dc\u05d0\u05d3\u05e0\u05d9\u05d4\u05d5 \u05d5\u05e9\u05d0\u05dc\u05d9 \u05dc\u05d5 \u05d0\u05ea \u05d4\u05de\u05dc\u05d5\u05db\u05d4 \u05db\u05d9 \u05d4\u05d5\u05d0 \u05d0\u05d7\u05d9 \u05d4\u05d2\u05d3\u05d5\u05dc \u05de\u05de\u05e0\u05d9 \u05d5\u05dc\u05d5 \u05d5\u05dc\u05d0\u05d1\u05d9\u05ea\u05e8 \u05d4\u05db\u05d4\u05df \u05d5\u05dc\u05d9\u05d5\u05d0\u05d1 \u05d1\u05df \u05e6\u05e8\u05d5\u05d9\u05d4\u00a0 {\u05e4}"}, {"pk": 2895818, "verse": 23, "text": "\u05db\u05d2 \u05d5\u05d9\u05e9\u05d1\u05e2 \u05d4\u05de\u05dc\u05da \u05e9\u05dc\u05de\u05d4 \u05d1\u05d9\u05d4\u05d5\u05d4 \u05dc\u05d0\u05de\u05e8\u00a0 \u05db\u05d4 \u05d9\u05e2\u05e9\u05d4 \u05dc\u05d9 \u05d0\u05dc\u05d4\u05d9\u05dd \u05d5\u05db\u05d4 \u05d9\u05d5\u05e1\u05d9\u05e3 \u05db\u05d9 \u05d1\u05e0\u05e4\u05e9\u05d5 \u05d3\u05d1\u05e8 \u05d0\u05d3\u05e0\u05d9\u05d4\u05d5 \u05d0\u05ea \u05d4\u05d3\u05d1\u05e8 \u05d4\u05d6\u05d4"}, {"pk": 2895819, "verse": 24, "text": "\u05db\u05d3 \u05d5\u05e2\u05ea\u05d4 \u05d7\u05d9 \u05d9\u05d4\u05d5\u05d4 \u05d0\u05e9\u05e8 \u05d4\u05db\u05d9\u05e0\u05e0\u05d9 \u05d5\u05d9\u05d5\u05e9\u05d9\u05d1\u05d9\u05e0\u05d9 (\u05d5\u05d9\u05d5\u05e9\u05d9\u05d1\u05e0\u05d9) \u05e2\u05dc \u05db\u05e1\u05d0 \u05d3\u05d5\u05d3 \u05d0\u05d1\u05d9 \u05d5\u05d0\u05e9\u05e8 \u05e2\u05e9\u05d4 \u05dc\u05d9 \u05d1\u05d9\u05ea \u05db\u05d0\u05e9\u05e8 \u05d3\u05d1\u05e8\u00a0 \u05db\u05d9 \u05d4\u05d9\u05d5\u05dd \u05d9\u05d5\u05de\u05ea \u05d0\u05d3\u05e0\u05d9\u05d4\u05d5"}, {"pk": 2895820, "verse": 25, "text": "\u05db\u05d4 \u05d5\u05d9\u05e9\u05dc\u05d7 \u05d4\u05de\u05dc\u05da \u05e9\u05dc\u05de\u05d4 \u05d1\u05d9\u05d3 \u05d1\u05e0\u05d9\u05d4\u05d5 \u05d1\u05df \u05d9\u05d4\u05d5\u05d9\u05d3\u05e2 \u05d5\u05d9\u05e4\u05d2\u05e2 \u05d1\u05d5 \u05d5\u05d9\u05de\u05ea\u00a0 {\u05e1}"}, {"pk": 2895821, "verse": 26, "text": "\u05db\u05d5 \u05d5\u05dc\u05d0\u05d1\u05d9\u05ea\u05e8 \u05d4\u05db\u05d4\u05df \u05d0\u05de\u05e8 \u05d4\u05de\u05dc\u05da \u05e2\u05e0\u05ea\u05ea \u05dc\u05da \u05e2\u05dc \u05e9\u05d3\u05d9\u05da--\u05db\u05d9 \u05d0\u05d9\u05e9 \u05de\u05d5\u05ea \u05d0\u05ea\u05d4 \u05d5\u05d1\u05d9\u05d5\u05dd \u05d4\u05d6\u05d4 \u05dc\u05d0 \u05d0\u05de\u05d9\u05ea\u05da \u05db\u05d9 \u05e0\u05e9\u05d0\u05ea \u05d0\u05ea \u05d0\u05e8\u05d5\u05df \u05d0\u05d3\u05e0\u05d9 \u05d9\u05d4\u05d5\u05d4 \u05dc\u05e4\u05e0\u05d9 \u05d3\u05d5\u05d3 \u05d0\u05d1\u05d9 \u05d5\u05db\u05d9 \u05d4\u05ea\u05e2\u05e0\u05d9\u05ea \u05d1\u05db\u05dc \u05d0\u05e9\u05e8 \u05d4\u05ea\u05e2\u05e0\u05d4 \u05d0\u05d1\u05d9"}, {"pk": 2895822, "verse": 27, "text": "\u05db\u05d6 \u05d5\u05d9\u05d2\u05e8\u05e9 \u05e9\u05dc\u05de\u05d4 \u05d0\u05ea \u05d0\u05d1\u05d9\u05ea\u05e8 \u05de\u05d4\u05d9\u05d5\u05ea \u05db\u05d4\u05df \u05dc\u05d9\u05d4\u05d5\u05d4 \u05dc\u05de\u05dc\u05d0 \u05d0\u05ea \u05d3\u05d1\u05e8 \u05d9\u05d4\u05d5\u05d4 \u05d0\u05e9\u05e8 \u05d3\u05d1\u05e8 \u05e2\u05dc \u05d1\u05d9\u05ea \u05e2\u05dc\u05d9 \u05d1\u05e9\u05dc\u05d4\u00a0 {\u05e4}"}, {"pk": 2895823, "verse": 28, "text": "\u05db\u05d7 \u05d5\u05d4\u05e9\u05de\u05e2\u05d4 \u05d1\u05d0\u05d4 \u05e2\u05d3 \u05d9\u05d5\u05d0\u05d1 \u05db\u05d9 \u05d9\u05d5\u05d0\u05d1 \u05e0\u05d8\u05d4 \u05d0\u05d7\u05e8\u05d9 \u05d0\u05d3\u05e0\u05d9\u05d4 \u05d5\u05d0\u05d7\u05e8\u05d9 \u05d0\u05d1\u05e9\u05dc\u05d5\u05dd \u05dc\u05d0 \u05e0\u05d8\u05d4 \u05d5\u05d9\u05e0\u05e1 \u05d9\u05d5\u05d0\u05d1 \u05d0\u05dc \u05d0\u05d4\u05dc \u05d9\u05d4\u05d5\u05d4 \u05d5\u05d9\u05d7\u05d6\u05e7 \u05d1\u05e7\u05e8\u05e0\u05d5\u05ea \u05d4\u05de\u05d6\u05d1\u05d7"}, {"pk": 2895824, "verse": 29, "text": "\u05db\u05d8 \u05d5\u05d9\u05d2\u05d3 \u05dc\u05de\u05dc\u05da \u05e9\u05dc\u05de\u05d4 \u05db\u05d9 \u05e0\u05e1 \u05d9\u05d5\u05d0\u05d1 \u05d0\u05dc \u05d0\u05d4\u05dc \u05d9\u05d4\u05d5\u05d4 \u05d5\u05d4\u05e0\u05d4 \u05d0\u05e6\u05dc \u05d4\u05de\u05d6\u05d1\u05d7 \u05d5\u05d9\u05e9\u05dc\u05d7 \u05e9\u05dc\u05de\u05d4 \u05d0\u05ea \u05d1\u05e0\u05d9\u05d4\u05d5 \u05d1\u05df \u05d9\u05d4\u05d5\u05d9\u05d3\u05e2 \u05dc\u05d0\u05de\u05e8--\u05dc\u05da \u05e4\u05d2\u05e2 \u05d1\u05d5"}, {"pk": 2895825, "verse": 30, "text": "\u05dc \u05d5\u05d9\u05d1\u05d0 \u05d1\u05e0\u05d9\u05d4\u05d5 \u05d0\u05dc \u05d0\u05d4\u05dc \u05d9\u05d4\u05d5\u05d4 \u05d5\u05d9\u05d0\u05de\u05e8 \u05d0\u05dc\u05d9\u05d5 \u05db\u05d4 \u05d0\u05de\u05e8 \u05d4\u05de\u05dc\u05da \u05e6\u05d0 \u05d5\u05d9\u05d0\u05de\u05e8 \u05dc\u05d0 \u05db\u05d9 \u05e4\u05d4 \u05d0\u05de\u05d5\u05ea \u05d5\u05d9\u05e9\u05d1 \u05d1\u05e0\u05d9\u05d4\u05d5 \u05d0\u05ea \u05d4\u05de\u05dc\u05da \u05d3\u05d1\u05e8 \u05dc\u05d0\u05de\u05e8 \u05db\u05d4 \u05d3\u05d1\u05e8 \u05d9\u05d5\u05d0\u05d1 \u05d5\u05db\u05d4 \u05e2\u05e0\u05e0\u05d9"}, {"pk": 2895826, "verse": 31, "text": "\u05dc\u05d0 \u05d5\u05d9\u05d0\u05de\u05e8 \u05dc\u05d5 \u05d4\u05de\u05dc\u05da \u05e2\u05e9\u05d4 \u05db\u05d0\u05e9\u05e8 \u05d3\u05d1\u05e8 \u05d5\u05e4\u05d2\u05e2 \u05d1\u05d5 \u05d5\u05e7\u05d1\u05e8\u05ea\u05d5 \u05d5\u05d4\u05e1\u05d9\u05e8\u05ea \u05d3\u05de\u05d9 \u05d7\u05e0\u05dd \u05d0\u05e9\u05e8 \u05e9\u05e4\u05da \u05d9\u05d5\u05d0\u05d1 \u05de\u05e2\u05dc\u05d9 \u05d5\u05de\u05e2\u05dc \u05d1\u05d9\u05ea \u05d0\u05d1\u05d9"}, {"pk": 2895827, "verse": 32, "text": "\u05dc\u05d1 \u05d5\u05d4\u05e9\u05d9\u05d1 \u05d9\u05d4\u05d5\u05d4 \u05d0\u05ea \u05d3\u05de\u05d5 \u05e2\u05dc \u05e8\u05d0\u05e9\u05d5 \u05d0\u05e9\u05e8 \u05e4\u05d2\u05e2 \u05d1\u05e9\u05e0\u05d9 \u05d0\u05e0\u05e9\u05d9\u05dd \u05e6\u05d3\u05e7\u05d9\u05dd \u05d5\u05d8\u05d1\u05d9\u05dd \u05de\u05de\u05e0\u05d5 \u05d5\u05d9\u05d4\u05e8\u05d2\u05dd \u05d1\u05d7\u05e8\u05d1--\u05d5\u05d0\u05d1\u05d9 \u05d3\u05d5\u05d3 \u05dc\u05d0 \u05d9\u05d3\u05e2\u00a0 \u05d0\u05ea \u05d0\u05d1\u05e0\u05e8 \u05d1\u05df \u05e0\u05e8 \u05e9\u05e8 \u05e6\u05d1\u05d0 \u05d9\u05e9\u05e8\u05d0\u05dc \u05d5\u05d0\u05ea \u05e2\u05de\u05e9\u05d0 \u05d1\u05df \u05d9\u05ea\u05e8 \u05e9\u05e8 \u05e6\u05d1\u05d0 \u05d9\u05d4\u05d5\u05d3\u05d4"}, {"pk": 2895828, "verse": 33, "text": "\u05dc\u05d2 \u05d5\u05e9\u05d1\u05d5 \u05d3\u05de\u05d9\u05d4\u05dd \u05d1\u05e8\u05d0\u05e9 \u05d9\u05d5\u05d0\u05d1 \u05d5\u05d1\u05e8\u05d0\u05e9 \u05d6\u05e8\u05e2\u05d5 \u05dc\u05e2\u05dc\u05dd \u05d5\u05dc\u05d3\u05d5\u05d3 \u05d5\u05dc\u05d6\u05e8\u05e2\u05d5 \u05d5\u05dc\u05d1\u05d9\u05ea\u05d5 \u05d5\u05dc\u05db\u05e1\u05d0\u05d5 \u05d9\u05d4\u05d9\u05d4 \u05e9\u05dc\u05d5\u05dd \u05e2\u05d3 \u05e2\u05d5\u05dc\u05dd--\u05de\u05e2\u05dd \u05d9\u05d4\u05d5\u05d4"}, {"pk": 2895829, "verse": 34, "text": "\u05dc\u05d3 \u05d5\u05d9\u05e2\u05dc \u05d1\u05e0\u05d9\u05d4\u05d5 \u05d1\u05df \u05d9\u05d4\u05d5\u05d9\u05d3\u05e2 \u05d5\u05d9\u05e4\u05d2\u05e2 \u05d1\u05d5 \u05d5\u05d9\u05de\u05ea\u05d4\u05d5 \u05d5\u05d9\u05e7\u05d1\u05e8 \u05d1\u05d1\u05d9\u05ea\u05d5 \u05d1\u05de\u05d3\u05d1\u05e8"}, {"pk": 2895830, "verse": 35, "text": "\u05dc\u05d4 \u05d5\u05d9\u05ea\u05df \u05d4\u05de\u05dc\u05da \u05d0\u05ea \u05d1\u05e0\u05d9\u05d4\u05d5 \u05d1\u05df \u05d9\u05d4\u05d5\u05d9\u05d3\u05e2 \u05ea\u05d7\u05ea\u05d9\u05d5--\u05e2\u05dc \u05d4\u05e6\u05d1\u05d0 \u05d5\u05d0\u05ea \u05e6\u05d3\u05d5\u05e7 \u05d4\u05db\u05d4\u05df \u05e0\u05ea\u05df \u05d4\u05de\u05dc\u05da \u05ea\u05d7\u05ea \u05d0\u05d1\u05d9\u05ea\u05e8"}, {"pk": 2895831, "verse": 36, "text": "\u05dc\u05d5 \u05d5\u05d9\u05e9\u05dc\u05d7 \u05d4\u05de\u05dc\u05da \u05d5\u05d9\u05e7\u05e8\u05d0 \u05dc\u05e9\u05de\u05e2\u05d9 \u05d5\u05d9\u05d0\u05de\u05e8 \u05dc\u05d5 \u05d1\u05e0\u05d4 \u05dc\u05da \u05d1\u05d9\u05ea \u05d1\u05d9\u05e8\u05d5\u05e9\u05dc\u05dd \u05d5\u05d9\u05e9\u05d1\u05ea \u05e9\u05dd \u05d5\u05dc\u05d0 \u05ea\u05e6\u05d0 \u05de\u05e9\u05dd \u05d0\u05e0\u05d4 \u05d5\u05d0\u05e0\u05d4"}, {"pk": 2895832, "verse": 37, "text": "\u05dc\u05d6 \u05d5\u05d4\u05d9\u05d4 \u05d1\u05d9\u05d5\u05dd \u05e6\u05d0\u05ea\u05da \u05d5\u05e2\u05d1\u05e8\u05ea \u05d0\u05ea \u05e0\u05d7\u05dc \u05e7\u05d3\u05e8\u05d5\u05df--\u05d9\u05d3\u05e2 \u05ea\u05d3\u05e2 \u05db\u05d9 \u05de\u05d5\u05ea \u05ea\u05de\u05d5\u05ea\u00a0 \u05d3\u05de\u05da \u05d9\u05d4\u05d9\u05d4 \u05d1\u05e8\u05d0\u05e9\u05da"}, {"pk": 2895833, "verse": 38, "text": "\u05dc\u05d7 \u05d5\u05d9\u05d0\u05de\u05e8 \u05e9\u05de\u05e2\u05d9 \u05dc\u05de\u05dc\u05da \u05d8\u05d5\u05d1 \u05d4\u05d3\u05d1\u05e8 \u05db\u05d0\u05e9\u05e8 \u05d3\u05d1\u05e8 \u05d0\u05d3\u05e0\u05d9 \u05d4\u05de\u05dc\u05da \u05db\u05df \u05d9\u05e2\u05e9\u05d4 \u05e2\u05d1\u05d3\u05da \u05d5\u05d9\u05e9\u05d1 \u05e9\u05de\u05e2\u05d9 \u05d1\u05d9\u05e8\u05d5\u05e9\u05dc\u05dd \u05d9\u05de\u05d9\u05dd \u05e8\u05d1\u05d9\u05dd\u00a0 {\u05e1}"}, {"pk": 2895834, "verse": 39, "text": "\u05dc\u05d8 \u05d5\u05d9\u05d4\u05d9 \u05de\u05e7\u05e5 \u05e9\u05dc\u05e9 \u05e9\u05e0\u05d9\u05dd \u05d5\u05d9\u05d1\u05e8\u05d7\u05d5 \u05e9\u05e0\u05d9 \u05e2\u05d1\u05d3\u05d9\u05dd \u05dc\u05e9\u05de\u05e2\u05d9 \u05d0\u05dc \u05d0\u05db\u05d9\u05e9 \u05d1\u05df \u05de\u05e2\u05db\u05d4 \u05de\u05dc\u05da \u05d2\u05ea \u05d5\u05d9\u05d2\u05d9\u05d3\u05d5 \u05dc\u05e9\u05de\u05e2\u05d9 \u05dc\u05d0\u05de\u05e8 \u05d4\u05e0\u05d4 \u05e2\u05d1\u05d3\u05d9\u05da \u05d1\u05d2\u05ea"}, {"pk": 2895835, "verse": 40, "text": "\u05de \u05d5\u05d9\u05e7\u05dd \u05e9\u05de\u05e2\u05d9 \u05d5\u05d9\u05d7\u05d1\u05e9 \u05d0\u05ea \u05d7\u05de\u05e8\u05d5 \u05d5\u05d9\u05dc\u05da \u05d2\u05ea\u05d4 \u05d0\u05dc \u05d0\u05db\u05d9\u05e9 \u05dc\u05d1\u05e7\u05e9 \u05d0\u05ea \u05e2\u05d1\u05d3\u05d9\u05d5 \u05d5\u05d9\u05dc\u05da \u05e9\u05de\u05e2\u05d9 \u05d5\u05d9\u05d1\u05d0 \u05d0\u05ea \u05e2\u05d1\u05d3\u05d9\u05d5 \u05de\u05d2\u05ea\u00a0 {\u05e1}"}, {"pk": 2895836, "verse": 41, "text": "\u05de\u05d0 \u05d5\u05d9\u05d2\u05d3 \u05dc\u05e9\u05dc\u05de\u05d4\u00a0 \u05db\u05d9 \u05d4\u05dc\u05da \u05e9\u05de\u05e2\u05d9 \u05de\u05d9\u05e8\u05d5\u05e9\u05dc\u05dd \u05d2\u05ea \u05d5\u05d9\u05e9\u05d1"}, {"pk": 2895837, "verse": 42, "text": "\u05de\u05d1 \u05d5\u05d9\u05e9\u05dc\u05d7 \u05d4\u05de\u05dc\u05da \u05d5\u05d9\u05e7\u05e8\u05d0 \u05dc\u05e9\u05de\u05e2\u05d9 \u05d5\u05d9\u05d0\u05de\u05e8 \u05d0\u05dc\u05d9\u05d5 \u05d4\u05dc\u05d5\u05d0 \u05d4\u05e9\u05d1\u05e2\u05ea\u05d9\u05da \u05d1\u05d9\u05d4\u05d5\u05d4 \u05d5\u05d0\u05e2\u05d3 \u05d1\u05da \u05dc\u05d0\u05de\u05e8 \u05d1\u05d9\u05d5\u05dd \u05e6\u05d0\u05ea\u05da \u05d5\u05d4\u05dc\u05db\u05ea \u05d0\u05e0\u05d4 \u05d5\u05d0\u05e0\u05d4 \u05d9\u05d3\u05e2 \u05ea\u05d3\u05e2 \u05db\u05d9 \u05de\u05d5\u05ea \u05ea\u05de\u05d5\u05ea \u05d5\u05ea\u05d0\u05de\u05e8 \u05d0\u05dc\u05d9 \u05d8\u05d5\u05d1 \u05d4\u05d3\u05d1\u05e8 \u05e9\u05de\u05e2\u05ea\u05d9"}, {"pk": 2895838, "verse": 43, "text": "\u05de\u05d2 \u05d5\u05de\u05d3\u05d5\u05e2--\u05dc\u05d0 \u05e9\u05de\u05e8\u05ea \u05d0\u05ea \u05e9\u05d1\u05e2\u05ea \u05d9\u05d4\u05d5\u05d4 \u05d5\u05d0\u05ea \u05d4\u05de\u05e6\u05d5\u05d4 \u05d0\u05e9\u05e8 \u05e6\u05d5\u05d9\u05ea\u05d9 \u05e2\u05dc\u05d9\u05da"}, {"pk": 2895839, "verse": 44, "text": "\u05de\u05d3 \u05d5\u05d9\u05d0\u05de\u05e8 \u05d4\u05de\u05dc\u05da \u05d0\u05dc \u05e9\u05de\u05e2\u05d9 \u05d0\u05ea\u05d4 \u05d9\u05d3\u05e2\u05ea \u05d0\u05ea \u05db\u05dc \u05d4\u05e8\u05e2\u05d4 \u05d0\u05e9\u05e8 \u05d9\u05d3\u05e2 \u05dc\u05d1\u05d1\u05da \u05d0\u05e9\u05e8 \u05e2\u05e9\u05d9\u05ea \u05dc\u05d3\u05d5\u05d3 \u05d0\u05d1\u05d9 \u05d5\u05d4\u05e9\u05d9\u05d1 \u05d9\u05d4\u05d5\u05d4 \u05d0\u05ea \u05e8\u05e2\u05ea\u05da \u05d1\u05e8\u05d0\u05e9\u05da"}, {"pk": 2895840, "verse": 45, "text": "\u05de\u05d4 \u05d5\u05d4\u05de\u05dc\u05da \u05e9\u05dc\u05de\u05d4 \u05d1\u05e8\u05d5\u05da \u05d5\u05db\u05e1\u05d0 \u05d3\u05d5\u05d3 \u05d9\u05d4\u05d9\u05d4 \u05e0\u05db\u05d5\u05df \u05dc\u05e4\u05e0\u05d9 \u05d9\u05d4\u05d5\u05d4--\u05e2\u05d3 \u05e2\u05d5\u05dc\u05dd"}, {"pk": 2895841, "verse": 46, "text": "\u05de\u05d5 \u05d5\u05d9\u05e6\u05d5 \u05d4\u05de\u05dc\u05da \u05d0\u05ea \u05d1\u05e0\u05d9\u05d4\u05d5 \u05d1\u05df \u05d9\u05d4\u05d5\u05d9\u05d3\u05e2 \u05d5\u05d9\u05e6\u05d0 \u05d5\u05d9\u05e4\u05d2\u05e2 \u05d1\u05d5 \u05d5\u05d9\u05de\u05ea \u05d5\u05d4\u05de\u05de\u05dc\u05db\u05d4 \u05e0\u05db\u05d5\u05e0\u05d4 \u05d1\u05d9\u05d3 \u05e9\u05dc\u05de\u05d4"}]