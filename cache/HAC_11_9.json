[{"pk": 2896063, "verse": 1, "text": "\u05d0 \u05d5\u05d9\u05d4\u05d9 \u05db\u05db\u05dc\u05d5\u05ea \u05e9\u05dc\u05de\u05d4 \u05dc\u05d1\u05e0\u05d5\u05ea \u05d0\u05ea \u05d1\u05d9\u05ea \u05d9\u05d4\u05d5\u05d4 \u05d5\u05d0\u05ea \u05d1\u05d9\u05ea \u05d4\u05de\u05dc\u05da \u05d5\u05d0\u05ea \u05db\u05dc \u05d7\u05e9\u05e7 \u05e9\u05dc\u05de\u05d4 \u05d0\u05e9\u05e8 \u05d7\u05e4\u05e5 \u05dc\u05e2\u05e9\u05d5\u05ea\u00a0 {\u05e4}"}, {"pk": 2896064, "verse": 2, "text": "\u05d1 \u05d5\u05d9\u05e8\u05d0 \u05d9\u05d4\u05d5\u05d4 \u05d0\u05dc \u05e9\u05dc\u05de\u05d4 \u05e9\u05e0\u05d9\u05ea \u05db\u05d0\u05e9\u05e8 \u05e0\u05e8\u05d0\u05d4 \u05d0\u05dc\u05d9\u05d5 \u05d1\u05d2\u05d1\u05e2\u05d5\u05df"}, {"pk": 2896065, "verse": 3, "text": "\u05d2 \u05d5\u05d9\u05d0\u05de\u05e8 \u05d9\u05d4\u05d5\u05d4 \u05d0\u05dc\u05d9\u05d5 \u05e9\u05de\u05e2\u05ea\u05d9 \u05d0\u05ea \u05ea\u05e4\u05dc\u05ea\u05da \u05d5\u05d0\u05ea \u05ea\u05d7\u05e0\u05ea\u05da \u05d0\u05e9\u05e8 \u05d4\u05ea\u05d7\u05e0\u05e0\u05ea\u05d4 \u05dc\u05e4\u05e0\u05d9--\u05d4\u05e7\u05d3\u05e9\u05ea\u05d9 \u05d0\u05ea \u05d4\u05d1\u05d9\u05ea \u05d4\u05d6\u05d4 \u05d0\u05e9\u05e8 \u05d1\u05e0\u05ea\u05d4 \u05dc\u05e9\u05d5\u05dd \u05e9\u05de\u05d9 \u05e9\u05dd \u05e2\u05d3 \u05e2\u05d5\u05dc\u05dd \u05d5\u05d4\u05d9\u05d5 \u05e2\u05d9\u05e0\u05d9 \u05d5\u05dc\u05d1\u05d9 \u05e9\u05dd \u05db\u05dc \u05d4\u05d9\u05de\u05d9\u05dd"}, {"pk": 2896066, "verse": 4, "text": "\u05d3 \u05d5\u05d0\u05ea\u05d4 \u05d0\u05dd \u05ea\u05dc\u05da \u05dc\u05e4\u05e0\u05d9 \u05db\u05d0\u05e9\u05e8 \u05d4\u05dc\u05da \u05d3\u05d5\u05d3 \u05d0\u05d1\u05d9\u05da \u05d1\u05ea\u05dd \u05dc\u05d1\u05d1 \u05d5\u05d1\u05d9\u05e9\u05e8 \u05dc\u05e2\u05e9\u05d5\u05ea \u05db\u05db\u05dc \u05d0\u05e9\u05e8 \u05e6\u05d5\u05d9\u05ea\u05d9\u05da--\u05d7\u05e7\u05d9 \u05d5\u05de\u05e9\u05e4\u05d8\u05d9 \u05ea\u05e9\u05de\u05e8"}, {"pk": 2896067, "verse": 5, "text": "\u05d4 \u05d5\u05d4\u05e7\u05de\u05ea\u05d9 \u05d0\u05ea \u05db\u05e1\u05d0 \u05de\u05de\u05dc\u05db\u05ea\u05da \u05e2\u05dc \u05d9\u05e9\u05e8\u05d0\u05dc--\u05dc\u05e2\u05dc\u05dd\u00a0 \u05db\u05d0\u05e9\u05e8 \u05d3\u05d1\u05e8\u05ea\u05d9 \u05e2\u05dc \u05d3\u05d5\u05d3 \u05d0\u05d1\u05d9\u05da \u05dc\u05d0\u05de\u05e8 \u05dc\u05d0 \u05d9\u05db\u05e8\u05ea \u05dc\u05da \u05d0\u05d9\u05e9 \u05de\u05e2\u05dc \u05db\u05e1\u05d0 \u05d9\u05e9\u05e8\u05d0\u05dc"}, {"pk": 2896068, "verse": 6, "text": "\u05d5 \u05d0\u05dd \u05e9\u05d5\u05d1 \u05ea\u05e9\u05d1\u05d5\u05df \u05d0\u05ea\u05dd \u05d5\u05d1\u05e0\u05d9\u05db\u05dd \u05de\u05d0\u05d7\u05e8\u05d9 \u05d5\u05dc\u05d0 \u05ea\u05e9\u05de\u05e8\u05d5 \u05de\u05e6\u05d5\u05ea\u05d9 \u05d7\u05e7\u05ea\u05d9 \u05d0\u05e9\u05e8 \u05e0\u05ea\u05ea\u05d9 \u05dc\u05e4\u05e0\u05d9\u05db\u05dd \u05d5\u05d4\u05dc\u05db\u05ea\u05dd \u05d5\u05e2\u05d1\u05d3\u05ea\u05dd \u05d0\u05dc\u05d4\u05d9\u05dd \u05d0\u05d7\u05e8\u05d9\u05dd \u05d5\u05d4\u05e9\u05ea\u05d7\u05d5\u05d9\u05ea\u05dd \u05dc\u05d4\u05dd"}, {"pk": 2896069, "verse": 7, "text": "\u05d6 \u05d5\u05d4\u05db\u05e8\u05ea\u05d9 \u05d0\u05ea \u05d9\u05e9\u05e8\u05d0\u05dc \u05de\u05e2\u05dc \u05e4\u05e0\u05d9 \u05d4\u05d0\u05d3\u05de\u05d4 \u05d0\u05e9\u05e8 \u05e0\u05ea\u05ea\u05d9 \u05dc\u05d4\u05dd \u05d5\u05d0\u05ea \u05d4\u05d1\u05d9\u05ea \u05d0\u05e9\u05e8 \u05d4\u05e7\u05d3\u05e9\u05ea\u05d9 \u05dc\u05e9\u05de\u05d9 \u05d0\u05e9\u05dc\u05d7 \u05de\u05e2\u05dc \u05e4\u05e0\u05d9 \u05d5\u05d4\u05d9\u05d4 \u05d9\u05e9\u05e8\u05d0\u05dc \u05dc\u05de\u05e9\u05dc \u05d5\u05dc\u05e9\u05e0\u05d9\u05e0\u05d4 \u05d1\u05db\u05dc \u05d4\u05e2\u05de\u05d9\u05dd"}, {"pk": 2896070, "verse": 8, "text": "\u05d7 \u05d5\u05d4\u05d1\u05d9\u05ea \u05d4\u05d6\u05d4 \u05d9\u05d4\u05d9\u05d4 \u05e2\u05dc\u05d9\u05d5\u05df \u05db\u05dc \u05e2\u05d1\u05e8 \u05e2\u05dc\u05d9\u05d5 \u05d9\u05e9\u05dd \u05d5\u05e9\u05e8\u05e7 \u05d5\u05d0\u05de\u05e8\u05d5 \u05e2\u05dc \u05de\u05d4 \u05e2\u05e9\u05d4 \u05d9\u05d4\u05d5\u05d4 \u05db\u05db\u05d4 \u05dc\u05d0\u05e8\u05e5 \u05d4\u05d6\u05d0\u05ea \u05d5\u05dc\u05d1\u05d9\u05ea \u05d4\u05d6\u05d4"}, {"pk": 2896071, "verse": 9, "text": "\u05d8 \u05d5\u05d0\u05de\u05e8\u05d5 \u05e2\u05dc \u05d0\u05e9\u05e8 \u05e2\u05d6\u05d1\u05d5 \u05d0\u05ea \u05d9\u05d4\u05d5\u05d4 \u05d0\u05dc\u05d4\u05d9\u05d4\u05dd \u05d0\u05e9\u05e8 \u05d4\u05d5\u05e6\u05d9\u05d0 \u05d0\u05ea \u05d0\u05d1\u05ea\u05dd \u05de\u05d0\u05e8\u05e5 \u05de\u05e6\u05e8\u05d9\u05dd \u05d5\u05d9\u05d7\u05d6\u05e7\u05d5 \u05d1\u05d0\u05dc\u05d4\u05d9\u05dd \u05d0\u05d7\u05e8\u05d9\u05dd \u05d5\u05d9\u05e9\u05ea\u05d7\u05d5 (\u05d5\u05d9\u05e9\u05ea\u05d7\u05d5\u05d5) \u05dc\u05d4\u05dd \u05d5\u05d9\u05e2\u05d1\u05d3\u05dd \u05e2\u05dc \u05db\u05df \u05d4\u05d1\u05d9\u05d0 \u05d9\u05d4\u05d5\u05d4 \u05e2\u05dc\u05d9\u05d4\u05dd \u05d0\u05ea \u05db\u05dc \u05d4\u05e8\u05e2\u05d4 \u05d4\u05d6\u05d0\u05ea\u00a0 {\u05e4}"}, {"pk": 2896072, "verse": 10, "text": "\u05d9 \u05d5\u05d9\u05d4\u05d9 \u05de\u05e7\u05e6\u05d4 \u05e2\u05e9\u05e8\u05d9\u05dd \u05e9\u05e0\u05d4 \u05d0\u05e9\u05e8 \u05d1\u05e0\u05d4 \u05e9\u05dc\u05de\u05d4 \u05d0\u05ea \u05e9\u05e0\u05d9 \u05d4\u05d1\u05ea\u05d9\u05dd--\u05d0\u05ea \u05d1\u05d9\u05ea \u05d9\u05d4\u05d5\u05d4 \u05d5\u05d0\u05ea \u05d1\u05d9\u05ea \u05d4\u05de\u05dc\u05da"}, {"pk": 2896073, "verse": 11, "text": "\u05d9\u05d0 \u05d7\u05d9\u05e8\u05dd \u05de\u05dc\u05da \u05e6\u05e8 \u05e0\u05e9\u05d0 \u05d0\u05ea \u05e9\u05dc\u05de\u05d4 \u05d1\u05e2\u05e6\u05d9 \u05d0\u05e8\u05d6\u05d9\u05dd \u05d5\u05d1\u05e2\u05e6\u05d9 \u05d1\u05e8\u05d5\u05e9\u05d9\u05dd \u05d5\u05d1\u05d6\u05d4\u05d1--\u05dc\u05db\u05dc \u05d7\u05e4\u05e6\u05d5 \u05d0\u05d6 \u05d9\u05ea\u05df \u05d4\u05de\u05dc\u05da \u05e9\u05dc\u05de\u05d4 \u05dc\u05d7\u05d9\u05e8\u05dd \u05e2\u05e9\u05e8\u05d9\u05dd \u05e2\u05d9\u05e8 \u05d1\u05d0\u05e8\u05e5 \u05d4\u05d2\u05dc\u05d9\u05dc"}, {"pk": 2896074, "verse": 12, "text": "\u05d9\u05d1 \u05d5\u05d9\u05e6\u05d0 \u05d7\u05d9\u05e8\u05dd \u05de\u05e6\u05e8 \u05dc\u05e8\u05d0\u05d5\u05ea \u05d0\u05ea \u05d4\u05e2\u05e8\u05d9\u05dd \u05d0\u05e9\u05e8 \u05e0\u05ea\u05df \u05dc\u05d5 \u05e9\u05dc\u05de\u05d4 \u05d5\u05dc\u05d0 \u05d9\u05e9\u05e8\u05d5 \u05d1\u05e2\u05d9\u05e0\u05d9\u05d5"}, {"pk": 2896075, "verse": 13, "text": "\u05d9\u05d2 \u05d5\u05d9\u05d0\u05de\u05e8--\u05de\u05d4 \u05d4\u05e2\u05e8\u05d9\u05dd \u05d4\u05d0\u05dc\u05d4 \u05d0\u05e9\u05e8 \u05e0\u05ea\u05ea\u05d4 \u05dc\u05d9 \u05d0\u05d7\u05d9 \u05d5\u05d9\u05e7\u05e8\u05d0 \u05dc\u05d4\u05dd \u05d0\u05e8\u05e5 \u05db\u05d1\u05d5\u05dc \u05e2\u05d3 \u05d4\u05d9\u05d5\u05dd \u05d4\u05d6\u05d4\u00a0 {\u05e4}"}, {"pk": 2896076, "verse": 14, "text": "\u05d9\u05d3 \u05d5\u05d9\u05e9\u05dc\u05d7 \u05d7\u05d9\u05e8\u05dd \u05dc\u05de\u05dc\u05da \u05de\u05d0\u05d4 \u05d5\u05e2\u05e9\u05e8\u05d9\u05dd \u05db\u05db\u05e8 \u05d6\u05d4\u05d1"}, {"pk": 2896077, "verse": 15, "text": "\u05d8\u05d5 \u05d5\u05d6\u05d4 \u05d3\u05d1\u05e8 \u05d4\u05de\u05e1 \u05d0\u05e9\u05e8 \u05d4\u05e2\u05dc\u05d4 \u05d4\u05de\u05dc\u05da \u05e9\u05dc\u05de\u05d4 \u05dc\u05d1\u05e0\u05d5\u05ea \u05d0\u05ea \u05d1\u05d9\u05ea \u05d9\u05d4\u05d5\u05d4 \u05d5\u05d0\u05ea \u05d1\u05d9\u05ea\u05d5 \u05d5\u05d0\u05ea \u05d4\u05de\u05dc\u05d5\u05d0 \u05d5\u05d0\u05ea \u05d7\u05d5\u05de\u05ea \u05d9\u05e8\u05d5\u05e9\u05dc\u05dd \u05d5\u05d0\u05ea \u05d7\u05e6\u05e8 \u05d5\u05d0\u05ea \u05de\u05d2\u05d3\u05d5 \u05d5\u05d0\u05ea \u05d2\u05d6\u05e8"}, {"pk": 2896078, "verse": 16, "text": "\u05d8\u05d6 \u05e4\u05e8\u05e2\u05d4 \u05de\u05dc\u05da \u05de\u05e6\u05e8\u05d9\u05dd \u05e2\u05dc\u05d4 \u05d5\u05d9\u05dc\u05db\u05d3 \u05d0\u05ea \u05d2\u05d6\u05e8 \u05d5\u05d9\u05e9\u05e8\u05e4\u05d4 \u05d1\u05d0\u05e9 \u05d5\u05d0\u05ea \u05d4\u05db\u05e0\u05e2\u05e0\u05d9 \u05d4\u05d9\u05e9\u05d1 \u05d1\u05e2\u05d9\u05e8 \u05d4\u05e8\u05d2 \u05d5\u05d9\u05ea\u05e0\u05d4 \u05e9\u05dc\u05d7\u05d9\u05dd \u05dc\u05d1\u05ea\u05d5 \u05d0\u05e9\u05ea \u05e9\u05dc\u05de\u05d4"}, {"pk": 2896079, "verse": 17, "text": "\u05d9\u05d6 \u05d5\u05d9\u05d1\u05df \u05e9\u05dc\u05de\u05d4 \u05d0\u05ea \u05d2\u05d6\u05e8 \u05d5\u05d0\u05ea \u05d1\u05d9\u05ea \u05d7\u05e8\u05df \u05ea\u05d7\u05ea\u05d5\u05df"}, {"pk": 2896080, "verse": 18, "text": "\u05d9\u05d7 \u05d5\u05d0\u05ea \u05d1\u05e2\u05dc\u05ea \u05d5\u05d0\u05ea \u05ea\u05de\u05e8 (\u05ea\u05d3\u05de\u05e8) \u05d1\u05de\u05d3\u05d1\u05e8 \u05d1\u05d0\u05e8\u05e5"}, {"pk": 2896081, "verse": 19, "text": "\u05d9\u05d8 \u05d5\u05d0\u05ea \u05db\u05dc \u05e2\u05e8\u05d9 \u05d4\u05de\u05e1\u05db\u05e0\u05d5\u05ea \u05d0\u05e9\u05e8 \u05d4\u05d9\u05d5 \u05dc\u05e9\u05dc\u05de\u05d4 \u05d5\u05d0\u05ea \u05e2\u05e8\u05d9 \u05d4\u05e8\u05db\u05d1 \u05d5\u05d0\u05ea \u05e2\u05e8\u05d9 \u05d4\u05e4\u05e8\u05e9\u05d9\u05dd \u05d5\u05d0\u05ea \u05d7\u05e9\u05e7 \u05e9\u05dc\u05de\u05d4 \u05d0\u05e9\u05e8 \u05d7\u05e9\u05e7 \u05dc\u05d1\u05e0\u05d5\u05ea \u05d1\u05d9\u05e8\u05d5\u05e9\u05dc\u05dd \u05d5\u05d1\u05dc\u05d1\u05e0\u05d5\u05df \u05d5\u05d1\u05db\u05dc \u05d0\u05e8\u05e5 \u05de\u05de\u05e9\u05dc\u05ea\u05d5"}, {"pk": 2896082, "verse": 20, "text": "\u05db \u05db\u05dc \u05d4\u05e2\u05dd \u05d4\u05e0\u05d5\u05ea\u05e8 \u05de\u05df \u05d4\u05d0\u05de\u05e8\u05d9 \u05d4\u05d7\u05ea\u05d9 \u05d4\u05e4\u05e8\u05d6\u05d9 \u05d4\u05d7\u05d5\u05d9 \u05d5\u05d4\u05d9\u05d1\u05d5\u05e1\u05d9 \u05d0\u05e9\u05e8 \u05dc\u05d0 \u05de\u05d1\u05e0\u05d9 \u05d9\u05e9\u05e8\u05d0\u05dc \u05d4\u05de\u05d4"}, {"pk": 2896083, "verse": 21, "text": "\u05db\u05d0 \u05d1\u05e0\u05d9\u05d4\u05dd \u05d0\u05e9\u05e8 \u05e0\u05ea\u05e8\u05d5 \u05d0\u05d7\u05e8\u05d9\u05d4\u05dd \u05d1\u05d0\u05e8\u05e5 \u05d0\u05e9\u05e8 \u05dc\u05d0 \u05d9\u05db\u05dc\u05d5 \u05d1\u05e0\u05d9 \u05d9\u05e9\u05e8\u05d0\u05dc \u05dc\u05d4\u05d7\u05e8\u05d9\u05de\u05dd \u05d5\u05d9\u05e2\u05dc\u05dd \u05e9\u05dc\u05de\u05d4 \u05dc\u05de\u05e1 \u05e2\u05d1\u05d3 \u05e2\u05d3 \u05d4\u05d9\u05d5\u05dd \u05d4\u05d6\u05d4"}, {"pk": 2896084, "verse": 22, "text": "\u05db\u05d1 \u05d5\u05de\u05d1\u05e0\u05d9 \u05d9\u05e9\u05e8\u05d0\u05dc \u05dc\u05d0 \u05e0\u05ea\u05df \u05e9\u05dc\u05de\u05d4 \u05e2\u05d1\u05d3\u00a0 \u05db\u05d9 \u05d4\u05dd \u05d0\u05e0\u05e9\u05d9 \u05d4\u05de\u05dc\u05d7\u05de\u05d4 \u05d5\u05e2\u05d1\u05d3\u05d9\u05d5 \u05d5\u05e9\u05e8\u05d9\u05d5 \u05d5\u05e9\u05dc\u05d9\u05e9\u05d9\u05d5 \u05d5\u05e9\u05e8\u05d9 \u05e8\u05db\u05d1\u05d5 \u05d5\u05e4\u05e8\u05e9\u05d9\u05d5\u00a0 {\u05e1}"}, {"pk": 2896085, "verse": 23, "text": "\u05db\u05d2 \u05d0\u05dc\u05d4 \u05e9\u05e8\u05d9 \u05d4\u05e0\u05e6\u05d1\u05d9\u05dd \u05d0\u05e9\u05e8 \u05e2\u05dc \u05d4\u05de\u05dc\u05d0\u05db\u05d4 \u05dc\u05e9\u05dc\u05de\u05d4 \u05d7\u05de\u05e9\u05d9\u05dd \u05d5\u05d7\u05de\u05e9 \u05de\u05d0\u05d5\u05ea--\u05d4\u05e8\u05d3\u05d9\u05dd \u05d1\u05e2\u05dd \u05d4\u05e2\u05e9\u05d9\u05dd \u05d1\u05de\u05dc\u05d0\u05db\u05d4"}, {"pk": 2896086, "verse": 24, "text": "\u05db\u05d3 \u05d0\u05da \u05d1\u05ea \u05e4\u05e8\u05e2\u05d4 \u05e2\u05dc\u05ea\u05d4 \u05de\u05e2\u05d9\u05e8 \u05d3\u05d5\u05d3 \u05d0\u05dc \u05d1\u05d9\u05ea\u05d4 \u05d0\u05e9\u05e8 \u05d1\u05e0\u05d4 \u05dc\u05d4 \u05d0\u05d6 \u05d1\u05e0\u05d4 \u05d0\u05ea \u05d4\u05de\u05dc\u05d5\u05d0"}, {"pk": 2896087, "verse": 25, "text": "\u05db\u05d4 \u05d5\u05d4\u05e2\u05dc\u05d4 \u05e9\u05dc\u05de\u05d4 \u05e9\u05dc\u05e9 \u05e4\u05e2\u05de\u05d9\u05dd \u05d1\u05e9\u05e0\u05d4 \u05e2\u05dc\u05d5\u05ea \u05d5\u05e9\u05dc\u05de\u05d9\u05dd \u05e2\u05dc \u05d4\u05de\u05d6\u05d1\u05d7 \u05d0\u05e9\u05e8 \u05d1\u05e0\u05d4 \u05dc\u05d9\u05d4\u05d5\u05d4 \u05d5\u05d4\u05e7\u05d8\u05d9\u05e8 \u05d0\u05ea\u05d5 \u05d0\u05e9\u05e8 \u05dc\u05e4\u05e0\u05d9 \u05d9\u05d4\u05d5\u05d4 \u05d5\u05e9\u05dc\u05dd \u05d0\u05ea \u05d4\u05d1\u05d9\u05ea"}, {"pk": 2896088, "verse": 26, "text": "\u05db\u05d5 \u05d5\u05d0\u05e0\u05d9 \u05e2\u05e9\u05d4 \u05d4\u05de\u05dc\u05da \u05e9\u05dc\u05de\u05d4 \u05d1\u05e2\u05e6\u05d9\u05d5\u05df \u05d2\u05d1\u05e8 \u05d0\u05e9\u05e8 \u05d0\u05ea \u05d0\u05dc\u05d5\u05ea \u05e2\u05dc \u05e9\u05e4\u05ea \u05d9\u05dd \u05e1\u05d5\u05e3--\u05d1\u05d0\u05e8\u05e5 \u05d0\u05d3\u05d5\u05dd"}, {"pk": 2896089, "verse": 27, "text": "\u05db\u05d6 \u05d5\u05d9\u05e9\u05dc\u05d7 \u05d7\u05d9\u05e8\u05dd \u05d1\u05d0\u05e0\u05d9 \u05d0\u05ea \u05e2\u05d1\u05d3\u05d9\u05d5 \u05d0\u05e0\u05e9\u05d9 \u05d0\u05e0\u05d9\u05d5\u05ea \u05d9\u05d3\u05e2\u05d9 \u05d4\u05d9\u05dd--\u05e2\u05dd \u05e2\u05d1\u05d3\u05d9 \u05e9\u05dc\u05de\u05d4"}, {"pk": 2896090, "verse": 28, "text": "\u05db\u05d7 \u05d5\u05d9\u05d1\u05d0\u05d5 \u05d0\u05d5\u05e4\u05d9\u05e8\u05d4--\u05d5\u05d9\u05e7\u05d7\u05d5 \u05de\u05e9\u05dd \u05d6\u05d4\u05d1 \u05d0\u05e8\u05d1\u05e2 \u05de\u05d0\u05d5\u05ea \u05d5\u05e2\u05e9\u05e8\u05d9\u05dd \u05db\u05db\u05e8 \u05d5\u05d9\u05d1\u05d0\u05d5 \u05d0\u05dc \u05d4\u05de\u05dc\u05da \u05e9\u05dc\u05de\u05d4\u00a0 {\u05e4}"}]