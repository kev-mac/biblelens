[{"pk": 2896120, "verse": 1, "text": "\u05d0 \u05d5\u05d4\u05de\u05dc\u05da \u05e9\u05dc\u05de\u05d4 \u05d0\u05d4\u05d1 \u05e0\u05e9\u05d9\u05dd \u05e0\u05db\u05e8\u05d9\u05d5\u05ea \u05e8\u05d1\u05d5\u05ea--\u05d5\u05d0\u05ea \u05d1\u05ea \u05e4\u05e8\u05e2\u05d4\u00a0 \u05de\u05d5\u05d0\u05d1\u05d9\u05d5\u05ea \u05e2\u05de\u05e0\u05d9\u05d5\u05ea \u05d0\u05d3\u05de\u05d9\u05ea \u05e6\u05d3\u05e0\u05d9\u05ea \u05d7\u05ea\u05d9\u05ea"}, {"pk": 2896121, "verse": 2, "text": "\u05d1 \u05de\u05df \u05d4\u05d2\u05d5\u05d9\u05dd \u05d0\u05e9\u05e8 \u05d0\u05de\u05e8 \u05d9\u05d4\u05d5\u05d4 \u05d0\u05dc \u05d1\u05e0\u05d9 \u05d9\u05e9\u05e8\u05d0\u05dc \u05dc\u05d0 \u05ea\u05d1\u05d0\u05d5 \u05d1\u05d4\u05dd \u05d5\u05d4\u05dd \u05dc\u05d0 \u05d9\u05d1\u05d0\u05d5 \u05d1\u05db\u05dd \u05d0\u05db\u05df \u05d9\u05d8\u05d5 \u05d0\u05ea \u05dc\u05d1\u05d1\u05db\u05dd \u05d0\u05d7\u05e8\u05d9 \u05d0\u05dc\u05d4\u05d9\u05d4\u05dd--\u05d1\u05d4\u05dd \u05d3\u05d1\u05e7 \u05e9\u05dc\u05de\u05d4 \u05dc\u05d0\u05d4\u05d1\u05d4"}, {"pk": 2896122, "verse": 3, "text": "\u05d2 \u05d5\u05d9\u05d4\u05d9 \u05dc\u05d5 \u05e0\u05e9\u05d9\u05dd \u05e9\u05e8\u05d5\u05ea \u05e9\u05d1\u05e2 \u05de\u05d0\u05d5\u05ea \u05d5\u05e4\u05dc\u05d2\u05e9\u05d9\u05dd \u05e9\u05dc\u05e9 \u05de\u05d0\u05d5\u05ea \u05d5\u05d9\u05d8\u05d5 \u05e0\u05e9\u05d9\u05d5 \u05d0\u05ea \u05dc\u05d1\u05d5"}, {"pk": 2896123, "verse": 4, "text": "\u05d3 \u05d5\u05d9\u05d4\u05d9 \u05dc\u05e2\u05ea \u05d6\u05e7\u05e0\u05ea \u05e9\u05dc\u05de\u05d4 \u05e0\u05e9\u05d9\u05d5 \u05d4\u05d8\u05d5 \u05d0\u05ea \u05dc\u05d1\u05d1\u05d5 \u05d0\u05d7\u05e8\u05d9 \u05d0\u05dc\u05d4\u05d9\u05dd \u05d0\u05d7\u05e8\u05d9\u05dd \u05d5\u05dc\u05d0 \u05d4\u05d9\u05d4 \u05dc\u05d1\u05d1\u05d5 \u05e9\u05dc\u05dd \u05e2\u05dd \u05d9\u05d4\u05d5\u05d4 \u05d0\u05dc\u05d4\u05d9\u05d5 \u05db\u05dc\u05d1\u05d1 \u05d3\u05d5\u05d9\u05d3 \u05d0\u05d1\u05d9\u05d5"}, {"pk": 2896124, "verse": 5, "text": "\u05d4 \u05d5\u05d9\u05dc\u05da \u05e9\u05dc\u05de\u05d4--\u05d0\u05d7\u05e8\u05d9 \u05e2\u05e9\u05ea\u05e8\u05ea \u05d0\u05dc\u05d4\u05d9 \u05e6\u05d3\u05e0\u05d9\u05dd \u05d5\u05d0\u05d7\u05e8\u05d9 \u05de\u05dc\u05db\u05dd \u05e9\u05e7\u05e5 \u05e2\u05de\u05e0\u05d9\u05dd"}, {"pk": 2896125, "verse": 6, "text": "\u05d5 \u05d5\u05d9\u05e2\u05e9 \u05e9\u05dc\u05de\u05d4 \u05d4\u05e8\u05e2 \u05d1\u05e2\u05d9\u05e0\u05d9 \u05d9\u05d4\u05d5\u05d4 \u05d5\u05dc\u05d0 \u05de\u05dc\u05d0 \u05d0\u05d7\u05e8\u05d9 \u05d9\u05d4\u05d5\u05d4 \u05db\u05d3\u05d5\u05d3 \u05d0\u05d1\u05d9\u05d5\u00a0 {\u05e1}"}, {"pk": 2896126, "verse": 7, "text": "\u05d6 \u05d0\u05d6 \u05d9\u05d1\u05e0\u05d4 \u05e9\u05dc\u05de\u05d4 \u05d1\u05de\u05d4 \u05dc\u05db\u05de\u05d5\u05e9 \u05e9\u05e7\u05e5 \u05de\u05d5\u05d0\u05d1 \u05d1\u05d4\u05e8 \u05d0\u05e9\u05e8 \u05e2\u05dc \u05e4\u05e0\u05d9 \u05d9\u05e8\u05d5\u05e9\u05dc\u05dd \u05d5\u05dc\u05de\u05dc\u05da \u05e9\u05e7\u05e5 \u05d1\u05e0\u05d9 \u05e2\u05de\u05d5\u05df"}, {"pk": 2896127, "verse": 8, "text": "\u05d7 \u05d5\u05db\u05df \u05e2\u05e9\u05d4 \u05dc\u05db\u05dc \u05e0\u05e9\u05d9\u05d5 \u05d4\u05e0\u05db\u05e8\u05d9\u05d5\u05ea \u05de\u05e7\u05d8\u05d9\u05e8\u05d5\u05ea \u05d5\u05de\u05d6\u05d1\u05d7\u05d5\u05ea \u05dc\u05d0\u05dc\u05d4\u05d9\u05d4\u05df"}, {"pk": 2896128, "verse": 9, "text": "\u05d8 \u05d5\u05d9\u05ea\u05d0\u05e0\u05e3 \u05d9\u05d4\u05d5\u05d4 \u05d1\u05e9\u05dc\u05de\u05d4\u00a0 \u05db\u05d9 \u05e0\u05d8\u05d4 \u05dc\u05d1\u05d1\u05d5 \u05de\u05e2\u05dd \u05d9\u05d4\u05d5\u05d4 \u05d0\u05dc\u05d4\u05d9 \u05d9\u05e9\u05e8\u05d0\u05dc \u05d4\u05e0\u05e8\u05d0\u05d4 \u05d0\u05dc\u05d9\u05d5 \u05e4\u05e2\u05de\u05d9\u05dd"}, {"pk": 2896129, "verse": 10, "text": "\u05d9 \u05d5\u05e6\u05d5\u05d4 \u05d0\u05dc\u05d9\u05d5 \u05e2\u05dc \u05d4\u05d3\u05d1\u05e8 \u05d4\u05d6\u05d4 \u05dc\u05d1\u05dc\u05ea\u05d9 \u05dc\u05db\u05ea \u05d0\u05d7\u05e8\u05d9 \u05d0\u05dc\u05d4\u05d9\u05dd \u05d0\u05d7\u05e8\u05d9\u05dd \u05d5\u05dc\u05d0 \u05e9\u05de\u05e8 \u05d0\u05ea \u05d0\u05e9\u05e8 \u05e6\u05d5\u05d4 \u05d9\u05d4\u05d5\u05d4\u00a0 {\u05e4}"}, {"pk": 2896130, "verse": 11, "text": "\u05d9\u05d0 \u05d5\u05d9\u05d0\u05de\u05e8 \u05d9\u05d4\u05d5\u05d4 \u05dc\u05e9\u05dc\u05de\u05d4 \u05d9\u05e2\u05df \u05d0\u05e9\u05e8 \u05d4\u05d9\u05ea\u05d4 \u05d6\u05d0\u05ea \u05e2\u05de\u05da \u05d5\u05dc\u05d0 \u05e9\u05de\u05e8\u05ea \u05d1\u05e8\u05d9\u05ea\u05d9 \u05d5\u05d7\u05e7\u05ea\u05d9 \u05d0\u05e9\u05e8 \u05e6\u05d5\u05d9\u05ea\u05d9 \u05e2\u05dc\u05d9\u05da--\u05e7\u05e8\u05e2 \u05d0\u05e7\u05e8\u05e2 \u05d0\u05ea \u05d4\u05de\u05de\u05dc\u05db\u05d4 \u05de\u05e2\u05dc\u05d9\u05da \u05d5\u05e0\u05ea\u05ea\u05d9\u05d4 \u05dc\u05e2\u05d1\u05d3\u05da"}, {"pk": 2896131, "verse": 12, "text": "\u05d9\u05d1 \u05d0\u05da \u05d1\u05d9\u05de\u05d9\u05da \u05dc\u05d0 \u05d0\u05e2\u05e9\u05e0\u05d4 \u05dc\u05de\u05e2\u05df \u05d3\u05d5\u05d3 \u05d0\u05d1\u05d9\u05da\u00a0 \u05de\u05d9\u05d3 \u05d1\u05e0\u05da \u05d0\u05e7\u05e8\u05e2\u05e0\u05d4"}, {"pk": 2896132, "verse": 13, "text": "\u05d9\u05d2 \u05e8\u05e7 \u05d0\u05ea \u05db\u05dc \u05d4\u05de\u05de\u05dc\u05db\u05d4 \u05dc\u05d0 \u05d0\u05e7\u05e8\u05e2 \u05e9\u05d1\u05d8 \u05d0\u05d7\u05d3 \u05d0\u05ea\u05df \u05dc\u05d1\u05e0\u05da\u00a0 \u05dc\u05de\u05e2\u05df \u05d3\u05d5\u05d3 \u05e2\u05d1\u05d3\u05d9 \u05d5\u05dc\u05de\u05e2\u05df \u05d9\u05e8\u05d5\u05e9\u05dc\u05dd \u05d0\u05e9\u05e8 \u05d1\u05d7\u05e8\u05ea\u05d9\u00a0 {\u05e1}"}, {"pk": 2896133, "verse": 14, "text": "\u05d9\u05d3 \u05d5\u05d9\u05e7\u05dd \u05d9\u05d4\u05d5\u05d4 \u05e9\u05d8\u05df \u05dc\u05e9\u05dc\u05de\u05d4 \u05d0\u05ea \u05d4\u05d3\u05d3 \u05d4\u05d0\u05d3\u05de\u05d9\u00a0 \u05de\u05d6\u05e8\u05e2 \u05d4\u05de\u05dc\u05da \u05d4\u05d5\u05d0 \u05d1\u05d0\u05d3\u05d5\u05dd"}, {"pk": 2896134, "verse": 15, "text": "\u05d8\u05d5 \u05d5\u05d9\u05d4\u05d9 \u05d1\u05d4\u05d9\u05d5\u05ea \u05d3\u05d5\u05d3 \u05d0\u05ea \u05d0\u05d3\u05d5\u05dd \u05d1\u05e2\u05dc\u05d5\u05ea \u05d9\u05d5\u05d0\u05d1 \u05e9\u05e8 \u05d4\u05e6\u05d1\u05d0 \u05dc\u05e7\u05d1\u05e8 \u05d0\u05ea \u05d4\u05d7\u05dc\u05dc\u05d9\u05dd \u05d5\u05d9\u05da \u05db\u05dc \u05d6\u05db\u05e8 \u05d1\u05d0\u05d3\u05d5\u05dd"}, {"pk": 2896135, "verse": 16, "text": "\u05d8\u05d6 \u05db\u05d9 \u05e9\u05e9\u05ea \u05d7\u05d3\u05e9\u05d9\u05dd \u05d9\u05e9\u05d1 \u05e9\u05dd \u05d9\u05d5\u05d0\u05d1 \u05d5\u05db\u05dc \u05d9\u05e9\u05e8\u05d0\u05dc \u05e2\u05d3 \u05d4\u05db\u05e8\u05d9\u05ea \u05db\u05dc \u05d6\u05db\u05e8 \u05d1\u05d0\u05d3\u05d5\u05dd"}, {"pk": 2896136, "verse": 17, "text": "\u05d9\u05d6 \u05d5\u05d9\u05d1\u05e8\u05d7 \u05d0\u05d3\u05d3 \u05d4\u05d5\u05d0 \u05d5\u05d0\u05e0\u05e9\u05d9\u05dd \u05d0\u05d3\u05de\u05d9\u05d9\u05dd \u05de\u05e2\u05d1\u05d3\u05d9 \u05d0\u05d1\u05d9\u05d5 \u05d0\u05ea\u05d5--\u05dc\u05d1\u05d5\u05d0 \u05de\u05e6\u05e8\u05d9\u05dd \u05d5\u05d4\u05d3\u05d3 \u05e0\u05e2\u05e8 \u05e7\u05d8\u05df"}, {"pk": 2896137, "verse": 18, "text": "\u05d9\u05d7 \u05d5\u05d9\u05e7\u05de\u05d5 \u05de\u05de\u05d3\u05d9\u05df \u05d5\u05d9\u05d1\u05d0\u05d5 \u05e4\u05d0\u05e8\u05df \u05d5\u05d9\u05e7\u05d7\u05d5 \u05d0\u05e0\u05e9\u05d9\u05dd \u05e2\u05de\u05dd \u05de\u05e4\u05d0\u05e8\u05df \u05d5\u05d9\u05d1\u05d0\u05d5 \u05de\u05e6\u05e8\u05d9\u05dd \u05d0\u05dc \u05e4\u05e8\u05e2\u05d4 \u05de\u05dc\u05da \u05de\u05e6\u05e8\u05d9\u05dd \u05d5\u05d9\u05ea\u05df \u05dc\u05d5 \u05d1\u05d9\u05ea \u05d5\u05dc\u05d7\u05dd \u05d0\u05de\u05e8 \u05dc\u05d5 \u05d5\u05d0\u05e8\u05e5 \u05e0\u05ea\u05df \u05dc\u05d5"}, {"pk": 2896138, "verse": 19, "text": "\u05d9\u05d8 \u05d5\u05d9\u05de\u05e6\u05d0 \u05d4\u05d3\u05d3 \u05d7\u05df \u05d1\u05e2\u05d9\u05e0\u05d9 \u05e4\u05e8\u05e2\u05d4 \u05de\u05d0\u05d3 \u05d5\u05d9\u05ea\u05df \u05dc\u05d5 \u05d0\u05e9\u05d4 \u05d0\u05ea \u05d0\u05d7\u05d5\u05ea \u05d0\u05e9\u05ea\u05d5 \u05d0\u05d7\u05d5\u05ea \u05ea\u05d7\u05e4\u05e0\u05d9\u05e1 \u05d4\u05d2\u05d1\u05d9\u05e8\u05d4"}, {"pk": 2896139, "verse": 20, "text": "\u05db \u05d5\u05ea\u05dc\u05d3 \u05dc\u05d5 \u05d0\u05d7\u05d5\u05ea \u05ea\u05d7\u05e4\u05e0\u05d9\u05e1 \u05d0\u05ea \u05d2\u05e0\u05d1\u05ea \u05d1\u05e0\u05d5 \u05d5\u05ea\u05d2\u05de\u05dc\u05d4\u05d5 \u05ea\u05d7\u05e4\u05e0\u05e1 \u05d1\u05ea\u05d5\u05da \u05d1\u05d9\u05ea \u05e4\u05e8\u05e2\u05d4 \u05d5\u05d9\u05d4\u05d9 \u05d2\u05e0\u05d1\u05ea \u05d1\u05d9\u05ea \u05e4\u05e8\u05e2\u05d4 \u05d1\u05ea\u05d5\u05da \u05d1\u05e0\u05d9 \u05e4\u05e8\u05e2\u05d4"}, {"pk": 2896140, "verse": 21, "text": "\u05db\u05d0 \u05d5\u05d4\u05d3\u05d3 \u05e9\u05de\u05e2 \u05d1\u05de\u05e6\u05e8\u05d9\u05dd \u05db\u05d9 \u05e9\u05db\u05d1 \u05d3\u05d5\u05d3 \u05e2\u05dd \u05d0\u05d1\u05ea\u05d9\u05d5 \u05d5\u05db\u05d9 \u05de\u05ea \u05d9\u05d5\u05d0\u05d1 \u05e9\u05e8 \u05d4\u05e6\u05d1\u05d0 \u05d5\u05d9\u05d0\u05de\u05e8 \u05d4\u05d3\u05d3 \u05d0\u05dc \u05e4\u05e8\u05e2\u05d4 \u05e9\u05dc\u05d7\u05e0\u05d9 \u05d5\u05d0\u05dc\u05da \u05d0\u05dc \u05d0\u05e8\u05e6\u05d9"}, {"pk": 2896141, "verse": 22, "text": "\u05db\u05d1 \u05d5\u05d9\u05d0\u05de\u05e8 \u05dc\u05d5 \u05e4\u05e8\u05e2\u05d4 \u05db\u05d9 \u05de\u05d4 \u05d0\u05ea\u05d4 \u05d7\u05e1\u05e8 \u05e2\u05de\u05d9 \u05d5\u05d4\u05e0\u05da \u05de\u05d1\u05e7\u05e9 \u05dc\u05dc\u05db\u05ea \u05d0\u05dc \u05d0\u05e8\u05e6\u05da \u05d5\u05d9\u05d0\u05de\u05e8 \u05dc\u05d0 \u05db\u05d9 \u05e9\u05dc\u05d7 \u05ea\u05e9\u05dc\u05d7\u05e0\u05d9"}, {"pk": 2896142, "verse": 23, "text": "\u05db\u05d2 \u05d5\u05d9\u05e7\u05dd \u05d0\u05dc\u05d4\u05d9\u05dd \u05dc\u05d5 \u05e9\u05d8\u05df \u05d0\u05ea \u05e8\u05d6\u05d5\u05df \u05d1\u05df \u05d0\u05dc\u05d9\u05d3\u05e2\u00a0 \u05d0\u05e9\u05e8 \u05d1\u05e8\u05d7 \u05de\u05d0\u05ea \u05d4\u05d3\u05d3\u05e2\u05d6\u05e8 \u05de\u05dc\u05da \u05e6\u05d5\u05d1\u05d4--\u05d0\u05d3\u05e0\u05d9\u05d5"}, {"pk": 2896143, "verse": 24, "text": "\u05db\u05d3 \u05d5\u05d9\u05e7\u05d1\u05e5 \u05e2\u05dc\u05d9\u05d5 \u05d0\u05e0\u05e9\u05d9\u05dd \u05d5\u05d9\u05d4\u05d9 \u05e9\u05e8 \u05d2\u05d3\u05d5\u05d3 \u05d1\u05d4\u05e8\u05d2 \u05d3\u05d5\u05d3 \u05d0\u05ea\u05dd \u05d5\u05d9\u05dc\u05db\u05d5 \u05d3\u05de\u05e9\u05e7 \u05d5\u05d9\u05e9\u05d1\u05d5 \u05d1\u05d4 \u05d5\u05d9\u05de\u05dc\u05db\u05d5 \u05d1\u05d3\u05de\u05e9\u05e7"}, {"pk": 2896144, "verse": 25, "text": "\u05db\u05d4 \u05d5\u05d9\u05d4\u05d9 \u05e9\u05d8\u05df \u05dc\u05d9\u05e9\u05e8\u05d0\u05dc \u05db\u05dc \u05d9\u05de\u05d9 \u05e9\u05dc\u05de\u05d4 \u05d5\u05d0\u05ea \u05d4\u05e8\u05e2\u05d4 \u05d0\u05e9\u05e8 \u05d4\u05d3\u05d3 \u05d5\u05d9\u05e7\u05e5 \u05d1\u05d9\u05e9\u05e8\u05d0\u05dc \u05d5\u05d9\u05de\u05dc\u05da \u05e2\u05dc \u05d0\u05e8\u05dd\u00a0 {\u05e4}"}, {"pk": 2896145, "verse": 26, "text": "\u05db\u05d5 \u05d5\u05d9\u05e8\u05d1\u05e2\u05dd \u05d1\u05df \u05e0\u05d1\u05d8 \u05d0\u05e4\u05e8\u05ea\u05d9 \u05de\u05df \u05d4\u05e6\u05e8\u05d3\u05d4 \u05d5\u05e9\u05dd \u05d0\u05de\u05d5 \u05e6\u05e8\u05d5\u05e2\u05d4 \u05d0\u05e9\u05d4 \u05d0\u05dc\u05de\u05e0\u05d4 \u05e2\u05d1\u05d3 \u05dc\u05e9\u05dc\u05de\u05d4 \u05d5\u05d9\u05e8\u05dd \u05d9\u05d3 \u05d1\u05de\u05dc\u05da"}, {"pk": 2896146, "verse": 27, "text": "\u05db\u05d6 \u05d5\u05d6\u05d4 \u05d4\u05d3\u05d1\u05e8 \u05d0\u05e9\u05e8 \u05d4\u05e8\u05d9\u05dd \u05d9\u05d3 \u05d1\u05de\u05dc\u05da\u00a0 \u05e9\u05dc\u05de\u05d4 \u05d1\u05e0\u05d4 \u05d0\u05ea \u05d4\u05de\u05dc\u05d5\u05d0--\u05e1\u05d2\u05e8 \u05d0\u05ea \u05e4\u05e8\u05e5 \u05e2\u05d9\u05e8 \u05d3\u05d5\u05d3 \u05d0\u05d1\u05d9\u05d5"}, {"pk": 2896147, "verse": 28, "text": "\u05db\u05d7 \u05d5\u05d4\u05d0\u05d9\u05e9 \u05d9\u05e8\u05d1\u05e2\u05dd \u05d2\u05d1\u05d5\u05e8 \u05d7\u05d9\u05dc \u05d5\u05d9\u05e8\u05d0 \u05e9\u05dc\u05de\u05d4 \u05d0\u05ea \u05d4\u05e0\u05e2\u05e8 \u05db\u05d9 \u05e2\u05e9\u05d4 \u05de\u05dc\u05d0\u05db\u05d4 \u05d4\u05d5\u05d0 \u05d5\u05d9\u05e4\u05e7\u05d3 \u05d0\u05ea\u05d5 \u05dc\u05db\u05dc \u05e1\u05d1\u05dc \u05d1\u05d9\u05ea \u05d9\u05d5\u05e1\u05e3\u00a0 {\u05e1}"}, {"pk": 2896148, "verse": 29, "text": "\u05db\u05d8 \u05d5\u05d9\u05d4\u05d9 \u05d1\u05e2\u05ea \u05d4\u05d4\u05d9\u05d0 \u05d5\u05d9\u05e8\u05d1\u05e2\u05dd \u05d9\u05e6\u05d0 \u05de\u05d9\u05e8\u05d5\u05e9\u05dc\u05dd \u05d5\u05d9\u05de\u05e6\u05d0 \u05d0\u05ea\u05d5 \u05d0\u05d7\u05d9\u05d4 \u05d4\u05e9\u05d9\u05dc\u05e0\u05d9 \u05d4\u05e0\u05d1\u05d9\u05d0 \u05d1\u05d3\u05e8\u05da \u05d5\u05d4\u05d5\u05d0 \u05de\u05ea\u05db\u05e1\u05d4 \u05d1\u05e9\u05dc\u05de\u05d4 \u05d7\u05d3\u05e9\u05d4 \u05d5\u05e9\u05e0\u05d9\u05d4\u05dd \u05dc\u05d1\u05d3\u05dd \u05d1\u05e9\u05d3\u05d4"}, {"pk": 2896149, "verse": 30, "text": "\u05dc \u05d5\u05d9\u05ea\u05e4\u05e9 \u05d0\u05d7\u05d9\u05d4 \u05d1\u05e9\u05dc\u05de\u05d4 \u05d4\u05d7\u05d3\u05e9\u05d4 \u05d0\u05e9\u05e8 \u05e2\u05dc\u05d9\u05d5 \u05d5\u05d9\u05e7\u05e8\u05e2\u05d4--\u05e9\u05e0\u05d9\u05dd \u05e2\u05e9\u05e8 \u05e7\u05e8\u05e2\u05d9\u05dd"}, {"pk": 2896150, "verse": 31, "text": "\u05dc\u05d0 \u05d5\u05d9\u05d0\u05de\u05e8 \u05dc\u05d9\u05e8\u05d1\u05e2\u05dd \u05e7\u05d7 \u05dc\u05da \u05e2\u05e9\u05e8\u05d4 \u05e7\u05e8\u05e2\u05d9\u05dd\u00a0 \u05db\u05d9 \u05db\u05d4 \u05d0\u05de\u05e8 \u05d9\u05d4\u05d5\u05d4 \u05d0\u05dc\u05d4\u05d9 \u05d9\u05e9\u05e8\u05d0\u05dc \u05d4\u05e0\u05e0\u05d9 \u05e7\u05e8\u05e2 \u05d0\u05ea \u05d4\u05de\u05de\u05dc\u05db\u05d4 \u05de\u05d9\u05d3 \u05e9\u05dc\u05de\u05d4 \u05d5\u05e0\u05ea\u05ea\u05d9 \u05dc\u05da \u05d0\u05ea \u05e2\u05e9\u05e8\u05d4 \u05d4\u05e9\u05d1\u05d8\u05d9\u05dd"}, {"pk": 2896151, "verse": 32, "text": "\u05dc\u05d1 \u05d5\u05d4\u05e9\u05d1\u05d8 \u05d4\u05d0\u05d7\u05d3 \u05d9\u05d4\u05d9\u05d4 \u05dc\u05d5--\u05dc\u05de\u05e2\u05df \u05e2\u05d1\u05d3\u05d9 \u05d3\u05d5\u05d3 \u05d5\u05dc\u05de\u05e2\u05df \u05d9\u05e8\u05d5\u05e9\u05dc\u05dd \u05d4\u05e2\u05d9\u05e8 \u05d0\u05e9\u05e8 \u05d1\u05d7\u05e8\u05ea\u05d9 \u05d1\u05d4 \u05de\u05db\u05dc \u05e9\u05d1\u05d8\u05d9 \u05d9\u05e9\u05e8\u05d0\u05dc"}, {"pk": 2896152, "verse": 33, "text": "\u05dc\u05d2 \u05d9\u05e2\u05df \u05d0\u05e9\u05e8 \u05e2\u05d6\u05d1\u05d5\u05e0\u05d9 \u05d5\u05d9\u05e9\u05ea\u05d7\u05d5\u05d5 \u05dc\u05e2\u05e9\u05ea\u05e8\u05ea \u05d0\u05dc\u05d4\u05d9 \u05e6\u05d3\u05e0\u05d9\u05df \u05dc\u05db\u05de\u05d5\u05e9 \u05d0\u05dc\u05d4\u05d9 \u05de\u05d5\u05d0\u05d1 \u05d5\u05dc\u05de\u05dc\u05db\u05dd \u05d0\u05dc\u05d4\u05d9 \u05d1\u05e0\u05d9 \u05e2\u05de\u05d5\u05df \u05d5\u05dc\u05d0 \u05d4\u05dc\u05db\u05d5 \u05d1\u05d3\u05e8\u05db\u05d9 \u05dc\u05e2\u05e9\u05d5\u05ea \u05d4\u05d9\u05e9\u05e8 \u05d1\u05e2\u05d9\u05e0\u05d9 \u05d5\u05d7\u05e7\u05ea\u05d9 \u05d5\u05de\u05e9\u05e4\u05d8\u05d9--\u05db\u05d3\u05d5\u05d3 \u05d0\u05d1\u05d9\u05d5"}, {"pk": 2896153, "verse": 34, "text": "\u05dc\u05d3 \u05d5\u05dc\u05d0 \u05d0\u05e7\u05d7 \u05d0\u05ea \u05db\u05dc \u05d4\u05de\u05de\u05dc\u05db\u05d4 \u05de\u05d9\u05d3\u05d5\u00a0 \u05db\u05d9 \u05e0\u05e9\u05d9\u05d0 \u05d0\u05e9\u05ea\u05e0\u05d5 \u05db\u05dc \u05d9\u05de\u05d9 \u05d7\u05d9\u05d9\u05d5 \u05dc\u05de\u05e2\u05df \u05d3\u05d5\u05d3 \u05e2\u05d1\u05d3\u05d9 \u05d0\u05e9\u05e8 \u05d1\u05d7\u05e8\u05ea\u05d9 \u05d0\u05ea\u05d5 \u05d0\u05e9\u05e8 \u05e9\u05de\u05e8 \u05de\u05e6\u05d5\u05ea\u05d9 \u05d5\u05d7\u05e7\u05ea\u05d9"}, {"pk": 2896154, "verse": 35, "text": "\u05dc\u05d4 \u05d5\u05dc\u05e7\u05d7\u05ea\u05d9 \u05d4\u05de\u05dc\u05d5\u05db\u05d4 \u05de\u05d9\u05d3 \u05d1\u05e0\u05d5 \u05d5\u05e0\u05ea\u05ea\u05d9\u05d4 \u05dc\u05da \u05d0\u05ea \u05e2\u05e9\u05e8\u05ea \u05d4\u05e9\u05d1\u05d8\u05d9\u05dd"}, {"pk": 2896155, "verse": 36, "text": "\u05dc\u05d5 \u05d5\u05dc\u05d1\u05e0\u05d5 \u05d0\u05ea\u05df \u05e9\u05d1\u05d8 \u05d0\u05d7\u05d3--\u05dc\u05de\u05e2\u05df \u05d4\u05d9\u05d5\u05ea \u05e0\u05d9\u05e8 \u05dc\u05d3\u05d5\u05d9\u05d3 \u05e2\u05d1\u05d3\u05d9 \u05db\u05dc \u05d4\u05d9\u05de\u05d9\u05dd \u05dc\u05e4\u05e0\u05d9 \u05d1\u05d9\u05e8\u05d5\u05e9\u05dc\u05dd \u05d4\u05e2\u05d9\u05e8 \u05d0\u05e9\u05e8 \u05d1\u05d7\u05e8\u05ea\u05d9 \u05dc\u05d9 \u05dc\u05e9\u05d5\u05dd \u05e9\u05de\u05d9 \u05e9\u05dd"}, {"pk": 2896156, "verse": 37, "text": "\u05dc\u05d6 \u05d5\u05d0\u05ea\u05da \u05d0\u05e7\u05d7--\u05d5\u05de\u05dc\u05db\u05ea \u05d1\u05db\u05dc \u05d0\u05e9\u05e8 \u05ea\u05d0\u05d5\u05d4 \u05e0\u05e4\u05e9\u05da \u05d5\u05d4\u05d9\u05d9\u05ea \u05de\u05dc\u05da \u05e2\u05dc \u05d9\u05e9\u05e8\u05d0\u05dc"}, {"pk": 2896157, "verse": 38, "text": "\u05dc\u05d7 \u05d5\u05d4\u05d9\u05d4 \u05d0\u05dd \u05ea\u05e9\u05de\u05e2 \u05d0\u05ea \u05db\u05dc \u05d0\u05e9\u05e8 \u05d0\u05e6\u05d5\u05da \u05d5\u05d4\u05dc\u05db\u05ea \u05d1\u05d3\u05e8\u05db\u05d9 \u05d5\u05e2\u05e9\u05d9\u05ea \u05d4\u05d9\u05e9\u05e8 \u05d1\u05e2\u05d9\u05e0\u05d9 \u05dc\u05e9\u05de\u05d5\u05e8 \u05d7\u05e7\u05d5\u05ea\u05d9 \u05d5\u05de\u05e6\u05d5\u05ea\u05d9 \u05db\u05d0\u05e9\u05e8 \u05e2\u05e9\u05d4 \u05d3\u05d5\u05d3 \u05e2\u05d1\u05d3\u05d9--\u05d5\u05d4\u05d9\u05d9\u05ea\u05d9 \u05e2\u05de\u05da \u05d5\u05d1\u05e0\u05d9\u05ea\u05d9 \u05dc\u05da \u05d1\u05d9\u05ea \u05e0\u05d0\u05de\u05df \u05db\u05d0\u05e9\u05e8 \u05d1\u05e0\u05d9\u05ea\u05d9 \u05dc\u05d3\u05d5\u05d3 \u05d5\u05e0\u05ea\u05ea\u05d9 \u05dc\u05da \u05d0\u05ea \u05d9\u05e9\u05e8\u05d0\u05dc"}, {"pk": 2896158, "verse": 39, "text": "\u05dc\u05d8 \u05d5\u05d0\u05e2\u05e0\u05d4 \u05d0\u05ea \u05d6\u05e8\u05e2 \u05d3\u05d5\u05d3 \u05dc\u05de\u05e2\u05df \u05d6\u05d0\u05ea--\u05d0\u05da \u05dc\u05d0 \u05db\u05dc \u05d4\u05d9\u05de\u05d9\u05dd\u00a0 {\u05e1}"}, {"pk": 2896159, "verse": 40, "text": "\u05de \u05d5\u05d9\u05d1\u05e7\u05e9 \u05e9\u05dc\u05de\u05d4 \u05dc\u05d4\u05de\u05d9\u05ea \u05d0\u05ea \u05d9\u05e8\u05d1\u05e2\u05dd \u05d5\u05d9\u05e7\u05dd \u05d9\u05e8\u05d1\u05e2\u05dd \u05d5\u05d9\u05d1\u05e8\u05d7 \u05de\u05e6\u05e8\u05d9\u05dd \u05d0\u05dc \u05e9\u05d9\u05e9\u05e7 \u05de\u05dc\u05da \u05de\u05e6\u05e8\u05d9\u05dd \u05d5\u05d9\u05d4\u05d9 \u05d1\u05de\u05e6\u05e8\u05d9\u05dd \u05e2\u05d3 \u05de\u05d5\u05ea \u05e9\u05dc\u05de\u05d4\u00a0 {\u05e1}"}, {"pk": 2896160, "verse": 41, "text": "\u05de\u05d0 \u05d5\u05d9\u05ea\u05e8 \u05d3\u05d1\u05e8\u05d9 \u05e9\u05dc\u05de\u05d4 \u05d5\u05db\u05dc \u05d0\u05e9\u05e8 \u05e2\u05e9\u05d4 \u05d5\u05d7\u05db\u05de\u05ea\u05d5--\u05d4\u05dc\u05d5\u05d0 \u05d4\u05dd \u05db\u05ea\u05d1\u05d9\u05dd \u05e2\u05dc \u05e1\u05e4\u05e8 \u05d3\u05d1\u05e8\u05d9 \u05e9\u05dc\u05de\u05d4"}, {"pk": 2896161, "verse": 42, "text": "\u05de\u05d1 \u05d5\u05d4\u05d9\u05de\u05d9\u05dd \u05d0\u05e9\u05e8 \u05de\u05dc\u05da \u05e9\u05dc\u05de\u05d4 \u05d1\u05d9\u05e8\u05d5\u05e9\u05dc\u05dd \u05e2\u05dc \u05db\u05dc \u05d9\u05e9\u05e8\u05d0\u05dc--\u05d0\u05e8\u05d1\u05e2\u05d9\u05dd \u05e9\u05e0\u05d4"}, {"pk": 2896162, "verse": 43, "text": "\u05de\u05d2 \u05d5\u05d9\u05e9\u05db\u05d1 \u05e9\u05dc\u05de\u05d4 \u05e2\u05dd \u05d0\u05d1\u05ea\u05d9\u05d5 \u05d5\u05d9\u05e7\u05d1\u05e8 \u05d1\u05e2\u05d9\u05e8 \u05d3\u05d5\u05d3 \u05d0\u05d1\u05d9\u05d5 \u05d5\u05d9\u05de\u05dc\u05da \u05e8\u05d7\u05d1\u05e2\u05dd \u05d1\u05e0\u05d5 \u05ea\u05d7\u05ea\u05d9\u05d5\u00a0 {\u05e1}"}]