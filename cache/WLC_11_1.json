[{"pk": 8722, "verse": 1, "text": "\u05d5\u05b0\u05d4\u05b7\u05de\u05bc\u05b6\u05a4\u05dc\u05b6\u05da\u05b0 \u05d3\u05bc\u05b8\u05d5\u05b4\u05d3\u0599 \u05d6\u05b8\u05e7\u05b5\u0594\u05df \u05d1\u05bc\u05b8\u0596\u05d0 \u05d1\u05bc\u05b7\u05d9\u05bc\u05b8\u05de\u05b4\u0591\u05d9\u05dd \u05d5\u05b7\u05d9\u05b0\u05db\u05b7\u05e1\u05bc\u05bb\u0599\u05d4\u05d5\u05bc\u0599 \u05d1\u05bc\u05b7\u05d1\u05bc\u05b0\u05d2\u05b8\u05d3\u05b4\u0594\u05d9\u05dd \u05d5\u05b0\u05dc\u05b9\u05a5\u05d0 \u05d9\u05b4\u05d7\u05b7\u0596\u05dd \u05dc\u05b9\u05bd\u05d5\u05c3"}, {"pk": 8723, "verse": 2, "text": "\u05d5\u05b7\u05d9\u05bc\u05b9\u05a7\u05d0\u05de\u05b0\u05e8\u05d5\u05bc \u05dc\u05b9\u05a3\u05d5 \u05e2\u05b2\u05d1\u05b8\u05d3\u05b8\u0597\u05d9\u05d5 \u05d9\u05b0\u05d1\u05b7\u05e7\u05b0\u05e9\u05c1\u059e\u05d5\u05bc \u05dc\u05b7\u05d0\u05d3\u05b9\u05e0\u05b4\u05a4\u05d9 \u05d4\u05b7\u05de\u05bc\u05b6\u0599\u05dc\u05b6\u05da\u05b0\u0599 \u05e0\u05b7\u05e2\u05b2\u05e8\u05b8\u05a3\u05d4 \u05d1\u05b0\u05ea\u05d5\u05bc\u05dc\u05b8\u0594\u05d4 \u05d5\u05b0\u05e2\u05b8\u05bd\u05de\u05b0\u05d3\u05b8\u05d4\u0599 \u05dc\u05b4\u05e4\u05b0\u05e0\u05b5\u05a3\u05d9 \u05d4\u05b7\u05de\u05bc\u05b6\u0594\u05dc\u05b6\u05da\u05b0 \u05d5\u05bc\u05ea\u05b0\u05d4\u05b4\u05d9\u05be\u05dc\u05b9\u0596\u05d5 \u05e1\u05b9\u05db\u05b6\u0591\u05e0\u05b6\u05ea \u05d5\u05b0\u05e9\u05c1\u05b8\u05db\u05b0\u05d1\u05b8\u05a3\u05d4 \u05d1\u05b0\u05d7\u05b5\u05d9\u05e7\u05b6\u0594\u05da\u05b8 \u05d5\u05b0\u05d7\u05b7\u0596\u05dd \u05dc\u05b7\u05d0\u05d3\u05b9\u05e0\u05b4\u05a5\u05d9 \u05d4\u05b7\u05de\u05bc\u05b6\u05bd\u05dc\u05b6\u05da\u05b0\u05c3"}, {"pk": 8724, "verse": 3, "text": "\u05d5\u05b7\u05d9\u05b0\u05d1\u05b7\u05e7\u05b0\u05e9\u05c1\u05d5\u05bc\u0599 \u05e0\u05b7\u05e2\u05b2\u05e8\u05b8\u05a3\u05d4 \u05d9\u05b8\u05e4\u05b8\u0594\u05d4 \u05d1\u05bc\u05b0\u05db\u05b9\u0596\u05dc \u05d2\u05bc\u05b0\u05d1\u05a3\u05d5\u05bc\u05dc \u05d9\u05b4\u05e9\u05c2\u05b0\u05e8\u05b8\u05d0\u05b5\u0591\u05dc \u05d5\u05b7\u05bd\u05d9\u05bc\u05b4\u05de\u05b0\u05e6\u05b0\u05d0\u0597\u05d5\u05bc \u05d0\u05b6\u05ea\u05be\u05d0\u05b2\u05d1\u05b4\u05d9\u05e9\u05c1\u05b7\u05d2\u0599 \u05d4\u05b7\u05e9\u05c1\u05bc\u05a3\u05d5\u05bc\u05e0\u05b7\u05de\u05bc\u05b4\u0594\u05d9\u05ea \u05d5\u05b7\u05d9\u05bc\u05b8\u05d1\u05b4\u05a5\u05d0\u05d5\u05bc \u05d0\u05b9\u05ea\u05b8\u0596\u05d4\u05bc \u05dc\u05b7\u05de\u05bc\u05b6\u05bd\u05dc\u05b6\u05da\u05b0\u05c3"}, {"pk": 8725, "verse": 4, "text": "\u05d5\u05b0\u05d4\u05b7\u05bd\u05e0\u05bc\u05b7\u05e2\u05b2\u05e8\u05b8\u0596\u05d4 \u05d9\u05b8\u05e4\u05b8\u05a3\u05d4 \u05e2\u05b7\u05d3\u05be\u05de\u05b0\u05d0\u05b9\u0591\u05d3 \u05d5\u05b7\u05ea\u05bc\u05b0\u05d4\u05b4\u05a8\u05d9 \u05dc\u05b7\u05de\u05bc\u05b6\u05a4\u05dc\u05b6\u05da\u05b0 \u05e1\u05b9\u05db\u05b6\u0599\u05e0\u05b6\u05ea\u0599 \u05d5\u05b7\u05ea\u05bc\u05b0\u05e9\u05c1\u05b8\u05a3\u05e8\u05b0\u05ea\u05b5\u0594\u05d4\u05d5\u05bc \u05d5\u05b0\u05d4\u05b7\u05de\u05bc\u05b6\u0596\u05dc\u05b6\u05da\u05b0 \u05dc\u05b9\u05a5\u05d0 \u05d9\u05b0\u05d3\u05b8\u05e2\u05b8\u05bd\u05d4\u05bc\u05c3"}, {"pk": 8726, "verse": 5, "text": "\u05d5\u05b7\u05d0\u05b2\u05d3\u05b9\u05e0\u05b4\u05d9\u05bc\u05b8\u05a7\u05d4 \u05d1\u05b6\u05df\u05be\u05d7\u05b7\u05d2\u05bc\u05b4\u059b\u05d9\u05ea \u05de\u05b4\u05ea\u05b0\u05e0\u05b7\u05e9\u05c2\u05bc\u05b5\u05a5\u05d0 \u05dc\u05b5\u05d0\u05de\u05b9\u0596\u05e8 \u05d0\u05b2\u05e0\u05b4\u05a3\u05d9 \u05d0\u05b6\u05de\u05b0\u05dc\u05b9\u0591\u05da\u05b0 \u05d5\u05b7\u05d9\u05bc\u05b7\u05a3\u05e2\u05b7\u05e9\u05c2 \u05dc\u05b9\u0597\u05d5 \u05e8\u05b6\u059a\u05db\u05b6\u05d1 \u05d5\u05bc\u05e4\u05b8\u05a3\u05e8\u05b8\u05e9\u05c1\u05b4\u0594\u05d9\u05dd \u05d5\u05b7\u05d7\u05b2\u05de\u05b4\u05e9\u05c1\u05bc\u05b4\u05a5\u05d9\u05dd \u05d0\u05b4\u0596\u05d9\u05e9\u05c1 \u05e8\u05b8\u05e6\u05b4\u05a5\u05d9\u05dd \u05dc\u05b0\u05e4\u05b8\u05e0\u05b8\u05bd\u05d9\u05d5\u05c3"}, {"pk": 8727, "verse": 6, "text": "\u05d5\u05b0\u05dc\u05b9\u05bd\u05d0\u05be\u05e2\u05b2\u05e6\u05b8\u05d1\u05b9\u05a8\u05d5 \u05d0\u05b8\u05d1\u05b4\u05a4\u05d9\u05d5 \u05de\u05b4\u05d9\u05bc\u05b8\u05de\u05b8\u05d9\u05d5\u0599 \u05dc\u05b5\u05d0\u05de\u05b9\u0594\u05e8 \u05de\u05b7\u05d3\u05bc\u0596\u05d5\u05bc\u05e2\u05b7 \u05db\u05bc\u05b8\u05a3\u05db\u05b8\u05d4 \u05e2\u05b8\u05e9\u05c2\u05b4\u0591\u05d9\u05ea\u05b8 \u05d5\u05b0\u05d2\u05b7\u05dd\u05be\u05d4\u05a4\u05d5\u05bc\u05d0 \u05d8\u05b9\u05bd\u05d5\u05d1\u05be\u05ea\u05bc\u05b9\u0599\u05d0\u05b7\u05e8\u0599 \u05de\u05b0\u05d0\u05b9\u0594\u05d3 \u05d5\u05b0\u05d0\u05b9\u05ea\u05b9\u05a5\u05d5 \u05d9\u05b8\u05dc\u05b0\u05d3\u05b8\u0596\u05d4 \u05d0\u05b7\u05d7\u05b2\u05e8\u05b5\u05a5\u05d9 \u05d0\u05b7\u05d1\u05b0\u05e9\u05c1\u05b8\u05dc\u05b9\u05bd\u05d5\u05dd\u05c3"}, {"pk": 8728, "verse": 7, "text": "\u05d5\u05b7\u05d9\u05bc\u05b4\u05d4\u05b0\u05d9\u05a3\u05d5\u05bc \u05d3\u05b0\u05d1\u05b8\u05e8\u05b8\u0594\u05d9\u05d5 \u05e2\u05b4\u059a\u05dd \u05d9\u05b9\u05d5\u05d0\u05b8\u05a3\u05d1 \u05d1\u05bc\u05b6\u05df\u05be\u05e6\u05b0\u05e8\u05d5\u05bc\u05d9\u05b8\u0594\u05d4 \u05d5\u05b0\u05e2\u05b4\u0596\u05dd \u05d0\u05b6\u05d1\u05b0\u05d9\u05b8\u05ea\u05b8\u05a3\u05e8 \u05d4\u05b7\u05db\u05bc\u05b9\u05d4\u05b5\u0591\u05df \u05d5\u05b7\u05bd\u05d9\u05bc\u05b7\u05e2\u05b0\u05d6\u05b0\u05e8\u0594\u05d5\u05bc \u05d0\u05b7\u05d7\u05b2\u05e8\u05b5\u0596\u05d9 \u05d0\u05b2\u05d3\u05b9\u05e0\u05b4\u05d9\u05bc\u05b8\u05bd\u05d4\u05c3"}, {"pk": 8729, "verse": 8, "text": "\u05d5\u05b0\u05e6\u05b8\u05d3\u05b9\u05a3\u05d5\u05e7 \u05d4\u05b7\u05a0\u05db\u05bc\u05b9\u05d4\u05b5\u05df \u05d5\u05bc\u05d1\u05b0\u05e0\u05b8\u05d9\u05b8\u05a8\u05d4\u05d5\u05bc \u05d1\u05b6\u05df\u05be\u05d9\u05b0\u05d4\u05b9\u05d5\u05d9\u05b8\u05d3\u05b8\u059c\u05e2 \u05d5\u05b0\u05e0\u05b8\u05ea\u05b8\u05a4\u05df \u05d4\u05b7\u05e0\u05bc\u05b8\u05d1\u05b4\u05d9\u05d0\u0599 \u05d5\u05b0\u05e9\u05c1\u05b4\u05de\u05b0\u05e2\u05b4\u05a3\u05d9 \u05d5\u05b0\u05e8\u05b5\u05e2\u05b4\u0594\u05d9 \u05d5\u05b0\u05d4\u05b7\u05d2\u05bc\u05b4\u05d1\u05bc\u05b9\u05d5\u05e8\u05b4\u0596\u05d9\u05dd \u05d0\u05b2\u05e9\u05c1\u05b6\u05a3\u05e8 \u05dc\u05b0\u05d3\u05b8\u05d5\u05b4\u0591\u05d3 \u05dc\u05b9\u05a5\u05d0 \u05d4\u05b8\u05d9\u0596\u05d5\u05bc \u05e2\u05b4\u05dd\u05be\u05d0\u05b2\u05d3\u05b9\u05e0\u05b4\u05d9\u05bc\u05b8\u05bd\u05d4\u05d5\u05bc\u05c3"}, {"pk": 8730, "verse": 9, "text": "\u05d5\u05b7\u05d9\u05bc\u05b4\u05d6\u05b0\u05d1\u05bc\u05b7\u05a3\u05d7 \u05d0\u05b2\u05d3\u05b9\u05e0\u05b4\u05d9\u05bc\u05b8\u0597\u05d4\u05d5\u05bc \u05e6\u05b9\u05a4\u05d0\u05df \u05d5\u05bc\u05d1\u05b8\u05e7\u05b8\u05e8\u0599 \u05d5\u05bc\u05de\u05b0\u05e8\u05b4\u0594\u05d9\u05d0 \u05e2\u05b4\u059a\u05dd \u05d0\u05b6\u05a3\u05d1\u05b6\u05df \u05d4\u05b7\u05d6\u05bc\u05b9\u05d7\u05b6\u0594\u05dc\u05b6\u05ea \u05d0\u05b2\u05e9\u05c1\u05b6\u05e8\u05be\u05d0\u05b5\u0596\u05e6\u05b6\u05dc \u05e2\u05b5\u05a3\u05d9\u05df \u05e8\u05b9\u05d2\u05b5\u0591\u05dc \u05d5\u05b7\u05d9\u05bc\u05b4\u05e7\u05b0\u05e8\u05b8\u0597\u05d0 \u05d0\u05b6\u05ea\u05be\u05db\u05bc\u05b8\u05dc\u05be\u05d0\u05b6\u05d7\u05b8\u05d9\u05d5\u0599 \u05d1\u05bc\u05b0\u05e0\u05b5\u05a3\u05d9 \u05d4\u05b7\u05de\u05bc\u05b6\u0594\u05dc\u05b6\u05da\u05b0 \u05d5\u05bc\u05dc\u05b0\u05db\u05b8\u05dc\u05be\u05d0\u05b7\u05e0\u05b0\u05e9\u05c1\u05b5\u05a5\u05d9 \u05d9\u05b0\u05d4\u05d5\u05bc\u05d3\u05b8\u0596\u05d4 \u05e2\u05b7\u05d1\u05b0\u05d3\u05b5\u05a5\u05d9 \u05d4\u05b7\u05de\u05bc\u05b6\u05bd\u05dc\u05b6\u05da\u05b0\u05c3"}, {"pk": 8731, "verse": 10, "text": "\u05d5\u05b0\u05bd\u05d0\u05b6\u05ea\u05be\u05e0\u05b8\u05ea\u05b8\u05df\u05a9 \u05d4\u05b7\u05e0\u05bc\u05b8\u05d1\u05b4\u05a8\u05d9\u05d0 \u05d5\u05bc\u05d1\u05b0\u05e0\u05b8\u05d9\u05b8\u059c\u05d4\u05d5\u05bc \u05d5\u05b0\u05d0\u05b6\u05ea\u05be\u05d4\u05b7\u05d2\u05bc\u05b4\u05d1\u05bc\u05b9\u05d5\u05e8\u05b4\u059b\u05d9\u05dd \u05d5\u05b0\u05d0\u05b6\u05ea\u05be\u05e9\u05c1\u05b0\u05dc\u05b9\u05de\u05b9\u05a5\u05d4 \u05d0\u05b8\u05d7\u05b4\u0596\u05d9\u05d5 \u05dc\u05b9\u05a5\u05d0 \u05e7\u05b8\u05e8\u05b8\u05bd\u05d0\u05c3"}, {"pk": 8732, "verse": 11, "text": "\u05d5\u05b7\u05d9\u05bc\u05b9\u05a3\u05d0\u05de\u05b6\u05e8 \u05e0\u05b8\u05ea\u05b8\u0597\u05df \u05d0\u05b6\u05dc\u05be\u05d1\u05bc\u05b7\u05ea\u05be\u05e9\u05c1\u05b6\u05a4\u05d1\u05b7\u05e2 \u05d0\u05b5\u05dd\u05be\u05e9\u05c1\u05b0\u05dc\u05b9\u05de\u05b9\u05d4\u0599 \u05dc\u05b5\u05d0\u05de\u05b9\u0594\u05e8 \u05d4\u05b2\u05dc\u05b9\u05a3\u05d5\u05d0 \u05e9\u05c1\u05b8\u05de\u05b7\u0594\u05e2\u05b7\u05ea\u05bc\u05b0 \u05db\u05bc\u05b4\u05a5\u05d9 \u05de\u05b8\u05dc\u05b7\u0596\u05da\u05b0 \u05d0\u05b2\u05d3\u05b9\u05e0\u05b4\u05d9\u05bc\u05b8\u05a3\u05d4\u05d5\u05bc \u05d1\u05b6\u05df\u05be\u05d7\u05b7\u05d2\u05bc\u05b4\u0591\u05d9\u05ea \u05d5\u05b7\u05d0\u05b2\u05d3\u05b9\u05e0\u05b5\u05a5\u05d9\u05e0\u05d5\u05bc \u05d3\u05b8\u05d5\u05b4\u0596\u05d3 \u05dc\u05b9\u05a5\u05d0 \u05d9\u05b8\u05d3\u05b8\u05bd\u05e2\u05c3"}, {"pk": 8733, "verse": 12, "text": "\u05d5\u05b0\u05e2\u05b7\u05ea\u05bc\u05b8\u0595\u05d4 \u05dc\u05b0\u05db\u05b4\u059b\u05d9 \u05d0\u05b4\u05d9\u05e2\u05b8\u05e6\u05b5\u05a5\u05da\u05b0 \u05e0\u05b8\u0596\u05d0 \u05e2\u05b5\u05e6\u05b8\u0591\u05d4 \u05d5\u05bc\u05de\u05b7\u05dc\u05bc\u05b0\u05d8\u05b4\u05d9\u0599 \u05d0\u05b6\u05ea\u05be\u05e0\u05b7\u05e4\u05b0\u05e9\u05c1\u05b5\u0594\u05da\u05b0 \u05d5\u05b0\u05d0\u05b6\u05ea\u05be\u05e0\u05b6\u05a5\u05e4\u05b6\u05e9\u05c1 \u05d1\u05bc\u05b0\u05e0\u05b5\u0596\u05da\u05b0 \u05e9\u05c1\u05b0\u05dc\u05b9\u05de\u05b9\u05bd\u05d4\u05c3"}, {"pk": 8734, "verse": 13, "text": "\u05dc\u05b0\u05db\u05b4\u059e\u05d9 \u05d5\u05bc\u05d1\u05b9\u05a3\u05d0\u05b4\u05d9 \u05c0 \u05d0\u05b6\u05dc\u05be\u05d4\u05b7\u05de\u05bc\u05b6\u05a3\u05dc\u05b6\u05da\u05b0 \u05d3\u05bc\u05b8\u05d5\u05b4\u0597\u05d3 \u05d5\u05b0\u05d0\u05b8\u05de\u05b7\u05a4\u05e8\u05b0\u05ea\u05bc\u05b0 \u05d0\u05b5\u05dc\u05b8\u05d9\u05d5\u0599 \u05d4\u05b2\u05dc\u05b9\u05bd\u05d0\u05be\u05d0\u05b7\u05ea\u05bc\u05b8\u059e\u05d4 \u05d0\u05b2\u05d3\u05b9\u05e0\u05b4\u05a3\u05d9 \u05d4\u05b7\u05de\u05bc\u05b6\u0597\u05dc\u05b6\u05da\u05b0 \u05e0\u05b4\u05e9\u05c1\u05b0\u05d1\u05bc\u05b7\u05a4\u05e2\u05b0\u05ea\u05bc\u05b8 \u05dc\u05b7\u05d0\u05b2\u05de\u05b8\u05bd\u05ea\u05b0\u05da\u05b8\u0599 \u05dc\u05b5\u05d0\u05de\u05b9\u0594\u05e8 \u05db\u05bc\u05b4\u05bd\u05d9\u05be\u05e9\u05c1\u05b0\u05dc\u05b9\u05de\u05b9\u05a4\u05d4 \u05d1\u05b0\u05e0\u05b5\u05da\u05b0\u0599 \u05d9\u05b4\u05de\u05b0\u05dc\u05b9\u05a3\u05da\u05b0 \u05d0\u05b7\u05d7\u05b2\u05e8\u05b7\u0594\u05d9 \u05d5\u05b0\u05d4\u0596\u05d5\u05bc\u05d0 \u05d9\u05b5\u05e9\u05c1\u05b5\u05a3\u05d1 \u05e2\u05b7\u05dc\u05be\u05db\u05bc\u05b4\u05e1\u05b0\u05d0\u05b4\u0591\u05d9 \u05d5\u05bc\u05de\u05b7\u05d3\u05bc\u0596\u05d5\u05bc\u05e2\u05b7 \u05de\u05b8\u05dc\u05b7\u05a5\u05da\u05b0 \u05d0\u05b2\u05d3\u05b9\u05e0\u05b4\u05d9\u05b8\u05bd\u05d4\u05d5\u05bc \u05c3"}, {"pk": 8735, "verse": 14, "text": "\u05d4\u05b4\u05e0\u05bc\u05b5\u0597\u05d4 \u05e2\u05b9\u05d5\u05d3\u05b8\u059b\u05da\u05b0 \u05de\u05b0\u05d3\u05b7\u05d1\u05bc\u05b6\u05a5\u05e8\u05b6\u05ea \u05e9\u05c1\u05b8\u0596\u05dd \u05e2\u05b4\u05dd\u05be\u05d4\u05b7\u05de\u05bc\u05b6\u0591\u05dc\u05b6\u05da\u05b0 \u05d5\u05b7\u05d0\u05b2\u05e0\u05b4\u05d9\u0599 \u05d0\u05b8\u05d1\u05b9\u05a3\u05d5\u05d0 \u05d0\u05b7\u05d7\u05b2\u05e8\u05b7\u0594\u05d9\u05b4\u05da\u05b0 \u05d5\u05bc\u05de\u05b4\u05dc\u05bc\u05b5\u05d0\u05ea\u05b4\u0596\u05d9 \u05d0\u05b6\u05ea\u05be\u05d3\u05bc\u05b0\u05d1\u05b8\u05e8\u05b8\u05bd\u05d9\u05b4\u05da\u05b0\u05c3"}, {"pk": 8736, "verse": 15, "text": "\u05d5\u05b7\u05ea\u05bc\u05b8\u05d1\u05b9\u05a8\u05d0 \u05d1\u05b7\u05ea\u05be\u05e9\u05c1\u05b6\u05a4\u05d1\u05b6\u05e2 \u05d0\u05b6\u05dc\u05be\u05d4\u05b7\u05de\u05bc\u05b6\u0599\u05dc\u05b6\u05da\u05b0\u0599 \u05d4\u05b7\u05d7\u05b7\u0594\u05d3\u05b0\u05e8\u05b8\u05d4 \u05d5\u05b0\u05d4\u05b7\u05de\u05bc\u05b6\u0596\u05dc\u05b6\u05da\u05b0 \u05d6\u05b8\u05e7\u05b5\u05a3\u05df \u05de\u05b0\u05d0\u05b9\u0591\u05d3 \u05d5\u05b7\u05bd\u05d0\u05b2\u05d1\u05b4\u05d9\u05e9\u05c1\u05b7\u05d2\u0599 \u05d4\u05b7\u05e9\u05c1\u05bc\u05a3\u05d5\u05bc\u05e0\u05b7\u05de\u05bc\u05b4\u0594\u05d9\u05ea \u05de\u05b0\u05e9\u05c1\u05b8\u05e8\u05b7\u0596\u05ea \u05d0\u05b6\u05ea\u05be\u05d4\u05b7\u05de\u05bc\u05b6\u05bd\u05dc\u05b6\u05da\u05b0\u05c3"}, {"pk": 8737, "verse": 16, "text": "\u05d5\u05b7\u05ea\u05bc\u05b4\u05e7\u05bc\u05b9\u05a3\u05d3 \u05d1\u05bc\u05b7\u05ea\u05be\u05e9\u05c1\u05b6\u0594\u05d1\u05b7\u05e2 \u05d5\u05b7\u05ea\u05bc\u05b4\u05e9\u05c1\u05b0\u05ea\u05bc\u05b7\u0596\u05d7\u05d5\u05bc \u05dc\u05b7\u05de\u05bc\u05b6\u0591\u05dc\u05b6\u05da\u05b0 \u05d5\u05b7\u05d9\u05bc\u05b9\u05a5\u05d0\u05de\u05b6\u05e8 \u05d4\u05b7\u05de\u05bc\u05b6\u0596\u05dc\u05b6\u05da\u05b0 \u05de\u05b7\u05d4\u05be\u05dc\u05bc\u05b8\u05bd\u05da\u05b0\u05c3"}, {"pk": 8738, "verse": 17, "text": "\u05d5\u05b7\u05ea\u05bc\u05b9\u05a3\u05d0\u05de\u05b6\u05e8 \u05dc\u05b9\u0597\u05d5 \u05d0\u05b2\u05d3\u05b9\u05e0\u05b4\u05d9\u0599 \u05d0\u05b7\u05ea\u05bc\u05b8\u05a8\u05d4 \u05e0\u05b4\u05e9\u05c1\u05b0\u05d1\u05bc\u05b7\u059c\u05e2\u05b0\u05ea\u05bc\u05b8 \u05d1\u05bc\u05b7\u05bd\u05d9\u05d4\u05d5\u05b8\u05a4\u05d4 \u05d0\u05b1\u05dc\u05b9\u05d4\u05b6\u0599\u05d9\u05da\u05b8\u0599 \u05dc\u05b7\u05bd\u05d0\u05b2\u05de\u05b8\u05ea\u05b6\u0594\u05da\u05b8 \u05db\u05bc\u05b4\u05bd\u05d9\u05be\u05e9\u05c1\u05b0\u05dc\u05b9\u05de\u05b9\u05a5\u05d4 \u05d1\u05b0\u05e0\u05b5\u0596\u05da\u05b0 \u05d9\u05b4\u05de\u05b0\u05dc\u05b9\u05a3\u05da\u05b0 \u05d0\u05b7\u05d7\u05b2\u05e8\u05b8\u0591\u05d9 \u05d5\u05b0\u05d4\u0596\u05d5\u05bc\u05d0 \u05d9\u05b5\u05e9\u05c1\u05b5\u05a5\u05d1 \u05e2\u05b7\u05dc\u05be\u05db\u05bc\u05b4\u05e1\u05b0\u05d0\u05b4\u05bd\u05d9\u05c3"}, {"pk": 8739, "verse": 18, "text": "\u05d5\u05b0\u05e2\u05b7\u05ea\u05bc\u05b8\u0595\u05d4 \u05d4\u05b4\u05e0\u05bc\u05b5\u05a5\u05d4 \u05d0\u05b2\u05d3\u05b9\u05e0\u05b4\u05d9\u05bc\u05b8\u0596\u05d4 \u05de\u05b8\u05dc\u05b8\u0591\u05da\u05b0 \u05d5\u05b0\u05e2\u05b7\u05ea\u05bc\u05b8\u059b\u05d4 \u05d0\u05b2\u05d3\u05b9\u05e0\u05b4\u05a5\u05d9 \u05d4\u05b7\u05de\u05bc\u05b6\u0596\u05dc\u05b6\u05da\u05b0 \u05dc\u05b9\u05a5\u05d0 \u05d9\u05b8\u05d3\u05b8\u05bd\u05e2\u05b0\u05ea\u05bc\u05b8\u05c3"}, {"pk": 8740, "verse": 19, "text": "\u05d5\u05b7\u05a0\u05d9\u05bc\u05b4\u05d6\u05b0\u05d1\u05bc\u05b7\u05d7 \u05e9\u05c1\u05b9\u05a5\u05d5\u05e8 \u05d5\u05bc\u05bd\u05de\u05b0\u05e8\u05b4\u05d9\u05d0\u05be\u05d5\u05b0\u05e6\u05b9\u05d0\u05df\u05ae \u05dc\u05b8\u05e8\u05b9\u05d1\u0592 \u05d5\u05b7\u05d9\u05bc\u05b4\u05e7\u05b0\u05e8\u05b8\u05d0\u0599 \u05dc\u05b0\u05db\u05b8\u05dc\u05be\u05d1\u05bc\u05b0\u05e0\u05b5\u05a3\u05d9 \u05d4\u05b7\u05de\u05bc\u05b6\u0594\u05dc\u05b6\u05da\u05b0 \u05d5\u05bc\u05dc\u05b0\u05d0\u05b6\u05d1\u05b0\u05d9\u05b8\u05ea\u05b8\u05e8\u0599 \u05d4\u05b7\u05db\u05bc\u05b9\u05d4\u05b5\u0594\u05df \u05d5\u05bc\u05dc\u05b0\u05d9\u05b9\u05d0\u05b8\u0596\u05d1 \u05e9\u05c2\u05b7\u05a3\u05e8 \u05d4\u05b7\u05e6\u05bc\u05b8\u05d1\u05b8\u0591\u05d0 \u05d5\u05b0\u05dc\u05b4\u05e9\u05c1\u05b0\u05dc\u05b9\u05de\u05b9\u05a5\u05d4 \u05e2\u05b7\u05d1\u05b0\u05d3\u05bc\u05b0\u05da\u05b8\u0596 \u05dc\u05b9\u05a5\u05d0 \u05e7\u05b8\u05e8\u05b8\u05bd\u05d0\u05c3"}, {"pk": 8741, "verse": 20, "text": "\u05d5\u05b0\u05d0\u05b7\u05ea\u05bc\u05b8\u05d4\u0599 \u05d0\u05b2\u05d3\u05b9\u05e0\u05b4\u05a3\u05d9 \u05d4\u05b7\u05de\u05bc\u05b6\u0594\u05dc\u05b6\u05da\u05b0 \u05e2\u05b5\u05d9\u05e0\u05b5\u05a5\u05d9 \u05db\u05b8\u05dc\u05be\u05d9\u05b4\u05e9\u05c2\u05b0\u05e8\u05b8\u05d0\u05b5\u0596\u05dc \u05e2\u05b8\u05dc\u05b6\u0591\u05d9\u05da\u05b8 \u05dc\u05b0\u05d4\u05b7\u05d2\u05bc\u05b4\u05a3\u05d9\u05d3 \u05dc\u05b8\u05d4\u05b6\u0594\u05dd \u05de\u05b4\u0597\u05d9 \u05d9\u05b5\u05e9\u05c1\u05b5\u059b\u05d1 \u05e2\u05b7\u05dc\u05be\u05db\u05bc\u05b4\u05e1\u05bc\u05b5\u05a5\u05d0 \u05d0\u05b2\u05d3\u05b9\u05e0\u05b4\u05bd\u05d9\u05be\u05d4\u05b7\u05de\u05bc\u05b6\u0596\u05dc\u05b6\u05da\u05b0 \u05d0\u05b7\u05d7\u05b2\u05e8\u05b8\u05bd\u05d9\u05d5\u05c3"}, {"pk": 8742, "verse": 21, "text": "\u05d5\u05b0\u05d4\u05b8\u05d9\u05b8\u0595\u05d4 \u05db\u05bc\u05b4\u05e9\u05c1\u05b0\u05db\u05b7\u05a5\u05d1 \u05d0\u05b2\u05d3\u05b9\u05e0\u05b4\u05bd\u05d9\u05be\u05d4\u05b7\u05de\u05bc\u05b6\u0596\u05dc\u05b6\u05da\u05b0 \u05e2\u05b4\u05dd\u05be\u05d0\u05b2\u05d1\u05b9\u05ea\u05b8\u0591\u05d9\u05d5 \u05d5\u05b0\u05d4\u05b8\u05d9\u05b4\u0597\u05d9\u05ea\u05b4\u05d9 \u05d0\u05b2\u05e0\u05b4\u059b\u05d9 \u05d5\u05bc\u05d1\u05b0\u05e0\u05b4\u05a5\u05d9 \u05e9\u05c1\u05b0\u05dc\u05b9\u05de\u05b9\u0596\u05d4 \u05d7\u05b7\u05d8\u05bc\u05b8\u05d0\u05b4\u05bd\u05d9\u05dd\u05c3"}, {"pk": 8743, "verse": 22, "text": "\u05d5\u05b0\u05d4\u05b4\u05e0\u05bc\u05b5\u059b\u05d4 \u05e2\u05b9\u05d5\u05d3\u05b6\u05a5\u05e0\u05bc\u05b8\u05d4 \u05de\u05b0\u05d3\u05b7\u05d1\u05bc\u05b6\u0596\u05e8\u05b6\u05ea \u05e2\u05b4\u05dd\u05be\u05d4\u05b7\u05de\u05bc\u05b6\u0591\u05dc\u05b6\u05da\u05b0 \u05d5\u05b0\u05e0\u05b8\u05ea\u05b8\u05a5\u05df \u05d4\u05b7\u05e0\u05bc\u05b8\u05d1\u05b4\u0596\u05d9\u05d0 \u05d1\u05bc\u05b8\u05bd\u05d0\u05c3"}, {"pk": 8744, "verse": 23, "text": "\u05d5\u05b7\u05d9\u05bc\u05b7\u05d2\u05bc\u05b4\u05a4\u05d9\u05d3\u05d5\u05bc \u05dc\u05b7\u05de\u05bc\u05b6\u0599\u05dc\u05b6\u05da\u05b0\u0599 \u05dc\u05b5\u05d0\u05de\u05b9\u0594\u05e8 \u05d4\u05b4\u05e0\u05bc\u05b5\u0596\u05d4 \u05e0\u05b8\u05ea\u05b8\u05a3\u05df \u05d4\u05b7\u05e0\u05bc\u05b8\u05d1\u05b4\u0591\u05d9\u05d0 \u05d5\u05b7\u05d9\u05bc\u05b8\u05d1\u05b9\u05d0\u0599 \u05dc\u05b4\u05e4\u05b0\u05e0\u05b5\u05a3\u05d9 \u05d4\u05b7\u05de\u05bc\u05b6\u0594\u05dc\u05b6\u05da\u05b0 \u05d5\u05b7\u05d9\u05bc\u05b4\u05e9\u05c1\u05b0\u05ea\u05bc\u05b7\u05a7\u05d7\u05d5\u05bc \u05dc\u05b7\u05de\u05bc\u05b6\u059b\u05dc\u05b6\u05da\u05b0 \u05e2\u05b7\u05dc\u05be\u05d0\u05b7\u05e4\u05bc\u05b8\u0596\u05d9\u05d5 \u05d0\u05b8\u05bd\u05e8\u05b0\u05e6\u05b8\u05d4\u05c3"}, {"pk": 8745, "verse": 24, "text": "\u05d5\u05b7\u05d9\u05bc\u05b9\u05d0\u05de\u05b6\u05e8\u05ae \u05e0\u05b8\u05ea\u05b8\u05df\u0592 \u05d0\u05b2\u05d3\u05b9\u05e0\u05b4\u05a3\u05d9 \u05d4\u05b7\u05de\u05bc\u05b6\u0594\u05dc\u05b6\u05da\u05b0 \u05d0\u05b7\u05ea\u05bc\u05b8\u05a3\u05d4 \u05d0\u05b8\u05de\u05b7\u0594\u05e8\u05b0\u05ea\u05bc\u05b8 \u05d0\u05b2\u05d3\u05b9\u05e0\u05b4\u05d9\u05bc\u05b8\u0596\u05d4\u05d5\u05bc \u05d9\u05b4\u05de\u05b0\u05dc\u05b9\u05a3\u05da\u05b0 \u05d0\u05b7\u05d7\u05b2\u05e8\u05b8\u0591\u05d9 \u05d5\u05b0\u05d4\u0596\u05d5\u05bc\u05d0 \u05d9\u05b5\u05e9\u05c1\u05b5\u05a5\u05d1 \u05e2\u05b7\u05dc\u05be\u05db\u05bc\u05b4\u05e1\u05b0\u05d0\u05b4\u05bd\u05d9\u05c3"}, {"pk": 8746, "verse": 25, "text": "\u05db\u05bc\u05b4\u05a3\u05d9 \u05c0 \u05d9\u05b8\u05e8\u05b7\u05a3\u05d3 \u05d4\u05b7\u05d9\u05bc\u05b9\u0597\u05d5\u05dd \u05d5\u05b7\u05a0\u05d9\u05bc\u05b4\u05d6\u05b0\u05d1\u05bc\u05b7\u05d7 \u05e9\u05c1\u05b9\u05a5\u05d5\u05e8 \u05d5\u05bc\u05bd\u05de\u05b0\u05e8\u05b4\u05d9\u05d0\u05be\u05d5\u05b0\u05e6\u05b9\u05d0\u05df\u05ae \u05dc\u05b8\u05e8\u05b9\u05d1\u0592 \u05d5\u05b7\u05d9\u05bc\u05b4\u05e7\u05b0\u05e8\u05b8\u05d0\u05a9 \u05dc\u05b0\u05db\u05b8\u05dc\u05be\u05d1\u05bc\u05b0\u05e0\u05b5\u05a8\u05d9 \u05d4\u05b7\u05de\u05bc\u05b6\u059c\u05dc\u05b6\u05da\u05b0 \u05d5\u05bc\u05dc\u05b0\u05e9\u05c2\u05b8\u05e8\u05b5\u05a4\u05d9 \u05d4\u05b7\u05e6\u05bc\u05b8\u05d1\u05b8\u05d0\u0599 \u05d5\u05bc\u05dc\u05b0\u05d0\u05b6\u05d1\u05b0\u05d9\u05b8\u05ea\u05b8\u05a3\u05e8 \u05d4\u05b7\u05db\u05bc\u05b9\u05d4\u05b5\u0594\u05df \u05d5\u05b0\u05d4\u05b4\u05e0\u05bc\u05b8\u059b\u05dd \u05d0\u05b9\u05db\u05b0\u05dc\u05b4\u05a5\u05d9\u05dd \u05d5\u05b0\u05e9\u05c1\u05b9\u05ea\u05b4\u0596\u05d9\u05dd \u05dc\u05b0\u05e4\u05b8\u05e0\u05b8\u0591\u05d9\u05d5 \u05d5\u05b7\u05d9\u05bc\u05b9\u05a3\u05d0\u05de\u05b0\u05e8\u0594\u05d5\u05bc \u05d9\u05b0\u05d7\u05b4\u0596\u05d9 \u05d4\u05b7\u05de\u05bc\u05b6\u05a5\u05dc\u05b6\u05da\u05b0 \u05d0\u05b2\u05d3\u05b9\u05e0\u05b4\u05d9\u05bc\u05b8\u05bd\u05d4\u05d5\u05bc\u05c3"}, {"pk": 8747, "verse": 26, "text": "\u05d5\u05b0\u05dc\u05b4\u05a3\u05d9 \u05d0\u05b2\u05e0\u05b4\u05bd\u05d9\u05be\u05e2\u05b7\u05a0\u05d1\u05b0\u05d3\u05bc\u05b6\u05da\u05b8 \u05d5\u05bc\u05dc\u05b0\u05e6\u05b8\u05d3\u05b9\u05a8\u05e7 \u05d4\u05b7\u05db\u05bc\u05b9\u05d4\u05b5\u059c\u05df \u05d5\u05b0\u05dc\u05b4\u05d1\u05b0\u05e0\u05b8\u05d9\u05b8\u05a7\u05d4\u05d5\u05bc \u05d1\u05b6\u05df\u05be\u05d9\u05b0\u05d4\u05b9\u05d5\u05d9\u05b8\u05d3\u05b8\u059b\u05e2 \u05d5\u05b0\u05dc\u05b4\u05e9\u05c1\u05b0\u05dc\u05b9\u05de\u05b9\u05a5\u05d4 \u05e2\u05b7\u05d1\u05b0\u05d3\u05bc\u05b0\u05da\u05b8\u0596 \u05dc\u05b9\u05a5\u05d0 \u05e7\u05b8\u05e8\u05b8\u05bd\u05d0\u05c3"}, {"pk": 8748, "verse": 27, "text": "\u05d0\u05b4\u0597\u05dd \u05de\u05b5\u05d0\u05b5\u05ea\u0599 \u05d0\u05b2\u05d3\u05b9\u05e0\u05b4\u05a3\u05d9 \u05d4\u05b7\u05de\u05bc\u05b6\u0594\u05dc\u05b6\u05da\u05b0 \u05e0\u05b4\u05d4\u05b0\u05d9\u05b8\u0596\u05d4 \u05d4\u05b7\u05d3\u05bc\u05b8\u05d1\u05b8\u05a3\u05e8 \u05d4\u05b7\u05d6\u05bc\u05b6\u0591\u05d4 \u05d5\u05b0\u05dc\u05b9\u05a4\u05d0 \u05d4\u05b9\u05d5\u05d3\u05b7\u0599\u05e2\u05b0\u05ea\u05bc\u05b8\u0599 \u05d0\u05b6\u05bd\u05ea\u05be [\u05e2\u05b7\u05d1\u05b0\u05d3\u05bc\u05b6\u05d9\u05da\u05b8 \u05db] (\u05e2\u05b7\u05d1\u05b0\u05d3\u05bc\u05b0\u05da\u05b8\u0594 \u05e7) \u05de\u05b4\u0597\u05d9 \u05d9\u05b5\u05e9\u05c1\u05b5\u059b\u05d1 \u05e2\u05b7\u05dc\u05be\u05db\u05bc\u05b4\u05e1\u05bc\u05b5\u05a5\u05d0 \u05d0\u05b2\u05d3\u05b9\u05e0\u05b4\u05bd\u05d9\u05be\u05d4\u05b7\u05de\u05bc\u05b6\u0596\u05dc\u05b6\u05da\u05b0 \u05d0\u05b7\u05d7\u05b2\u05e8\u05b8\u05bd\u05d9\u05d5\u05c3    \u05e1"}, {"pk": 8749, "verse": 28, "text": "\u05d5\u05b7\u05d9\u05bc\u05b7\u05a8\u05e2\u05b7\u05df \u05d4\u05b7\u05de\u05bc\u05b6\u05a4\u05dc\u05b6\u05da\u05b0 \u05d3\u05bc\u05b8\u05d5\u05b4\u05d3\u0599 \u05d5\u05b7\u05d9\u05bc\u05b9\u0594\u05d0\u05de\u05b6\u05e8 \u05e7\u05b4\u05e8\u05b0\u05d0\u05d5\u05bc\u05be\u05dc\u05b4\u0596\u05d9 \u05dc\u05b0\u05d1\u05b7\u05ea\u05be\u05e9\u05c1\u05b8\u0591\u05d1\u05b7\u05e2 \u05d5\u05b7\u05ea\u05bc\u05b8\u05d1\u05b9\u05d0\u0599 \u05dc\u05b4\u05e4\u05b0\u05e0\u05b5\u05a3\u05d9 \u05d4\u05b7\u05de\u05bc\u05b6\u0594\u05dc\u05b6\u05da\u05b0 \u05d5\u05b7\u05bd\u05ea\u05bc\u05b7\u05e2\u05b2\u05de\u05b9\u0596\u05d3 \u05dc\u05b4\u05e4\u05b0\u05e0\u05b5\u05a5\u05d9 \u05d4\u05b7\u05de\u05bc\u05b6\u05bd\u05dc\u05b6\u05da\u05b0\u05c3"}, {"pk": 8750, "verse": 29, "text": "\u05d5\u05b7\u05d9\u05bc\u05b4\u05e9\u05c1\u05bc\u05b8\u05d1\u05b7\u05a5\u05e2 \u05d4\u05b7\u05de\u05bc\u05b6\u0596\u05dc\u05b6\u05da\u05b0 \u05d5\u05b7\u05d9\u05bc\u05b9\u05d0\u05de\u05b7\u0591\u05e8 \u05d7\u05b7\u05d9\u05be\u05d9\u05b0\u05d4\u05d5\u05b8\u0595\u05d4 \u05d0\u05b2\u05e9\u05c1\u05b6\u05e8\u05be\u05e4\u05bc\u05b8\u05d3\u05b8\u05a5\u05d4 \u05d0\u05b6\u05ea\u05be\u05e0\u05b7\u05e4\u05b0\u05e9\u05c1\u05b4\u0596\u05d9 \u05de\u05b4\u05db\u05bc\u05b8\u05dc\u05be\u05e6\u05b8\u05e8\u05b8\u05bd\u05d4\u05c3"}, {"pk": 8751, "verse": 30, "text": "\u05db\u05bc\u05b4\u05a1\u05d9 \u05db\u05bc\u05b7\u05d0\u05b2\u05e9\u05c1\u05b6\u05e8\u05a9 \u05e0\u05b4\u05e9\u05c1\u05b0\u05d1\u05bc\u05b7\u05a8\u05e2\u05b0\u05ea\u05bc\u05b4\u05d9 \u05dc\u05b8\u059c\u05da\u05b0 \u05d1\u05bc\u05b7\u05d9\u05d4\u05d5\u05b8\u05a8\u05d4 \u05d0\u05b1\u05dc\u05b9\u05d4\u05b5\u05a4\u05d9 \u05d9\u05b4\u05e9\u05c2\u05b0\u05e8\u05b8\u05d0\u05b5\u05dc\u0599 \u05dc\u05b5\u05d0\u05de\u05b9\u0594\u05e8 \u05db\u05bc\u05b4\u05bd\u05d9\u05be\u05e9\u05c1\u05b0\u05dc\u05b9\u05de\u05b9\u05a4\u05d4 \u05d1\u05b0\u05e0\u05b5\u05da\u05b0\u0599 \u05d9\u05b4\u05de\u05b0\u05dc\u05b9\u05a3\u05da\u05b0 \u05d0\u05b7\u05d7\u05b2\u05e8\u05b7\u0594\u05d9 \u05d5\u05b0\u05d4\u059b\u05d5\u05bc\u05d0 \u05d9\u05b5\u05e9\u05c1\u05b5\u05a5\u05d1 \u05e2\u05b7\u05dc\u05be\u05db\u05bc\u05b4\u05e1\u05b0\u05d0\u05b4\u0596\u05d9 \u05ea\u05bc\u05b7\u05d7\u05b0\u05ea\u05bc\u05b8\u0591\u05d9 \u05db\u05bc\u05b4\u059b\u05d9 \u05db\u05bc\u05b5\u05a5\u05df \u05d0\u05b6\u05e2\u05b1\u05e9\u05c2\u05b6\u0596\u05d4 \u05d4\u05b7\u05d9\u05bc\u05b9\u05a5\u05d5\u05dd \u05d4\u05b7\u05d6\u05bc\u05b6\u05bd\u05d4\u05c3"}, {"pk": 8752, "verse": 31, "text": "\u05d5\u05b7\u05ea\u05bc\u05b4\u05e7\u05bc\u05b9\u05a8\u05d3 \u05d1\u05bc\u05b7\u05ea\u05be\u05e9\u05c1\u05b6\u05a4\u05d1\u05b7\u05e2 \u05d0\u05b7\u05e4\u05bc\u05b7\u0599\u05d9\u05b4\u05dd\u0599 \u05d0\u05b6\u0594\u05e8\u05b6\u05e5 \u05d5\u05b7\u05ea\u05bc\u05b4\u05e9\u05c1\u05b0\u05ea\u05bc\u05b7\u0596\u05d7\u05d5\u05bc \u05dc\u05b7\u05de\u05bc\u05b6\u0591\u05dc\u05b6\u05da\u05b0 \u05d5\u05b7\u05ea\u05bc\u05b9\u0595\u05d0\u05de\u05b6\u05e8 \u05d9\u05b0\u05d7\u05b4\u0597\u05d9 \u05d0\u05b2\u05d3\u05b9\u05e0\u05b4\u059b\u05d9 \u05d4\u05b7\u05de\u05bc\u05b6\u05a5\u05dc\u05b6\u05da\u05b0 \u05d3\u05bc\u05b8\u05d5\u05b4\u0596\u05d3 \u05dc\u05b0\u05e2\u05b9\u05dc\u05b8\u05bd\u05dd\u05c3  \u05e4"}, {"pk": 8753, "verse": 32, "text": "\u05d5\u05b7\u05d9\u05bc\u05b9\u05a3\u05d0\u05de\u05b6\u05e8 \u05c0 \u05d4\u05b7\u05de\u05bc\u05b6\u05a3\u05dc\u05b6\u05da\u05b0 \u05d3\u05bc\u05b8\u05d5\u05b4\u0597\u05d3 \u05e7\u05b4\u05e8\u05b0\u05d0\u05d5\u05bc\u05be\u05dc\u05b4\u059e\u05d9 \u05dc\u05b0\u05e6\u05b8\u05d3\u05b9\u05a4\u05d5\u05e7 \u05d4\u05b7\u05db\u05bc\u05b9\u05d4\u05b5\u05df\u0599 \u05d5\u05bc\u05dc\u05b0\u05e0\u05b8\u05ea\u05b8\u05a3\u05df \u05d4\u05b7\u05e0\u05bc\u05b8\u05d1\u05b4\u0594\u05d9\u05d0 \u05d5\u05b0\u05dc\u05b4\u05d1\u05b0\u05e0\u05b8\u05d9\u05b8\u0596\u05d4\u05d5\u05bc \u05d1\u05bc\u05b6\u05df\u05be\u05d9\u05b0\u05d4\u05b9\u05d5\u05d9\u05b8\u05d3\u05b8\u0591\u05e2 \u05d5\u05b7\u05d9\u05bc\u05b8\u05d1\u05b9\u0596\u05d0\u05d5\u05bc \u05dc\u05b4\u05e4\u05b0\u05e0\u05b5\u05a5\u05d9 \u05d4\u05b7\u05de\u05bc\u05b6\u05bd\u05dc\u05b6\u05da\u05b0\u05c3"}, {"pk": 8754, "verse": 33, "text": "\u05d5\u05b7\u05d9\u05bc\u05b9\u05a8\u05d0\u05de\u05b6\u05e8 \u05d4\u05b7\u05de\u05bc\u05b6\u059c\u05dc\u05b6\u05da\u05b0 \u05dc\u05b8\u05d4\u05b6\u0597\u05dd \u05e7\u05b0\u05d7\u05a4\u05d5\u05bc \u05e2\u05b4\u05de\u05bc\u05b8\u05db\u05b6\u05dd\u0599 \u05d0\u05b6\u05ea\u05be\u05e2\u05b7\u05d1\u05b0\u05d3\u05b5\u05a3\u05d9 \u05d0\u05b2\u05d3\u05b9\u05e0\u05b5\u05d9\u05db\u05b6\u0594\u05dd \u05d5\u05b0\u05d4\u05b4\u05e8\u05b0\u05db\u05bc\u05b7\u05d1\u05b0\u05ea\u05bc\u05b6\u05dd\u0599 \u05d0\u05b6\u05ea\u05be\u05e9\u05c1\u05b0\u05dc\u05b9\u05de\u05b9\u05a3\u05d4 \u05d1\u05b0\u05e0\u05b4\u0594\u05d9 \u05e2\u05b7\u05dc\u05be\u05d4\u05b7\u05e4\u05bc\u05b4\u05e8\u05b0\u05d3\u05bc\u05b8\u0596\u05d4 \u05d0\u05b2\u05e9\u05c1\u05b6\u05e8\u05be\u05dc\u05b4\u0591\u05d9 \u05d5\u05b0\u05d4\u05b9\u05d5\u05e8\u05b7\u05d3\u05b0\u05ea\u05bc\u05b6\u05a5\u05dd \u05d0\u05b9\u05ea\u05b9\u0596\u05d5 \u05d0\u05b6\u05dc\u05be\u05d2\u05bc\u05b4\u05d7\u05b9\u05bd\u05d5\u05df\u05c3"}, {"pk": 8755, "verse": 34, "text": "\u05d5\u05bc\u05de\u05b8\u05e9\u05c1\u05b7\u05a3\u05d7 \u05d0\u05b9\u05ea\u05b9\u05a3\u05d5 \u05dd \u05e6\u05b8\u05d3\u05b9\u05a8\u05d5\u05e7 \u05d4\u05b7\u05db\u05bc\u05b9\u05d4\u05b5\u059c\u05df \u05d5\u05b0\u05e0\u05b8\u05ea\u05b8\u05a7\u05df \u05d4\u05b7\u05e0\u05bc\u05b8\u05d1\u05b4\u059b\u05d9\u05d0 \u05dc\u05b0\u05de\u05b6\u0596\u05dc\u05b6\u05da\u05b0 \u05e2\u05b7\u05dc\u05be\u05d9\u05b4\u05e9\u05c2\u05b0\u05e8\u05b8\u05d0\u05b5\u0591\u05dc \u05d5\u05bc\u05ea\u05b0\u05e7\u05b7\u05e2\u05b0\u05ea\u05bc\u05b6\u05dd\u0599 \u05d1\u05bc\u05b7\u05e9\u05c1\u05bc\u05b9\u05d5\u05e4\u05b8\u0594\u05e8 \u05d5\u05b7\u05d0\u05b2\u05de\u05b7\u05e8\u05b0\u05ea\u05bc\u05b6\u0595\u05dd \u05d9\u05b0\u05d7\u05b4\u0596\u05d9 \u05d4\u05b7\u05de\u05bc\u05b6\u05a5\u05dc\u05b6\u05da\u05b0 \u05e9\u05c1\u05b0\u05dc\u05b9\u05de\u05b9\u05bd\u05d4\u05c3"}, {"pk": 8756, "verse": 35, "text": "\u05d5\u05b7\u05e2\u05b2\u05dc\u05b4\u05d9\u05ea\u05b6\u05a3\u05dd \u05d0\u05b7\u05d7\u05b2\u05e8\u05b8\u0597\u05d9\u05d5 \u05d5\u05bc\u05d1\u05b8\u05d0\u0599 \u05d5\u05b0\u05d9\u05b8\u05e9\u05c1\u05b7\u05a3\u05d1 \u05e2\u05b7\u05dc\u05be\u05db\u05bc\u05b4\u05e1\u05b0\u05d0\u05b4\u0594\u05d9 \u05d5\u05b0\u05d4\u05a5\u05d5\u05bc\u05d0 \u05d9\u05b4\u05de\u05b0\u05dc\u05b9\u0596\u05da\u05b0 \u05ea\u05bc\u05b7\u05d7\u05b0\u05ea\u05bc\u05b8\u0591\u05d9 \u05d5\u05b0\u05d0\u05b9\u05ea\u05b9\u05a4\u05d5 \u05e6\u05b4\u05d5\u05bc\u05b4\u0599\u05d9\u05ea\u05b4\u05d9\u0599 \u05dc\u05b4\u05bd\u05d4\u05b0\u05d9\u05b9\u05a3\u05d5\u05ea \u05e0\u05b8\u05d2\u05b4\u0594\u05d9\u05d3 \u05e2\u05b7\u05dc\u05be\u05d9\u05b4\u05e9\u05c2\u05b0\u05e8\u05b8\u05d0\u05b5\u0596\u05dc \u05d5\u05b0\u05e2\u05b7\u05dc\u05be\u05d9\u05b0\u05d4\u05d5\u05bc\u05d3\u05b8\u05bd\u05d4\u05c3"}, {"pk": 8757, "verse": 36, "text": "\u05d5\u05b7\u05d9\u05bc\u05b7\u05a8\u05e2\u05b7\u05df \u05d1\u05bc\u05b0\u05e0\u05b8\u05d9\u05b8\u05a7\u05d4\u05d5\u05bc \u05d1\u05b6\u05df\u05be\u05d9\u05b0\u05d4\u05b9\u05bd\u05d5\u05d9\u05b8\u05d3\u05b8\u059b\u05e2 \u05d0\u05b6\u05ea\u05be\u05d4\u05b7\u05de\u05bc\u05b6\u0596\u05dc\u05b6\u05da\u05b0 \u05d5\u05b7\u05d9\u05bc\u05b9\u05a3\u05d0\u05de\u05b6\u05e8 \u05c0 \u05d0\u05b8\u05de\u05b5\u0591\u05df \u05db\u05bc\u05b5\u059a\u05df \u05d9\u05b9\u05d0\u05de\u05b7\u05a3\u05e8 \u05d9\u05b0\u05d4\u05d5\u05b8\u0594\u05d4 \u05d0\u05b1\u05dc\u05b9\u05d4\u05b5\u0596\u05d9 \u05d0\u05b2\u05d3\u05b9\u05e0\u05b4\u05a5\u05d9 \u05d4\u05b7\u05de\u05bc\u05b6\u05bd\u05dc\u05b6\u05da\u05b0\u05c3"}, {"pk": 8758, "verse": 37, "text": "\u05db\u05bc\u05b7\u05d0\u05b2\u05e9\u05c1\u05b6\u05a8\u05e8 \u05d4\u05b8\u05d9\u05b8\u05a4\u05d4 \u05d9\u05b0\u05d4\u05d5\u05b8\u05d4\u0599 \u05e2\u05b4\u05dd\u05be\u05d0\u05b2\u05d3\u05b9\u05e0\u05b4\u05a3\u05d9 \u05d4\u05b7\u05de\u05bc\u05b6\u0594\u05dc\u05b6\u05da\u05b0 \u05db\u05bc\u05b5\u0596\u05df [\u05d9\u05b0\u05d4\u05b4\u05d9 \u05db] (\u05d9\u05b4\u05bd\u05d4\u05b0\u05d9\u05b6\u05a3\u05d4 \u05e7) \u05e2\u05b4\u05dd\u05be\u05e9\u05c1\u05b0\u05dc\u05b9\u05de\u05b9\u0591\u05d4 \u05d5\u05b4\u05bd\u05d9\u05d2\u05b7\u05d3\u05bc\u05b5\u05dc\u0599 \u05d0\u05b6\u05ea\u05be\u05db\u05bc\u05b4\u05e1\u05b0\u05d0\u05b9\u0594\u05d5 \u05de\u05b4\u05a8\u05db\u05bc\u05b4\u05e1\u05bc\u05b5\u0594\u05d0 \u05d0\u05b2\u05d3\u05b9\u05e0\u05b4\u0596\u05d9 \u05d4\u05b7\u05de\u05bc\u05b6\u05a5\u05dc\u05b6\u05da\u05b0 \u05d3\u05bc\u05b8\u05d5\u05b4\u05bd\u05d3\u05c3"}, {"pk": 8759, "verse": 38, "text": "\u05d5\u05b7\u05d9\u05bc\u05b5\u05a3\u05e8\u05b6\u05d3 \u05e6\u05b8\u05d3\u05b9\u05a3\u05d5\u05e7 \u05d4\u05b7\u05a0\u05db\u05bc\u05b9\u05d4\u05b5\u05df \u05d5\u05b0\u05e0\u05b8\u05ea\u05b8\u05a8\u05df \u05d4\u05b7\u05e0\u05bc\u05b8\u05d1\u05b4\u059c\u05d9\u05d0 \u05d5\u05bc\u05d1\u05b0\u05e0\u05b8\u05d9\u05b8\u05a3\u05d4\u05d5\u05bc \u05d1\u05b6\u05df\u05be\u05d9\u05b0\u05d4\u05b9\u05d5\u05d9\u05b8\u05d3\u05b8\u0597\u05e2 \u05d5\u05b0\u05d4\u05b7\u05db\u05bc\u05b0\u05e8\u05b5\u05ea\u05b4\u05d9\u0599 \u05d5\u05b0\u05d4\u05b7\u05e4\u05bc\u05b0\u05dc\u05b5\u05ea\u05b4\u0594\u05d9 \u05d5\u05b7\u05d9\u05bc\u05b7\u05e8\u05b0\u05db\u05bc\u05b4\u0599\u05d1\u05d5\u05bc\u0599 \u05d0\u05b6\u05ea\u05be\u05e9\u05c1\u05b0\u05dc\u05b9\u05de\u05b9\u0594\u05d4 \u05e2\u05b7\u05dc\u05be\u05e4\u05bc\u05b4\u05e8\u05b0\u05d3\u05bc\u05b7\u0596\u05ea \u05d4\u05b7\u05de\u05bc\u05b6\u05a3\u05dc\u05b6\u05da\u05b0 \u05d3\u05bc\u05b8\u05d5\u05b4\u0591\u05d3 \u05d5\u05b7\u05d9\u05bc\u05b9\u05dc\u05b4\u05a5\u05db\u05d5\u05bc \u05d0\u05b9\u05ea\u05b9\u0596\u05d5 \u05e2\u05b7\u05dc\u05be\u05d2\u05bc\u05b4\u05d7\u05b9\u05bd\u05d5\u05df\u05c3"}, {"pk": 8760, "verse": 39, "text": "\u05d5\u05b7\u05d9\u05bc\u05b4\u05e7\u05bc\u05b7\u05d7\u05a9 \u05e6\u05b8\u05d3\u05b9\u05a8\u05d5\u05e7 \u05d4\u05b7\u05db\u05bc\u05b9\u05d4\u05b5\u059c\u05df \u05d0\u05b6\u05ea\u05be\u05e7\u05b6\u05a4\u05e8\u05b6\u05df \u05d4\u05b7\u05e9\u05c1\u05bc\u05b6\u0599\u05de\u05b6\u05df\u0599 \u05de\u05b4\u05df\u05be\u05d4\u05b8\u05d0\u05b9\u0594\u05d4\u05b6\u05dc \u05d5\u05b7\u05d9\u05bc\u05b4\u05de\u05b0\u05e9\u05c1\u05b7\u0596\u05d7 \u05d0\u05b6\u05ea\u05be\u05e9\u05c1\u05b0\u05dc\u05b9\u05de\u05b9\u0591\u05d4 \u05d5\u05b7\u05bd\u05d9\u05bc\u05b4\u05ea\u05b0\u05e7\u05b0\u05e2\u05d5\u05bc\u0599 \u05d1\u05bc\u05b7\u05e9\u05c1\u05bc\u05b9\u05d5\u05e4\u05b8\u0594\u05e8 \u05d5\u05b7\u05d9\u05bc\u05b9\u05bd\u05d0\u05de\u05b0\u05e8\u05d5\u05bc\u0599 \u05db\u05bc\u05b8\u05dc\u05be\u05d4\u05b8\u05e2\u05b8\u0594\u05dd \u05d9\u05b0\u05d7\u05b4\u0596\u05d9 \u05d4\u05b7\u05de\u05bc\u05b6\u05a5\u05dc\u05b6\u05da\u05b0 \u05e9\u05c1\u05b0\u05dc\u05b9\u05de\u05b9\u05bd\u05d4\u05c3"}, {"pk": 8761, "verse": 40, "text": "\u05d5\u05b7\u05d9\u05bc\u05b7\u05e2\u05b2\u05dc\u05a4\u05d5\u05bc \u05db\u05b8\u05dc\u05be\u05d4\u05b8\u05e2\u05b8\u05dd\u0599 \u05d0\u05bd\u05b7\u05d7\u05b2\u05e8\u05b8\u0594\u05d9\u05d5 \u05d5\u05b0\u05d4\u05b8\u05e2\u05b8\u05dd\u0599 \u05de\u05b0\u05d7\u05b7\u05dc\u05bc\u05b0\u05dc\u05b4\u05a3\u05d9\u05dd \u05d1\u05bc\u05b7\u05d7\u05b2\u05dc\u05b4\u05dc\u05b4\u0594\u05d9\u05dd \u05d5\u05bc\u05e9\u05c2\u05b0\u05de\u05b5\u05d7\u05b4\u0596\u05d9\u05dd \u05e9\u05c2\u05b4\u05de\u05b0\u05d7\u05b8\u05a3\u05d4 \u05d2\u05b0\u05d3\u05b9\u05d5\u05dc\u05b8\u0591\u05d4 \u05d5\u05b7\u05ea\u05bc\u05b4\u05d1\u05bc\u05b8\u05e7\u05b7\u05a5\u05e2 \u05d4\u05b8\u05d0\u05b8\u0596\u05e8\u05b6\u05e5 \u05d1\u05bc\u05b0\u05e7\u05b9\u05d5\u05dc\u05b8\u05bd\u05dd\u05c3"}, {"pk": 8762, "verse": 41, "text": "\u05d5\u05b7\u05d9\u05bc\u05b4\u05e9\u05c1\u05b0\u05de\u05b7\u05a3\u05e2 \u05d0\u05b2\u05d3\u05b9\u05e0\u05b4\u05d9\u05bc\u05b8\u0597\u05d4\u05d5\u05bc \u05d5\u05b0\u05db\u05b8\u05dc\u05be\u05d4\u05b7\u05e7\u05bc\u05b0\u05e8\u05bb\u05d0\u05b4\u05d9\u05dd\u0599 \u05d0\u05b2\u05e9\u05c1\u05b6\u05a3\u05e8 \u05d0\u05b4\u05ea\u05bc\u05b9\u0594\u05d5 \u05d5\u05b0\u05d4\u05b5\u0596\u05dd \u05db\u05bc\u05b4\u05dc\u05bc\u05a3\u05d5\u05bc \u05dc\u05b6\u05d0\u05b1\u05db\u05b9\u0591\u05dc \u05d5\u05b7\u05d9\u05bc\u05b4\u05e9\u05c1\u05b0\u05de\u05b7\u05a4\u05e2 \u05d9\u05b9\u05d5\u05d0\u05b8\u05d1\u0599 \u05d0\u05b6\u05ea\u05be\u05e7\u05b9\u05a3\u05d5\u05dc \u05d4\u05b7\u05e9\u05c1\u05bc\u05b9\u05d5\u05e4\u05b8\u0594\u05e8 \u05d5\u05b7\u05d9\u05bc\u05b9\u0595\u05d0\u05de\u05b6\u05e8 \u05de\u05b7\u05d3\u05bc\u05a5\u05d5\u05bc\u05e2\u05b7 \u05e7\u05b9\u05bd\u05d5\u05dc\u05be\u05d4\u05b7\u05e7\u05bc\u05b4\u05e8\u05b0\u05d9\u05b8\u0596\u05d4 \u05d4\u05b9\u05d5\u05de\u05b8\u05bd\u05d4\u05c3"}, {"pk": 8763, "verse": 42, "text": "\u05e2\u05b9\u05d5\u05d3\u05b6\u05a3\u05e0\u05bc\u05d5\u05bc \u05de\u05b0\u05d3\u05b7\u05d1\u05bc\u05b5\u0594\u05e8 \u05d5\u05b0\u05d4\u05b4\u05e0\u05bc\u05b5\u05a7\u05d4 \u05d9\u05b9\u05d5\u05e0\u05b8\u05ea\u05b8\u059b\u05df \u05d1\u05bc\u05b6\u05df\u05be\u05d0\u05b6\u05d1\u05b0\u05d9\u05b8\u05ea\u05b8\u05a5\u05e8 \u05d4\u05b7\u05db\u05bc\u05b9\u05d4\u05b5\u0596\u05df \u05d1\u05bc\u05b8\u0591\u05d0 \u05d5\u05b7\u05d9\u05bc\u05b9\u05a4\u05d0\u05de\u05b6\u05e8 \u05d0\u05b2\u05d3\u05b9\u05e0\u05b4\u05d9\u05bc\u05b8\u0599\u05d4\u05d5\u05bc\u0599 \u05d1\u05bc\u05b9\u0594\u05d0 \u05db\u05bc\u05b4\u05a3\u05d9 \u05d0\u05b4\u05a5\u05d9\u05e9\u05c1 \u05d7\u05b7\u059b\u05d9\u05b4\u05dc \u05d0\u05b7\u0596\u05ea\u05bc\u05b8\u05d4 \u05d5\u05b0\u05d8\u05b9\u05a5\u05d5\u05d1 \u05ea\u05bc\u05b0\u05d1\u05b7\u05e9\u05c2\u05bc\u05b5\u05bd\u05e8\u05c3"}, {"pk": 8764, "verse": 43, "text": "\u05d5\u05b7\u05d9\u05bc\u05b7\u0599\u05e2\u05b7\u05df\u0599 \u05d9\u05b9\u05d5\u05e0\u05b8\u05ea\u05b8\u0594\u05df \u05d5\u05b7\u05d9\u05bc\u05b9\u0596\u05d0\u05de\u05b6\u05e8 \u05dc\u05b7\u05d0\u05b2\u05d3\u05b9\u05e0\u05b4\u05d9\u05bc\u05b8\u0591\u05d4\u05d5\u05bc \u05d0\u05b2\u05d1\u05b8\u0595\u05dc \u05d0\u05b2\u05d3\u05b9\u05e0\u05b5\u05a5\u05d9\u05e0\u05d5\u05bc \u05d4\u05b7\u05de\u05bc\u05b6\u05bd\u05dc\u05b6\u05da\u05b0\u05be\u05d3\u05bc\u05b8\u05d5\u05b4\u0596\u05d3 \u05d4\u05b4\u05de\u05b0\u05dc\u05b4\u05a5\u05d9\u05da\u05b0 \u05d0\u05b6\u05ea\u05be\u05e9\u05c1\u05b0\u05dc\u05b9\u05de\u05b9\u05bd\u05d4\u05c3"}, {"pk": 8765, "verse": 44, "text": "\u05d5\u05b7\u05d9\u05bc\u05b4\u05e9\u05c1\u05b0\u05dc\u05b7\u05a3\u05d7 \u05d0\u05b4\u05ea\u05bc\u05b9\u05bd\u05d5\u05be\u05d4\u05b7\u05a0\u05de\u05bc\u05b6\u05dc\u05b6\u05da\u05b0 \u05d0\u05b6\u05ea\u05be\u05e6\u05b8\u05d3\u05b9\u05a8\u05d5\u05e7 \u05d4\u05b7\u05db\u05bc\u05b9\u05d4\u05b5\u059c\u05df \u05d5\u05b0\u05d0\u05b6\u05ea\u05be\u05e0\u05b8\u05ea\u05b8\u05a3\u05df \u05d4\u05b7\u05e0\u05bc\u05b8\u05d1\u05b4\u0597\u05d9\u05d0 \u05d5\u05bc\u05d1\u05b0\u05e0\u05b8\u05d9\u05b8\u0599\u05d4\u05d5\u05bc\u0599 \u05d1\u05bc\u05b6\u05df\u05be\u05d9\u05b0\u05d4\u05b9\u05a3\u05d5\u05d9\u05b8\u05d3\u05b8\u0594\u05e2 \u05d5\u05b0\u05d4\u05b7\u05db\u05bc\u05b0\u05e8\u05b5\u05ea\u05b4\u0596\u05d9 \u05d5\u05b0\u05d4\u05b7\u05e4\u05bc\u05b0\u05dc\u05b5\u05ea\u05b4\u0591\u05d9 \u05d5\u05b7\u05d9\u05bc\u05b7\u05e8\u05b0\u05db\u05bc\u05b4\u05a3\u05d1\u05d5\u05bc \u05d0\u05b9\u05ea\u05b9\u0594\u05d5 \u05e2\u05b7\u0596\u05dc \u05e4\u05bc\u05b4\u05e8\u05b0\u05d3\u05bc\u05b7\u05a5\u05ea \u05d4\u05b7\u05de\u05bc\u05b6\u05bd\u05dc\u05b6\u05da\u05b0\u05c3"}, {"pk": 8766, "verse": 45, "text": "\u05d5\u05b7\u05d9\u05bc\u05b4\u05de\u05b0\u05e9\u05c1\u05b0\u05d7\u05a3\u05d5\u05bc \u05d0\u05b9\u05ea\u05b9\u05a1\u05d5 \u05e6\u05b8\u05d3\u05b9\u05a3\u05d5\u05e7 \u05d4\u05b7\u05db\u05bc\u05b9\u05d4\u05b5\u05a3\u05df \u05d5\u05b0\u05e0\u05b8\u05ea\u05b8\u05df\u05a9 \u05d4\u05b7\u05e0\u05bc\u05b8\u05d1\u05b4\u05a8\u05d9\u05d0 \u05dc\u05b0\u05de\u05b6\u059c\u05dc\u05b6\u05da\u05b0 \u05d1\u05bc\u05b0\u05d2\u05b4\u05d7\u05b9\u0597\u05d5\u05df \u05d5\u05b7\u05d9\u05bc\u05b7\u05e2\u05b2\u05dc\u05a4\u05d5\u05bc \u05de\u05b4\u05e9\u05c1\u05bc\u05b8\u05dd\u0599 \u05e9\u05c2\u05b0\u05de\u05b5\u05d7\u05b4\u0594\u05d9\u05dd \u05d5\u05b7\u05ea\u05bc\u05b5\u05d4\u05b9\u0596\u05dd \u05d4\u05b7\u05e7\u05bc\u05b4\u05e8\u05b0\u05d9\u05b8\u0591\u05d4 \u05d4\u05a5\u05d5\u05bc\u05d0 \u05d4\u05b7\u05e7\u05bc\u05b9\u0596\u05d5\u05dc \u05d0\u05b2\u05e9\u05c1\u05b6\u05a5\u05e8 \u05e9\u05c1\u05b0\u05de\u05b7\u05e2\u05b0\u05ea\u05bc\u05b6\u05bd\u05dd\u05c3"}, {"pk": 8767, "verse": 46, "text": "\u05d5\u05b0\u05d2\u05b7\u05dd\u0599 \u05d9\u05b8\u05e9\u05c1\u05b7\u05a3\u05d1 \u05e9\u05c1\u05b0\u05dc\u05b9\u05de\u05b9\u0594\u05d4 \u05e2\u05b7\u0596\u05dc \u05db\u05bc\u05b4\u05e1\u05bc\u05b5\u05a5\u05d0 \u05d4\u05b7\u05de\u05bc\u05b0\u05dc\u05d5\u05bc\u05db\u05b8\u05bd\u05d4\u05c3"}, {"pk": 8768, "verse": 47, "text": "\u05d5\u05b0\u05d2\u05b7\u05dd\u05be\u05d1\u05bc\u05b8\u059c\u05d0\u05d5\u05bc \u05e2\u05b7\u05d1\u05b0\u05d3\u05b5\u05a3\u05d9 \u05d4\u05b7\u05de\u05bc\u05b6\u0597\u05dc\u05b6\u05da\u05b0 \u05dc\u05b0\u05a0\u05d1\u05b8\u05e8\u05b5\u05da\u05b0 \u05d0\u05b6\u05ea\u05be\u05d0\u05b2\u05d3\u05b9\u05e0\u05b5\u059c\u05d9\u05e0\u05d5\u05bc \u05d4\u05b7\u05de\u05bc\u05b6\u05a3\u05dc\u05b6\u05da\u05b0 \u05d3\u05bc\u05b8\u05d5\u05b4\u05d3\u05ae \u05dc\u05b5\u05d0\u05de\u05b9\u05e8\u0592 \u05d9\u05b5\u05d9\u05d8\u05b5\u05a8\u05d1 [\u05d0\u05b1\u05dc\u05b9\u05d4\u05b6\u05d9\u05da\u05b8 \u05db] (\u05d0\u05b1\u05dc\u05b9\u05d4\u05b4\u059c\u05d9\u05dd \u05e7) \u05d0\u05b6\u05ea\u05be\u05e9\u05c1\u05b5\u05a4\u05dd \u05e9\u05c1\u05b0\u05dc\u05b9\u05de\u05b9\u05d4\u0599 \u05de\u05b4\u05e9\u05c1\u05bc\u05b0\u05de\u05b6\u0594\u05da\u05b8 \u05d5\u05b4\u05bd\u05d9\u05d2\u05b7\u05d3\u05bc\u05b5\u05a5\u05dc \u05d0\u05b6\u05ea\u05be\u05db\u05bc\u05b4\u05e1\u05b0\u05d0\u05b9\u0596\u05d5 \u05de\u05b4\u05db\u05bc\u05b4\u05e1\u05b0\u05d0\u05b6\u0591\u05da\u05b8 \u05d5\u05b7\u05d9\u05bc\u05b4\u05e9\u05c1\u05b0\u05ea\u05bc\u05b7\u05a5\u05d7\u05d5\u05bc \u05d4\u05b7\u05de\u05bc\u05b6\u0596\u05dc\u05b6\u05da\u05b0 \u05e2\u05b7\u05dc\u05be\u05d4\u05b7\u05de\u05bc\u05b4\u05e9\u05c1\u05b0\u05db\u05bc\u05b8\u05bd\u05d1\u05c3"}, {"pk": 8769, "verse": 48, "text": "\u05d5\u05b0\u05d2\u05b7\u05dd\u05be\u05db\u05bc\u05b8\u0596\u05db\u05b8\u05d4 \u05d0\u05b8\u05de\u05b7\u05a3\u05e8 \u05d4\u05b7\u05de\u05bc\u05b6\u0591\u05dc\u05b6\u05da\u05b0 \u05d1\u05bc\u05b8\u05e8\u05a8\u05d5\u05bc\u05da\u05b0 \u05d9\u05b0\u05d4\u05d5\u05b8\u059c\u05d4 \u05d0\u05b1\u05dc\u05b9\u05d4\u05b5\u05a3\u05d9 \u05d9\u05b4\u05e9\u05c2\u05b0\u05e8\u05b8\u05d0\u05b5\u0597\u05dc \u05d0\u05b2\u05e9\u05c1\u05b6\u05a8\u05e8 \u05e0\u05b8\u05ea\u05b7\u05a5\u05df \u05d4\u05b7\u05d9\u05bc\u05b9\u059b\u05d5\u05dd \u05d9\u05b9\u05e9\u05c1\u05b5\u05a5\u05d1 \u05e2\u05b7\u05dc\u05be\u05db\u05bc\u05b4\u05e1\u05b0\u05d0\u05b4\u0596\u05d9 \u05d5\u05b0\u05e2\u05b5\u05d9\u05e0\u05b7\u05a5\u05d9 \u05e8\u05b9\u05d0\u05b9\u05bd\u05d5\u05ea\u05c3"}, {"pk": 8770, "verse": 49, "text": "\u05d5\u05b7\u05d9\u05bc\u05bd\u05b6\u05d7\u05b6\u05e8\u05b0\u05d3\u05d5\u05bc\u0599 \u05d5\u05b7\u05d9\u05bc\u05b8\u05e7\u05bb\u0594\u05de\u05d5\u05bc \u05db\u05bc\u05b8\u05dc\u05be\u05d4\u05b7\u05a8\u05e7\u05bc\u05b0\u05e8\u05bb\u05d0\u05b4\u0594\u05d9\u05dd \u05d0\u05b2\u05e9\u05c1\u05b6\u0596\u05e8 \u05dc\u05b7\u05d0\u05b2\u05d3\u05b9\u05e0\u05b4\u05d9\u05bc\u05b8\u0591\u05d4\u05d5\u05bc \u05d5\u05b7\u05d9\u05bc\u05b5\u05dc\u05b0\u05db\u0596\u05d5\u05bc \u05d0\u05b4\u05a5\u05d9\u05e9\u05c1 \u05dc\u05b0\u05d3\u05b7\u05e8\u05b0\u05db\u05bc\u05b9\u05bd\u05d5\u05c3"}, {"pk": 8771, "verse": 50, "text": "\u05d5\u05b7\u05d0\u05b2\u05d3\u05b9\u05a3\u05e0\u05b4\u05d9\u05bc\u05b8\u0594\u05d4\u05d5\u05bc \u05d9\u05b8\u05e8\u05b5\u0596\u05d0 \u05de\u05b4\u05e4\u05bc\u05b0\u05e0\u05b5\u05a3\u05d9 \u05e9\u05c1\u05b0\u05dc\u05b9\u05de\u05b9\u0591\u05d4 \u05d5\u05b7\u05d9\u05bc\u05b8\u05a3\u05e7\u05b8\u05dd \u05d5\u05b7\u05d9\u05bc\u05b5\u0594\u05dc\u05b6\u05da\u05b0 \u05d5\u05b7\u05bd\u05d9\u05bc\u05b7\u05d7\u05b2\u05d6\u05b5\u0596\u05e7 \u05d1\u05bc\u05b0\u05e7\u05b7\u05e8\u05b0\u05e0\u05b9\u05a5\u05d5\u05ea \u05d4\u05b7\u05de\u05bc\u05b4\u05d6\u05b0\u05d1\u05bc\u05b5\u05bd\u05d7\u05b7\u05c3"}, {"pk": 8772, "verse": 51, "text": "\u05d5\u05b7\u05d9\u05bc\u05bb\u05d2\u05bc\u05b7\u05a4\u05d3 \u05dc\u05b4\u05e9\u05c1\u05b0\u05dc\u05b9\u05de\u05b9\u05d4\u0599 \u05dc\u05b5\u05d0\u05de\u05b9\u0594\u05e8 \u05d4\u05b4\u05e0\u05bc\u05b5\u05d4\u0599 \u05d0\u05b2\u05d3\u05b9\u05a3\u05e0\u05b4\u05d9\u05bc\u05b8\u0594\u05d4\u05d5\u05bc \u05d9\u05b8\u05e8\u05b5\u0596\u05d0 \u05d0\u05b6\u05ea\u05be\u05d4\u05b7\u05de\u05bc\u05b6\u05a3\u05dc\u05b6\u05da\u05b0 \u05e9\u05c1\u05b0\u05dc\u05b9\u05de\u05b9\u0591\u05d4 \u05d5\u05b0\u05a0\u05d4\u05b4\u05e0\u05bc\u05b5\u05d4 \u05d0\u05b8\u05d7\u05b7\u059e\u05d6 \u05d1\u05bc\u05b0\u05e7\u05b7\u05e8\u05b0\u05e0\u05b9\u05a4\u05d5\u05ea \u05d4\u05b7\u05de\u05bc\u05b4\u05d6\u05b0\u05d1\u05bc\u05b5\u0599\u05d7\u05b7\u0599 \u05dc\u05b5\u05d0\u05de\u05b9\u0594\u05e8 \u05d9\u05b4\u05e9\u05c1\u05bc\u05b8\u05bd\u05d1\u05b7\u05bd\u05e2\u05be\u05dc\u05b4\u05a4\u05d9 \u05db\u05b7\u05d9\u05bc\u05b9\u05d5\u05dd\u0599 \u05d4\u05b7\u05de\u05bc\u05b6\u05a3\u05dc\u05b6\u05da\u05b0 \u05e9\u05c1\u05b0\u05dc\u05b9\u05de\u05b9\u0594\u05d4 \u05d0\u05b4\u05dd\u05be\u05d9\u05b8\u05de\u05b4\u05a5\u05d9\u05ea \u05d0\u05b6\u05ea\u05be\u05e2\u05b7\u05d1\u05b0\u05d3\u05bc\u05b9\u0596\u05d5 \u05d1\u05bc\u05b6\u05d7\u05b8\u05bd\u05e8\u05b6\u05d1\u05c3"}, {"pk": 8773, "verse": 52, "text": "\u05d5\u05b7\u05d9\u05bc\u05b9\u05a3\u05d0\u05de\u05b6\u05e8 \u05e9\u05c1\u05b0\u05dc\u05b9\u05de\u05b9\u0594\u05d4 \u05d0\u05b4\u059a\u05dd \u05d9\u05b4\u05d4\u05b0\u05d9\u05b6\u05a3\u05d4 \u05dc\u05b0\u05d1\u05b6\u05df\u05be\u05d7\u05b7\u0594\u05d9\u05b4\u05dc \u05dc\u05b9\u05bd\u05d0\u05be\u05d9\u05b4\u05e4\u05bc\u05b9\u05a5\u05dc \u05de\u05b4\u05e9\u05c2\u05bc\u05b7\u05e2\u05b2\u05e8\u05b8\u05ea\u05b9\u0596\u05d5 \u05d0\u05b8\u0591\u05e8\u05b0\u05e6\u05b8\u05d4 \u05d5\u05b0\u05d0\u05b4\u05dd\u05be\u05e8\u05b8\u05e2\u05b8\u05a5\u05d4 \u05ea\u05b4\u05de\u05bc\u05b8\u05e6\u05b5\u05d0\u05be\u05d1\u05b9\u0596\u05d5 \u05d5\u05b8\u05de\u05b5\u05bd\u05ea\u05c3"}, {"pk": 8774, "verse": 53, "text": "\u05d5\u05b7\u05d9\u05bc\u05b4\u05e9\u05c1\u05b0\u05dc\u05b7\u059e\u05d7 \u05d4\u05b7\u05de\u05bc\u05b6\u05a3\u05dc\u05b6\u05da\u05b0 \u05e9\u05c1\u05b0\u05dc\u05b9\u05de\u05b9\u0597\u05d4 \u05d5\u05b7\u05d9\u05bc\u05b9\u05e8\u05b4\u05d3\u05bb\u0599\u05d4\u05d5\u05bc\u0599 \u05de\u05b5\u05e2\u05b7\u05a3\u05dc \u05d4\u05b7\u05de\u05bc\u05b4\u05d6\u05b0\u05d1\u05bc\u05b5\u0594\u05d7\u05b7 \u05d5\u05b7\u05d9\u05bc\u05b8\u05d1\u05b9\u0595\u05d0 \u05d5\u05b7\u05d9\u05bc\u05b4\u05e9\u05c1\u05b0\u05ea\u05bc\u05b7\u0596\u05d7\u05d5\u05bc \u05dc\u05b7\u05de\u05bc\u05b6\u05a3\u05dc\u05b6\u05da\u05b0 \u05e9\u05c1\u05b0\u05dc\u05b9\u05de\u05b9\u0591\u05d4 \u05d5\u05b7\u05d9\u05bc\u05b9\u05bd\u05d0\u05de\u05b6\u05e8\u05be\u05dc\u05b9\u05a5\u05d5 \u05e9\u05c1\u05b0\u05dc\u05b9\u05de\u05b9\u0596\u05d4 \u05dc\u05b5\u05a5\u05da\u05b0 \u05dc\u05b0\u05d1\u05b5\u05d9\u05ea\u05b6\u05bd\u05da\u05b8\u05c3  \u05e4"}]