[{"pk": 8939, "verse": 1, "text": "\u05d5\u05b0\u05d0\u05b6\u05ea\u05be\u05d1\u05bc\u05b5\u05d9\u05ea\u05b9\u05d5\u0599 \u05d1\u05bc\u05b8\u05e0\u05b8\u05a3\u05d4 \u05e9\u05c1\u05b0\u05dc\u05b9\u05de\u05b9\u0594\u05d4 \u05e9\u05c1\u05b0\u05dc\u05b9\u05a5\u05e9\u05c1 \u05e2\u05b6\u05e9\u05c2\u05b0\u05e8\u05b5\u0596\u05d4 \u05e9\u05c1\u05b8\u05e0\u05b8\u0591\u05d4 \u05d5\u05b7\u05d9\u05b0\u05db\u05b7\u0596\u05dc \u05d0\u05b6\u05ea\u05be\u05db\u05bc\u05b8\u05dc\u05be\u05d1\u05bc\u05b5\u05d9\u05ea\u05b9\u05bd\u05d5\u05c3"}, {"pk": 8940, "verse": 2, "text": "\u05d5\u05b7\u05d9\u05bc\u05b4\u059c\u05d1\u05b6\u05df \u05d0\u05b6\u05ea\u05be\u05d1\u05bc\u05b5\u05a3\u05d9\u05ea \u05c0 \u05d9\u05b7\u05a3\u05e2\u05b7\u05e8 \u05d4\u05b7\u05dc\u05bc\u05b0\u05d1\u05b8\u05e0\u05b9\u0597\u05d5\u05df \u05de\u05b5\u05d0\u05b8\u05a8\u05d4 \u05d0\u05b7\u05de\u05bc\u05b8\u05a4\u05d4 \u05d0\u05b8\u05e8\u05b0\u05db\u05bc\u05b9\u05d5\u0599 \u05d5\u05b7\u05d7\u05b2\u05de\u05b4\u05e9\u05c1\u05bc\u05b4\u05a4\u05d9\u05dd \u05d0\u05b7\u05de\u05bc\u05b8\u05d4\u0599 \u05e8\u05b8\u05d7\u05b0\u05d1\u05bc\u05b9\u0594\u05d5 \u05d5\u05bc\u05e9\u05c1\u05b0\u05dc\u05b9\u05e9\u05c1\u05b4\u05a5\u05d9\u05dd \u05d0\u05b7\u05de\u05bc\u05b8\u0596\u05d4 \u05e7\u05b9\u05d5\u05de\u05b8\u05ea\u05b9\u0591\u05d5 \u05e2\u05b7\u0597\u05dc \u05d0\u05b7\u05e8\u05b0\u05d1\u05bc\u05b8\u05e2\u05b8\u05d4\u0599 \u05d8\u05d5\u05bc\u05e8\u05b5\u05d9\u0599 \u05e2\u05b7\u05de\u05bc\u05d5\u05bc\u05d3\u05b5\u05a3\u05d9 \u05d0\u05b2\u05e8\u05b8\u05d6\u05b4\u0594\u05d9\u05dd \u05d5\u05bc\u05db\u05b0\u05e8\u05bb\u05ea\u05b9\u05a5\u05d5\u05ea \u05d0\u05b2\u05e8\u05b8\u05d6\u05b4\u0596\u05d9\u05dd \u05e2\u05b7\u05dc\u05be\u05d4\u05b8\u05e2\u05b7\u05de\u05bc\u05d5\u05bc\u05d3\u05b4\u05bd\u05d9\u05dd\u05c3"}, {"pk": 8941, "verse": 3, "text": "\u05d5\u05b0\u05e1\u05b8\u05e4\u05bb\u05a3\u05df \u05d1\u05bc\u05b8\u05d0\u05b6\u0597\u05e8\u05b6\u05d6 \u05de\u05b4\u05de\u05bc\u05b7\u0599\u05e2\u05b7\u05dc\u0599 \u05e2\u05b7\u05dc\u05be\u05d4\u05b7\u05e6\u05bc\u05b0\u05dc\u05b8\u05e2\u05b9\u05ea\u0599 \u05d0\u05b2\u05e9\u05c1\u05b6\u05a3\u05e8 \u05e2\u05b7\u05dc\u05be\u05d4\u05b8\u05bd\u05e2\u05b7\u05de\u05bc\u05d5\u05bc\u05d3\u05b4\u0594\u05d9\u05dd \u05d0\u05b7\u05e8\u05b0\u05d1\u05bc\u05b8\u05e2\u05b4\u0596\u05d9\u05dd \u05d5\u05b7\u05d7\u05b2\u05de\u05b4\u05e9\u05c1\u05bc\u05b8\u0591\u05d4 \u05d7\u05b2\u05de\u05b4\u05e9\u05c1\u05bc\u05b8\u05a5\u05d4 \u05e2\u05b8\u05e9\u05c2\u05b8\u0596\u05e8 \u05d4\u05b7\u05d8\u05bc\u05bd\u05d5\u05bc\u05e8\u05c3"}, {"pk": 8942, "verse": 4, "text": "\u05d5\u05bc\u05e9\u05c1\u05b0\u05e7\u05bb\u05e4\u05b4\u0596\u05d9\u05dd \u05e9\u05c1\u05b0\u05dc\u05b9\u05e9\u05c1\u05b8\u05a3\u05d4 \u05d8\u05d5\u05bc\u05e8\u05b4\u0591\u05d9\u05dd \u05d5\u05bc\u05de\u05b6\u05d7\u05b1\u05d6\u05b8\u05a5\u05d4 \u05d0\u05b6\u05dc\u05be\u05de\u05b6\u05d7\u05b1\u05d6\u05b8\u0596\u05d4 \u05e9\u05c1\u05b8\u05dc\u05b9\u05a5\u05e9\u05c1 \u05e4\u05bc\u05b0\u05e2\u05b8\u05de\u05b4\u05bd\u05d9\u05dd\u05c3"}, {"pk": 8943, "verse": 5, "text": "\u05d5\u05b0\u05db\u05b8\u05dc\u05be\u05d4\u05b7\u05e4\u05bc\u05b0\u05ea\u05b8\u05d7\u05b4\u05a5\u05d9\u05dd \u05d5\u05b0\u05d4\u05b7\u05de\u05bc\u05b0\u05d6\u05d5\u05bc\u05d6\u05b9\u0596\u05d5\u05ea \u05e8\u05b0\u05d1\u05bb\u05e2\u05b4\u05a3\u05d9\u05dd \u05e9\u05c1\u05b8\u0591\u05e7\u05b6\u05e3 \u05d5\u05bc\u05de\u05a7\u05d5\u05bc\u05dc \u05de\u05b6\u05d7\u05b1\u05d6\u05b8\u059b\u05d4 \u05d0\u05b6\u05dc\u05be\u05de\u05b6\u05d7\u05b1\u05d6\u05b8\u0596\u05d4 \u05e9\u05c1\u05b8\u05dc\u05b9\u05a5\u05e9\u05c1 \u05e4\u05bc\u05b0\u05e2\u05b8\u05de\u05b4\u05bd\u05d9\u05dd\u05c3"}, {"pk": 8944, "verse": 6, "text": "\u05d5\u05b0\u05d0\u05b5\u05a8\u05ea \u05d0\u05d5\u05bc\u05dc\u05b8\u05a4\u05dd \u05d4\u05b8\u05bd\u05e2\u05b7\u05de\u05bc\u05d5\u05bc\u05d3\u05b4\u05d9\u05dd\u0599 \u05e2\u05b8\u05e9\u05c2\u05b8\u0594\u05d4 \u05d7\u05b2\u05de\u05b4\u05e9\u05c1\u05bc\u05b4\u05a4\u05d9\u05dd \u05d0\u05b7\u05de\u05bc\u05b8\u05d4\u0599 \u05d0\u05b8\u05e8\u05b0\u05db\u05bc\u05b9\u0594\u05d5 \u05d5\u05bc\u05e9\u05c1\u05b0\u05dc\u05b9\u05e9\u05c1\u05b4\u05a5\u05d9\u05dd \u05d0\u05b7\u05de\u05bc\u05b8\u0596\u05d4 \u05e8\u05b8\u05d7\u05b0\u05d1\u05bc\u05b9\u0591\u05d5 \u05d5\u05b0\u05d0\u05d5\u05bc\u05dc\u05b8\u05dd\u0599 \u05e2\u05b7\u05dc\u05be\u05e4\u05bc\u05b0\u05e0\u05b5\u05d9\u05d4\u05b6\u0594\u05dd \u05d5\u05b0\u05e2\u05b7\u05de\u05bc\u05bb\u05d3\u05b4\u05a5\u05d9\u05dd \u05d5\u05b0\u05e2\u05b8\u0596\u05d1 \u05e2\u05b7\u05dc\u05be\u05e4\u05bc\u05b0\u05e0\u05b5\u05d9\u05d4\u05b6\u05bd\u05dd\u05c3"}, {"pk": 8945, "verse": 7, "text": "\u05d5\u05b0\u05d0\u05d5\u05bc\u05dc\u05b8\u05a4\u05dd \u05d4\u05b7\u05db\u05bc\u05b4\u05e1\u05bc\u05b5\u05d0\u0599 \u05d0\u05b2\u05e9\u05c1\u05b6\u05a3\u05e8 \u05d9\u05b4\u05e9\u05c1\u05b0\u05e4\u05bc\u05b8\u05d8\u05be\u05e9\u05c1\u05b8\u0594\u05dd \u05d0\u05bb\u05dc\u05b8\u05a5\u05dd \u05d4\u05b7\u05de\u05bc\u05b4\u05e9\u05c1\u05b0\u05e4\u05bc\u05b8\u0596\u05d8 \u05e2\u05b8\u05e9\u05c2\u05b8\u0591\u05d4 \u05d5\u05b0\u05e1\u05b8\u05e4\u05a3\u05d5\u05bc\u05df \u05d1\u05bc\u05b8\u05d0\u05b6\u0594\u05e8\u05b6\u05d6 \u05de\u05b5\u05d4\u05b7\u05e7\u05bc\u05b7\u05e8\u05b0\u05e7\u05b7\u0596\u05e2 \u05e2\u05b7\u05d3\u05be\u05d4\u05b7\u05e7\u05bc\u05b7\u05e8\u05b0\u05e7\u05b8\u05bd\u05e2\u05c3"}, {"pk": 8946, "verse": 8, "text": "\u05d5\u05bc\u05d1\u05b5\u05d9\u05ea\u05b9\u05d5\u05a9 \u05d0\u05b2\u05e9\u05c1\u05b6\u05e8\u05be\u05d9\u05b5\u05a8\u05e9\u05c1\u05b6\u05d1 \u05e9\u05c1\u05b8\u059c\u05dd \u05d7\u05b8\u05e6\u05b5\u05a3\u05e8 \u05d4\u05b8\u05d0\u05b7\u05d7\u05b6\u0597\u05e8\u05b6\u05ea \u05de\u05b4\u05d1\u05bc\u05b5\u05d9\u05ea\u0599 \u05dc\u05b8\u05bd\u05d0\u05d5\u05bc\u05dc\u05b8\u0594\u05dd \u05db\u05bc\u05b7\u05de\u05bc\u05b7\u05bd\u05e2\u05b2\u05e9\u05c2\u05b6\u05a5\u05d4 \u05d4\u05b7\u05d6\u05bc\u05b6\u0596\u05d4 \u05d4\u05b8\u05d9\u05b8\u0591\u05d4 \u05d5\u05bc\u05d1\u05b7\u059c\u05d9\u05b4\u05ea \u05d9\u05b7\u05e2\u05b2\u05e9\u05c2\u05b6\u05a4\u05d4 \u05dc\u05b0\u05d1\u05b7\u05ea\u05be\u05e4\u05bc\u05b7\u05e8\u05b0\u05e2\u05b9\u05d4\u0599 \u05d0\u05b2\u05e9\u05c1\u05b6\u05a3\u05e8 \u05dc\u05b8\u05e7\u05b7\u05a3\u05d7 \u05e9\u05c1\u05b0\u05dc\u05b9\u05de\u05b9\u0594\u05d4 \u05db\u05bc\u05b8\u05d0\u05d5\u05bc\u05dc\u05b8\u0596\u05dd \u05d4\u05b7\u05d6\u05bc\u05b6\u05bd\u05d4\u05c3"}, {"pk": 8947, "verse": 9, "text": "\u05db\u05bc\u05b8\u05dc\u05be\u05d0\u05b5\u059c\u05dc\u05bc\u05b6\u05d4 \u05d0\u05b2\u05d1\u05b8\u05e0\u05b4\u05a4\u05d9\u05dd \u05d9\u05b0\u05e7\u05b8\u05e8\u05b9\u05ea\u0599 \u05db\u05bc\u05b0\u05de\u05b4\u05d3\u05bc\u05b9\u05a3\u05ea \u05d2\u05bc\u05b8\u05d6\u05b4\u0594\u05d9\u05ea \u05de\u05b0\u05d2\u05b9\u05e8\u05b8\u05e8\u05b9\u05a5\u05d5\u05ea \u05d1\u05bc\u05b7\u05de\u05bc\u05b0\u05d2\u05b5\u05e8\u05b8\u0596\u05d4 \u05de\u05b4\u05d1\u05bc\u05b7\u05a3\u05d9\u05b4\u05ea \u05d5\u05bc\u05de\u05b4\u05d7\u0591\u05d5\u05bc\u05e5 \u05d5\u05bc\u05de\u05b4\u05de\u05bc\u05b7\u05e1\u05bc\u05b8\u05d3\u0599 \u05e2\u05b7\u05d3\u05be\u05d4\u05b7\u05d8\u05bc\u05b0\u05e4\u05b8\u05d7\u05b9\u0594\u05d5\u05ea \u05d5\u05bc\u05de\u05b4\u05d7\u0596\u05d5\u05bc\u05e5 \u05e2\u05b7\u05d3\u05be\u05d4\u05b6\u05d7\u05b8\u05e6\u05b5\u05a5\u05e8 \u05d4\u05b7\u05d2\u05bc\u05b0\u05d3\u05b9\u05d5\u05dc\u05b8\u05bd\u05d4\u05c3"}, {"pk": 8948, "verse": 10, "text": "\u05d5\u05bc\u05de\u05b0\u05d9\u05bb\u05e1\u05bc\u05b8\u0595\u05d3 \u05d0\u05b2\u05d1\u05b8\u05e0\u05b4\u05a5\u05d9\u05dd \u05d9\u05b0\u05e7\u05b8\u05e8\u05b9\u0596\u05d5\u05ea \u05d0\u05b2\u05d1\u05b8\u05e0\u05b4\u05a3\u05d9\u05dd \u05d2\u05bc\u05b0\u05d3\u05b9\u05dc\u05b9\u0591\u05d5\u05ea \u05d0\u05b7\u05d1\u05b0\u05e0\u05b5\u05d9\u0599 \u05e2\u05b6\u05a3\u05e9\u05c2\u05b6\u05e8 \u05d0\u05b7\u05de\u05bc\u05b9\u0594\u05d5\u05ea \u05d5\u05b0\u05d0\u05b7\u05d1\u05b0\u05e0\u05b5\u0596\u05d9 \u05e9\u05c1\u05b0\u05de\u05b9\u05e0\u05b6\u05a5\u05d4 \u05d0\u05b7\u05de\u05bc\u05b9\u05bd\u05d5\u05ea\u05c3"}, {"pk": 8949, "verse": 11, "text": "\u05d5\u05bc\u05de\u05b4\u05dc\u05b0\u05de\u05b7\u0597\u05e2\u05b0\u05dc\u05b8\u05d4 \u05d0\u05b2\u05d1\u05b8\u05e0\u05b4\u05a7\u05d9\u05dd \u05d9\u05b0\u05e7\u05b8\u05e8\u05b9\u059b\u05d5\u05ea \u05db\u05bc\u05b0\u05de\u05b4\u05d3\u05bc\u05b9\u05a5\u05d5\u05ea \u05d2\u05bc\u05b8\u05d6\u05b4\u0596\u05d9\u05ea \u05d5\u05b8\u05d0\u05b8\u05bd\u05e8\u05b6\u05d6\u05c3"}, {"pk": 8950, "verse": 12, "text": "\u05d5\u05b0\u05d7\u05b8\u05e6\u05b5\u05a8\u05e8 \u05d4\u05b7\u05d2\u05bc\u05b0\u05d3\u05b9\u05d5\u05dc\u05b8\u059c\u05d4 \u05e1\u05b8\u05d1\u05b4\u0597\u05d9\u05d1 \u05e9\u05c1\u05b0\u05dc\u05b9\u05e9\u05c1\u05b8\u05d4\u0599 \u05d8\u05d5\u05bc\u05e8\u05b4\u05a3\u05d9\u05dd \u05d2\u05bc\u05b8\u05d6\u05b4\u0594\u05d9\u05ea \u05d5\u05b0\u05d8\u0596\u05d5\u05bc\u05e8 \u05db\u05bc\u05b0\u05e8\u05bb\u05ea\u05b9\u05a3\u05ea \u05d0\u05b2\u05e8\u05b8\u05d6\u05b4\u0591\u05d9\u05dd \u05d5\u05b0\u05dc\u05b7\u05d7\u05b2\u05e6\u05b7\u05a7\u05e8 \u05d1\u05bc\u05b5\u05d9\u05ea\u05be\u05d9\u05b0\u05d4\u05d5\u05b8\u059b\u05d4 \u05d4\u05b7\u05e4\u05bc\u05b0\u05e0\u05b4\u05d9\u05de\u05b4\u0596\u05d9\u05ea \u05d5\u05bc\u05dc\u05b0\u05d0\u05bb\u05dc\u05b8\u05a5\u05dd \u05d4\u05b7\u05d1\u05bc\u05b8\u05bd\u05d9\u05b4\u05ea\u05c3  \u05e4"}, {"pk": 8951, "verse": 13, "text": "\u05d5\u05b7\u05d9\u05bc\u05b4\u05e9\u05c1\u05b0\u05dc\u05b7\u05d7\u0599 \u05d4\u05b7\u05de\u05bc\u05b6\u05a3\u05dc\u05b6\u05da\u05b0 \u05e9\u05c1\u05b0\u05dc\u05b9\u05de\u05b9\u0594\u05d4 \u05d5\u05b7\u05d9\u05bc\u05b4\u05e7\u05bc\u05b7\u05a5\u05d7 \u05d0\u05b6\u05ea\u05be\u05d7\u05b4\u05d9\u05e8\u05b8\u0596\u05dd \u05de\u05b4\u05e6\u05bc\u05b9\u05bd\u05e8\u05c3"}, {"pk": 8952, "verse": 14, "text": "\u05d1\u05bc\u05b6\u05df\u05be\u05d0\u05b4\u05e9\u05c1\u05bc\u05b8\u05d4\u05a9 \u05d0\u05b7\u05dc\u05b0\u05de\u05b8\u05e0\u05b8\u05a8\u05d4 \u05d4\u059c\u05d5\u05bc\u05d0 \u05de\u05b4\u05de\u05bc\u05b7\u05d8\u05bc\u05b5\u05a3\u05d4 \u05e0\u05b7\u05e4\u05b0\u05ea\u05bc\u05b8\u05dc\u05b4\u0597\u05d9 \u05d5\u05b0\u05d0\u05b8\u05d1\u05b4\u05a3\u05d9\u05d5 \u05d0\u05b4\u05d9\u05e9\u05c1\u05be\u05e6\u05b9\u05e8\u05b4\u05d9\u05ae \u05d7\u05b9\u05e8\u05b5\u05a3\u05e9\u05c1 \u05e0\u05b0\u05d7\u05b9\u05e9\u05c1\u05b6\u05ea\u0592 \u05d5\u05b7\u05a0\u05d9\u05bc\u05b4\u05de\u05bc\u05b8\u05dc\u05b5\u05d0 \u05d0\u05b6\u05ea\u05be\u05d4\u05b7\u05d7\u05b8\u05db\u05b0\u05de\u05b8\u05a4\u05d4 \u05d5\u05b0\u05d0\u05b6\u05ea\u05be\u05d4\u05b7\u05ea\u05bc\u05b0\u05d1\u05d5\u05bc\u05e0\u05b8\u05d4\u0599 \u05d5\u05b0\u05d0\u05b6\u05ea\u05be\u05d4\u05b7\u05d3\u05bc\u05b7\u0594\u05e2\u05b7\u05ea \u05dc\u05b7\u05e2\u05b2\u05e9\u05c2\u05b9\u05a5\u05d5\u05ea \u05db\u05bc\u05b8\u05dc\u05be\u05de\u05b0\u05dc\u05b8\u05d0\u05db\u05b8\u0596\u05d4 \u05d1\u05bc\u05b7\u05e0\u05bc\u05b0\u05d7\u05b9\u0591\u05e9\u05c1\u05b6\u05ea \u05d5\u05b7\u05d9\u05bc\u05b8\u05d1\u05b9\u05d5\u05d0\u0599 \u05d0\u05b6\u05dc\u05be\u05d4\u05b7\u05de\u05bc\u05b6\u05a3\u05dc\u05b6\u05da\u05b0 \u05e9\u05c1\u05b0\u05dc\u05b9\u05de\u05b9\u0594\u05d4 \u05d5\u05b7\u05d9\u05bc\u05b7\u0596\u05e2\u05b7\u05e9\u05c2 \u05d0\u05b6\u05ea\u05be\u05db\u05bc\u05b8\u05dc\u05be\u05de\u05b0\u05dc\u05b7\u05d0\u05db\u05b0\u05ea\u05bc\u05b9\u05bd\u05d5\u05c3"}, {"pk": 8953, "verse": 15, "text": "\u05d5\u05b7\u05d9\u05bc\u05b8\u059b\u05e6\u05b7\u05e8 \u05d0\u05b6\u05ea\u05be\u05e9\u05c1\u05b0\u05e0\u05b5\u05a5\u05d9 \u05d4\u05b8\u05e2\u05b7\u05de\u05bc\u05d5\u05bc\u05d3\u05b4\u0596\u05d9\u05dd \u05e0\u05b0\u05d7\u05b9\u0591\u05e9\u05c1\u05b6\u05ea \u05e9\u05c1\u05b0\u05de\u05b9\u05e0\u05b6\u05a8\u05d4 \u05e2\u05b6\u05e9\u05c2\u05b0\u05e8\u05b5\u059c\u05d4 \u05d0\u05b7\u05de\u05bc\u05b8\u0597\u05d4 \u05e7\u05b9\u05d5\u05de\u05b7\u05ea\u0599 \u05d4\u05b8\u05e2\u05b7\u05de\u05bc\u05a3\u05d5\u05bc\u05d3 \u05d4\u05b8\u05d0\u05b6\u05d7\u05b8\u0594\u05d3 \u05d5\u05b0\u05d7\u05d5\u05bc\u05d8\u0599 \u05e9\u05c1\u05b0\u05ea\u05bc\u05b5\u05d9\u05dd\u05be\u05e2\u05b6\u05e9\u05c2\u05b0\u05e8\u05b5\u05a3\u05d4 \u05d0\u05b7\u05de\u05bc\u05b8\u0594\u05d4 \u05d9\u05b8\u05e1\u05b9\u0596\u05d1 \u05d0\u05b6\u05ea\u05be\u05d4\u05b8\u05e2\u05b7\u05de\u05bc\u05a5\u05d5\u05bc\u05d3 \u05d4\u05b7\u05e9\u05c1\u05bc\u05b5\u05e0\u05b4\u05bd\u05d9\u05c3"}, {"pk": 8954, "verse": 16, "text": "\u05d5\u05bc\u05e9\u05c1\u05b0\u05ea\u05bc\u05b5\u05a8\u05d9 \u05db\u05b9\u05ea\u05b8\u05e8\u05b9\u059c\u05ea \u05e2\u05b8\u05e9\u05c2\u05b8\u0597\u05d4 \u05dc\u05b8\u05ea\u05b5\u059b\u05ea \u05e2\u05b7\u05dc\u05be\u05e8\u05b8\u05d0\u05e9\u05c1\u05b5\u05a5\u05d9 \u05d4\u05b8\u05bd\u05e2\u05b7\u05de\u05bc\u05d5\u05bc\u05d3\u05b4\u0596\u05d9\u05dd \u05de\u05bb\u05e6\u05b7\u05a3\u05e7 \u05e0\u05b0\u05d7\u05b9\u0591\u05e9\u05c1\u05b6\u05ea \u05d7\u05b8\u05de\u05b5\u05a3\u05e9\u05c1 \u05d0\u05b7\u05de\u05bc\u05b9\u0597\u05d5\u05ea \u05e7\u05b9\u05d5\u05de\u05b7\u05ea\u0599 \u05d4\u05b7\u05db\u05bc\u05b9\u05ea\u05b6\u05a3\u05e8\u05b6\u05ea \u05d4\u05b8\u05d0\u05b6\u05d7\u05b8\u0594\u05ea \u05d5\u05b0\u05d7\u05b8\u05de\u05b5\u05a3\u05e9\u05c1 \u05d0\u05b7\u05de\u05bc\u05b9\u0594\u05d5\u05ea \u05e7\u05b9\u05d5\u05de\u05b7\u0596\u05ea \u05d4\u05b7\u05db\u05bc\u05b9\u05ea\u05b6\u05a5\u05e8\u05b6\u05ea \u05d4\u05b7\u05e9\u05c1\u05bc\u05b5\u05e0\u05b4\u05bd\u05d9\u05ea\u05c3"}, {"pk": 8955, "verse": 17, "text": "\u05e9\u05c2\u05b0\u05d1\u05b8\u05db\u05b4\u059e\u05d9\u05dd \u05de\u05b7\u05e2\u05b2\u05e9\u05c2\u05b5\u05a3\u05d4 \u05e9\u05c2\u05b0\u05d1\u05b8\u05db\u05b8\u0597\u05d4 \u05d2\u05bc\u05b0\u05d3\u05b4\u05dc\u05b4\u05d9\u05dd\u0599 \u05de\u05b7\u05e2\u05b2\u05e9\u05c2\u05b5\u05a3\u05d4 \u05e9\u05c1\u05b7\u05e8\u05b0\u05e9\u05c1\u05b0\u05e8\u05b9\u0594\u05d5\u05ea \u05dc\u05b7\u05db\u05bc\u05b9\u05a3\u05ea\u05b8\u05e8\u05b9\u0594\u05ea \u05d0\u05b2\u05e9\u05c1\u05b6\u0596\u05e8 \u05e2\u05b7\u05dc\u05be\u05e8\u05b9\u05a3\u05d0\u05e9\u05c1 \u05d4\u05b8\u05e2\u05b7\u05de\u05bc\u05d5\u05bc\u05d3\u05b4\u0591\u05d9\u05dd \u05e9\u05c1\u05b4\u05d1\u05b0\u05e2\u05b8\u05d4\u0599 \u05dc\u05b7\u05db\u05bc\u05b9\u05ea\u05b6\u05a3\u05e8\u05b6\u05ea \u05d4\u05b8\u05d0\u05b6\u05d7\u05b8\u0594\u05ea \u05d5\u05b0\u05e9\u05c1\u05b4\u05d1\u05b0\u05e2\u05b8\u0596\u05d4 \u05dc\u05b7\u05db\u05bc\u05b9\u05ea\u05b6\u05a5\u05e8\u05b6\u05ea \u05d4\u05b7\u05e9\u05c1\u05bc\u05b5\u05e0\u05b4\u05bd\u05d9\u05ea\u05c3"}, {"pk": 8956, "verse": 18, "text": "\u05d5\u05b7\u05d9\u05bc\u05b7\u0596\u05e2\u05b7\u05e9\u05c2 \u05d0\u05b6\u05ea\u05be\u05d4\u05b8\u05e2\u05b7\u05de\u05bc\u05d5\u05bc\u05d3\u05b4\u0591\u05d9\u05dd \u05d5\u05bc\u05e9\u05c1\u05b0\u05e0\u05b5\u05d9\u05a9 \u05d8\u05d5\u05bc\u05e8\u05b4\u05a8\u05d9\u05dd \u05e1\u05b8\u05d1\u05b4\u059c\u05d9\u05d1 \u05e2\u05b7\u05dc\u05be\u05d4\u05b7\u05e9\u05c2\u05bc\u05b0\u05d1\u05b8\u05db\u05b8\u05a3\u05d4 \u05d4\u05b8\u05d0\u05b6\u05d7\u05b8\u0597\u05ea \u05dc\u05b0\u05db\u05b7\u05e1\u05bc\u05b9\u05a4\u05d5\u05ea \u05d0\u05b6\u05ea\u05be\u05d4\u05b7\u05db\u05bc\u05b9\u05bd\u05ea\u05b8\u05e8\u05b9\u05ea\u0599 \u05d0\u05b2\u05e9\u05c1\u05b6\u05e8\u0599 \u05e2\u05b7\u05dc\u05be\u05e8\u05b9\u05a3\u05d0\u05e9\u05c1 \u05d4\u05b8\u05bd\u05e8\u05b4\u05de\u05bc\u05b9\u05e0\u05b4\u0594\u05d9\u05dd \u05d5\u05b0\u05db\u05b5\u05a3\u05df \u05e2\u05b8\u05e9\u05c2\u05b8\u0594\u05d4 \u05dc\u05b7\u05db\u05bc\u05b9\u05ea\u05b6\u0596\u05e8\u05b6\u05ea \u05d4\u05b7\u05e9\u05c1\u05bc\u05b5\u05e0\u05b4\u05bd\u05d9\u05ea\u05c3"}, {"pk": 8957, "verse": 19, "text": "\u05d5\u05b0\u05db\u05b9\u05bd\u05ea\u05b8\u05e8\u05b9\u0597\u05ea \u05d0\u05b2\u05e9\u05c1\u05b6\u05e8\u0599 \u05e2\u05b7\u05dc\u05be\u05e8\u05b9\u05a3\u05d0\u05e9\u05c1 \u05d4\u05b8\u05e2\u05b7\u05de\u05bc\u05d5\u05bc\u05d3\u05b4\u0594\u05d9\u05dd \u05de\u05b7\u05e2\u05b2\u05e9\u05c2\u05b5\u0596\u05d4 \u05e9\u05c1\u05d5\u05bc\u05e9\u05c1\u05b7\u05a3\u05df \u05d1\u05bc\u05b8\u05bd\u05d0\u05d5\u05bc\u05dc\u05b8\u0591\u05dd \u05d0\u05b7\u05e8\u05b0\u05d1\u05bc\u05b7\u0596\u05e2 \u05d0\u05b7\u05de\u05bc\u05b9\u05bd\u05d5\u05ea\u05c3"}, {"pk": 8958, "verse": 20, "text": "\u05d5\u05b0\u05db\u05b9\u05ea\u05b8\u05e8\u05b9\u0597\u05ea \u05e2\u05b7\u05dc\u05be\u05e9\u05c1\u05b0\u05e0\u05b5\u05d9\u0599 \u05d4\u05b8\u05bd\u05e2\u05b7\u05de\u05bc\u05d5\u05bc\u05d3\u05b4\u0594\u05d9\u05dd \u05d2\u05bc\u05b7\u05dd\u05be\u05de\u05b4\u05de\u05bc\u05b7\u0599\u05e2\u05b7\u05dc\u0599 \u05de\u05b4\u05dc\u05bc\u05b0\u05e2\u05bb\u05de\u05bc\u05b7\u05a3\u05ea \u05d4\u05b7\u05d1\u05bc\u05b6\u0594\u05d8\u05b6\u05df \u05d0\u05b2\u05e9\u05c1\u05b6\u0596\u05e8 \u05dc\u05b0\u05e2\u05b5\u05a3\u05d1\u05b6\u05e8 [\u05e9\u05c2\u05b0\u05d1\u05b8\u05db\u05b8\u05d4 \u05db] (\u05d4\u05b7\u05e9\u05c2\u05bc\u05b0\u05d1\u05b8\u05db\u05b8\u0591\u05d4 \u05e7) \u05d5\u05b0\u05d4\u05b8\u05e8\u05b4\u05de\u05bc\u05b9\u05d5\u05e0\u05b4\u05a4\u05d9\u05dd \u05de\u05b8\u05d0\u05ea\u05b7\u0599\u05d9\u05b4\u05dd\u0599 \u05d8\u05bb\u05e8\u05b4\u05a3\u05d9\u05dd \u05e1\u05b8\u05d1\u05b4\u0594\u05d9\u05d1 \u05e2\u05b7\u0596\u05dc \u05d4\u05b7\u05db\u05bc\u05b9\u05ea\u05b6\u05a5\u05e8\u05b6\u05ea \u05d4\u05b7\u05e9\u05c1\u05bc\u05b5\u05e0\u05b4\u05bd\u05d9\u05ea\u05c3"}, {"pk": 8959, "verse": 21, "text": "\u05d5\u05b7\u05d9\u05bc\u05b8\u0599\u05e7\u05b6\u05dd\u0599 \u05d0\u05b6\u05ea\u05be\u05d4\u05b8\u05bd\u05e2\u05b7\u05de\u05bc\u05bb\u05d3\u05b4\u0594\u05d9\u05dd \u05dc\u05b0\u05d0\u05bb\u05dc\u05b8\u0596\u05dd \u05d4\u05b7\u05bd\u05d4\u05b5\u05d9\u05db\u05b8\u0591\u05dc \u05d5\u05b7\u05d9\u05bc\u05b8\u059c\u05e7\u05b6\u05dd \u05d0\u05b6\u05ea\u05be\u05d4\u05b8\u05e2\u05b7\u05de\u05bc\u05a3\u05d5\u05bc\u05d3 \u05d4\u05b7\u05d9\u05b0\u05de\u05b8\u05e0\u05b4\u0597\u05d9 \u05d5\u05b7\u05d9\u05bc\u05b4\u05e7\u05b0\u05e8\u05b8\u05a4\u05d0 \u05d0\u05b6\u05ea\u05be\u05e9\u05c1\u05b0\u05de\u05b9\u05d5\u0599 \u05d9\u05b8\u05db\u05b4\u0594\u05d9\u05df \u05d5\u05b7\u05d9\u05bc\u05b8\u0599\u05e7\u05b6\u05dd\u0599 \u05d0\u05b6\u05ea\u05be\u05d4\u05b8\u05e2\u05b7\u05de\u05bc\u05a3\u05d5\u05bc\u05d3 \u05d4\u05b7\u05e9\u05c2\u05bc\u05b0\u05de\u05b8\u05d0\u05dc\u05b4\u0594\u05d9 \u05d5\u05b7\u05d9\u05bc\u05b4\u05e7\u05b0\u05e8\u05b8\u05a5\u05d0 \u05d0\u05b6\u05ea\u05be\u05e9\u05c1\u05b0\u05de\u05b9\u0596\u05d5 \u05d1\u05bc\u05b9\u05bd\u05e2\u05b7\u05d6\u05c3"}, {"pk": 8960, "verse": 22, "text": "\u05d5\u05b0\u05e2\u05b7\u059b\u05dc \u05e8\u05b9\u05a5\u05d0\u05e9\u05c1 \u05d4\u05b8\u05e2\u05b7\u05de\u05bc\u05d5\u05bc\u05d3\u05b4\u0596\u05d9\u05dd \u05de\u05b7\u05e2\u05b2\u05e9\u05c2\u05b5\u05a3\u05d4 \u05e9\u05c1\u05b9\u05d5\u05e9\u05c1\u05b8\u0591\u05df \u05d5\u05b7\u05ea\u05bc\u05b4\u05ea\u05bc\u05b9\u0596\u05dd \u05de\u05b0\u05dc\u05b6\u05a5\u05d0\u05db\u05b6\u05ea \u05d4\u05b8\u05e2\u05b7\u05de\u05bc\u05d5\u05bc\u05d3\u05b4\u05bd\u05d9\u05dd\u05c3"}, {"pk": 8961, "verse": 23, "text": "\u05d5\u05b7\u05d9\u05bc\u05b7\u05a5\u05e2\u05b7\u05e9\u05c2 \u05d0\u05b6\u05ea\u05be\u05d4\u05b7\u05d9\u05bc\u05b8\u0596\u05dd \u05de\u05d5\u05bc\u05e6\u05b8\u0591\u05e7 \u05e2\u05b6\u05a3\u05e9\u05c2\u05b6\u05e8 \u05d1\u05bc\u05b8\u05a0\u05d0\u05b7\u05de\u05bc\u05b8\u05d4 \u05de\u05b4\u05e9\u05c2\u05bc\u05b0\u05e4\u05b8\u05ea\u05b9\u05a8\u05d5 \u05e2\u05b7\u05d3\u05be\u05e9\u05c2\u05b0\u05e4\u05b8\u05ea\u05b9\u059c\u05d5 \u05e2\u05b8\u05d2\u05b9\u05a3\u05dc \u05c0 \u05e1\u05b8\u05d1\u05b4\u0597\u05d9\u05d1 \u05d5\u05b0\u05d7\u05b8\u05de\u05b5\u05a4\u05e9\u05c1 \u05d1\u05bc\u05b8\u05bd\u05d0\u05b7\u05de\u05bc\u05b8\u05d4\u0599 \u05e7\u05b9\u05d5\u05de\u05b8\u05ea\u05b9\u0594\u05d5 [\u05d5\u05bc\u05e7\u05b0\u05d5\u05b5\u05d4 \u05db] (\u05d5\u05b0\u05e7\u05b8\u05d5\u0599 \u05e7) \u05e9\u05c1\u05b0\u05dc\u05b9\u05e9\u05c1\u05b4\u05a3\u05d9\u05dd \u05d1\u05bc\u05b8\u05bd\u05d0\u05b7\u05de\u05bc\u05b8\u0594\u05d4 \u05d9\u05b8\u05e1\u05b9\u05a5\u05d1 \u05d0\u05b9\u05ea\u05b9\u0596\u05d5 \u05e1\u05b8\u05d1\u05b4\u05bd\u05d9\u05d1\u05c3"}, {"pk": 8962, "verse": 24, "text": "\u05d5\u05bc\u05e4\u05b0\u05e7\u05b8\u05e2\u05b4\u05d9\u05dd\u05a9 \u05de\u05b4\u05ea\u05bc\u05b7\u05a8\u05d7\u05b7\u05ea \u05dc\u05b4\u05e9\u05c2\u05b0\u05e4\u05b8\u05ea\u05b9\u05a4\u05d5 \u05c0 \u05e1\u05b8\u05d1\u05b4\u05d9\u05d1\u0599 \u05e1\u05b9\u05d1\u05b0\u05d1\u05b4\u05a3\u05d9\u05dd \u05d0\u05b9\u05ea\u05b9\u0594\u05d5 \u05e2\u05b6\u059a\u05e9\u05c2\u05b6\u05e8 \u05d1\u05bc\u05b8\u05bd\u05d0\u05b7\u05de\u05bc\u05b8\u0594\u05d4 \u05de\u05b7\u05e7\u05bc\u05b4\u05e4\u05b4\u05a5\u05d9\u05dd \u05d0\u05b6\u05ea\u05be\u05d4\u05b7\u05d9\u05bc\u05b8\u0596\u05dd \u05e1\u05b8\u05d1\u05b4\u0591\u05d9\u05d1 \u05e9\u05c1\u05b0\u05e0\u05b5\u05a4\u05d9 \u05d8\u05d5\u05bc\u05e8\u05b4\u05d9\u05dd\u0599 \u05d4\u05b7\u05e4\u05bc\u05b0\u05e7\u05b8\u05e2\u05b4\u0594\u05d9\u05dd \u05d9\u05b0\u05e6\u05bb\u05e7\u05b4\u0596\u05d9\u05dd \u05d1\u05bc\u05b4\u05d9\u05e6\u05bb\u05e7\u05b8\u05ea\u05b9\u05bd\u05d5\u05c3"}, {"pk": 8963, "verse": 25, "text": "\u05e2\u05b9\u05de\u05b5\u059e\u05d3 \u05e2\u05b7\u05dc\u05be\u05e9\u05c1\u05b0\u05e0\u05b5\u05a7\u05d9 \u05e2\u05b8\u05e9\u05c2\u05b8\u05a3\u05e8 \u05d1\u05bc\u05b8\u05e7\u05b8\u0597\u05e8 \u05e9\u05c1\u05b0\u05dc\u05b9\u05e9\u05c1\u05b8\u05a3\u05d4 \u05e4\u05b9\u05e0\u05b4\u05a3\u05d9\u05dd \u05c0 \u05e6\u05b8\u05e4\u05b9\u05a1\u05d5\u05e0\u05b8\u05d4 \u05d5\u05bc\u05e9\u05c1\u05b0\u05dc\u05b9\u05e9\u05c1\u05b8\u05d4\u05a9 \u05e4\u05b9\u05e0\u05b4\u05a8\u05d9\u05dd \u05c0 \u05d9\u05b8\u059c\u05de\u05bc\u05b8\u05d4 \u05d5\u05bc\u05e9\u05c1\u05b0\u05dc\u05b9\u05e9\u05c1\u05b8\u05a3\u05d4 \u05c0 \u05e4\u05bc\u05b9\u05e0\u05b4\u05a3\u05d9\u05dd \u05e0\u05b6\u0597\u05d2\u05b0\u05d1\u05bc\u05b8\u05d4 \u05d5\u05bc\u05e9\u05c1\u05b0\u05dc\u05b9\u05e9\u05c1\u05b8\u05d4\u0599 \u05e4\u05bc\u05b9\u05e0\u05b4\u05a3\u05d9\u05dd \u05de\u05b4\u05d6\u05b0\u05e8\u05b8\u0594\u05d7\u05b8\u05d4 \u05d5\u05b0\u05d4\u05b7\u05d9\u05bc\u05b8\u05a5\u05dd \u05e2\u05b2\u05dc\u05b5\u05d9\u05d4\u05b6\u0596\u05dd \u05de\u05b4\u05dc\u05b0\u05de\u05b8\u0591\u05e2\u05b0\u05dc\u05b8\u05d4 \u05d5\u05b0\u05db\u05b8\u05dc\u05be\u05d0\u05b2\u05d7\u05b9\u05bd\u05e8\u05b5\u05d9\u05d4\u05b6\u0596\u05dd \u05d1\u05bc\u05b8\u05bd\u05d9\u05b0\u05ea\u05b8\u05d4\u05c3"}, {"pk": 8964, "verse": 26, "text": "\u05d5\u05b0\u05e2\u05b8\u05d1\u05b0\u05d9\u05b9\u05a3\u05d5 \u05d8\u05b6\u0594\u05e4\u05b7\u05d7 \u05d5\u05bc\u05e9\u05c2\u05b0\u05e4\u05b8\u05ea\u05b9\u059b\u05d5 \u05db\u05bc\u05b0\u05de\u05b7\u05e2\u05b2\u05e9\u05c2\u05b5\u05a5\u05d4 \u05e9\u05c2\u05b0\u05e4\u05b7\u05ea\u05be\u05db\u05bc\u05b9\u0596\u05d5\u05e1 \u05e4\u05bc\u05b6\u05a3\u05e8\u05b7\u05d7 \u05e9\u05c1\u05b9\u05d5\u05e9\u05c1\u05b8\u0591\u05df \u05d0\u05b7\u05dc\u05b0\u05e4\u05bc\u05b7\u05a5\u05d9\u05b4\u05dd \u05d1\u05bc\u05b7\u0596\u05ea \u05d9\u05b8\u05db\u05b4\u05bd\u05d9\u05dc\u05c3  \u05e4"}, {"pk": 8965, "verse": 27, "text": "\u05d5\u05b7\u05d9\u05bc\u05b7\u05a7\u05e2\u05b7\u05e9\u05c2 \u05d0\u05b6\u05ea\u05be\u05d4\u05b7\u05de\u05bc\u05b0\u05db\u05b9\u05e0\u05b9\u059b\u05d5\u05ea \u05e2\u05b6\u0596\u05e9\u05c2\u05b6\u05e8 \u05e0\u05b0\u05d7\u05b9\u0591\u05e9\u05c1\u05b6\u05ea \u05d0\u05b7\u05e8\u05b0\u05d1\u05bc\u05b7\u05a3\u05e2 \u05d1\u05bc\u05b8\u05d0\u05b7\u05de\u05bc\u05b8\u0597\u05d4 \u05d0\u05b9\u059a\u05e8\u05b6\u05da\u05b0 \u05d4\u05b7\u05de\u05bc\u05b0\u05db\u05b9\u05d5\u05e0\u05b8\u05a3\u05d4 \u05d4\u05b8\u05bd\u05d0\u05b6\u05d7\u05b8\u0594\u05ea \u05d5\u05b0\u05d0\u05b7\u05e8\u05b0\u05d1\u05bc\u05b7\u05a4\u05e2 \u05d1\u05bc\u05b8\u05bd\u05d0\u05b7\u05de\u05bc\u05b8\u05d4\u0599 \u05e8\u05b8\u05d7\u05b0\u05d1\u05bc\u05b8\u0594\u05d4\u05bc \u05d5\u05b0\u05e9\u05c1\u05b8\u05dc\u05b9\u05a5\u05e9\u05c1 \u05d1\u05bc\u05b8\u05d0\u05b7\u05de\u05bc\u05b8\u0596\u05d4 \u05e7\u05b9\u05d5\u05de\u05b8\u05ea\u05b8\u05bd\u05d4\u05bc\u05c3"}, {"pk": 8966, "verse": 28, "text": "\u05d5\u05b0\u05d6\u05b6\u059b\u05d4 \u05de\u05b7\u05e2\u05b2\u05e9\u05c2\u05b5\u05a5\u05d4 \u05d4\u05b7\u05de\u05bc\u05b0\u05db\u05b9\u05d5\u05e0\u05b8\u0596\u05d4 \u05de\u05b4\u05e1\u05b0\u05d2\u05bc\u05b0\u05e8\u05b9\u05a3\u05ea \u05dc\u05b8\u05d4\u05b6\u0591\u05dd \u05d5\u05bc\u05de\u05b4\u05e1\u05b0\u05d2\u05bc\u05b0\u05e8\u05b9\u0596\u05ea \u05d1\u05bc\u05b5\u05a5\u05d9\u05df \u05d4\u05b7\u05e9\u05c1\u05b0\u05dc\u05b7\u05d1\u05bc\u05b4\u05bd\u05d9\u05dd\u05c3"}, {"pk": 8967, "verse": 29, "text": "\u05d5\u05b0\u05e2\u05b7\u05bd\u05dc\u05be\u05d4\u05b7\u05de\u05bc\u05b4\u05e1\u05b0\u05d2\u05bc\u05b0\u05e8\u05b9\u059e\u05d5\u05ea \u05d0\u05b2\u05e9\u05c1\u05b6\u05a3\u05e8 \u05c0 \u05d1\u05bc\u05b5\u05a3\u05d9\u05df \u05d4\u05b7\u05e9\u05c1\u05b0\u05dc\u05b7\u05d1\u05bc\u05b4\u0597\u05d9\u05dd \u05d0\u05b2\u05e8\u05b8\u05d9\u05b9\u05a4\u05d5\u05ea \u05c0 \u05d1\u05bc\u05b8\u05e7\u05b8\u05e8\u0599 \u05d5\u05bc\u05db\u05b0\u05e8\u05d5\u05bc\u05d1\u05b4\u0594\u05d9\u05dd \u05d5\u05b0\u05e2\u05b7\u05dc\u05be\u05d4\u05b7\u05e9\u05c1\u05b0\u05dc\u05b7\u05d1\u05bc\u05b4\u0596\u05d9\u05dd \u05db\u05bc\u05b5\u05a3\u05df \u05de\u05b4\u05de\u05bc\u05b8\u0591\u05e2\u05b7\u05dc \u05d5\u05bc\u05de\u05b4\u05ea\u05bc\u05b7\u0599\u05d7\u05b7\u05ea\u0599 \u05dc\u05b7\u05d0\u05b2\u05e8\u05b8\u05d9\u05b9\u05a3\u05d5\u05ea \u05d5\u05b0\u05dc\u05b7\u05d1\u05bc\u05b8\u05e7\u05b8\u0594\u05e8 \u05dc\u05b9\u05d9\u05b9\u0596\u05d5\u05ea \u05de\u05b7\u05e2\u05b2\u05e9\u05c2\u05b5\u05a5\u05d4 \u05de\u05b9\u05d5\u05e8\u05b8\u05bd\u05d3\u05c3"}, {"pk": 8968, "verse": 30, "text": "\u05d5\u05b0\u05d0\u05b7\u05e8\u05b0\u05d1\u05bc\u05b8\u05e2\u05b8\u05d4\u05a9 \u05d0\u05b9\u05d5\u05e4\u05b7\u05e0\u05bc\u05b5\u05a8\u05d9 \u05e0\u05b0\u05d7\u05b9\u059c\u05e9\u05c1\u05b6\u05ea \u05dc\u05b7\u05de\u05bc\u05b0\u05db\u05b9\u05d5\u05e0\u05b8\u05a4\u05d4 \u05d4\u05b8\u05bd\u05d0\u05b7\u05d7\u05b7\u05ea\u0599 \u05d5\u05b0\u05e1\u05b7\u05e8\u05b0\u05e0\u05b5\u05a3\u05d9 \u05e0\u05b0\u05d7\u05b9\u0594\u05e9\u05c1\u05b6\u05ea \u05d5\u05b0\u05d0\u05b7\u05e8\u05b0\u05d1\u05bc\u05b8\u05e2\u05b8\u05a5\u05d4 \u05e4\u05b7\u05e2\u05b2\u05de\u05b9\u05ea\u05b8\u0596\u05d9\u05d5 \u05db\u05bc\u05b0\u05ea\u05b5\u05e4\u05b9\u05a3\u05ea \u05dc\u05b8\u05d4\u05b6\u0591\u05dd \u05de\u05b4\u05ea\u05bc\u05b7\u05a4\u05d7\u05b7\u05ea \u05dc\u05b7\u05db\u05bc\u05b4\u05d9\u05bc\u05b9\u05e8\u0599 \u05d4\u05b7\u05db\u05bc\u05b0\u05ea\u05b5\u05e4\u05b9\u05a3\u05ea \u05d9\u05b0\u05e6\u05bb\u05e7\u05b9\u0594\u05d5\u05ea \u05de\u05b5\u05e2\u05b5\u05a5\u05d1\u05b6\u05e8 \u05d0\u05b4\u0596\u05d9\u05e9\u05c1 \u05dc\u05b9\u05d9\u05b9\u05bd\u05d5\u05ea\u05c3"}, {"pk": 8969, "verse": 31, "text": "\u05d5\u05bc\u05a0\u05e4\u05b4\u05d9\u05d4\u05d5\u05bc \u05de\u05b4\u05d1\u05bc\u05b5\u05a8\u05d9\u05ea \u05dc\u05b7\u05db\u05bc\u05b9\u05ea\u05b6\u05a4\u05e8\u05b6\u05ea \u05d5\u05b8\u05de\u05b7\u0599\u05e2\u05b0\u05dc\u05b8\u05d4\u0599 \u05d1\u05bc\u05b8\u05bd\u05d0\u05b7\u05de\u05bc\u05b8\u0594\u05d4 \u05d5\u05bc\u05e4\u05b4\u0599\u05d9\u05d4\u05b8\u0599 \u05e2\u05b8\u05d2\u05b9\u05a3\u05dc \u05de\u05b7\u05e2\u05b2\u05e9\u05c2\u05b5\u05d4\u05be\u05db\u05b5\u0594\u05df \u05d0\u05b7\u05de\u05bc\u05b8\u0596\u05d4 \u05d5\u05b7\u05d7\u05b2\u05e6\u05b4\u05a3\u05d9 \u05d4\u05b8\u05bd\u05d0\u05b7\u05de\u05bc\u05b8\u0591\u05d4 \u05d5\u05b0\u05d2\u05b7\u05dd\u05be\u05e2\u05b7\u05dc\u05be\u05e4\u05bc\u05b4\u0599\u05d9\u05d4\u05b8\u0599 \u05de\u05b4\u05e7\u05b0\u05dc\u05b8\u05e2\u05b9\u0594\u05d5\u05ea \u05d5\u05bc\u05de\u05b4\u05e1\u05b0\u05d2\u05bc\u05b0\u05e8\u05b9\u05ea\u05b5\u05d9\u05d4\u05b6\u05a5\u05dd \u05de\u05b0\u05e8\u05bb\u05d1\u05bc\u05b8\u05e2\u05b9\u0596\u05d5\u05ea \u05dc\u05b9\u05a5\u05d0 \u05e2\u05b2\u05d2\u05bb\u05dc\u05bc\u05b9\u05bd\u05d5\u05ea\u05c3"}, {"pk": 8970, "verse": 32, "text": "\u05d5\u05b0\u05d0\u05b7\u05e8\u05b0\u05d1\u05bc\u05b7\u05a3\u05e2\u05b7\u05ea \u05d4\u05b8\u05d0\u05b9\u05bd\u05d5\u05e4\u05b7\u05e0\u05bc\u05b4\u0597\u05d9\u05dd \u05dc\u05b0\u05de\u05b4\u05ea\u05bc\u05b7\u0599\u05d7\u05b7\u05ea\u0599 \u05dc\u05b7\u05bd\u05de\u05bc\u05b4\u05e1\u05b0\u05d2\u05bc\u05b0\u05e8\u05b9\u0594\u05d5\u05ea \u05d5\u05b4\u05d9\u05d3\u05b9\u05a5\u05d5\u05ea \u05d4\u05b8\u05d0\u05b9\u05bd\u05d5\u05e4\u05b7\u05e0\u05bc\u05b4\u0596\u05d9\u05dd \u05d1\u05bc\u05b7\u05de\u05bc\u05b0\u05db\u05b9\u05d5\u05e0\u05b8\u0591\u05d4 \u05d5\u05b0\u05e7\u05b9\u05d5\u05de\u05b7\u05ea\u0599 \u05d4\u05b8\u05d0\u05b9\u05d5\u05e4\u05b7\u05a3\u05df \u05d4\u05b8\u05d0\u05b6\u05d7\u05b8\u0594\u05d3 \u05d0\u05b7\u05de\u05bc\u05b8\u0596\u05d4 \u05d5\u05b7\u05d7\u05b2\u05e6\u05b4\u05a5\u05d9 \u05d4\u05b8\u05d0\u05b7\u05de\u05bc\u05b8\u05bd\u05d4\u05c3"}, {"pk": 8971, "verse": 33, "text": "\u05d5\u05bc\u05de\u05b7\u05bd\u05e2\u05b2\u05e9\u05c2\u05b5\u05d4\u0599 \u05d4\u05b8\u05d0\u05b9\u05a3\u05d5\u05e4\u05b7\u05e0\u05bc\u05b4\u0594\u05d9\u05dd \u05db\u05bc\u05b0\u05de\u05b7\u05e2\u05b2\u05e9\u05c2\u05b5\u0596\u05d4 \u05d0\u05b9\u05d5\u05e4\u05b7\u05a3\u05df \u05d4\u05b7\u05de\u05bc\u05b6\u05e8\u05b0\u05db\u05bc\u05b8\u05d1\u05b8\u0591\u05d4 \u05d9\u05b0\u05d3\u05b9\u05d5\u05ea\u05b8\u05a3\u05dd \u05d5\u05b0\u05d2\u05b7\u05d1\u05bc\u05b5\u05d9\u05d4\u05b6\u0597\u05dd \u05d5\u05b0\u05d7\u05b4\u05e9\u05c1\u05bc\u05bb\u05e7\u05b5\u05d9\u05d4\u05b6\u059b\u05dd \u05d5\u05b0\u05d7\u05b4\u05e9\u05c1\u05bc\u05bb\u05e8\u05b5\u05d9\u05d4\u05b6\u0596\u05dd \u05d4\u05b7\u05db\u05bc\u05b9\u05a5\u05dc \u05de\u05d5\u05bc\u05e6\u05b8\u05bd\u05e7\u05c3"}, {"pk": 8972, "verse": 34, "text": "\u05d5\u05b0\u05d0\u05b7\u05e8\u05b0\u05d1\u05bc\u05b7\u05a3\u05e2 \u05db\u05bc\u05b0\u05ea\u05b5\u05e4\u05b9\u0594\u05d5\u05ea \u05d0\u05b6\u059a\u05dc \u05d0\u05b7\u05e8\u05b0\u05d1\u05bc\u05b7\u05a3\u05e2 \u05e4\u05bc\u05b4\u05e0\u05bc\u05b9\u0594\u05d5\u05ea \u05d4\u05b7\u05de\u05bc\u05b0\u05db\u05b9\u05e0\u05b8\u0596\u05d4 \u05d4\u05b8\u05bd\u05d0\u05b6\u05d7\u05b8\u0591\u05ea \u05de\u05b4\u05df\u05be\u05d4\u05b7\u05de\u05bc\u05b0\u05db\u05b9\u05e0\u05b8\u0596\u05d4 \u05db\u05bc\u05b0\u05ea\u05b5\u05e4\u05b6\u05bd\u05d9\u05d4\u05b8\u05c3"}, {"pk": 8973, "verse": 35, "text": "\u05d5\u05bc\u05d1\u05b0\u05e8\u05b9\u05a3\u05d0\u05e9\u05c1 \u05d4\u05b7\u05de\u05bc\u05b0\u05db\u05b9\u05d5\u05e0\u05b8\u0597\u05d4 \u05d7\u05b2\u05e6\u05b4\u05a7\u05d9 \u05d4\u05b8\u05d0\u05b7\u05de\u05bc\u05b8\u059b\u05d4 \u05e7\u05b9\u05d5\u05de\u05b8\u0596\u05d4 \u05e2\u05b8\u05d2\u05b9\u05a3\u05dc \u05c0 \u05e1\u05b8\u05d1\u05b4\u0591\u05d9\u05d1 \u05d5\u05b0\u05e2\u05b7\u05a8\u05dc \u05e8\u05b9\u05a4\u05d0\u05e9\u05c1 \u05d4\u05b7\u05de\u05bc\u05b0\u05db\u05b9\u05e0\u05b8\u05d4\u0599 \u05d9\u05b0\u05d3\u05b9\u05ea\u05b6\u0594\u05d9\u05d4\u05b8 \u05d5\u05bc\u05de\u05b4\u05e1\u05b0\u05d2\u05bc\u05b0\u05e8\u05b9\u05ea\u05b6\u0596\u05d9\u05d4\u05b8 \u05de\u05b4\u05de\u05bc\u05b6\u05bd\u05e0\u05bc\u05b8\u05d4\u05c3"}, {"pk": 8974, "verse": 36, "text": "\u05d5\u05b7\u05d9\u05b0\u05e4\u05b7\u05ea\u05bc\u05b7\u05a4\u05d7 \u05e2\u05b7\u05dc\u05be\u05d4\u05b7\u05dc\u05bc\u05bb\u05d7\u05b9\u05ea\u0599 \u05d9\u05b0\u05d3\u05b9\u05ea\u05b6\u0594\u05d9\u05d4\u05b8 \u05d5\u05b0\u05e2\u05b7\u05dc\u0599 [\u05d5\u05b7\u05de\u05b4\u05e1\u05b0\u05d2\u05bc\u05b0\u05e8\u05b9\u05ea\u05b6\u05d9\u05d4\u05b8 \u05db] (\u05de\u05b4\u05e1\u05b0\u05d2\u05bc\u05b0\u05e8\u05b9\u05ea\u05b6\u0594\u05d9\u05d4\u05b8 \u05e7) \u05db\u05bc\u05b0\u05e8\u05d5\u05bc\u05d1\u05b4\u0596\u05d9\u05dd \u05d0\u05b2\u05e8\u05b8\u05d9\u05b9\u05a3\u05d5\u05ea \u05d5\u05b0\u05ea\u05b4\u05de\u05b9\u05e8\u05b9\u0591\u05ea \u05db\u05bc\u05b0\u05de\u05b7\u05bd\u05e2\u05b7\u05e8\u05be\u05d0\u05b4\u05a5\u05d9\u05e9\u05c1 \u05d5\u05b0\u05dc\u05b9\u05d9\u05b9\u0596\u05d5\u05ea \u05e1\u05b8\u05d1\u05b4\u05bd\u05d9\u05d1\u05c3"}, {"pk": 8975, "verse": 37, "text": "\u05db\u05bc\u05b8\u05d6\u05b9\u05a3\u05d0\u05ea \u05e2\u05b8\u05e9\u05c2\u05b8\u0594\u05d4 \u05d0\u05b5\u0596\u05ea \u05e2\u05b6\u05a3\u05e9\u05c2\u05b6\u05e8 \u05d4\u05b7\u05de\u05bc\u05b0\u05db\u05b9\u05e0\u05b9\u0591\u05d5\u05ea \u05de\u05d5\u05bc\u05e6\u05b8\u05a8\u05e7 \u05d0\u05b6\u05d7\u05b8\u059c\u05d3 \u05de\u05b4\u05d3\u05bc\u05b8\u05a5\u05d4 \u05d0\u05b7\u05d7\u05b7\u059b\u05ea \u05e7\u05b6\u05a5\u05e6\u05b6\u05d1 \u05d0\u05b6\u05d7\u05b8\u0596\u05d3 \u05dc\u05b0\u05db\u05bb\u05dc\u05bc\u05b8\u05bd\u05d4\u05b0\u05e0\u05b8\u05d4\u05c3    \u05e1"}, {"pk": 8976, "verse": 38, "text": "\u05d5\u05b7\u05d9\u05bc\u05b7\u059b\u05e2\u05b7\u05e9\u05c2 \u05e2\u05b2\u05e9\u05c2\u05b8\u05e8\u05b8\u05a5\u05d4 \u05db\u05b4\u05d9\u05bc\u05b9\u05e8\u05b9\u0596\u05d5\u05ea \u05e0\u05b0\u05d7\u05b9\u0591\u05e9\u05c1\u05b6\u05ea \u05d0\u05b7\u05e8\u05b0\u05d1\u05bc\u05b8\u05e2\u05b4\u05a8\u05d9\u05dd \u05d1\u05bc\u05b7\u059c\u05ea \u05d9\u05b8\u05db\u05b4\u05a3\u05d9\u05dc \u05c0 \u05d4\u05b7\u05db\u05bc\u05b4\u05d9\u05bc\u05b9\u05a3\u05d5\u05e8 \u05d4\u05b8\u05d0\u05b6\u05d7\u05b8\u0597\u05d3 \u05d0\u05b7\u05e8\u05b0\u05d1\u05bc\u05b7\u05a4\u05e2 \u05d1\u05bc\u05b8\u05bd\u05d0\u05b7\u05de\u05bc\u05b8\u05d4\u0599 \u05d4\u05b7\u05db\u05bc\u05b4\u05d9\u05bc\u05b9\u05a3\u05d5\u05e8 \u05d4\u05b8\u05d0\u05b6\u05d7\u05b8\u0594\u05d3 \u05db\u05bc\u05b4\u05d9\u05bc\u05b9\u05a4\u05d5\u05e8 \u05d0\u05b6\u05d7\u05b8\u05d3\u0599 \u05e2\u05b7\u05dc\u05be\u05d4\u05b7\u05de\u05bc\u05b0\u05db\u05b9\u05d5\u05e0\u05b8\u05a3\u05d4 \u05d4\u05b8\u05d0\u05b7\u05d7\u05b7\u0594\u05ea \u05dc\u05b0\u05e2\u05b6\u0596\u05e9\u05c2\u05b6\u05e8 \u05d4\u05b7\u05de\u05bc\u05b0\u05db\u05b9\u05e0\u05b9\u05bd\u05d5\u05ea\u05c3"}, {"pk": 8977, "verse": 39, "text": "\u05d5\u05b7\u05d9\u05bc\u05b4\u05ea\u05bc\u05b5\u05df\u0599 \u05d0\u05b6\u05ea\u05be\u05d4\u05b7\u05de\u05bc\u05b0\u05db\u05b9\u05e0\u05b9\u0594\u05d5\u05ea \u05d7\u05b8\u05de\u05b5\u059e\u05e9\u05c1 \u05e2\u05b7\u05dc\u05be\u05db\u05bc\u05b6\u05a4\u05ea\u05b6\u05e3 \u05d4\u05b7\u05d1\u05bc\u05b7\u0599\u05d9\u05b4\u05ea\u0599 \u05de\u05b4\u05d9\u05bc\u05b8\u05de\u05b4\u0594\u05d9\u05df \u05d5\u05b0\u05d7\u05b8\u05de\u05b5\u059b\u05e9\u05c1 \u05e2\u05b7\u05dc\u05be\u05db\u05bc\u05b6\u05a5\u05ea\u05b6\u05e3 \u05d4\u05b7\u05d1\u05bc\u05b7\u0596\u05d9\u05b4\u05ea \u05de\u05b4\u05e9\u05c2\u05bc\u05b0\u05de\u05b9\u05d0\u05dc\u05b9\u0591\u05d5 \u05d5\u05b0\u05d0\u05b6\u05ea\u05be\u05d4\u05b7\u05d9\u05bc\u05b8\u0597\u05dd \u05e0\u05b8\u05ea\u05b7\u059e\u05df \u05de\u05b4\u05db\u05bc\u05b6\u05a8\u05ea\u05b6\u05e3 \u05d4\u05b7\u05d1\u05bc\u05b7\u05a7\u05d9\u05b4\u05ea \u05d4\u05b7\u05d9\u05b0\u05de\u05b8\u05e0\u05b4\u059b\u05d9\u05ea \u05e7\u05b5\u0596\u05d3\u05b0\u05de\u05b8\u05d4 \u05de\u05b4\u05de\u05bc\u05a5\u05d5\u05bc\u05dc \u05e0\u05b6\u05bd\u05d2\u05b6\u05d1\u05c3    \u05e1"}, {"pk": 8978, "verse": 40, "text": "\u05d5\u05b7\u05d9\u05bc\u05b7\u05a3\u05e2\u05b7\u05e9\u05c2 \u05d7\u05b4\u05d9\u05e8\u05b9\u0594\u05d5\u05dd \u05d0\u05b6\u05ea\u05be\u05d4\u05b7\u05a8\u05db\u05bc\u05b4\u05d9\u05bc\u05b9\u05e8\u05b9\u0594\u05d5\u05ea \u05d5\u05b0\u05d0\u05b6\u05ea\u05be\u05d4\u05b7\u05d9\u05bc\u05b8\u05e2\u05b4\u0596\u05d9\u05dd \u05d5\u05b0\u05d0\u05b6\u05ea\u05be\u05d4\u05b7\u05de\u05bc\u05b4\u05d6\u05b0\u05e8\u05b8\u05e7\u05b9\u0591\u05d5\u05ea \u05d5\u05b7\u05d9\u05b0\u05db\u05b7\u05a3\u05dc \u05d7\u05b4\u05d9\u05e8\u05b8\u0597\u05dd \u05dc\u05b7\u05bd\u05e2\u05b2\u05e9\u05c2\u05b9\u05d5\u05ea\u0599 \u05d0\u05b6\u05ea\u05be\u05db\u05bc\u05b8\u05dc\u05be\u05d4\u05b7\u05de\u05bc\u05b0\u05dc\u05b8\u05d0\u05db\u05b8\u0594\u05d4 \u05d0\u05b2\u05e9\u05c1\u05b6\u05a5\u05e8 \u05e2\u05b8\u05e9\u05c2\u05b8\u059b\u05d4 \u05dc\u05b7\u05de\u05bc\u05b6\u05a5\u05dc\u05b6\u05da\u05b0 \u05e9\u05c1\u05b0\u05dc\u05b9\u05de\u05b9\u0596\u05d4 \u05d1\u05bc\u05b5\u05a5\u05d9\u05ea \u05d9\u05b0\u05d4\u05d5\u05b8\u05bd\u05d4\u05c3"}, {"pk": 8979, "verse": 41, "text": "\u05e2\u05b7\u05de\u05bc\u05bb\u05d3\u05b4\u05a3\u05d9\u05dd \u05e9\u05c1\u05b0\u05e0\u05b7\u0594\u05d9\u05b4\u05dd \u05d5\u05b0\u05d2\u05bb\u05dc\u05bc\u05b9\u05a7\u05ea \u05d4\u05b7\u05db\u05bc\u05b9\u05ea\u05b8\u05e8\u05b9\u059b\u05ea \u05d0\u05b2\u05e9\u05c1\u05b6\u05e8\u05be\u05e2\u05b7\u05dc\u05be\u05e8\u05b9\u05a5\u05d0\u05e9\u05c1 \u05d4\u05b8\u05bd\u05e2\u05b7\u05de\u05bc\u05bb\u05d3\u05b4\u0596\u05d9\u05dd \u05e9\u05c1\u05b0\u05ea\u05bc\u05b8\u0591\u05d9\u05b4\u05dd \u05d5\u05b0\u05d4\u05b7\u05e9\u05c2\u05bc\u05b0\u05d1\u05b8\u05db\u05b9\u05a3\u05d5\u05ea \u05e9\u05c1\u05b0\u05ea\u05bc\u05b7\u0594\u05d9\u05b4\u05dd \u05dc\u05b0\u05db\u05b7\u05e1\u05bc\u05b9\u0597\u05d5\u05ea \u05d0\u05b6\u05ea\u05be\u05e9\u05c1\u05b0\u05ea\u05bc\u05b5\u05d9\u0599 \u05d2\u05bc\u05bb\u05dc\u05bc\u05b9\u05a3\u05ea \u05d4\u05b7\u05db\u05bc\u05b9\u05bd\u05ea\u05b8\u05e8\u05b9\u0594\u05ea \u05d0\u05b2\u05e9\u05c1\u05b6\u0596\u05e8 \u05e2\u05b7\u05dc\u05be\u05e8\u05b9\u05a5\u05d0\u05e9\u05c1 \u05d4\u05b8\u05e2\u05b7\u05de\u05bc\u05d5\u05bc\u05d3\u05b4\u05bd\u05d9\u05dd\u05c3"}, {"pk": 8980, "verse": 42, "text": "\u05d5\u05b0\u05d0\u05b6\u05ea\u05be\u05d4\u05b8\u05e8\u05b4\u05de\u05bc\u05b9\u05e0\u05b4\u059b\u05d9\u05dd \u05d0\u05b7\u05e8\u05b0\u05d1\u05bc\u05b7\u05a5\u05e2 \u05de\u05b5\u05d0\u05b9\u0596\u05d5\u05ea \u05dc\u05b4\u05e9\u05c1\u05b0\u05ea\u05bc\u05b5\u05a3\u05d9 \u05d4\u05b7\u05e9\u05c2\u05bc\u05b0\u05d1\u05b8\u05db\u05b9\u0591\u05d5\u05ea \u05e9\u05c1\u05b0\u05e0\u05b5\u05bd\u05d9\u05be\u05d8\u05d5\u05bc\u05e8\u05b4\u05a4\u05d9\u05dd \u05e8\u05b4\u05de\u05bc\u05b9\u05e0\u05b4\u05d9\u05dd\u0599 \u05dc\u05b7\u05e9\u05c2\u05bc\u05b0\u05d1\u05b8\u05db\u05b8\u05a3\u05d4 \u05d4\u05b8\u05bd\u05d0\u05b6\u05d7\u05b8\u0594\u05ea \u05dc\u05b0\u05db\u05b7\u05e1\u05bc\u05b9\u0597\u05d5\u05ea \u05d0\u05b6\u05ea\u05be\u05e9\u05c1\u05b0\u05ea\u05bc\u05b5\u05d9\u0599 \u05d2\u05bc\u05bb\u05dc\u05bc\u05b9\u05a3\u05ea \u05d4\u05b7\u05db\u05bc\u05b9\u05bd\u05ea\u05b8\u05e8\u05b9\u0594\u05ea \u05d0\u05b2\u05e9\u05c1\u05b6\u0596\u05e8 \u05e2\u05b7\u05dc\u05be\u05e4\u05bc\u05b0\u05e0\u05b5\u05a5\u05d9 \u05d4\u05b8\u05e2\u05b7\u05de\u05bc\u05d5\u05bc\u05d3\u05b4\u05bd\u05d9\u05dd\u05c3"}, {"pk": 8981, "verse": 43, "text": "\u05d5\u05b0\u05d0\u05b6\u05ea\u05be\u05d4\u05b7\u05de\u05bc\u05b0\u05db\u05b9\u05e0\u05b9\u0596\u05d5\u05ea \u05e2\u05b8\u0591\u05e9\u05c2\u05b6\u05e8 \u05d5\u05b0\u05d0\u05b6\u05ea\u05be\u05d4\u05b7\u05db\u05bc\u05b4\u05d9\u05bc\u05b9\u05e8\u05b9\u05a5\u05ea \u05e2\u05b2\u05e9\u05c2\u05b8\u05e8\u05b8\u0596\u05d4 \u05e2\u05b7\u05dc\u05be\u05d4\u05b7\u05de\u05bc\u05b0\u05db\u05b9\u05e0\u05b9\u05bd\u05d5\u05ea\u05c3"}, {"pk": 8982, "verse": 44, "text": "\u05d5\u05b0\u05d0\u05b6\u05ea\u05be\u05d4\u05b7\u05d9\u05bc\u05b8\u0596\u05dd \u05d4\u05b8\u05d0\u05b6\u05d7\u05b8\u0591\u05d3 \u05d5\u05b0\u05d0\u05b6\u05ea\u05be\u05d4\u05b7\u05d1\u05bc\u05b8\u05e7\u05b8\u05a5\u05e8 \u05e9\u05c1\u05b0\u05e0\u05b5\u05d9\u05dd\u05be\u05e2\u05b8\u05e9\u05c2\u05b8\u0596\u05e8 \u05ea\u05bc\u05b7\u05a5\u05d7\u05b7\u05ea \u05d4\u05b7\u05d9\u05bc\u05b8\u05bd\u05dd\u05c3"}, {"pk": 8983, "verse": 45, "text": "\u05d5\u05b0\u05d0\u05b6\u05ea\u05be\u05d4\u05b7\u05e1\u05bc\u05b4\u05d9\u05e8\u05b9\u05a8\u05d5\u05ea \u05d5\u05b0\u05d0\u05b6\u05ea\u05be\u05d4\u05b7\u05d9\u05bc\u05b8\u05e2\u05b4\u059c\u05d9\u05dd \u05d5\u05b0\u05d0\u05b6\u05ea\u05be\u05d4\u05b7\u05de\u05bc\u05b4\u05d6\u05b0\u05e8\u05b8\u05e7\u05b9\u0597\u05d5\u05ea \u05d5\u05b0\u05d0\u05b5\u05ea\u0599 \u05db\u05bc\u05b8\u05dc\u05be\u05d4\u05b7\u05db\u05bc\u05b5\u05dc\u05b4\u05a3\u05d9\u05dd [\u05d4\u05b8\u05d0\u05b9\u05d4\u05b6\u05dc \u05db] (\u05d4\u05b8\u05d0\u05b5\u0594\u05dc\u05bc\u05b6\u05d4  \u05e7) \u05d0\u05b2\u05e9\u05c1\u05b6\u05a8\u05e8 \u05e2\u05b8\u05e9\u05c2\u05b8\u05a5\u05d4 \u05d7\u05b4\u05d9\u05e8\u05b8\u059b\u05dd \u05dc\u05b7\u05de\u05bc\u05b6\u05a5\u05dc\u05b6\u05da\u05b0 \u05e9\u05c1\u05b0\u05dc\u05b9\u05de\u05b9\u0596\u05d4 \u05d1\u05bc\u05b5\u05a3\u05d9\u05ea \u05d9\u05b0\u05d4\u05d5\u05b8\u0591\u05d4 \u05e0\u05b0\u05d7\u05b9\u0596\u05e9\u05c1\u05b6\u05ea \u05de\u05b0\u05de\u05b9\u05e8\u05b8\u05bd\u05d8\u05c3"}, {"pk": 8984, "verse": 46, "text": "\u05d1\u05bc\u05b0\u05db\u05b4\u05db\u05bc\u05b7\u05a4\u05e8 \u05d4\u05b7\u05d9\u05bc\u05b7\u05e8\u05b0\u05d3\u05bc\u05b5\u05df\u0599 \u05d9\u05b0\u05e6\u05b8\u05e7\u05b8\u05a3\u05dd \u05d4\u05b7\u05de\u05bc\u05b6\u0594\u05dc\u05b6\u05da\u05b0 \u05d1\u05bc\u05b0\u05de\u05b7\u05e2\u05b2\u05d1\u05b5\u0596\u05d4 \u05d4\u05b8\u05d0\u05b2\u05d3\u05b8\u05de\u05b8\u0591\u05d4 \u05d1\u05bc\u05b5\u05a5\u05d9\u05df \u05e1\u05bb\u05db\u05bc\u05b9\u0596\u05d5\u05ea \u05d5\u05bc\u05d1\u05b5\u05a5\u05d9\u05df \u05e6\u05b8\u05e8\u05b0\u05ea\u05b8\u05bd\u05df\u05c3"}, {"pk": 8985, "verse": 47, "text": "\u05d5\u05b7\u05d9\u05bc\u05b7\u05e0\u05bc\u05b7\u05a4\u05d7 \u05e9\u05c1\u05b0\u05dc\u05b9\u05de\u05b9\u05d4\u0599 \u05d0\u05b6\u05ea\u05be\u05db\u05bc\u05b8\u05dc\u05be\u05d4\u05b7\u05db\u05bc\u05b5\u05dc\u05b4\u0594\u05d9\u05dd \u05de\u05b5\u05e8\u05b9\u0596\u05d1 \u05de\u05b0\u05d0\u05b9\u05a3\u05d3 \u05de\u05b0\u05d0\u05b9\u0591\u05d3 \u05dc\u05b9\u05a5\u05d0 \u05e0\u05b6\u05d7\u05b0\u05e7\u05b7\u0596\u05e8 \u05de\u05b4\u05e9\u05c1\u05b0\u05e7\u05b7\u05a5\u05dc \u05d4\u05b7\u05e0\u05bc\u05b0\u05d7\u05b9\u05bd\u05e9\u05c1\u05b6\u05ea\u05c3"}, {"pk": 8986, "verse": 48, "text": "\u05d5\u05b7\u05d9\u05bc\u05b7\u05a3\u05e2\u05b7\u05e9\u05c2 \u05e9\u05c1\u05b0\u05dc\u05b9\u05de\u05b9\u0594\u05d4 \u05d0\u05b5\u059a\u05ea \u05db\u05bc\u05b8\u05dc\u05be\u05d4\u05b7\u05db\u05bc\u05b5\u05dc\u05b4\u0594\u05d9\u05dd \u05d0\u05b2\u05e9\u05c1\u05b6\u0596\u05e8 \u05d1\u05bc\u05b5\u05a3\u05d9\u05ea \u05d9\u05b0\u05d4\u05d5\u05b8\u0591\u05d4 \u05d0\u05b5\u059a\u05ea \u05de\u05b4\u05d6\u05b0\u05d1\u05bc\u05b7\u05a3\u05d7 \u05d4\u05b7\u05d6\u05bc\u05b8\u05d4\u05b8\u0594\u05d1 \u05d5\u05b0\u05d0\u05b6\u05ea\u05be\u05d4\u05b7\u05e9\u05c1\u05bc\u05bb\u05dc\u05b0\u05d7\u05b8\u0597\u05df \u05d0\u05b2\u05e9\u05c1\u05b6\u05a5\u05e8 \u05e2\u05b8\u05dc\u05b8\u059b\u05d9\u05d5 \u05dc\u05b6\u05a5\u05d7\u05b6\u05dd \u05d4\u05b7\u05e4\u05bc\u05b8\u05e0\u05b4\u0596\u05d9\u05dd \u05d6\u05b8\u05d4\u05b8\u05bd\u05d1\u05c3"}, {"pk": 8987, "verse": 49, "text": "\u05d5\u05b0\u05d0\u05b6\u05ea\u05be\u05d4\u05b7\u05a0\u05de\u05bc\u05b0\u05e0\u05b9\u05e8\u05b9\u05d5\u05ea \u05d7\u05b8\u05de\u05b5\u05a8\u05e9\u05c1 \u05de\u05b4\u05d9\u05bc\u05b8\u05de\u05b4\u059c\u05d9\u05df \u05d5\u05b0\u05d7\u05b8\u05de\u05b5\u05a7\u05e9\u05c1 \u05de\u05b4\u05e9\u05c2\u05bc\u05b0\u05de\u05b9\u059b\u05d0\u05d5\u05dc \u05dc\u05b4\u05e4\u05b0\u05e0\u05b5\u05a5\u05d9 \u05d4\u05b7\u05d3\u05bc\u05b0\u05d1\u05b4\u0596\u05d9\u05e8 \u05d6\u05b8\u05d4\u05b8\u05a3\u05d1 \u05e1\u05b8\u05d2\u0591\u05d5\u05bc\u05e8 \u05d5\u05b0\u05d4\u05b7\u05e4\u05bc\u05b6\u05a7\u05e8\u05b7\u05d7 \u05d5\u05b0\u05d4\u05b7\u05e0\u05bc\u05b5\u05e8\u05b9\u059b\u05ea \u05d5\u05b0\u05d4\u05b7\u05de\u05bc\u05b6\u05dc\u05b0\u05e7\u05b7\u05d7\u05b7\u0596\u05d9\u05b4\u05dd \u05d6\u05b8\u05d4\u05b8\u05bd\u05d1\u05c3"}, {"pk": 8988, "verse": 50, "text": "\u05d5\u05b0\u05a0\u05d4\u05b7\u05e1\u05bc\u05b4\u05e4\u05bc\u05b9\u05d5\u05ea \u05d5\u05b0\u05d4\u05b7\u05bd\u05de\u05b0\u05d6\u05b7\u05de\u05bc\u05b0\u05e8\u05b9\u05a7\u05d5\u05ea \u05d5\u05b0\u05d4\u05b7\u05de\u05bc\u05b4\u05d6\u05b0\u05e8\u05b8\u05e7\u05b9\u059b\u05d5\u05ea \u05d5\u05b0\u05d4\u05b7\u05db\u05bc\u05b7\u05e4\u05bc\u05b9\u05a5\u05d5\u05ea \u05d5\u05b0\u05d4\u05b7\u05de\u05bc\u05b7\u05d7\u05b0\u05ea\u05bc\u05b9\u0596\u05d5\u05ea \u05d6\u05b8\u05d4\u05b8\u05a3\u05d1 \u05e1\u05b8\u05d2\u0591\u05d5\u05bc\u05e8 \u05d5\u05b0\u05d4\u05b7\u05e4\u05bc\u05b9\u05ea\u05b9\u05a1\u05d5\u05ea \u05dc\u05b0\u05d3\u05b7\u05dc\u05b0\u05ea\u05b9\u05d5\u05ea\u05a9 \u05d4\u05b7\u05d1\u05bc\u05b7\u05a8\u05d9\u05b4\u05ea \u05d4\u05b7\u05e4\u05bc\u05b0\u05e0\u05b4\u05d9\u05de\u05b4\u059c\u05d9 \u05dc\u05b0\u05e7\u05b9\u05a3\u05d3\u05b6\u05e9\u05c1 \u05d4\u05b7\u05e7\u05bc\u05b3\u05d3\u05b8\u05e9\u05c1\u05b4\u0597\u05d9\u05dd \u05dc\u05b0\u05d3\u05b7\u05dc\u05b0\u05ea\u05b5\u05a5\u05d9 \u05d4\u05b7\u05d1\u05bc\u05b7\u059b\u05d9\u05b4\u05ea \u05dc\u05b7\u05d4\u05b5\u05d9\u05db\u05b8\u0596\u05dc \u05d6\u05b8\u05d4\u05b8\u05bd\u05d1\u05c3  \u05e4"}, {"pk": 8989, "verse": 51, "text": "\u05d5\u05b7\u05ea\u05bc\u05b4\u05e9\u05c1\u05b0\u05dc\u05b7\u05dd\u0599 \u05db\u05bc\u05b8\u05dc\u05be\u05d4\u05b7\u05de\u05bc\u05b0\u05dc\u05b8\u05d0\u05db\u05b8\u0594\u05d4 \u05d0\u05b2\u05e9\u05c1\u05b6\u05a5\u05e8 \u05e2\u05b8\u05e9\u05c2\u05b8\u059b\u05d4 \u05d4\u05b7\u05de\u05bc\u05b6\u05a5\u05dc\u05b6\u05da\u05b0 \u05e9\u05c1\u05b0\u05dc\u05b9\u05de\u05b9\u0596\u05d4 \u05d1\u05bc\u05b5\u05a3\u05d9\u05ea \u05d9\u05b0\u05d4\u05d5\u05b8\u0591\u05d4 \u05d5\u05b7\u05d9\u05bc\u05b8\u05d1\u05b5\u05a8\u05d0 \u05e9\u05c1\u05b0\u05dc\u05b9\u05de\u05b9\u059c\u05d4 \u05d0\u05b6\u05ea\u05be\u05e7\u05b8\u05d3\u05b0\u05e9\u05c1\u05b5\u05a3\u05d9 \u05c0 \u05d3\u05bc\u05b8\u05d5\u05b4\u05a3\u05d3 \u05d0\u05b8\u05d1\u05b4\u0597\u05d9\u05d5 \u05d0\u05b6\u05ea\u05be\u05d4\u05b7\u05db\u05bc\u05b6\u05a4\u05e1\u05b6\u05e3 \u05d5\u05b0\u05d0\u05b6\u05ea\u05be\u05d4\u05b7\u05d6\u05bc\u05b8\u05d4\u05b8\u05d1\u0599 \u05d5\u05b0\u05d0\u05b6\u05ea\u05be\u05d4\u05b7\u05db\u05bc\u05b5\u05dc\u05b4\u0594\u05d9\u05dd \u05e0\u05b8\u05ea\u05b7\u0595\u05df \u05d1\u05bc\u05b0\u05d0\u05b9\u05e6\u05b0\u05e8\u05b9\u0596\u05d5\u05ea \u05d1\u05bc\u05b5\u05a5\u05d9\u05ea \u05d9\u05b0\u05d4\u05d5\u05b8\u05bd\u05d4\u05c3  \u05e4"}]