[{"pk": 11530, "verse": 1, "text": "\u05d5\u05b7\u05d9\u05bc\u05b4\u05de\u05b0\u05dc\u05b9\u059b\u05da\u05b0 \u05d9\u05b0\u05d4\u05b9\u05d5\u05e9\u05c1\u05b8\u05e4\u05b8\u05a5\u05d8 \u05d1\u05bc\u05b0\u05e0\u05b9\u0596\u05d5 \u05ea\u05bc\u05b7\u05d7\u05b0\u05ea\u05bc\u05b8\u0591\u05d9\u05d5 \u05d5\u05b7\u05d9\u05bc\u05b4\u05ea\u05b0\u05d7\u05b7\u05d6\u05bc\u05b5\u0596\u05e7 \u05e2\u05b7\u05dc\u05be\u05d9\u05b4\u05e9\u05c2\u05b0\u05e8\u05b8\u05d0\u05b5\u05bd\u05dc\u05c3"}, {"pk": 11531, "verse": 2, "text": "\u05d5\u05b7\u05d9\u05bc\u05b4\u05a8\u05ea\u05bc\u05b6\u05df\u05be\u05d7\u05b7\u0594\u05d9\u05b4\u05dc \u05d1\u05bc\u05b0\u05db\u05b8\u05dc\u05be\u05e2\u05b8\u05e8\u05b5\u05a5\u05d9 \u05d9\u05b0\u05d4\u05d5\u05bc\u05d3\u05b8\u0596\u05d4 \u05d4\u05b7\u05d1\u05bc\u05b0\u05e6\u05bb\u05e8\u05b9\u0591\u05d5\u05ea \u05d5\u05b7\u05d9\u05bc\u05b4\u05ea\u05bc\u05b5\u05a4\u05df \u05e0\u05b0\u05e6\u05b4\u05d9\u05d1\u05b4\u05d9\u05dd\u0599 \u05d1\u05bc\u05b0\u05d0\u05b6\u05a3\u05e8\u05b6\u05e5 \u05d9\u05b0\u05d4\u05d5\u05bc\u05d3\u05b8\u0594\u05d4 \u05d5\u05bc\u05d1\u05b0\u05e2\u05b8\u05e8\u05b5\u05a3\u05d9 \u05d0\u05b6\u05e4\u05b0\u05e8\u05b7\u0594\u05d9\u05b4\u05dd \u05d0\u05b2\u05e9\u05c1\u05b6\u05a5\u05e8 \u05dc\u05b8\u05db\u05b7\u0596\u05d3 \u05d0\u05b8\u05e1\u05b8\u05a5\u05d0 \u05d0\u05b8\u05d1\u05b4\u05bd\u05d9\u05d5\u05c3"}, {"pk": 11532, "verse": 3, "text": "\u05d5\u05b7\u05d9\u05b0\u05d4\u05b4\u05a5\u05d9 \u05d9\u05b0\u05d4\u05d5\u05b8\u0596\u05d4 \u05e2\u05b4\u05dd\u05be\u05d9\u05b0\u05d4\u05b9\u05d5\u05e9\u05c1\u05b8\u05e4\u05b8\u0591\u05d8 \u05db\u05bc\u05b4\u05a3\u05d9 \u05d4\u05b8\u05dc\u05b7\u0597\u05da\u05b0 \u05d1\u05bc\u05b0\u05d3\u05b7\u05e8\u05b0\u05db\u05b5\u059e\u05d9 \u05d3\u05bc\u05b8\u05d5\u05b4\u05a4\u05d9\u05d3 \u05d0\u05b8\u05d1\u05b4\u05d9\u05d5\u0599 \u05d4\u05b8\u05e8\u05b4\u05a3\u05d0\u05e9\u05c1\u05b9\u05e0\u05b4\u0594\u05d9\u05dd \u05d5\u05b0\u05dc\u05b9\u05a5\u05d0 \u05d3\u05b8\u05e8\u05b7\u0596\u05e9\u05c1 \u05dc\u05b7\u05d1\u05bc\u05b0\u05e2\u05b8\u05dc\u05b4\u05bd\u05d9\u05dd\u05c3"}, {"pk": 11533, "verse": 4, "text": "\u05db\u05bc\u05b4\u05a0\u05d9 \u05dc\u05bd\u05b5\u05d0\u05dc\u05b9\u05d4\u05b5\u05a4\u05d9 \u05d0\u05b8\u05d1\u05b4\u05d9\u05d5\u0599 \u05d3\u05bc\u05b8\u05e8\u05b8\u0594\u05e9\u05c1 \u05d5\u05bc\u05d1\u05b0\u05de\u05b4\u05e6\u05b0\u05d5\u05b9\u05ea\u05b8\u0596\u05d9\u05d5 \u05d4\u05b8\u05dc\u05b8\u0591\u05da\u05b0 \u05d5\u05b0\u05dc\u05b9\u0596\u05d0 \u05db\u05bc\u05b0\u05de\u05b7\u05e2\u05b2\u05e9\u05c2\u05b5\u05a5\u05d4 \u05d9\u05b4\u05e9\u05c2\u05b0\u05e8\u05b8\u05d0\u05b5\u05bd\u05dc\u05c3"}, {"pk": 11534, "verse": 5, "text": "\u05d5\u05b7\u05d9\u05bc\u05b8\u05a8\u05db\u05b6\u05df \u05d9\u05b0\u05d4\u05d5\u05b8\u05a4\u05d4 \u05d0\u05b6\u05ea\u05be\u05d4\u05b7\u05de\u05bc\u05b7\u05de\u05b0\u05dc\u05b8\u05db\u05b8\u05d4\u0599 \u05d1\u05bc\u05b0\u05d9\u05b8\u05d3\u05b9\u0594\u05d5 \u05d5\u05b7\u05d9\u05bc\u05b4\u05ea\u05bc\u05b0\u05e0\u05a7\u05d5\u05bc \u05db\u05b8\u05dc\u05be\u05d9\u05b0\u05d4\u05d5\u05bc\u05d3\u05b8\u059b\u05d4 \u05de\u05b4\u05e0\u05b0\u05d7\u05b8\u0596\u05d4 \u05dc\u05b4\u05d9\u05d4\u05b9\u05d5\u05e9\u05c1\u05b8\u05e4\u05b8\u0591\u05d8 \u05d5\u05b7\u05bd\u05d9\u05b0\u05d4\u05b4\u05d9\u05be\u05dc\u05b9\u05a5\u05d5 \u05e2\u05b9\u05bd\u05e9\u05c1\u05b6\u05e8\u05be\u05d5\u05b0\u05db\u05b8\u05d1\u05b9\u0596\u05d5\u05d3 \u05dc\u05b8\u05e8\u05b9\u05bd\u05d1\u05c3"}, {"pk": 11535, "verse": 6, "text": "\u05d5\u05b7\u05d9\u05bc\u05b4\u05d2\u05b0\u05d1\u05bc\u05b7\u05a5\u05d4\u05bc \u05dc\u05b4\u05d1\u05bc\u05b9\u0596\u05d5 \u05d1\u05bc\u05b0\u05d3\u05b7\u05e8\u05b0\u05db\u05b5\u05a3\u05d9 \u05d9\u05b0\u05d4\u05d5\u05b8\u0591\u05d4 \u05d5\u05b0\u05e2\u05b9\u0597\u05d5\u05d3 \u05d4\u05b5\u05e1\u05b4\u059b\u05d9\u05e8 \u05d0\u05b6\u05ea\u05be\u05d4\u05b7\u05d1\u05bc\u05b8\u05de\u05b9\u05a5\u05d5\u05ea \u05d5\u05b0\u05d0\u05b6\u05ea\u05be\u05d4\u05b8\u05d0\u05b2\u05e9\u05c1\u05b5\u05e8\u05b4\u0596\u05d9\u05dd \u05de\u05b4\u05d9\u05d4\u05d5\u05bc\u05d3\u05b8\u05bd\u05d4\u05c3  \u05e4"}, {"pk": 11536, "verse": 7, "text": "\u05d5\u05bc\u05d1\u05b4\u05e9\u05c1\u05b0\u05e0\u05b7\u05a8\u05ea \u05e9\u05c1\u05b8\u05dc\u05b9\u059c\u05d5\u05e9\u05c1 \u05dc\u05b0\u05de\u05b8\u05dc\u05b0\u05db\u05b9\u0597\u05d5 \u05e9\u05c1\u05b8\u05dc\u05b7\u05a4\u05d7 \u05dc\u05b0\u05e9\u05c2\u05b8\u05e8\u05b8\u05d9\u05d5\u0599 \u05dc\u05b0\u05d1\u05b6\u05df\u05be\u05d7\u05b7\u0599\u05d9\u05b4\u05dc\u0599 \u05d5\u05bc\u05dc\u05b0\u05e2\u05b9\u05d1\u05b7\u05d3\u05b0\u05d9\u05b8\u05a3\u05d4 \u05d5\u05b0\u05dc\u05b4\u05d6\u05b0\u05db\u05b7\u05e8\u05b0\u05d9\u05b8\u0594\u05d4 \u05d5\u05b0\u05dc\u05b4\u05e0\u05b0\u05ea\u05b7\u05e0\u05b0\u05d0\u05b5\u0596\u05dc \u05d5\u05bc\u05dc\u05b0\u05de\u05b4\u05d9\u05db\u05b8\u05d9\u05b8\u0591\u05d4\u05d5\u05bc \u05dc\u05b0\u05dc\u05b7\u05de\u05bc\u05b5\u0596\u05d3 \u05d1\u05bc\u05b0\u05e2\u05b8\u05e8\u05b5\u05a5\u05d9 \u05d9\u05b0\u05d4\u05d5\u05bc\u05d3\u05b8\u05bd\u05d4\u05c3"}, {"pk": 11537, "verse": 8, "text": "\u05d5\u05b0\u05e2\u05b4\u05de\u05bc\u05b8\u05d4\u05b6\u05a3\u05dd \u05d4\u05b7\u05dc\u05b0\u05d5\u05b4\u05d9\u05bc\u05b4\u0597\u05dd \u05e9\u05c1\u05b0\u05bd\u05de\u05b7\u05bd\u05e2\u05b0\u05d9\u05b8\u05a1\u05d4\u05d5\u05bc \u05d5\u05bc\u05e0\u05b0\u05ea\u05b7\u05e0\u05b0\u05d9\u05b8\u05a1\u05d4\u05d5\u05bc \u05d5\u05bc\u05d6\u05b0\u05d1\u05b7\u05d3\u05b0\u05d9\u05b8\u05a1\u05d4\u05d5\u05bc \u05d5\u05b7\u05e2\u05b2\u05e9\u05c2\u05b8\u05d4\u05d0\u05b5\u05a1\u05dc [\u05d5\u05bc\u05e9\u05c1\u05b0\u05de\u05b4\u05e8\u05b4\u05d9\u05de\u05b9\u05d5\u05ea \u05db] (\u05d5\u05bc\u05e9\u05c1\u05b0\u05de\u05b4\u05bd\u05d9\u05e8\u05b8\u05de\u05b9\u05a1\u05d5\u05ea \u05e7) \u05d5\u05b4\u05bd\u05d9\u05d4\u05b9\u05d5\u05e0\u05b8\u05ea\u05b8\u05df\u05a9 \u05d5\u05b7\u05d0\u05b2\u05d3\u05b9\u05a8\u05e0\u05b4\u05d9\u05bc\u05b8\u05a7\u05d4\u05d5\u05bc \u05d5\u05b0\u05d8\u05b9\u05bd\u05d5\u05d1\u05b4\u05d9\u05bc\u05b8\u059b\u05d4\u05d5\u05bc \u05d5\u05b0\u05d8\u05b9\u05a5\u05d5\u05d1 \u05d0\u05b2\u05d3\u05b9\u05d5\u05e0\u05b4\u05d9\u05bc\u05b8\u0596\u05d4 \u05d4\u05b7\u05dc\u05b0\u05d5\u05b4\u05d9\u05bc\u05b4\u0591\u05dd \u05d5\u05b0\u05e2\u05b4\u05de\u05bc\u05b8\u05d4\u05b6\u059b\u05dd \u05d0\u05b1\u05dc\u05b4\u05d9\u05e9\u05c1\u05b8\u05de\u05b8\u05a5\u05e2 \u05d5\u05b4\u05bd\u05d9\u05d4\u05b9\u05d5\u05e8\u05b8\u0596\u05dd \u05d4\u05b7\u05db\u05bc\u05b9\u05d4\u05b2\u05e0\u05b4\u05bd\u05d9\u05dd\u05c3"}, {"pk": 11538, "verse": 9, "text": "\u05d5\u05b7\u05bd\u05d9\u05b0\u05dc\u05b7\u05de\u05bc\u05b0\u05d3\u05d5\u05bc\u0599 \u05d1\u05bc\u05b4\u05bd\u05d9\u05d4\u05d5\u05bc\u05d3\u05b8\u0594\u05d4 \u05d5\u05b0\u05e2\u05b4\u05a8\u05de\u05bc\u05b8\u05d4\u05b6\u0594\u05dd \u05e1\u05b5\u0596\u05e4\u05b6\u05e8 \u05ea\u05bc\u05b9\u05d5\u05e8\u05b7\u05a3\u05ea \u05d9\u05b0\u05d4\u05d5\u05b8\u0591\u05d4 \u05d5\u05b7\u05d9\u05bc\u05b8\u05e1\u05b9\u0599\u05d1\u05bc\u05d5\u05bc\u0599 \u05d1\u05bc\u05b0\u05db\u05b8\u05dc\u05be\u05e2\u05b8\u05e8\u05b5\u05a3\u05d9 \u05d9\u05b0\u05d4\u05d5\u05bc\u05d3\u05b8\u0594\u05d4 \u05d5\u05b7\u05bd\u05d9\u05b0\u05dc\u05b7\u05de\u05bc\u05b0\u05d3\u0596\u05d5\u05bc \u05d1\u05bc\u05b8\u05e2\u05b8\u05bd\u05dd\u05c3"}, {"pk": 11539, "verse": 10, "text": "\u05d5\u05b7\u05d9\u05b0\u05d4\u05b4\u05a3\u05d9 \u05c0 \u05e4\u05bc\u05b7\u05a3\u05d7\u05b7\u05d3 \u05d9\u05b0\u05d4\u05d5\u05b8\u0597\u05d4 \u05e2\u05b7\u059a\u05dc \u05db\u05bc\u05b8\u05dc\u05be\u05de\u05b7\u05de\u05b0\u05dc\u05b0\u05db\u05b9\u05a3\u05d5\u05ea \u05d4\u05bd\u05b8\u05d0\u05b2\u05e8\u05b8\u05e6\u05b9\u0594\u05d5\u05ea \u05d0\u05b2\u05e9\u05c1\u05b6\u0596\u05e8 \u05e1\u05b0\u05d1\u05b4\u05d9\u05d1\u05b9\u05a3\u05d5\u05ea \u05d9\u05b0\u05d4\u05d5\u05bc\u05d3\u05b8\u0591\u05d4 \u05d5\u05b0\u05dc\u05b9\u05a5\u05d0 \u05e0\u05b4\u05dc\u05b0\u05d7\u05b2\u05de\u0596\u05d5\u05bc \u05e2\u05b4\u05dd\u05be\u05d9\u05b0\u05d4\u05b9\u05d5\u05e9\u05c1\u05b8\u05e4\u05b8\u05bd\u05d8\u05c3"}, {"pk": 11540, "verse": 11, "text": "\u05d5\u05bc\u05de\u05b4\u05df\u05be\u05e4\u05bc\u05b0\u05dc\u05b4\u05e9\u05c1\u05b0\u05ea\u05bc\u05b4\u0597\u05d9\u05dd \u05de\u05b0\u05d1\u05b4\u05d9\u05d0\u05b4\u05a7\u05d9\u05dd \u05dc\u05b4\u05bd\u05d9\u05d4\u05b9\u05d5\u05e9\u05c1\u05b8\u05e4\u05b8\u059b\u05d8 \u05de\u05b4\u05e0\u05b0\u05d7\u05b8\u0596\u05d4 \u05d5\u05b0\u05db\u05b6\u05a3\u05e1\u05b6\u05e3 \u05de\u05b7\u05e9\u05c2\u05bc\u05b8\u0591\u05d0 \u05d2\u05bc\u05b7\u05a3\u05dd \u05d4\u05b8\u05bd\u05e2\u05b7\u05e8\u05b0\u05d1\u05b4\u05d9\u05d0\u05b4\u0597\u05d9\u05dd \u05de\u05b0\u05d1\u05b4\u05d9\u05d0\u05b4\u05a5\u05d9\u05dd \u05dc\u05b9\u05d5\u0599 \u05e6\u05b9\u0595\u05d0\u05df \u05d0\u05b5\u05d9\u05dc\u05b4\u0594\u05d9\u05dd \u05e9\u05c1\u05b4\u05d1\u05b0\u05e2\u05b7\u05a4\u05ea \u05d0\u05b2\u05dc\u05b8\u05e4\u05b4\u05d9\u05dd\u0599 \u05d5\u05bc\u05e9\u05c1\u05b0\u05d1\u05b7\u05a3\u05e2 \u05de\u05b5\u05d0\u05b9\u0594\u05d5\u05ea \u05d5\u05bc\u05ea\u05b0\u05d9\u05b8\u05e9\u05c1\u05b4\u0595\u05d9\u05dd \u05e9\u05c1\u05b4\u05d1\u05b0\u05e2\u05b7\u05a5\u05ea \u05d0\u05b2\u05dc\u05b8\u05e4\u05b4\u0596\u05d9\u05dd \u05d5\u05bc\u05e9\u05c1\u05b0\u05d1\u05b7\u05a5\u05e2 \u05de\u05b5\u05d0\u05b9\u05bd\u05d5\u05ea\u05c3  \u05e4"}, {"pk": 11541, "verse": 12, "text": "\u05d5\u05b7\u05d9\u05b0\u05d4\u05b4\u05a7\u05d9 \u05d9\u05b0\u05d4\u05b9\u05d5\u05e9\u05c1\u05b8\u05e4\u05b8\u059b\u05d8 \u05d4\u05b9\u05dc\u05b5\u05a5\u05da\u05b0 \u05d5\u05b0\u05d2\u05b8\u05d3\u05b5\u0596\u05dc \u05e2\u05b7\u05d3\u05be\u05dc\u05b0\u05de\u05b8\u0591\u05e2\u05b0\u05dc\u05b8\u05d4 \u05d5\u05b7\u05d9\u05bc\u05b4\u05a7\u05d1\u05b6\u05df \u05d1\u05bc\u05b4\u05bd\u05d9\u05d4\u05d5\u05bc\u05d3\u05b8\u059b\u05d4 \u05d1\u05bc\u05b4\u05d9\u05e8\u05b8\u05e0\u05b4\u05d9\u05bc\u05b9\u0596\u05d5\u05ea \u05d5\u05b0\u05e2\u05b8\u05e8\u05b5\u05a5\u05d9 \u05de\u05b4\u05e1\u05b0\u05db\u05bc\u05b0\u05e0\u05b9\u05bd\u05d5\u05ea\u05c3"}, {"pk": 11542, "verse": 13, "text": "\u05d5\u05bc\u05de\u05b0\u05dc\u05b8\u05d0\u05db\u05b8\u05a5\u05d4 \u05e8\u05b7\u05d1\u05bc\u05b8\u059b\u05d4 \u05d4\u05b8\u05a5\u05d9\u05b8\u05d4 \u05dc\u05b9\u0596\u05d5 \u05d1\u05bc\u05b0\u05e2\u05b8\u05e8\u05b5\u05a3\u05d9 \u05d9\u05b0\u05d4\u05d5\u05bc\u05d3\u05b8\u0591\u05d4 \u05d5\u05b0\u05d0\u05b7\u05e0\u05b0\u05e9\u05c1\u05b5\u05a7\u05d9 \u05de\u05b4\u05dc\u05b0\u05d7\u05b8\u05de\u05b8\u059b\u05d4 \u05d2\u05bc\u05b4\u05d1\u05bc\u05b9\u05a5\u05d5\u05e8\u05b5\u05d9 \u05d7\u05b7\u0596\u05d9\u05b4\u05dc \u05d1\u05bc\u05b4\u05d9\u05e8\u05d5\u05bc\u05e9\u05c1\u05b8\u05dc\u05b8\u05b4\u05bd\u05dd\u05c3"}, {"pk": 11543, "verse": 14, "text": "\u05d5\u05b0\u05d0\u05b5\u05a5\u05dc\u05bc\u05b6\u05d4 \u05e4\u05b0\u05e7\u05bb\u05d3\u05bc\u05b8\u05ea\u05b8\u0596\u05dd \u05dc\u05b0\u05d1\u05b5\u05a3\u05d9\u05ea \u05d0\u05b2\u05d1\u05b9\u05d5\u05ea\u05b5\u05d9\u05d4\u05b6\u0591\u05dd \u05dc\u05b4\u05bd\u05d9\u05d4\u05d5\u05bc\u05d3\u05b8\u05d4\u0599 \u05e9\u05c2\u05b8\u05e8\u05b5\u05a3\u05d9 \u05d0\u05b2\u05dc\u05b8\u05e4\u05b4\u0594\u05d9\u05dd \u05e2\u05b7\u05d3\u05b0\u05e0\u05b8\u05a3\u05d4 \u05d4\u05b7\u05e9\u05c2\u05bc\u05b8\u0594\u05e8 \u05d5\u05b0\u05e2\u05b4\u05de\u05bc\u05b9\u05d5\u0599 \u05d2\u05bc\u05b4\u05d1\u05bc\u05b9\u05a3\u05d5\u05e8\u05b5\u05d9 \u05d7\u05b7\u0594\u05d9\u05b4\u05dc \u05e9\u05c1\u05b0\u05dc\u05b9\u05a5\u05e9\u05c1 \u05de\u05b5\u05d0\u05b9\u0596\u05d5\u05ea \u05d0\u05b8\u05bd\u05dc\u05b6\u05e3\u05c3    \u05e1"}, {"pk": 11544, "verse": 15, "text": "\u05d5\u05b0\u05e2\u05b7\u05dc\u05be\u05d9\u05b8\u05d3\u05b9\u0596\u05d5 \u05d9\u05b0\u05d4\u05b9\u05d5\u05d7\u05b8\u05e0\u05b8\u05a3\u05df \u05d4\u05b7\u05e9\u05c2\u05bc\u05b8\u0591\u05e8 \u05d5\u05b0\u05e2\u05b4\u05de\u05bc\u05b9\u0595\u05d5 \u05de\u05b8\u05d0\u05ea\u05b7\u05a5\u05d9\u05b4\u05dd \u05d5\u05bc\u05e9\u05c1\u05b0\u05de\u05b9\u05d5\u05e0\u05b4\u0596\u05d9\u05dd \u05d0\u05b8\u05bd\u05dc\u05b6\u05e3\u05c3    \u05e1"}, {"pk": 11545, "verse": 16, "text": "\u05d5\u05b0\u05e2\u05b7\u05dc\u05be\u05d9\u05b8\u05d3\u05b9\u05d5\u0599 \u05e2\u05b2\u05de\u05b7\u05e1\u05b0\u05d9\u05b8\u05a3\u05d4 \u05d1\u05b6\u05df\u05be\u05d6\u05b4\u05db\u05b0\u05e8\u05b4\u0594\u05d9 \u05d4\u05b7\u05de\u05bc\u05b4\u05ea\u05b0\u05e0\u05b7\u05d3\u05bc\u05b5\u0596\u05d1 \u05dc\u05b7\u05d9\u05d4\u05d5\u05b8\u0591\u05d4 \u05d5\u05b0\u05e2\u05b4\u05de\u05bc\u05b9\u059b\u05d5 \u05de\u05b8\u05d0\u05ea\u05b7\u05a5\u05d9\u05b4\u05dd \u05d0\u05b6\u0596\u05dc\u05b6\u05e3 \u05d2\u05bc\u05b4\u05d1\u05bc\u05b9\u05a5\u05d5\u05e8 \u05d7\u05b8\u05bd\u05d9\u05b4\u05dc\u05c3    \u05e1"}, {"pk": 11546, "verse": 17, "text": "\u05d5\u05bc\u05de\u05b4\u05a8\u05df\u05be\u05d1\u05bc\u05b4\u05e0\u05b0\u05d9\u05b8\u05de\u05b4\u0594\u05df \u05d2\u05bc\u05b4\u05d1\u05bc\u05b9\u05a5\u05d5\u05e8 \u05d7\u05b7\u0596\u05d9\u05b4\u05dc \u05d0\u05b6\u05dc\u05b0\u05d9\u05b8\u05d3\u05b8\u0591\u05e2 \u05d5\u05b0\u05e2\u05b4\u05de\u05bc\u05b9\u059b\u05d5 \u05e0\u05b9\u05bd\u05e9\u05c1\u05b0\u05e7\u05b5\u05d9\u05be\u05e7\u05b6\u05a5\u05e9\u05c1\u05b6\u05ea \u05d5\u05bc\u05de\u05b8\u05d2\u05b5\u0596\u05df \u05de\u05b8\u05d0\u05ea\u05b7\u05a5\u05d9\u05b4\u05dd \u05d0\u05b8\u05bd\u05dc\u05b6\u05e3\u05c3    \u05e1"}, {"pk": 11547, "verse": 18, "text": "\u05d5\u05b0\u05e2\u05b7\u05dc\u05be\u05d9\u05b8\u05d3\u05b9\u0596\u05d5 \u05d9\u05b0\u05d4\u05b9\u05d5\u05d6\u05b8\u05d1\u05b8\u0591\u05d3 \u05d5\u05b0\u05e2\u05b4\u05de\u05bc\u05b9\u059b\u05d5 \u05de\u05b5\u05d0\u05b8\u05bd\u05d4\u05be\u05d5\u05bc\u05e9\u05c1\u05b0\u05de\u05b9\u05d5\u05e0\u05b4\u05a5\u05d9\u05dd \u05d0\u05b6\u0596\u05dc\u05b6\u05e3 \u05d7\u05b2\u05dc\u05d5\u05bc\u05e6\u05b5\u05a5\u05d9 \u05e6\u05b8\u05d1\u05b8\u05bd\u05d0\u05c3    \u05e1"}, {"pk": 11548, "verse": 19, "text": "\u05d0\u05b5\u0596\u05dc\u05bc\u05b6\u05d4 \u05d4\u05b7\u05de\u05b0\u05e9\u05c1\u05b8\u05e8\u05b0\u05ea\u05b4\u05a3\u05d9\u05dd \u05d0\u05b6\u05ea\u05be\u05d4\u05b7\u05de\u05bc\u05b6\u0591\u05dc\u05b6\u05da\u05b0 \u05de\u05b4\u05dc\u05bc\u05b0\u05d1\u05b7\u059e\u05d3 \u05d0\u05b2\u05e9\u05c1\u05b6\u05e8\u05be\u05e0\u05b8\u05ea\u05b7\u05a5\u05df \u05d4\u05b7\u05de\u05bc\u05b6\u059b\u05dc\u05b6\u05da\u05b0 \u05d1\u05bc\u05b0\u05e2\u05b8\u05e8\u05b5\u05a5\u05d9 \u05d4\u05b7\u05de\u05bc\u05b4\u05d1\u05b0\u05e6\u05b8\u0596\u05e8 \u05d1\u05bc\u05b0\u05db\u05b8\u05dc\u05be\u05d9\u05b0\u05d4\u05d5\u05bc\u05d3\u05b8\u05bd\u05d4\u05c3  \u05e4"}]