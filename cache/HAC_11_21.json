[{"pk": 2896463, "verse": 1, "text": "\u05d0 \u05d5\u05d9\u05d4\u05d9 \u05d0\u05d7\u05e8 \u05d4\u05d3\u05d1\u05e8\u05d9\u05dd \u05d4\u05d0\u05dc\u05d4 \u05db\u05e8\u05dd \u05d4\u05d9\u05d4 \u05dc\u05e0\u05d1\u05d5\u05ea \u05d4\u05d9\u05d6\u05e8\u05e2\u05d0\u05dc\u05d9 \u05d0\u05e9\u05e8 \u05d1\u05d9\u05d6\u05e8\u05e2\u05d0\u05dc--\u05d0\u05e6\u05dc \u05d4\u05d9\u05db\u05dc \u05d0\u05d7\u05d0\u05d1 \u05de\u05dc\u05da \u05e9\u05de\u05e8\u05d5\u05df"}, {"pk": 2896464, "verse": 2, "text": "\u05d1 \u05d5\u05d9\u05d3\u05d1\u05e8 \u05d0\u05d7\u05d0\u05d1 \u05d0\u05dc \u05e0\u05d1\u05d5\u05ea \u05dc\u05d0\u05de\u05e8 \u05ea\u05e0\u05d4 \u05dc\u05d9 \u05d0\u05ea \u05db\u05e8\u05de\u05da \u05d5\u05d9\u05d4\u05d9 \u05dc\u05d9 \u05dc\u05d2\u05df \u05d9\u05e8\u05e7 \u05db\u05d9 \u05d4\u05d5\u05d0 \u05e7\u05e8\u05d5\u05d1 \u05d0\u05e6\u05dc \u05d1\u05d9\u05ea\u05d9 \u05d5\u05d0\u05ea\u05e0\u05d4 \u05dc\u05da \u05ea\u05d7\u05ea\u05d9\u05d5 \u05db\u05e8\u05dd \u05d8\u05d5\u05d1 \u05de\u05de\u05e0\u05d5 \u05d0\u05dd \u05d8\u05d5\u05d1 \u05d1\u05e2\u05d9\u05e0\u05d9\u05da \u05d0\u05ea\u05e0\u05d4 \u05dc\u05da \u05db\u05e1\u05e3 \u05de\u05d7\u05d9\u05e8 \u05d6\u05d4"}, {"pk": 2896465, "verse": 3, "text": "\u05d2 \u05d5\u05d9\u05d0\u05de\u05e8 \u05e0\u05d1\u05d5\u05ea \u05d0\u05dc \u05d0\u05d7\u05d0\u05d1\u00a0 \u05d7\u05dc\u05d9\u05dc\u05d4 \u05dc\u05d9 \u05de\u05d9\u05d4\u05d5\u05d4 \u05de\u05ea\u05ea\u05d9 \u05d0\u05ea \u05e0\u05d7\u05dc\u05ea \u05d0\u05d1\u05ea\u05d9 \u05dc\u05da"}, {"pk": 2896466, "verse": 4, "text": "\u05d3 \u05d5\u05d9\u05d1\u05d0 \u05d0\u05d7\u05d0\u05d1 \u05d0\u05dc \u05d1\u05d9\u05ea\u05d5 \u05e1\u05e8 \u05d5\u05d6\u05e2\u05e3 \u05e2\u05dc \u05d4\u05d3\u05d1\u05e8 \u05d0\u05e9\u05e8 \u05d3\u05d1\u05e8 \u05d0\u05dc\u05d9\u05d5 \u05e0\u05d1\u05d5\u05ea \u05d4\u05d9\u05d6\u05e8\u05e2\u05d0\u05dc\u05d9 \u05d5\u05d9\u05d0\u05de\u05e8 \u05dc\u05d0 \u05d0\u05ea\u05df \u05dc\u05da \u05d0\u05ea \u05e0\u05d7\u05dc\u05ea \u05d0\u05d1\u05d5\u05ea\u05d9 \u05d5\u05d9\u05e9\u05db\u05d1 \u05e2\u05dc \u05de\u05d8\u05ea\u05d5 \u05d5\u05d9\u05e1\u05d1 \u05d0\u05ea \u05e4\u05e0\u05d9\u05d5 \u05d5\u05dc\u05d0 \u05d0\u05db\u05dc \u05dc\u05d7\u05dd"}, {"pk": 2896467, "verse": 5, "text": "\u05d4 \u05d5\u05ea\u05d1\u05d0 \u05d0\u05dc\u05d9\u05d5 \u05d0\u05d9\u05d6\u05d1\u05dc \u05d0\u05e9\u05ea\u05d5 \u05d5\u05ea\u05d3\u05d1\u05e8 \u05d0\u05dc\u05d9\u05d5 \u05de\u05d4 \u05d6\u05d4 \u05e8\u05d5\u05d7\u05da \u05e1\u05e8\u05d4 \u05d5\u05d0\u05d9\u05e0\u05da \u05d0\u05db\u05dc \u05dc\u05d7\u05dd"}, {"pk": 2896468, "verse": 6, "text": "\u05d5 \u05d5\u05d9\u05d3\u05d1\u05e8 \u05d0\u05dc\u05d9\u05d4 \u05db\u05d9 \u05d0\u05d3\u05d1\u05e8 \u05d0\u05dc \u05e0\u05d1\u05d5\u05ea \u05d4\u05d9\u05d6\u05e8\u05e2\u05d0\u05dc\u05d9 \u05d5\u05d0\u05de\u05e8 \u05dc\u05d5 \u05ea\u05e0\u05d4 \u05dc\u05d9 \u05d0\u05ea \u05db\u05e8\u05de\u05da \u05d1\u05db\u05e1\u05e3 \u05d0\u05d5 \u05d0\u05dd \u05d7\u05e4\u05e5 \u05d0\u05ea\u05d4 \u05d0\u05ea\u05e0\u05d4 \u05dc\u05da \u05db\u05e8\u05dd \u05ea\u05d7\u05ea\u05d9\u05d5 \u05d5\u05d9\u05d0\u05de\u05e8 \u05dc\u05d0 \u05d0\u05ea\u05df \u05dc\u05da \u05d0\u05ea \u05db\u05e8\u05de\u05d9"}, {"pk": 2896469, "verse": 7, "text": "\u05d6 \u05d5\u05ea\u05d0\u05de\u05e8 \u05d0\u05dc\u05d9\u05d5 \u05d0\u05d9\u05d6\u05d1\u05dc \u05d0\u05e9\u05ea\u05d5 \u05d0\u05ea\u05d4 \u05e2\u05ea\u05d4 \u05ea\u05e2\u05e9\u05d4 \u05de\u05dc\u05d5\u05db\u05d4 \u05e2\u05dc \u05d9\u05e9\u05e8\u05d0\u05dc \u05e7\u05d5\u05dd \u05d0\u05db\u05dc \u05dc\u05d7\u05dd \u05d5\u05d9\u05d8\u05d1 \u05dc\u05d1\u05da--\u05d0\u05e0\u05d9 \u05d0\u05ea\u05df \u05dc\u05da \u05d0\u05ea \u05db\u05e8\u05dd \u05e0\u05d1\u05d5\u05ea \u05d4\u05d9\u05d6\u05e8\u05e2\u05d0\u05dc\u05d9"}, {"pk": 2896470, "verse": 8, "text": "\u05d7 \u05d5\u05ea\u05db\u05ea\u05d1 \u05e1\u05e4\u05e8\u05d9\u05dd \u05d1\u05e9\u05dd \u05d0\u05d7\u05d0\u05d1 \u05d5\u05ea\u05d7\u05ea\u05dd \u05d1\u05d7\u05ea\u05de\u05d5 \u05d5\u05ea\u05e9\u05dc\u05d7 \u05d4\u05e1\u05e4\u05e8\u05d9\u05dd (\u05e1\u05e4\u05e8\u05d9\u05dd) \u05d0\u05dc \u05d4\u05d6\u05e7\u05e0\u05d9\u05dd \u05d5\u05d0\u05dc \u05d4\u05d7\u05e8\u05d9\u05dd \u05d0\u05e9\u05e8 \u05d1\u05e2\u05d9\u05e8\u05d5 \u05d4\u05d9\u05e9\u05d1\u05d9\u05dd \u05d0\u05ea \u05e0\u05d1\u05d5\u05ea"}, {"pk": 2896471, "verse": 9, "text": "\u05d8 \u05d5\u05ea\u05db\u05ea\u05d1 \u05d1\u05e1\u05e4\u05e8\u05d9\u05dd \u05dc\u05d0\u05de\u05e8\u00a0 \u05e7\u05e8\u05d0\u05d5 \u05e6\u05d5\u05dd \u05d5\u05d4\u05e9\u05d9\u05d1\u05d5 \u05d0\u05ea \u05e0\u05d1\u05d5\u05ea \u05d1\u05e8\u05d0\u05e9 \u05d4\u05e2\u05dd"}, {"pk": 2896472, "verse": 10, "text": "\u05d9 \u05d5\u05d4\u05d5\u05e9\u05d9\u05d1\u05d5 \u05e9\u05e0\u05d9\u05dd \u05d0\u05e0\u05e9\u05d9\u05dd \u05d1\u05e0\u05d9 \u05d1\u05dc\u05d9\u05e2\u05dc \u05e0\u05d2\u05d3\u05d5 \u05d5\u05d9\u05e2\u05d3\u05d4\u05d5 \u05dc\u05d0\u05de\u05e8 \u05d1\u05e8\u05db\u05ea \u05d0\u05dc\u05d4\u05d9\u05dd \u05d5\u05de\u05dc\u05da \u05d5\u05d4\u05d5\u05e6\u05d9\u05d0\u05d4\u05d5 \u05d5\u05e1\u05e7\u05dc\u05d4\u05d5 \u05d5\u05d9\u05de\u05ea"}, {"pk": 2896473, "verse": 11, "text": "\u05d9\u05d0 \u05d5\u05d9\u05e2\u05e9\u05d5 \u05d0\u05e0\u05e9\u05d9 \u05e2\u05d9\u05e8\u05d5 \u05d4\u05d6\u05e7\u05e0\u05d9\u05dd \u05d5\u05d4\u05d7\u05e8\u05d9\u05dd \u05d0\u05e9\u05e8 \u05d4\u05d9\u05e9\u05d1\u05d9\u05dd \u05d1\u05e2\u05d9\u05e8\u05d5 \u05db\u05d0\u05e9\u05e8 \u05e9\u05dc\u05d7\u05d4 \u05d0\u05dc\u05d9\u05d4\u05dd \u05d0\u05d9\u05d6\u05d1\u05dc--\u05db\u05d0\u05e9\u05e8 \u05db\u05ea\u05d5\u05d1 \u05d1\u05e1\u05e4\u05e8\u05d9\u05dd \u05d0\u05e9\u05e8 \u05e9\u05dc\u05d7\u05d4 \u05d0\u05dc\u05d9\u05d4\u05dd"}, {"pk": 2896474, "verse": 12, "text": "\u05d9\u05d1 \u05e7\u05e8\u05d0\u05d5 \u05e6\u05d5\u05dd \u05d5\u05d4\u05e9\u05d9\u05d1\u05d5 \u05d0\u05ea \u05e0\u05d1\u05d5\u05ea \u05d1\u05e8\u05d0\u05e9 \u05d4\u05e2\u05dd"}, {"pk": 2896475, "verse": 13, "text": "\u05d9\u05d2 \u05d5\u05d9\u05d1\u05d0\u05d5 \u05e9\u05e0\u05d9 \u05d4\u05d0\u05e0\u05e9\u05d9\u05dd \u05d1\u05e0\u05d9 \u05d1\u05dc\u05d9\u05e2\u05dc \u05d5\u05d9\u05e9\u05d1\u05d5 \u05e0\u05d2\u05d3\u05d5 \u05d5\u05d9\u05e2\u05d3\u05d4\u05d5 \u05d0\u05e0\u05e9\u05d9 \u05d4\u05d1\u05dc\u05d9\u05e2\u05dc \u05d0\u05ea \u05e0\u05d1\u05d5\u05ea \u05e0\u05d2\u05d3 \u05d4\u05e2\u05dd \u05dc\u05d0\u05de\u05e8 \u05d1\u05e8\u05da \u05e0\u05d1\u05d5\u05ea \u05d0\u05dc\u05d4\u05d9\u05dd \u05d5\u05de\u05dc\u05da \u05d5\u05d9\u05e6\u05d0\u05d4\u05d5 \u05de\u05d7\u05d5\u05e5 \u05dc\u05e2\u05d9\u05e8 \u05d5\u05d9\u05e1\u05e7\u05dc\u05d4\u05d5 \u05d1\u05d0\u05d1\u05e0\u05d9\u05dd \u05d5\u05d9\u05de\u05ea"}, {"pk": 2896476, "verse": 14, "text": "\u05d9\u05d3 \u05d5\u05d9\u05e9\u05dc\u05d7\u05d5 \u05d0\u05dc \u05d0\u05d9\u05d6\u05d1\u05dc \u05dc\u05d0\u05de\u05e8\u00a0 \u05e1\u05e7\u05dc \u05e0\u05d1\u05d5\u05ea \u05d5\u05d9\u05de\u05ea"}, {"pk": 2896477, "verse": 15, "text": "\u05d8\u05d5 \u05d5\u05d9\u05d4\u05d9 \u05db\u05e9\u05de\u05e2 \u05d0\u05d9\u05d6\u05d1\u05dc \u05db\u05d9 \u05e1\u05e7\u05dc \u05e0\u05d1\u05d5\u05ea \u05d5\u05d9\u05de\u05ea \u05d5\u05ea\u05d0\u05de\u05e8 \u05d0\u05d9\u05d6\u05d1\u05dc \u05d0\u05dc \u05d0\u05d7\u05d0\u05d1 \u05e7\u05d5\u05dd \u05e8\u05e9 \u05d0\u05ea \u05db\u05e8\u05dd \u05e0\u05d1\u05d5\u05ea \u05d4\u05d9\u05d6\u05e8\u05e2\u05d0\u05dc\u05d9 \u05d0\u05e9\u05e8 \u05de\u05d0\u05df \u05dc\u05ea\u05ea \u05dc\u05da \u05d1\u05db\u05e1\u05e3--\u05db\u05d9 \u05d0\u05d9\u05df \u05e0\u05d1\u05d5\u05ea \u05d7\u05d9 \u05db\u05d9 \u05de\u05ea"}, {"pk": 2896478, "verse": 16, "text": "\u05d8\u05d6 \u05d5\u05d9\u05d4\u05d9 \u05db\u05e9\u05de\u05e2 \u05d0\u05d7\u05d0\u05d1 \u05db\u05d9 \u05de\u05ea \u05e0\u05d1\u05d5\u05ea \u05d5\u05d9\u05e7\u05dd \u05d0\u05d7\u05d0\u05d1 \u05dc\u05e8\u05d3\u05ea \u05d0\u05dc \u05db\u05e8\u05dd \u05e0\u05d1\u05d5\u05ea \u05d4\u05d9\u05d6\u05e8\u05e2\u05d0\u05dc\u05d9--\u05dc\u05e8\u05e9\u05ea\u05d5\u00a0 {\u05e4}"}, {"pk": 2896479, "verse": 17, "text": "\u05d9\u05d6 \u05d5\u05d9\u05d4\u05d9 \u05d3\u05d1\u05e8 \u05d9\u05d4\u05d5\u05d4 \u05d0\u05dc \u05d0\u05dc\u05d9\u05d4\u05d5 \u05d4\u05ea\u05e9\u05d1\u05d9 \u05dc\u05d0\u05de\u05e8"}, {"pk": 2896480, "verse": 18, "text": "\u05d9\u05d7 \u05e7\u05d5\u05dd \u05e8\u05d3 \u05dc\u05e7\u05e8\u05d0\u05ea \u05d0\u05d7\u05d0\u05d1 \u05de\u05dc\u05da \u05d9\u05e9\u05e8\u05d0\u05dc--\u05d0\u05e9\u05e8 \u05d1\u05e9\u05de\u05e8\u05d5\u05df \u05d4\u05e0\u05d4 \u05d1\u05db\u05e8\u05dd \u05e0\u05d1\u05d5\u05ea \u05d0\u05e9\u05e8 \u05d9\u05e8\u05d3 \u05e9\u05dd \u05dc\u05e8\u05e9\u05ea\u05d5"}, {"pk": 2896481, "verse": 19, "text": "\u05d9\u05d8 \u05d5\u05d3\u05d1\u05e8\u05ea \u05d0\u05dc\u05d9\u05d5 \u05dc\u05d0\u05de\u05e8 \u05db\u05d4 \u05d0\u05de\u05e8 \u05d9\u05d4\u05d5\u05d4 \u05d4\u05e8\u05e6\u05d7\u05ea \u05d5\u05d2\u05dd \u05d9\u05e8\u05e9\u05ea \u05d5\u05d3\u05d1\u05e8\u05ea \u05d0\u05dc\u05d9\u05d5 \u05dc\u05d0\u05de\u05e8 \u05db\u05d4 \u05d0\u05de\u05e8 \u05d9\u05d4\u05d5\u05d4 \u05d1\u05de\u05e7\u05d5\u05dd \u05d0\u05e9\u05e8 \u05dc\u05e7\u05e7\u05d5 \u05d4\u05db\u05dc\u05d1\u05d9\u05dd \u05d0\u05ea \u05d3\u05dd \u05e0\u05d1\u05d5\u05ea \u05d9\u05dc\u05e7\u05d5 \u05d4\u05db\u05dc\u05d1\u05d9\u05dd \u05d0\u05ea \u05d3\u05de\u05da \u05d2\u05dd \u05d0\u05ea\u05d4"}, {"pk": 2896482, "verse": 20, "text": "\u05db \u05d5\u05d9\u05d0\u05de\u05e8 \u05d0\u05d7\u05d0\u05d1 \u05d0\u05dc \u05d0\u05dc\u05d9\u05d4\u05d5 \u05d4\u05de\u05e6\u05d0\u05ea\u05e0\u05d9 \u05d0\u05d9\u05d1\u05d9 \u05d5\u05d9\u05d0\u05de\u05e8 \u05de\u05e6\u05d0\u05ea\u05d9--\u05d9\u05e2\u05df \u05d4\u05ea\u05de\u05db\u05e8\u05da \u05dc\u05e2\u05e9\u05d5\u05ea \u05d4\u05e8\u05e2 \u05d1\u05e2\u05d9\u05e0\u05d9 \u05d9\u05d4\u05d5\u05d4"}, {"pk": 2896483, "verse": 21, "text": "\u05db\u05d0 \u05d4\u05e0\u05e0\u05d9 \u05de\u05d1\u05d9 \u05d0\u05dc\u05d9\u05da \u05e8\u05e2\u05d4 \u05d5\u05d1\u05e2\u05e8\u05ea\u05d9 \u05d0\u05d7\u05e8\u05d9\u05da \u05d5\u05d4\u05db\u05e8\u05ea\u05d9 \u05dc\u05d0\u05d7\u05d0\u05d1 \u05de\u05e9\u05ea\u05d9\u05df \u05d1\u05e7\u05d9\u05e8 \u05d5\u05e2\u05e6\u05d5\u05e8 \u05d5\u05e2\u05d6\u05d5\u05d1 \u05d1\u05d9\u05e9\u05e8\u05d0\u05dc"}, {"pk": 2896484, "verse": 22, "text": "\u05db\u05d1 \u05d5\u05e0\u05ea\u05ea\u05d9 \u05d0\u05ea \u05d1\u05d9\u05ea\u05da \u05db\u05d1\u05d9\u05ea \u05d9\u05e8\u05d1\u05e2\u05dd \u05d1\u05df \u05e0\u05d1\u05d8 \u05d5\u05db\u05d1\u05d9\u05ea \u05d1\u05e2\u05e9\u05d0 \u05d1\u05df \u05d0\u05d7\u05d9\u05d4\u00a0 \u05d0\u05dc \u05d4\u05db\u05e2\u05e1 \u05d0\u05e9\u05e8 \u05d4\u05db\u05e2\u05e1\u05ea \u05d5\u05ea\u05d7\u05d8\u05d0 \u05d0\u05ea \u05d9\u05e9\u05e8\u05d0\u05dc"}, {"pk": 2896485, "verse": 23, "text": "\u05db\u05d2 \u05d5\u05d2\u05dd \u05dc\u05d0\u05d9\u05d6\u05d1\u05dc--\u05d3\u05d1\u05e8 \u05d9\u05d4\u05d5\u05d4 \u05dc\u05d0\u05de\u05e8\u00a0 \u05d4\u05db\u05dc\u05d1\u05d9\u05dd \u05d9\u05d0\u05db\u05dc\u05d5 \u05d0\u05ea \u05d0\u05d9\u05d6\u05d1\u05dc \u05d1\u05d7\u05dc \u05d9\u05d6\u05e8\u05e2\u05d0\u05dc"}, {"pk": 2896486, "verse": 24, "text": "\u05db\u05d3 \u05d4\u05de\u05ea \u05dc\u05d0\u05d7\u05d0\u05d1 \u05d1\u05e2\u05d9\u05e8 \u05d9\u05d0\u05db\u05dc\u05d5 \u05d4\u05db\u05dc\u05d1\u05d9\u05dd \u05d5\u05d4\u05de\u05ea \u05d1\u05e9\u05d3\u05d4 \u05d9\u05d0\u05db\u05dc\u05d5 \u05e2\u05d5\u05e3 \u05d4\u05e9\u05de\u05d9\u05dd"}, {"pk": 2896487, "verse": 25, "text": "\u05db\u05d4 \u05e8\u05e7 \u05dc\u05d0 \u05d4\u05d9\u05d4 \u05db\u05d0\u05d7\u05d0\u05d1 \u05d0\u05e9\u05e8 \u05d4\u05ea\u05de\u05db\u05e8 \u05dc\u05e2\u05e9\u05d5\u05ea \u05d4\u05e8\u05e2 \u05d1\u05e2\u05d9\u05e0\u05d9 \u05d9\u05d4\u05d5\u05d4--\u05d0\u05e9\u05e8 \u05d4\u05e1\u05ea\u05d4 \u05d0\u05ea\u05d5 \u05d0\u05d9\u05d6\u05d1\u05dc \u05d0\u05e9\u05ea\u05d5"}, {"pk": 2896488, "verse": 26, "text": "\u05db\u05d5 \u05d5\u05d9\u05ea\u05e2\u05d1 \u05de\u05d0\u05d3 \u05dc\u05dc\u05db\u05ea \u05d0\u05d7\u05e8\u05d9 \u05d4\u05d2\u05dc\u05dc\u05d9\u05dd--\u05db\u05db\u05dc \u05d0\u05e9\u05e8 \u05e2\u05e9\u05d5 \u05d4\u05d0\u05de\u05e8\u05d9 \u05d0\u05e9\u05e8 \u05d4\u05d5\u05e8\u05d9\u05e9 \u05d9\u05d4\u05d5\u05d4 \u05de\u05e4\u05e0\u05d9 \u05d1\u05e0\u05d9 \u05d9\u05e9\u05e8\u05d0\u05dc\u00a0 {\u05e4}"}, {"pk": 2896489, "verse": 27, "text": "\u05db\u05d6 \u05d5\u05d9\u05d4\u05d9 \u05db\u05e9\u05de\u05e2 \u05d0\u05d7\u05d0\u05d1 \u05d0\u05ea \u05d4\u05d3\u05d1\u05e8\u05d9\u05dd \u05d4\u05d0\u05dc\u05d4 \u05d5\u05d9\u05e7\u05e8\u05e2 \u05d1\u05d2\u05d3\u05d9\u05d5 \u05d5\u05d9\u05e9\u05dd \u05e9\u05e7 \u05e2\u05dc \u05d1\u05e9\u05e8\u05d5 \u05d5\u05d9\u05e6\u05d5\u05dd \u05d5\u05d9\u05e9\u05db\u05d1 \u05d1\u05e9\u05e7 \u05d5\u05d9\u05d4\u05dc\u05da \u05d0\u05d8\u00a0 {\u05e4}"}, {"pk": 2896490, "verse": 28, "text": "\u05db\u05d7 \u05d5\u05d9\u05d4\u05d9 \u05d3\u05d1\u05e8 \u05d9\u05d4\u05d5\u05d4 \u05d0\u05dc \u05d0\u05dc\u05d9\u05d4\u05d5 \u05d4\u05ea\u05e9\u05d1\u05d9 \u05dc\u05d0\u05de\u05e8"}, {"pk": 2896491, "verse": 29, "text": "\u05db\u05d8 \u05d4\u05e8\u05d0\u05d9\u05ea \u05db\u05d9 \u05e0\u05db\u05e0\u05e2 \u05d0\u05d7\u05d0\u05d1 \u05de\u05dc\u05e4\u05e0\u05d9 \u05d9\u05e2\u05df \u05db\u05d9 \u05e0\u05db\u05e0\u05e2 \u05de\u05e4\u05e0\u05d9 \u05dc\u05d0 \u05d0\u05d1\u05d9 \u05d4\u05e8\u05e2\u05d4 \u05d1\u05d9\u05de\u05d9\u05d5--\u05d1\u05d9\u05de\u05d9 \u05d1\u05e0\u05d5 \u05d0\u05d1\u05d9\u05d0 \u05d4\u05e8\u05e2\u05d4 \u05e2\u05dc \u05d1\u05d9\u05ea\u05d5"}]