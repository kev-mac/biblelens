[{"pk": 2896399, "verse": 1, "text": "\u05d0 \u05d5\u05d9\u05d2\u05d3 \u05d0\u05d7\u05d0\u05d1 \u05dc\u05d0\u05d9\u05d6\u05d1\u05dc \u05d0\u05ea \u05db\u05dc \u05d0\u05e9\u05e8 \u05e2\u05e9\u05d4 \u05d0\u05dc\u05d9\u05d4\u05d5 \u05d5\u05d0\u05ea \u05db\u05dc \u05d0\u05e9\u05e8 \u05d4\u05e8\u05d2 \u05d0\u05ea \u05db\u05dc \u05d4\u05e0\u05d1\u05d9\u05d0\u05d9\u05dd \u05d1\u05d7\u05e8\u05d1"}, {"pk": 2896400, "verse": 2, "text": "\u05d1 \u05d5\u05ea\u05e9\u05dc\u05d7 \u05d0\u05d9\u05d6\u05d1\u05dc \u05de\u05dc\u05d0\u05da \u05d0\u05dc \u05d0\u05dc\u05d9\u05d4\u05d5 \u05dc\u05d0\u05de\u05e8\u00a0 \u05db\u05d4 \u05d9\u05e2\u05e9\u05d5\u05df \u05d0\u05dc\u05d4\u05d9\u05dd \u05d5\u05db\u05d4 \u05d9\u05d5\u05e1\u05e4\u05d5\u05df \u05db\u05d9 \u05db\u05e2\u05ea \u05de\u05d7\u05e8 \u05d0\u05e9\u05d9\u05dd \u05d0\u05ea \u05e0\u05e4\u05e9\u05da \u05db\u05e0\u05e4\u05e9 \u05d0\u05d7\u05d3 \u05de\u05d4\u05dd"}, {"pk": 2896401, "verse": 3, "text": "\u05d2 \u05d5\u05d9\u05e8\u05d0 \u05d5\u05d9\u05e7\u05dd \u05d5\u05d9\u05dc\u05da \u05d0\u05dc \u05e0\u05e4\u05e9\u05d5 \u05d5\u05d9\u05d1\u05d0 \u05d1\u05d0\u05e8 \u05e9\u05d1\u05e2 \u05d0\u05e9\u05e8 \u05dc\u05d9\u05d4\u05d5\u05d3\u05d4 \u05d5\u05d9\u05e0\u05d7 \u05d0\u05ea \u05e0\u05e2\u05e8\u05d5 \u05e9\u05dd"}, {"pk": 2896402, "verse": 4, "text": "\u05d3 \u05d5\u05d4\u05d5\u05d0 \u05d4\u05dc\u05da \u05d1\u05de\u05d3\u05d1\u05e8 \u05d3\u05e8\u05da \u05d9\u05d5\u05dd \u05d5\u05d9\u05d1\u05d0 \u05d5\u05d9\u05e9\u05d1 \u05ea\u05d7\u05ea \u05e8\u05ea\u05dd \u05d0\u05d7\u05ea (\u05d0\u05d7\u05d3) \u05d5\u05d9\u05e9\u05d0\u05dc \u05d0\u05ea \u05e0\u05e4\u05e9\u05d5 \u05dc\u05de\u05d5\u05ea \u05d5\u05d9\u05d0\u05de\u05e8 \u05e8\u05d1 \u05e2\u05ea\u05d4 \u05d9\u05d4\u05d5\u05d4 \u05e7\u05d7 \u05e0\u05e4\u05e9\u05d9 \u05db\u05d9 \u05dc\u05d0 \u05d8\u05d5\u05d1 \u05d0\u05e0\u05db\u05d9 \u05de\u05d0\u05d1\u05ea\u05d9"}, {"pk": 2896403, "verse": 5, "text": "\u05d4 \u05d5\u05d9\u05e9\u05db\u05d1 \u05d5\u05d9\u05d9\u05e9\u05df \u05ea\u05d7\u05ea \u05e8\u05ea\u05dd \u05d0\u05d7\u05d3 \u05d5\u05d4\u05e0\u05d4 \u05d6\u05d4 \u05de\u05dc\u05d0\u05da \u05e0\u05d2\u05e2 \u05d1\u05d5 \u05d5\u05d9\u05d0\u05de\u05e8 \u05dc\u05d5 \u05e7\u05d5\u05dd \u05d0\u05db\u05d5\u05dc"}, {"pk": 2896404, "verse": 6, "text": "\u05d5 \u05d5\u05d9\u05d1\u05d8 \u05d5\u05d4\u05e0\u05d4 \u05de\u05e8\u05d0\u05e9\u05ea\u05d9\u05d5 \u05e2\u05d2\u05ea \u05e8\u05e6\u05e4\u05d9\u05dd \u05d5\u05e6\u05e4\u05d7\u05ea \u05de\u05d9\u05dd \u05d5\u05d9\u05d0\u05db\u05dc \u05d5\u05d9\u05e9\u05ea \u05d5\u05d9\u05e9\u05d1 \u05d5\u05d9\u05e9\u05db\u05d1"}, {"pk": 2896405, "verse": 7, "text": "\u05d6 \u05d5\u05d9\u05e9\u05d1 \u05de\u05dc\u05d0\u05da \u05d9\u05d4\u05d5\u05d4 \u05e9\u05e0\u05d9\u05ea \u05d5\u05d9\u05d2\u05e2 \u05d1\u05d5 \u05d5\u05d9\u05d0\u05de\u05e8 \u05e7\u05d5\u05dd \u05d0\u05db\u05dc\u00a0 \u05db\u05d9 \u05e8\u05d1 \u05de\u05de\u05da \u05d4\u05d3\u05e8\u05da"}, {"pk": 2896406, "verse": 8, "text": "\u05d7 \u05d5\u05d9\u05e7\u05dd \u05d5\u05d9\u05d0\u05db\u05dc \u05d5\u05d9\u05e9\u05ea\u05d4 \u05d5\u05d9\u05dc\u05da \u05d1\u05db\u05d7 \u05d4\u05d0\u05db\u05d9\u05dc\u05d4 \u05d4\u05d4\u05d9\u05d0 \u05d0\u05e8\u05d1\u05e2\u05d9\u05dd \u05d9\u05d5\u05dd \u05d5\u05d0\u05e8\u05d1\u05e2\u05d9\u05dd \u05dc\u05d9\u05dc\u05d4 \u05e2\u05d3 \u05d4\u05e8 \u05d4\u05d0\u05dc\u05d4\u05d9\u05dd \u05d7\u05e8\u05d1"}, {"pk": 2896407, "verse": 9, "text": "\u05d8 \u05d5\u05d9\u05d1\u05d0 \u05e9\u05dd \u05d0\u05dc \u05d4\u05de\u05e2\u05e8\u05d4 \u05d5\u05d9\u05dc\u05df \u05e9\u05dd \u05d5\u05d4\u05e0\u05d4 \u05d3\u05d1\u05e8 \u05d9\u05d4\u05d5\u05d4 \u05d0\u05dc\u05d9\u05d5 \u05d5\u05d9\u05d0\u05de\u05e8 \u05dc\u05d5 \u05de\u05d4 \u05dc\u05da \u05e4\u05d4 \u05d0\u05dc\u05d9\u05d4\u05d5"}, {"pk": 2896408, "verse": 10, "text": "\u05d9 \u05d5\u05d9\u05d0\u05de\u05e8 \u05e7\u05e0\u05d0 \u05e7\u05e0\u05d0\u05ea\u05d9 \u05dc\u05d9\u05d4\u05d5\u05d4 \u05d0\u05dc\u05d4\u05d9 \u05e6\u05d1\u05d0\u05d5\u05ea \u05db\u05d9 \u05e2\u05d6\u05d1\u05d5 \u05d1\u05e8\u05d9\u05ea\u05da \u05d1\u05e0\u05d9 \u05d9\u05e9\u05e8\u05d0\u05dc--\u05d0\u05ea \u05de\u05d6\u05d1\u05d7\u05ea\u05d9\u05da \u05d4\u05e8\u05e1\u05d5 \u05d5\u05d0\u05ea \u05e0\u05d1\u05d9\u05d0\u05d9\u05da \u05d4\u05e8\u05d2\u05d5 \u05d1\u05d7\u05e8\u05d1 \u05d5\u05d0\u05d5\u05ea\u05e8 \u05d0\u05e0\u05d9 \u05dc\u05d1\u05d3\u05d9 \u05d5\u05d9\u05d1\u05e7\u05e9\u05d5 \u05d0\u05ea \u05e0\u05e4\u05e9\u05d9 \u05dc\u05e7\u05d7\u05ea\u05d4"}, {"pk": 2896409, "verse": 11, "text": "\u05d9\u05d0 \u05d5\u05d9\u05d0\u05de\u05e8 \u05e6\u05d0 \u05d5\u05e2\u05de\u05d3\u05ea \u05d1\u05d4\u05e8 \u05dc\u05e4\u05e0\u05d9 \u05d9\u05d4\u05d5\u05d4 \u05d5\u05d4\u05e0\u05d4 \u05d9\u05d4\u05d5\u05d4 \u05e2\u05d1\u05e8 \u05d5\u05e8\u05d5\u05d7 \u05d2\u05d3\u05d5\u05dc\u05d4 \u05d5\u05d7\u05d6\u05e7 \u05de\u05e4\u05e8\u05e7 \u05d4\u05e8\u05d9\u05dd \u05d5\u05de\u05e9\u05d1\u05e8 \u05e1\u05dc\u05e2\u05d9\u05dd \u05dc\u05e4\u05e0\u05d9 \u05d9\u05d4\u05d5\u05d4 \u05dc\u05d0 \u05d1\u05e8\u05d5\u05d7 \u05d9\u05d4\u05d5\u05d4 \u05d5\u05d0\u05d7\u05e8 \u05d4\u05e8\u05d5\u05d7 \u05e8\u05e2\u05e9 \u05dc\u05d0 \u05d1\u05e8\u05e2\u05e9 \u05d9\u05d4\u05d5\u05d4"}, {"pk": 2896410, "verse": 12, "text": "\u05d9\u05d1 \u05d5\u05d0\u05d7\u05e8 \u05d4\u05e8\u05e2\u05e9 \u05d0\u05e9 \u05dc\u05d0 \u05d1\u05d0\u05e9 \u05d9\u05d4\u05d5\u05d4 \u05d5\u05d0\u05d7\u05e8 \u05d4\u05d0\u05e9 \u05e7\u05d5\u05dc \u05d3\u05de\u05de\u05d4 \u05d3\u05e7\u05d4"}, {"pk": 2896411, "verse": 13, "text": "\u05d9\u05d2 \u05d5\u05d9\u05d4\u05d9 \u05db\u05e9\u05de\u05e2 \u05d0\u05dc\u05d9\u05d4\u05d5 \u05d5\u05d9\u05dc\u05d8 \u05e4\u05e0\u05d9\u05d5 \u05d1\u05d0\u05d3\u05e8\u05ea\u05d5 \u05d5\u05d9\u05e6\u05d0 \u05d5\u05d9\u05e2\u05de\u05d3 \u05e4\u05ea\u05d7 \u05d4\u05de\u05e2\u05e8\u05d4 \u05d5\u05d4\u05e0\u05d4 \u05d0\u05dc\u05d9\u05d5 \u05e7\u05d5\u05dc \u05d5\u05d9\u05d0\u05de\u05e8 \u05de\u05d4 \u05dc\u05da \u05e4\u05d4 \u05d0\u05dc\u05d9\u05d4\u05d5"}, {"pk": 2896412, "verse": 14, "text": "\u05d9\u05d3 \u05d5\u05d9\u05d0\u05de\u05e8 \u05e7\u05e0\u05d0 \u05e7\u05e0\u05d0\u05ea\u05d9 \u05dc\u05d9\u05d4\u05d5\u05d4 \u05d0\u05dc\u05d4\u05d9 \u05e6\u05d1\u05d0\u05d5\u05ea \u05db\u05d9 \u05e2\u05d6\u05d1\u05d5 \u05d1\u05e8\u05d9\u05ea\u05da \u05d1\u05e0\u05d9 \u05d9\u05e9\u05e8\u05d0\u05dc--\u05d0\u05ea \u05de\u05d6\u05d1\u05d7\u05ea\u05d9\u05da \u05d4\u05e8\u05e1\u05d5 \u05d5\u05d0\u05ea \u05e0\u05d1\u05d9\u05d0\u05d9\u05da \u05d4\u05e8\u05d2\u05d5 \u05d1\u05d7\u05e8\u05d1 \u05d5\u05d0\u05d5\u05ea\u05e8 \u05d0\u05e0\u05d9 \u05dc\u05d1\u05d3\u05d9 \u05d5\u05d9\u05d1\u05e7\u05e9\u05d5 \u05d0\u05ea \u05e0\u05e4\u05e9\u05d9 \u05dc\u05e7\u05d7\u05ea\u05d4\u00a0 {\u05e1}"}, {"pk": 2896413, "verse": 15, "text": "\u05d8\u05d5 \u05d5\u05d9\u05d0\u05de\u05e8 \u05d9\u05d4\u05d5\u05d4 \u05d0\u05dc\u05d9\u05d5 \u05dc\u05da \u05e9\u05d5\u05d1 \u05dc\u05d3\u05e8\u05db\u05da \u05de\u05d3\u05d1\u05e8\u05d4 \u05d3\u05de\u05e9\u05e7 \u05d5\u05d1\u05d0\u05ea \u05d5\u05de\u05e9\u05d7\u05ea \u05d0\u05ea \u05d7\u05d6\u05d0\u05dc \u05dc\u05de\u05dc\u05da--\u05e2\u05dc \u05d0\u05e8\u05dd"}, {"pk": 2896414, "verse": 16, "text": "\u05d8\u05d6 \u05d5\u05d0\u05ea \u05d9\u05d4\u05d5\u05d0 \u05d1\u05df \u05e0\u05de\u05e9\u05d9 \u05ea\u05de\u05e9\u05d7 \u05dc\u05de\u05dc\u05da \u05e2\u05dc \u05d9\u05e9\u05e8\u05d0\u05dc \u05d5\u05d0\u05ea \u05d0\u05dc\u05d9\u05e9\u05e2 \u05d1\u05df \u05e9\u05e4\u05d8 \u05de\u05d0\u05d1\u05dc \u05de\u05d7\u05d5\u05dc\u05d4 \u05ea\u05de\u05e9\u05d7 \u05dc\u05e0\u05d1\u05d9\u05d0 \u05ea\u05d7\u05ea\u05d9\u05da"}, {"pk": 2896415, "verse": 17, "text": "\u05d9\u05d6 \u05d5\u05d4\u05d9\u05d4 \u05d4\u05e0\u05de\u05dc\u05d8 \u05de\u05d7\u05e8\u05d1 \u05d7\u05d6\u05d0\u05dc--\u05d9\u05de\u05d9\u05ea \u05d9\u05d4\u05d5\u05d0 \u05d5\u05d4\u05e0\u05de\u05dc\u05d8 \u05de\u05d7\u05e8\u05d1 \u05d9\u05d4\u05d5\u05d0 \u05d9\u05de\u05d9\u05ea \u05d0\u05dc\u05d9\u05e9\u05e2"}, {"pk": 2896416, "verse": 18, "text": "\u05d9\u05d7 \u05d5\u05d4\u05e9\u05d0\u05e8\u05ea\u05d9 \u05d1\u05d9\u05e9\u05e8\u05d0\u05dc \u05e9\u05d1\u05e2\u05ea \u05d0\u05dc\u05e4\u05d9\u05dd\u00a0 \u05db\u05dc \u05d4\u05d1\u05e8\u05db\u05d9\u05dd \u05d0\u05e9\u05e8 \u05dc\u05d0 \u05db\u05e8\u05e2\u05d5 \u05dc\u05d1\u05e2\u05dc \u05d5\u05db\u05dc \u05d4\u05e4\u05d4 \u05d0\u05e9\u05e8 \u05dc\u05d0 \u05e0\u05e9\u05e7 \u05dc\u05d5"}, {"pk": 2896417, "verse": 19, "text": "\u05d9\u05d8 \u05d5\u05d9\u05dc\u05da \u05de\u05e9\u05dd \u05d5\u05d9\u05de\u05e6\u05d0 \u05d0\u05ea \u05d0\u05dc\u05d9\u05e9\u05e2 \u05d1\u05df \u05e9\u05e4\u05d8 \u05d5\u05d4\u05d5\u05d0 \u05d7\u05e8\u05e9 \u05e9\u05e0\u05d9\u05dd \u05e2\u05e9\u05e8 \u05e6\u05de\u05d3\u05d9\u05dd \u05dc\u05e4\u05e0\u05d9\u05d5 \u05d5\u05d4\u05d5\u05d0 \u05d1\u05e9\u05e0\u05d9\u05dd \u05d4\u05e2\u05e9\u05e8 \u05d5\u05d9\u05e2\u05d1\u05e8 \u05d0\u05dc\u05d9\u05d4\u05d5 \u05d0\u05dc\u05d9\u05d5 \u05d5\u05d9\u05e9\u05dc\u05da \u05d0\u05d3\u05e8\u05ea\u05d5 \u05d0\u05dc\u05d9\u05d5"}, {"pk": 2896418, "verse": 20, "text": "\u05db \u05d5\u05d9\u05e2\u05d6\u05d1 \u05d0\u05ea \u05d4\u05d1\u05e7\u05e8 \u05d5\u05d9\u05e8\u05e5 \u05d0\u05d7\u05e8\u05d9 \u05d0\u05dc\u05d9\u05d4\u05d5 \u05d5\u05d9\u05d0\u05de\u05e8 \u05d0\u05e9\u05e7\u05d4 \u05e0\u05d0 \u05dc\u05d0\u05d1\u05d9 \u05d5\u05dc\u05d0\u05de\u05d9 \u05d5\u05d0\u05dc\u05db\u05d4 \u05d0\u05d7\u05e8\u05d9\u05da \u05d5\u05d9\u05d0\u05de\u05e8 \u05dc\u05d5 \u05dc\u05da \u05e9\u05d5\u05d1 \u05db\u05d9 \u05de\u05d4 \u05e2\u05e9\u05d9\u05ea\u05d9 \u05dc\u05da"}, {"pk": 2896419, "verse": 21, "text": "\u05db\u05d0 \u05d5\u05d9\u05e9\u05d1 \u05de\u05d0\u05d7\u05e8\u05d9\u05d5 \u05d5\u05d9\u05e7\u05d7 \u05d0\u05ea \u05e6\u05de\u05d3 \u05d4\u05d1\u05e7\u05e8 \u05d5\u05d9\u05d6\u05d1\u05d7\u05d4\u05d5 \u05d5\u05d1\u05db\u05dc\u05d9 \u05d4\u05d1\u05e7\u05e8 \u05d1\u05e9\u05dc\u05dd \u05d4\u05d1\u05e9\u05e8 \u05d5\u05d9\u05ea\u05df \u05dc\u05e2\u05dd \u05d5\u05d9\u05d0\u05db\u05dc\u05d5 \u05d5\u05d9\u05e7\u05dd \u05d5\u05d9\u05dc\u05da \u05d0\u05d7\u05e8\u05d9 \u05d0\u05dc\u05d9\u05d4\u05d5--\u05d5\u05d9\u05e9\u05e8\u05ea\u05d4\u05d5\u00a0 {\u05e4}"}]