[{"pk": 8901, "verse": 1, "text": "\u05d5\u05b7\u05d9\u05b0\u05d4\u05b4\u05a3\u05d9 \u05d1\u05b4\u05e9\u05c1\u05b0\u05de\u05b9\u05d5\u05e0\u05b4\u05a3\u05d9\u05dd \u05e9\u05c1\u05b8\u05e0\u05b8\u05a3\u05d4 \u05d5\u05b0\u05d0\u05b7\u05e8\u05b0\u05d1\u05bc\u05b7\u05a3\u05e2 \u05de\u05b5\u05d0\u05b9\u05a3\u05d5\u05ea \u05e9\u05c1\u05b8\u05e0\u05b8\u05a1\u05d4 \u05dc\u05b0\u05e6\u05b5\u05a3\u05d0\u05ea \u05d1\u05bc\u05b0\u05e0\u05b5\u05bd\u05d9\u05be\u05d9\u05b4\u05e9\u05c2\u05b0\u05e8\u05b8\u05d0\u05b5\u05a3\u05dc \u05de\u05b5\u05d0\u05b6\u05bd\u05e8\u05b6\u05e5\u05be\u05de\u05b4\u05e6\u05b0\u05e8\u05b7\u05d9\u05b4\u05dd\u05a9 \u05d1\u05bc\u05b7\u05e9\u05c1\u05bc\u05b8\u05e0\u05b8\u05a8\u05d4 \u05d4\u05b8\u05e8\u05b0\u05d1\u05b4\u05d9\u05e2\u05b4\u059c\u05d9\u05ea \u05d1\u05bc\u05b0\u05d7\u05b9\u05a3\u05d3\u05b6\u05e9\u05c1 \u05d6\u05b4\u0597\u05d5 \u05d4\u059a\u05d5\u05bc\u05d0 \u05d4\u05b7\u05d7\u05b9\u05a3\u05d3\u05b6\u05e9\u05c1 \u05d4\u05b7\u05e9\u05c1\u05bc\u05b5\u05e0\u05b4\u0594\u05d9 \u05dc\u05b4\u05de\u05b0\u05dc\u05b9\u05a5\u05da\u05b0 \u05e9\u05c1\u05b0\u05dc\u05b9\u05de\u05b9\u0596\u05d4 \u05e2\u05b7\u05dc\u05be\u05d9\u05b4\u05e9\u05c2\u05b0\u05e8\u05b8\u05d0\u05b5\u0591\u05dc \u05d5\u05b7\u05d9\u05bc\u05b4\u05a5\u05d1\u05b6\u05df \u05d4\u05b7\u05d1\u05bc\u05b7\u0596\u05d9\u05b4\u05ea \u05dc\u05b7\u05d9\u05d4\u05d5\u05b8\u05bd\u05d4\u05c3"}, {"pk": 8902, "verse": 2, "text": "\u05d5\u05b0\u05d4\u05b7\u05d1\u05bc\u05b7\u0597\u05d9\u05b4\u05ea \u05d0\u05b2\u05e9\u05c1\u05b6\u05a8\u05e8 \u05d1\u05bc\u05b8\u05e0\u05b8\u059c\u05d4 \u05d4\u05b7\u05de\u05bc\u05b6\u05a4\u05dc\u05b6\u05da\u05b0 \u05e9\u05c1\u05b0\u05dc\u05b9\u05de\u05b9\u05d4\u0599 \u05dc\u05b7\u05bd\u05d9\u05d4\u05d5\u05b8\u0594\u05d4 \u05e9\u05c1\u05b4\u05e9\u05c1\u05bc\u05b4\u05bd\u05d9\u05dd\u05be\u05d0\u05b7\u05de\u05bc\u05b8\u05a5\u05d4 \u05d0\u05b8\u05e8\u05b0\u05db\u05bc\u05b9\u0596\u05d5 \u05d5\u05b0\u05e2\u05b6\u05e9\u05c2\u05b0\u05e8\u05b4\u05a4\u05d9\u05dd \u05e8\u05b8\u05d7\u05b0\u05d1\u05bc\u05b9\u0591\u05d5 \u05d5\u05bc\u05e9\u05c1\u05b0\u05dc\u05b9\u05e9\u05c1\u05b4\u05a5\u05d9\u05dd \u05d0\u05b7\u05de\u05bc\u05b8\u0596\u05d4 \u05e7\u05b9\u05d5\u05de\u05b8\u05ea\u05b9\u05bd\u05d5\u05c3"}, {"pk": 8903, "verse": 3, "text": "\u05d5\u05b0\u05d4\u05b8\u05d0\u05d5\u05bc\u05dc\u05b8\u0597\u05dd \u05e2\u05b7\u05dc\u05be\u05e4\u05bc\u05b0\u05e0\u05b5\u05d9\u0599 \u05d4\u05b5\u05d9\u05db\u05b7\u05a3\u05dc \u05d4\u05b7\u05d1\u05bc\u05b7\u0594\u05d9\u05b4\u05ea \u05e2\u05b6\u05e9\u05c2\u05b0\u05e8\u05b4\u05a3\u05d9\u05dd \u05d0\u05b7\u05de\u05bc\u05b8\u05d4\u0599 \u05d0\u05b8\u05e8\u05b0\u05db\u05bc\u05b9\u0594\u05d5 \u05e2\u05b7\u05dc\u05be\u05e4\u05bc\u05b0\u05e0\u05b5\u0596\u05d9 \u05e8\u05b9\u05a3\u05d7\u05b7\u05d1 \u05d4\u05b7\u05d1\u05bc\u05b8\u0591\u05d9\u05b4\u05ea \u05e2\u05b6\u05a7\u05e9\u05c2\u05b6\u05e8 \u05d1\u05bc\u05b8\u05d0\u05b7\u05de\u05bc\u05b8\u059b\u05d4 \u05e8\u05b8\u05d7\u05b0\u05d1\u05bc\u05b9\u0596\u05d5 \u05e2\u05b7\u05dc\u05be\u05e4\u05bc\u05b0\u05e0\u05b5\u05a5\u05d9 \u05d4\u05b7\u05d1\u05bc\u05b8\u05bd\u05d9\u05b4\u05ea\u05c3"}, {"pk": 8904, "verse": 4, "text": "\u05d5\u05b7\u05d9\u05bc\u05b7\u05a3\u05e2\u05b7\u05e9\u05c2 \u05dc\u05b7\u05d1\u05bc\u05b8\u0594\u05d9\u05b4\u05ea \u05d7\u05b7\u05dc\u05bc\u05b9\u05d5\u05e0\u05b5\u0596\u05d9 \u05e9\u05c1\u05b0\u05e7\u05bb\u05e4\u05b4\u05a5\u05d9\u05dd \u05d0\u05b2\u05d8\u05bb\u05de\u05b4\u05bd\u05d9\u05dd\u05c3"}, {"pk": 8905, "verse": 5, "text": "\u05d5\u05b7\u05d9\u05bc\u05b4\u05d1\u05b6\u05df\u05a9 \u05e2\u05b7\u05dc\u05be\u05e7\u05b4\u05a8\u05d9\u05e8 \u05d4\u05b7\u05d1\u05bc\u05b7\u05a4\u05d9\u05b4\u05ea [\u05d9\u05b8\u05e6\u05b9\u05d5\u05e2\u05b7 \u05db] (\u05d9\u05b8\u05e6\u05b4\u0599\u05d9\u05e2\u05b7\u0599 \u05e7) \u05e1\u05b8\u05d1\u05b4\u0594\u05d9\u05d1 \u05d0\u05b6\u05ea\u05be\u05e7\u05b4\u05d9\u05e8\u05b9\u05a4\u05d5\u05ea \u05d4\u05b7\u05d1\u05bc\u05b7\u0599\u05d9\u05b4\u05ea\u0599 \u05e1\u05b8\u05d1\u05b4\u0594\u05d9\u05d1 \u05dc\u05b7\u05bd\u05d4\u05b5\u05d9\u05db\u05b8\u0596\u05dc \u05d5\u05b0\u05dc\u05b7\u05d3\u05bc\u05b0\u05d1\u05b4\u0591\u05d9\u05e8 \u05d5\u05b7\u05d9\u05bc\u05b7\u05a5\u05e2\u05b7\u05e9\u05c2 \u05e6\u05b0\u05dc\u05b8\u05e2\u05b9\u0596\u05d5\u05ea \u05e1\u05b8\u05d1\u05b4\u05bd\u05d9\u05d1\u05c3"}, {"pk": 8906, "verse": 6, "text": "[\u05d4\u05b7\u05d9\u05bc\u05b8\u05e6\u05b9\u05d5\u05e2\u05b7 \u05db] (\u05d4\u05b7\u05d9\u05bc\u05b8\u05e6\u05b4\u05a8\u05d9\u05e2\u05b7 \u05e7) \u05d4\u05b7\u05ea\u05bc\u05b7\u05d7\u05b0\u05ea\u05bc\u05b9\u05e0\u05b8\u059c\u05d4 \u05d7\u05b8\u05de\u05b5\u05a7\u05e9\u05c1 \u05d1\u05bc\u05b8\u05d0\u05b7\u05de\u05bc\u05b8\u05a3\u05d4 \u05e8\u05b8\u05d7\u05b0\u05d1\u05bc\u05b8\u0597\u05d4\u05bc \u05d5\u05b0\u05d4\u05b7\u05ea\u05bc\u05b4\u05bd\u05d9\u05db\u05b9\u05e0\u05b8\u05d4\u0599 \u05e9\u05c1\u05b5\u05a4\u05e9\u05c1 \u05d1\u05bc\u05b8\u05bd\u05d0\u05b7\u05de\u05bc\u05b8\u05d4\u0599 \u05e8\u05b8\u05d7\u05b0\u05d1\u05bc\u05b8\u0594\u05d4\u05bc \u05d5\u05b0\u05d4\u05b7\u05a8\u05e9\u05c1\u05bc\u05b0\u05dc\u05b4\u05d9\u05e9\u05c1\u05b4\u0594\u05d9\u05ea \u05e9\u05c1\u05b6\u05a5\u05d1\u05b7\u05e2 \u05d1\u05bc\u05b8\u05d0\u05b7\u05de\u05bc\u05b8\u0596\u05d4 \u05e8\u05b8\u05d7\u05b0\u05d1\u05bc\u05b8\u0591\u05d4\u05bc \u05db\u05bc\u05b4\u05a1\u05d9 \u05de\u05b4\u05d2\u05b0\u05e8\u05b8\u05e2\u05b9\u05d5\u05ea\u05a9 \u05e0\u05b8\u05ea\u05b7\u05a8\u05df \u05dc\u05b7\u05d1\u05bc\u05b7\u05a4\u05d9\u05b4\u05ea \u05e1\u05b8\u05d1\u05b4\u05d9\u05d1\u0599 \u05d7\u0594\u05d5\u05bc\u05e6\u05b8\u05d4 \u05dc\u05b0\u05d1\u05b4\u05dc\u05b0\u05ea\u05bc\u05b4\u0596\u05d9 \u05d0\u05b2\u05d7\u05b9\u05a5\u05d6 \u05d1\u05bc\u05b0\u05e7\u05b4\u05bd\u05d9\u05e8\u05b9\u05d5\u05ea\u05be\u05d4\u05b7\u05d1\u05bc\u05b8\u05bd\u05d9\u05b4\u05ea\u05c3"}, {"pk": 8907, "verse": 7, "text": "\u05d5\u05b0\u05d4\u05b7\u05d1\u05bc\u05b7\u0599\u05d9\u05b4\u05ea\u0599 \u05d1\u05bc\u05b0\u05d4\u05b4\u05d1\u05bc\u05b8\u05a3\u05e0\u05b9\u05ea\u05b9\u0594\u05d5 \u05d0\u05b6\u05bd\u05d1\u05b6\u05df\u05be\u05e9\u05c1\u05b0\u05dc\u05b5\u05de\u05b8\u05a5\u05d4 \u05de\u05b7\u05e1\u05bc\u05b8\u0596\u05e2 \u05e0\u05b4\u05d1\u05b0\u05e0\u05b8\u0591\u05d4 \u05d5\u05bc\u05de\u05b7\u05e7\u05bc\u05b8\u05d1\u05b9\u05a4\u05d5\u05ea \u05d5\u05b0\u05d4\u05b7\u05d2\u05bc\u05b7\u05e8\u05b0\u05d6\u05b6\u05df\u0599 \u05db\u05bc\u05b8\u05dc\u05be\u05db\u05bc\u05b0\u05dc\u05b4\u05a3\u05d9 \u05d1\u05b7\u05e8\u05b0\u05d6\u05b6\u0594\u05dc \u05dc\u05b9\u05bd\u05d0\u05be\u05e0\u05b4\u05e9\u05c1\u05b0\u05de\u05b7\u05a5\u05e2 \u05d1\u05bc\u05b7\u05d1\u05bc\u05b7\u0596\u05d9\u05b4\u05ea \u05d1\u05bc\u05b0\u05d4\u05b4\u05d1\u05bc\u05b8\u05e0\u05b9\u05ea\u05b9\u05bd\u05d5\u05c3"}, {"pk": 8908, "verse": 8, "text": "\u05e4\u05bc\u05b6\u0597\u05ea\u05b7\u05d7 \u05d4\u05b7\u05e6\u05bc\u05b5\u05dc\u05b8\u05e2\u0599 \u05d4\u05b7\u05ea\u05bc\u05b4\u05a3\u05d9\u05db\u05b9\u05e0\u05b8\u0594\u05d4 \u05d0\u05b6\u05dc\u05be\u05db\u05bc\u05b6\u05a5\u05ea\u05b6\u05e3 \u05d4\u05b7\u05d1\u05bc\u05b7\u0596\u05d9\u05b4\u05ea \u05d4\u05b7\u05d9\u05b0\u05de\u05b8\u05e0\u05b4\u0591\u05d9\u05ea \u05d5\u05bc\u05d1\u05b0\u05dc\u05d5\u05bc\u05dc\u05bc\u05b4\u0597\u05d9\u05dd \u05d9\u05b7\u05bd\u05e2\u05b2\u05dc\u05d5\u05bc\u0599 \u05e2\u05b7\u05dc\u05be\u05d4\u05b7\u05ea\u05bc\u05b4\u05a3\u05d9\u05db\u05b9\u05e0\u05b8\u0594\u05d4 \u05d5\u05bc\u05de\u05b4\u05df\u05be\u05d4\u05b7\u05ea\u05bc\u05b4\u05bd\u05d9\u05db\u05b9\u05e0\u05b8\u0596\u05d4 \u05d0\u05b6\u05dc\u05be\u05d4\u05b7\u05e9\u05c1\u05bc\u05b0\u05dc\u05b4\u05e9\u05c1\u05b4\u05bd\u05d9\u05dd\u05c3"}, {"pk": 8909, "verse": 9, "text": "\u05d5\u05b7\u05d9\u05bc\u05b4\u05a5\u05d1\u05b6\u05df \u05d0\u05b6\u05ea\u05be\u05d4\u05b7\u05d1\u05bc\u05b7\u0596\u05d9\u05b4\u05ea \u05d5\u05b7\u05d9\u05b0\u05db\u05b7\u05dc\u05bc\u05b5\u0591\u05d4\u05d5\u05bc \u05d5\u05b7\u05d9\u05bc\u05b4\u05e1\u05b0\u05e4\u05bc\u05b9\u05a4\u05df \u05d0\u05b6\u05ea\u05be\u05d4\u05b7\u05d1\u05bc\u05b7\u0599\u05d9\u05b4\u05ea\u0599 \u05d2\u05bc\u05b5\u05d1\u05b4\u0594\u05d9\u05dd \u05d5\u05bc\u05e9\u05c2\u05b0\u05d3\u05b5\u05e8\u05b9\u0596\u05ea \u05d1\u05bc\u05b8\u05d0\u05b2\u05e8\u05b8\u05d6\u05b4\u05bd\u05d9\u05dd\u05c3"}, {"pk": 8910, "verse": 10, "text": "\u05d5\u05b7\u05d9\u05bc\u05b4\u05a4\u05d1\u05b6\u05df \u05d0\u05b6\u05ea\u05be [\u05d4\u05b7\u05d9\u05bc\u05b8\u05e6\u05b9\u05d5\u05e2\u05b7 \u05db] (\u05d4\u05b7\u05d9\u05bc\u05b8\u05e6\u05b4\u0599\u05d9\u05e2\u05b7\u0599 \u05e7) \u05e2\u05b7\u05dc\u05be\u05db\u05bc\u05b8\u05dc\u05be\u05d4\u05b7\u05d1\u05bc\u05b7\u0594\u05d9\u05b4\u05ea \u05d7\u05b8\u05de\u05b5\u05a5\u05e9\u05c1 \u05d0\u05b7\u05de\u05bc\u05b9\u0596\u05d5\u05ea \u05e7\u05b9\u05bd\u05d5\u05de\u05b8\u05ea\u05b9\u0591\u05d5 \u05d5\u05b7\u05d9\u05bc\u05b6\u05d0\u05b1\u05d7\u05b9\u05a5\u05d6 \u05d0\u05b6\u05ea\u05be\u05d4\u05b7\u05d1\u05bc\u05b7\u0596\u05d9\u05b4\u05ea \u05d1\u05bc\u05b7\u05e2\u05b2\u05e6\u05b5\u05a5\u05d9 \u05d0\u05b2\u05e8\u05b8\u05d6\u05b4\u05bd\u05d9\u05dd\u05c3  \u05e4"}, {"pk": 8911, "verse": 11, "text": "\u05d5\u05b7\u05bd\u05d9\u05b0\u05d4\u05b4\u05d9\u0599 \u05d3\u05bc\u05b0\u05d1\u05b7\u05e8\u05be\u05d9\u05b0\u05d4\u05d5\u05b8\u0594\u05d4 \u05d0\u05b6\u05dc\u05be\u05e9\u05c1\u05b0\u05dc\u05b9\u05de\u05b9\u0596\u05d4 \u05dc\u05b5\u05d0\u05de\u05b9\u05bd\u05e8\u05c3"}, {"pk": 8912, "verse": 12, "text": "\u05d4\u05b7\u05d1\u05bc\u05b7\u05a8\u05d9\u05b4\u05ea \u05d4\u05b7\u05d6\u05bc\u05b6\u059c\u05d4 \u05d0\u05b2\u05e9\u05c1\u05b6\u05e8\u05be\u05d0\u05b7\u05ea\u05bc\u05b8\u05a3\u05d4 \u05d1\u05b9\u05e0\u05b6\u0597\u05d4 \u05d0\u05b4\u05dd\u05be\u05ea\u05bc\u05b5\u05dc\u05b5\u05a4\u05da\u05b0 \u05d1\u05bc\u05b0\u05d7\u05bb\u05e7\u05bc\u05b9\u05ea\u05b7\u05d9\u0599 \u05d5\u05b0\u05d0\u05b6\u05ea\u05be\u05de\u05b4\u05e9\u05c1\u05b0\u05e4\u05bc\u05b8\u05d8\u05b7\u05a3\u05d9 \u05ea\u05bc\u05b7\u05bd\u05e2\u05b2\u05e9\u05c2\u05b6\u0594\u05d4 \u05d5\u05b0\u05e9\u05c1\u05b8\u05de\u05b7\u05e8\u05b0\u05ea\u05bc\u05b8\u05a5 \u05d0\u05b6\u05ea\u05be\u05db\u05bc\u05b8\u05dc\u05be\u05de\u05b4\u05e6\u05b0\u05d5\u05b9\u05ea\u05b7\u0596\u05d9 \u05dc\u05b8\u05dc\u05b6\u05a3\u05db\u05b6\u05ea \u05d1\u05bc\u05b8\u05d4\u05b6\u0591\u05dd \u05d5\u05b7\u05d4\u05b2\u05e7\u05b4\u05de\u05b9\u05ea\u05b4\u05a4\u05d9 \u05d0\u05b6\u05ea\u05be\u05d3\u05bc\u05b0\u05d1\u05b8\u05e8\u05b4\u05d9\u0599 \u05d0\u05b4\u05ea\u05bc\u05b8\u0594\u05da\u05b0 \u05d0\u05b2\u05e9\u05c1\u05b6\u05a5\u05e8 \u05d3\u05bc\u05b4\u05d1\u05bc\u05b7\u0596\u05e8\u05b0\u05ea\u05bc\u05b4\u05d9 \u05d0\u05b6\u05dc\u05be\u05d3\u05bc\u05b8\u05d5\u05b4\u05a5\u05d3 \u05d0\u05b8\u05d1\u05b4\u05bd\u05d9\u05da\u05b8\u05c3"}, {"pk": 8913, "verse": 13, "text": "\u05d5\u05b0\u05e9\u05c1\u05b8\u05a3\u05db\u05b7\u05e0\u05b0\u05ea\u05bc\u05b4\u0594\u05d9 \u05d1\u05bc\u05b0\u05ea\u05b9\u0596\u05d5\u05da\u05b0 \u05d1\u05bc\u05b0\u05e0\u05b5\u05a3\u05d9 \u05d9\u05b4\u05e9\u05c2\u05b0\u05e8\u05b8\u05d0\u05b5\u0591\u05dc \u05d5\u05b0\u05dc\u05b9\u05a5\u05d0 \u05d0\u05b6\u05e2\u05b1\u05d6\u05b9\u0596\u05d1 \u05d0\u05b6\u05ea\u05be\u05e2\u05b7\u05de\u05bc\u05b4\u05a5\u05d9 \u05d9\u05b4\u05e9\u05c2\u05b0\u05e8\u05b8\u05d0\u05b5\u05bd\u05dc\u05c3    \u05e1"}, {"pk": 8914, "verse": 14, "text": "\u05d5\u05b7\u05d9\u05bc\u05b4\u05a7\u05d1\u05b6\u05df \u05e9\u05c1\u05b0\u05dc\u05b9\u05de\u05b9\u059b\u05d4 \u05d0\u05b6\u05ea\u05be\u05d4\u05b7\u05d1\u05bc\u05b7\u0596\u05d9\u05b4\u05ea \u05d5\u05b7\u05d9\u05b0\u05db\u05b7\u05dc\u05bc\u05b5\u05bd\u05d4\u05d5\u05bc\u05c3"}, {"pk": 8915, "verse": 15, "text": "\u05d5\u05b7\u05d9\u05bc\u05b4\u05d1\u05b6\u05df\u05a9 \u05d0\u05b6\u05ea\u05be\u05e7\u05b4\u05d9\u05e8\u05b9\u05a8\u05d5\u05ea \u05d4\u05b7\u05d1\u05bc\u05b7\u05a4\u05d9\u05b4\u05ea \u05de\u05b4\u05d1\u05bc\u05b7\u0599\u05d9\u05b0\u05ea\u05b8\u05d4\u0599 \u05d1\u05bc\u05b0\u05e6\u05b7\u05dc\u05b0\u05e2\u05b9\u05a3\u05d5\u05ea \u05d0\u05b2\u05e8\u05b8\u05d6\u05b4\u0594\u05d9\u05dd \u05de\u05b4\u05e7\u05bc\u05b7\u05e8\u05b0\u05e7\u05b7\u05a4\u05e2 \u05d4\u05b7\u05d1\u05bc\u05b7\u0599\u05d9\u05b4\u05ea\u0599 \u05e2\u05b7\u05d3\u05be\u05e7\u05b4\u05d9\u05e8\u05b9\u05a3\u05d5\u05ea \u05d4\u05b7\u05e1\u05bc\u05b4\u05e4\u05bc\u05bb\u0594\u05df \u05e6\u05b4\u05e4\u05bc\u05b8\u05a5\u05d4 \u05e2\u05b5\u0596\u05e5 \u05de\u05b4\u05d1\u05bc\u05b8\u0591\u05d9\u05b4\u05ea \u05d5\u05b7\u05d9\u05b0\u05e6\u05b7\u059b\u05e3 \u05d0\u05b6\u05ea\u05be\u05e7\u05b7\u05e8\u05b0\u05e7\u05b7\u05a5\u05e2 \u05d4\u05b7\u05d1\u05bc\u05b7\u0596\u05d9\u05b4\u05ea \u05d1\u05bc\u05b0\u05e6\u05b7\u05dc\u05b0\u05e2\u05b9\u05a5\u05d5\u05ea \u05d1\u05bc\u05b0\u05e8\u05b9\u05d5\u05e9\u05c1\u05b4\u05bd\u05d9\u05dd\u05c3"}, {"pk": 8916, "verse": 16, "text": "\u05d5\u05b7\u05d9\u05bc\u05b4\u05d1\u05b6\u05df\u05a9 \u05d0\u05b6\u05ea\u05be\u05e2\u05b6\u05e9\u05c2\u05b0\u05e8\u05b4\u05a8\u05d9\u05dd \u05d0\u05b7\u05de\u05bc\u05b8\u059c\u05d4 [\u05de\u05b4\u05d9\u05bc\u05b7\u05e8\u05b0\u05db\u05bc\u05b9\u05d5\u05ea\u05b5\u05d9 \u05db] (\u05de\u05b4\u05bd\u05d9\u05bc\u05b7\u05e8\u05b0\u05db\u05bc\u05b0\u05ea\u05b5\u05a4\u05d9 \u05e7) \u05d4\u05b7\u05d1\u05bc\u05b7\u0599\u05d9\u05b4\u05ea\u0599 \u05d1\u05bc\u05b0\u05e6\u05b7\u05dc\u05b0\u05e2\u05b9\u05a3\u05d5\u05ea \u05d0\u05b2\u05e8\u05b8\u05d6\u05b4\u0594\u05d9\u05dd \u05de\u05b4\u05df\u05be\u05d4\u05b7\u05e7\u05bc\u05b7\u05e8\u05b0\u05e7\u05b7\u0596\u05e2 \u05e2\u05b7\u05d3\u05be\u05d4\u05b7\u05e7\u05bc\u05b4\u05d9\u05e8\u05b9\u0591\u05d5\u05ea \u05d5\u05b7\u05d9\u05bc\u05b4\u05a4\u05d1\u05b6\u05df \u05dc\u05b9\u05d5\u0599 \u05de\u05b4\u05d1\u05bc\u05b7\u05a3\u05d9\u05b4\u05ea \u05dc\u05b4\u05d3\u05b0\u05d1\u05b4\u0594\u05d9\u05e8 \u05dc\u05b0\u05e7\u05b9\u0596\u05d3\u05b6\u05e9\u05c1 \u05d4\u05b7\u05e7\u05bc\u05b3\u05d3\u05b8\u05e9\u05c1\u05b4\u05bd\u05d9\u05dd\u05c3"}, {"pk": 8917, "verse": 17, "text": "\u05d5\u05b0\u05d0\u05b7\u05e8\u05b0\u05d1\u05bc\u05b8\u05e2\u05b4\u05a5\u05d9\u05dd \u05d1\u05bc\u05b8\u05d0\u05b7\u05de\u05bc\u05b8\u0596\u05d4 \u05d4\u05b8\u05d9\u05b8\u05a3\u05d4 \u05d4\u05b7\u05d1\u05bc\u05b8\u0591\u05d9\u05b4\u05ea \u05d4\u0596\u05d5\u05bc\u05d0 \u05d4\u05b7\u05d4\u05b5\u05d9\u05db\u05b8\u05a5\u05dc \u05dc\u05b4\u05e4\u05b0\u05e0\u05b8\u05bd\u05d9\u05c3"}, {"pk": 8918, "verse": 18, "text": "\u05d5\u05b0\u05d0\u05b6\u05a4\u05e8\u05b6\u05d6 \u05d0\u05b6\u05dc\u05be\u05d4\u05b7\u05d1\u05bc\u05b7\u0599\u05d9\u05b4\u05ea\u0599 \u05e4\u05bc\u05b0\u05e0\u05b4\u0594\u05d9\u05de\u05b8\u05d4 \u05de\u05b4\u05e7\u05b0\u05dc\u05b7\u05a3\u05e2\u05b7\u05ea \u05e4\u05bc\u05b0\u05e7\u05b8\u05e2\u05b4\u0594\u05d9\u05dd \u05d5\u05bc\u05e4\u05b0\u05d8\u05d5\u05bc\u05e8\u05b5\u0596\u05d9 \u05e6\u05b4\u05e6\u05bc\u05b4\u0591\u05d9\u05dd \u05d4\u05b7\u05db\u05bc\u05b9\u05a3\u05dc \u05d0\u05b6\u0594\u05e8\u05b6\u05d6 \u05d0\u05b5\u05a5\u05d9\u05df \u05d0\u05b6\u0596\u05d1\u05b6\u05df \u05e0\u05b4\u05e8\u05b0\u05d0\u05b8\u05bd\u05d4\u05c3"}, {"pk": 8919, "verse": 19, "text": "\u05d5\u05bc\u05d3\u05b0\u05d1\u05b4\u05a7\u05d9\u05e8 \u05d1\u05bc\u05b0\u05ea\u05b9\u05d5\u05da\u05b0\u05be\u05d4\u05b7\u05d1\u05bc\u05b7\u059b\u05d9\u05b4\u05ea \u05de\u05b4\u05e4\u05bc\u05b0\u05e0\u05b4\u0596\u05d9\u05de\u05b8\u05d4 \u05d4\u05b5\u05db\u05b4\u0591\u05d9\u05df \u05dc\u05b0\u05ea\u05b4\u05ea\u05bc\u05b5\u05a3\u05df \u05e9\u05c1\u05b8\u0594\u05dd \u05d0\u05b6\u05ea\u05be\u05d0\u05b2\u05e8\u05b9\u0596\u05d5\u05df \u05d1\u05bc\u05b0\u05e8\u05b4\u05a5\u05d9\u05ea \u05d9\u05b0\u05d4\u05d5\u05b8\u05bd\u05d4\u05c3"}, {"pk": 8920, "verse": 20, "text": "\u05d5\u05b0\u05dc\u05b4\u05e4\u05b0\u05e0\u05b5\u05a3\u05d9 \u05d4\u05b7\u05d3\u05bc\u05b0\u05d1\u05b4\u05a1\u05d9\u05e8 \u05e2\u05b6\u05e9\u05c2\u05b0\u05e8\u05b4\u05d9\u05dd\u05a9 \u05d0\u05b7\u05de\u05bc\u05b8\u05a8\u05d4 \u05d0\u05b9\u059c\u05e8\u05b6\u05da\u05b0 \u05d5\u05b0\u05e2\u05b6\u05e9\u05c2\u05b0\u05e8\u05b4\u05a7\u05d9\u05dd \u05d0\u05b7\u05de\u05bc\u05b8\u05a3\u05d4 \u05e8\u05b9\u0597\u05d7\u05b7\u05d1 \u05d5\u05b0\u05e2\u05b6\u05e9\u05c2\u05b0\u05e8\u05b4\u05a4\u05d9\u05dd \u05d0\u05b7\u05de\u05bc\u05b8\u05d4\u0599 \u05e7\u05b9\u05bd\u05d5\u05de\u05b8\u05ea\u05b9\u0594\u05d5 \u05d5\u05b7\u05d9\u05b0\u05e6\u05b7\u05e4\u05bc\u05b5\u0596\u05d4\u05d5\u05bc \u05d6\u05b8\u05d4\u05b8\u05a3\u05d1 \u05e1\u05b8\u05d2\u0591\u05d5\u05bc\u05e8 \u05d5\u05b7\u05d9\u05b0\u05e6\u05b7\u05a5\u05e3 \u05de\u05b4\u05d6\u05b0\u05d1\u05bc\u05b5\u0596\u05d7\u05b7 \u05d0\u05b8\u05bd\u05e8\u05b6\u05d6\u05c3"}, {"pk": 8921, "verse": 21, "text": "\u05d5\u05b7\u05d9\u05b0\u05e6\u05b7\u05a8\u05e3 \u05e9\u05c1\u05b0\u05dc\u05b9\u05de\u05b9\u05a7\u05d4 \u05d0\u05b6\u05ea\u05be\u05d4\u05b7\u05d1\u05bc\u05b7\u059b\u05d9\u05b4\u05ea \u05de\u05b4\u05e4\u05bc\u05b0\u05e0\u05b4\u0596\u05d9\u05de\u05b8\u05d4 \u05d6\u05b8\u05d4\u05b8\u05a3\u05d1 \u05e1\u05b8\u05d2\u0591\u05d5\u05bc\u05e8 \u05d5\u05b7\u05d9\u05b0\u05e2\u05b7\u05d1\u05bc\u05b5\u059e\u05e8 [\u05d1\u05bc\u05b0\u05e8\u05b7\u05ea\u05bc\u05b4\u05d9\u05e7\u05b9\u05d5\u05ea \u05db] (\u05d1\u05bc\u05b0\u05e8\u05b7\u05ea\u05bc\u05d5\u05bc\u05e7\u05b9\u05a4\u05d5\u05ea \u05e7) \u05d6\u05b8\u05d4\u05b8\u05d1\u0599 \u05dc\u05b4\u05e4\u05b0\u05e0\u05b5\u05a3\u05d9 \u05d4\u05b7\u05d3\u05bc\u05b0\u05d1\u05b4\u0594\u05d9\u05e8 \u05d5\u05b7\u05d9\u05b0\u05e6\u05b7\u05e4\u05bc\u05b5\u0596\u05d4\u05d5\u05bc \u05d6\u05b8\u05d4\u05b8\u05bd\u05d1\u05c3"}, {"pk": 8922, "verse": 22, "text": "\u05d5\u05b0\u05d0\u05b6\u05ea\u05be\u05db\u05bc\u05b8\u05dc\u05be\u05d4\u05b7\u05d1\u05bc\u05b7\u059b\u05d9\u05b4\u05ea \u05e6\u05b4\u05e4\u05bc\u05b8\u05a5\u05d4 \u05d6\u05b8\u05d4\u05b8\u0596\u05d1 \u05e2\u05b7\u05d3\u05be\u05ea\u05bc\u05b9\u05a3\u05dd \u05db\u05bc\u05b8\u05dc\u05be\u05d4\u05b7\u05d1\u05bc\u05b8\u0591\u05d9\u05b4\u05ea \u05d5\u05b0\u05db\u05b8\u05dc\u05be\u05d4\u05b7\u05de\u05bc\u05b4\u05d6\u05b0\u05d1\u05bc\u05b5\u05a5\u05d7\u05b7 \u05d0\u05b2\u200d\u05bd\u05e9\u05c1\u05b6\u05e8\u05be\u05dc\u05b7\u05d3\u05bc\u05b0\u05d1\u05b4\u0596\u05d9\u05e8 \u05e6\u05b4\u05e4\u05bc\u05b8\u05a5\u05d4 \u05d6\u05b8\u05d4\u05b8\u05bd\u05d1\u05c3"}, {"pk": 8923, "verse": 23, "text": "\u05d5\u05b7\u05d9\u05bc\u05b7\u05a3\u05e2\u05b7\u05e9\u05c2 \u05d1\u05bc\u05b7\u05d3\u05bc\u05b0\u05d1\u05b4\u0594\u05d9\u05e8 \u05e9\u05c1\u05b0\u05e0\u05b5\u05a5\u05d9 \u05db\u05b0\u05e8\u05d5\u05bc\u05d1\u05b4\u0596\u05d9\u05dd \u05e2\u05b2\u05e6\u05b5\u05d9\u05be\u05e9\u05c1\u05b8\u0591\u05de\u05b6\u05df \u05e2\u05b6\u05a5\u05e9\u05c2\u05b6\u05e8 \u05d0\u05b7\u05de\u05bc\u05b9\u0596\u05d5\u05ea \u05e7\u05b9\u05d5\u05de\u05b8\u05ea\u05b9\u05bd\u05d5\u05c3"}, {"pk": 8924, "verse": 24, "text": "\u05d5\u05b0\u05d7\u05b8\u05de\u05b5\u05a3\u05e9\u05c1 \u05d0\u05b7\u05de\u05bc\u05b9\u0597\u05d5\u05ea \u05db\u05bc\u05b0\u05e0\u05b7\u05a4\u05e3 \u05d4\u05b7\u05db\u05bc\u05b0\u05e8\u05d5\u05bc\u05d1\u0599 \u05d4\u05b8\u05bd\u05d0\u05b6\u05d7\u05b8\u0594\u05ea \u05d5\u05b0\u05d7\u05b8\u05de\u05b5\u05a3\u05e9\u05c1 \u05d0\u05b7\u05de\u05bc\u05b9\u0594\u05d5\u05ea \u05db\u05bc\u05b0\u05e0\u05b7\u05a5\u05e3 \u05d4\u05b7\u05db\u05bc\u05b0\u05e8\u0596\u05d5\u05bc\u05d1 \u05d4\u05b7\u05e9\u05c1\u05bc\u05b5\u05e0\u05b4\u0591\u05d9\u05ea \u05e2\u05b6\u05a3\u05e9\u05c2\u05b6\u05e8 \u05d0\u05b7\u05de\u05bc\u05b9\u0594\u05d5\u05ea \u05de\u05b4\u05e7\u05b0\u05e6\u05b9\u05a5\u05d5\u05ea \u05db\u05bc\u05b0\u05e0\u05b8\u05e4\u05b8\u0596\u05d9\u05d5 \u05d5\u05b0\u05e2\u05b7\u05d3\u05be\u05e7\u05b0\u05e6\u05b9\u05a5\u05d5\u05ea \u05db\u05bc\u05b0\u05e0\u05b8\u05e4\u05b8\u05bd\u05d9\u05d5\u05c3"}, {"pk": 8925, "verse": 25, "text": "\u05d5\u05b0\u05e2\u05b6\u0599\u05e9\u05c2\u05b6\u05e8\u0599 \u05d1\u05bc\u05b8\u05bd\u05d0\u05b7\u05de\u05bc\u05b8\u0594\u05d4 \u05d4\u05b7\u05db\u05bc\u05b0\u05e8\u0596\u05d5\u05bc\u05d1 \u05d4\u05b7\u05e9\u05c1\u05bc\u05b5\u05e0\u05b4\u0591\u05d9 \u05de\u05b4\u05d3\u05bc\u05b8\u05a5\u05d4 \u05d0\u05b7\u05d7\u05b7\u059b\u05ea \u05d5\u05b0\u05e7\u05b6\u05a5\u05e6\u05b6\u05d1 \u05d0\u05b6\u05d7\u05b8\u0596\u05d3 \u05dc\u05b4\u05e9\u05c1\u05b0\u05e0\u05b5\u05a5\u05d9 \u05d4\u05b7\u05db\u05bc\u05b0\u05e8\u05bb\u05d1\u05b4\u05bd\u05d9\u05dd\u05c3"}, {"pk": 8926, "verse": 26, "text": "\u05e7\u05b9\u05d5\u05de\u05b7\u05ea\u0599 \u05d4\u05b7\u05db\u05bc\u05b0\u05e8\u05a3\u05d5\u05bc\u05d1 \u05d4\u05b8\u05bd\u05d0\u05b6\u05d7\u05b8\u0594\u05d3 \u05e2\u05b6\u0596\u05e9\u05c2\u05b6\u05e8 \u05d1\u05bc\u05b8\u05bd\u05d0\u05b7\u05de\u05bc\u05b8\u0591\u05d4 \u05d5\u05b0\u05db\u05b5\u0596\u05df \u05d4\u05b7\u05db\u05bc\u05b0\u05e8\u05a5\u05d5\u05bc\u05d1 \u05d4\u05b7\u05e9\u05c1\u05bc\u05b5\u05e0\u05b4\u05bd\u05d9\u05c3"}, {"pk": 8927, "verse": 27, "text": "\u05d5\u05b7\u05d9\u05bc\u05b4\u05ea\u05bc\u05b5\u05a8\u05df \u05d0\u05b6\u05ea\u05be\u05d4\u05b7\u05db\u05bc\u05b0\u05e8\u05d5\u05bc\u05d1\u05b4\u059c\u05d9\u05dd \u05d1\u05bc\u05b0\u05ea\u05b9\u05a3\u05d5\u05da\u05b0 \u05c0 \u05d4\u05b7\u05d1\u05bc\u05b7\u05a3\u05d9\u05b4\u05ea \u05d4\u05b7\u05e4\u05bc\u05b0\u05e0\u05b4\u05d9\u05de\u05b4\u0597\u05d9 \u05d5\u05b7\u05bd\u05d9\u05bc\u05b4\u05e4\u05b0\u05e8\u05b0\u05e9\u05c2\u05d5\u05bc\u05ae \u05d0\u05b6\u05ea\u05be\u05db\u05bc\u05b7\u05e0\u05b0\u05e4\u05b5\u05a3\u05d9 \u05d4\u05b7\u05db\u05bc\u05b0\u05e8\u05bb\u05d1\u05b4\u05d9\u05dd\u0592 \u05d5\u05b7\u05ea\u05bc\u05b4\u05d2\u05bc\u05b7\u05a4\u05e2 \u05db\u05bc\u05b0\u05e0\u05b7\u05e3\u05be\u05d4\u05b8\u05bd\u05d0\u05b6\u05d7\u05b8\u05d3\u0599 \u05d1\u05bc\u05b7\u05e7\u05bc\u05b4\u0594\u05d9\u05e8 \u05d5\u05bc\u05db\u05b0\u05e0\u05b7\u05e3\u0599 \u05d4\u05b7\u05db\u05bc\u05b0\u05e8\u05a3\u05d5\u05bc\u05d1 \u05d4\u05b7\u05e9\u05c1\u05bc\u05b5\u05e0\u05b4\u0594\u05d9 \u05e0\u05b9\u05d2\u05b7\u0596\u05e2\u05b7\u05ea \u05d1\u05bc\u05b7\u05e7\u05bc\u05b4\u05a3\u05d9\u05e8 \u05d4\u05b7\u05e9\u05c1\u05bc\u05b5\u05e0\u05b4\u0591\u05d9  \u05d5\u05b0\u05db\u05b7\u05e0\u05b0\u05e4\u05b5\u05d9\u05d4\u05b6\u05dd\u0599 \u05d0\u05b6\u05dc\u05be\u05ea\u05bc\u05b9\u05a3\u05d5\u05da\u05b0 \u05d4\u05b7\u05d1\u05bc\u05b7\u0594\u05d9\u05b4\u05ea \u05e0\u05b9\u05d2\u05b0\u05e2\u05b9\u0596\u05ea \u05db\u05bc\u05b8\u05e0\u05b8\u05a5\u05e3 \u05d0\u05b6\u05dc\u05be\u05db\u05bc\u05b8\u05e0\u05b8\u05bd\u05e3\u05c3"}, {"pk": 8928, "verse": 28, "text": "\u05d5\u05b7\u05d9\u05b0\u05e6\u05b7\u05a5\u05e3 \u05d0\u05b6\u05ea\u05be\u05d4\u05b7\u05db\u05bc\u05b0\u05e8\u05d5\u05bc\u05d1\u05b4\u0596\u05d9\u05dd \u05d6\u05b8\u05d4\u05b8\u05bd\u05d1\u05c3"}, {"pk": 8929, "verse": 29, "text": "\u05d5\u05b0\u05d0\u05b5\u05ea\u05a9 \u05db\u05bc\u05b8\u05dc\u05be\u05e7\u05b4\u05d9\u05e8\u05b9\u05a8\u05d5\u05ea \u05d4\u05b7\u05d1\u05bc\u05b7\u059c\u05d9\u05b4\u05ea \u05de\u05b5\u05e1\u05b7\u05a3\u05d1 \u05c0 \u05e7\u05b8\u05dc\u05b7\u0597\u05e2 \u05e4\u05bc\u05b4\u05ea\u05bc\u05d5\u05bc\u05d7\u05b5\u05d9\u0599 \u05de\u05b4\u05e7\u05b0\u05dc\u05b0\u05e2\u05b9\u05d5\u05ea\u0599 \u05db\u05bc\u05b0\u05e8\u05d5\u05bc\u05d1\u05b4\u05a3\u05d9\u05dd \u05d5\u05b0\u05ea\u05b4\u05bd\u05de\u05b9\u05e8\u05b9\u0594\u05ea \u05d5\u05bc\u05e4\u05b0\u05d8\u05d5\u05bc\u05e8\u05b5\u0596\u05d9 \u05e6\u05b4\u05e6\u05bc\u05b4\u0591\u05d9\u05dd \u05de\u05b4\u05dc\u05bc\u05b4\u05e4\u05b0\u05e0\u05b4\u0596\u05d9\u05dd \u05d5\u05b0\u05dc\u05b7\u05d7\u05b4\u05d9\u05e6\u05b9\u05bd\u05d5\u05df\u05c3"}, {"pk": 8930, "verse": 30, "text": "\u05d5\u05b0\u05d0\u05b6\u05ea\u05be\u05e7\u05b7\u05e8\u05b0\u05e7\u05b7\u05a5\u05e2 \u05d4\u05b7\u05d1\u05bc\u05b7\u0596\u05d9\u05b4\u05ea \u05e6\u05b4\u05e4\u05bc\u05b8\u05a3\u05d4 \u05d6\u05b8\u05d4\u05b8\u0591\u05d1 \u05dc\u05b4\u05e4\u05b0\u05e0\u05b4\u0596\u05d9\u05de\u05b8\u05d4 \u05d5\u05b0\u05dc\u05b7\u05d7\u05b4\u05d9\u05e6\u05b9\u05bd\u05d5\u05df\u05c3"}, {"pk": 8931, "verse": 31, "text": "\u05d5\u05b0\u05d0\u05b5\u05ea\u0599 \u05e4\u05bc\u05b6\u05a3\u05ea\u05b7\u05d7 \u05d4\u05b7\u05d3\u05bc\u05b0\u05d1\u05b4\u0594\u05d9\u05e8 \u05e2\u05b8\u05e9\u05c2\u05b8\u0596\u05d4 \u05d3\u05bc\u05b7\u05dc\u05b0\u05ea\u05b9\u05a3\u05d5\u05ea \u05e2\u05b2\u05e6\u05b5\u05d9\u05be\u05e9\u05c1\u05b8\u0591\u05de\u05b6\u05df \u05d4\u05b8\u05d0\u05b7\u05a5\u05d9\u05b4\u05dc \u05de\u05b0\u05d6\u05d5\u05bc\u05d6\u05b9\u0596\u05d5\u05ea \u05d7\u05b2\u05de\u05b4\u05e9\u05c1\u05b4\u05bd\u05d9\u05ea\u05c3"}, {"pk": 8932, "verse": 32, "text": "\u05d5\u05bc\u05e9\u05c1\u05b0\u05ea\u05bc\u05b5\u05d9\u05ae \u05d3\u05bc\u05b7\u05dc\u05b0\u05ea\u05b9\u05a3\u05d5\u05ea \u05e2\u05b2\u05e6\u05b5\u05d9\u05be\u05e9\u05c1\u05b6\u05de\u05b6\u05df\u0592 \u05d5\u05b0\u05e7\u05b8\u05dc\u05b7\u05a3\u05e2 \u05e2\u05b2\u05a0\u05dc\u05b5\u05d9\u05d4\u05b6\u05dd \u05de\u05b4\u05e7\u05b0\u05dc\u05b0\u05e2\u05b9\u05a8\u05d5\u05ea \u05db\u05bc\u05b0\u05e8\u05d5\u05bc\u05d1\u05b4\u05a7\u05d9\u05dd \u05d5\u05b0\u05ea\u05b4\u05de\u05b9\u05e8\u05b9\u059b\u05d5\u05ea \u05d5\u05bc\u05e4\u05b0\u05d8\u05d5\u05bc\u05e8\u05b5\u05a5\u05d9 \u05e6\u05b4\u05e6\u05bc\u05b4\u0596\u05d9\u05dd \u05d5\u05b0\u05e6\u05b4\u05e4\u05bc\u05b8\u05a3\u05d4 \u05d6\u05b8\u05d4\u05b8\u0591\u05d1 \u05d5\u05b7\u05d9\u05bc\u05b8\u059b\u05e8\u05b6\u05d3 \u05e2\u05b7\u05dc\u05be\u05d4\u05b7\u05db\u05bc\u05b0\u05e8\u05d5\u05bc\u05d1\u05b4\u05a5\u05d9\u05dd \u05d5\u05b0\u05e2\u05b7\u05dc\u05be\u05d4\u05b7\u05ea\u05bc\u05b4\u05bd\u05de\u05b9\u05e8\u05b9\u0596\u05d5\u05ea \u05d0\u05b6\u05ea\u05be\u05d4\u05b7\u05d6\u05bc\u05b8\u05d4\u05b8\u05bd\u05d1\u05c3"}, {"pk": 8933, "verse": 33, "text": "\u05d5\u05b0\u05db\u05b5\u05a5\u05df \u05e2\u05b8\u05e9\u05c2\u05b8\u059b\u05d4 \u05dc\u05b0\u05e4\u05b6\u05a5\u05ea\u05b7\u05d7 \u05d4\u05b7\u05bd\u05d4\u05b5\u05d9\u05db\u05b8\u0596\u05dc \u05de\u05b0\u05d6\u05d5\u05bc\u05d6\u05b9\u05a3\u05d5\u05ea \u05e2\u05b2\u05e6\u05b5\u05d9\u05be\u05e9\u05c1\u05b8\u0591\u05de\u05b6\u05df \u05de\u05b5\u05d0\u05b5\u0596\u05ea \u05e8\u05b0\u05d1\u05b4\u05e2\u05b4\u05bd\u05d9\u05ea\u05c3"}, {"pk": 8934, "verse": 34, "text": "\u05d5\u05bc\u05e9\u05c1\u05b0\u05ea\u05bc\u05b5\u05a5\u05d9 \u05d3\u05b7\u05dc\u05b0\u05ea\u05b9\u0596\u05d5\u05ea \u05e2\u05b2\u05e6\u05b5\u05a3\u05d9 \u05d1\u05b0\u05e8\u05b9\u05d5\u05e9\u05c1\u05b4\u0591\u05d9\u05dd \u05e9\u05c1\u05b0\u05e0\u05b5\u05a8\u05d9 \u05e6\u05b0\u05dc\u05b8\u05e2\u05b4\u059c\u05d9\u05dd \u05d4\u05b7\u05d3\u05bc\u05b6\u05a4\u05dc\u05b6\u05ea \u05d4\u05b8\u05bd\u05d0\u05b7\u05d7\u05b7\u05ea\u0599 \u05d2\u05bc\u05b0\u05dc\u05b4\u05d9\u05dc\u05b4\u0594\u05d9\u05dd \u05d5\u05bc\u05e9\u05c1\u05b0\u05e0\u05b5\u05a7\u05d9 \u05e7\u05b0\u05dc\u05b8\u05e2\u05b4\u059b\u05d9\u05dd \u05d4\u05b7\u05d3\u05bc\u05b6\u05a5\u05dc\u05b6\u05ea \u05d4\u05b7\u05e9\u05c1\u05bc\u05b5\u05e0\u05b4\u0596\u05d9\u05ea \u05d2\u05bc\u05b0\u05dc\u05b4\u05d9\u05dc\u05b4\u05bd\u05d9\u05dd\u05c3"}, {"pk": 8935, "verse": 35, "text": "\u05d5\u05b0\u05e7\u05b8\u05dc\u05b7\u05a4\u05e2 \u05db\u05bc\u05b0\u05e8\u05d5\u05bc\u05d1\u05b4\u05d9\u05dd\u0599 \u05d5\u05b0\u05ea\u05b4\u05a3\u05de\u05b9\u05e8\u05b9\u0594\u05d5\u05ea \u05d5\u05bc\u05e4\u05b0\u05d8\u05bb\u05e8\u05b5\u0596\u05d9 \u05e6\u05b4\u05e6\u05bc\u05b4\u0591\u05d9\u05dd \u05d5\u05b0\u05e6\u05b4\u05e4\u05bc\u05b8\u05a3\u05d4 \u05d6\u05b8\u05d4\u05b8\u0594\u05d1 \u05de\u05b0\u05d9\u05bb\u05e9\u05c1\u05bc\u05b8\u0596\u05e8 \u05e2\u05b7\u05dc\u05be\u05d4\u05b7\u05de\u05bc\u05b0\u05d7\u05bb\u05e7\u05bc\u05b6\u05bd\u05d4\u05c3"}, {"pk": 8936, "verse": 36, "text": "\u05d5\u05b7\u05d9\u05bc\u05b4\u0599\u05d1\u05b6\u05df\u0599 \u05d0\u05b6\u05ea\u05be\u05d4\u05b6\u05d7\u05b8\u05e6\u05b5\u05a3\u05e8 \u05d4\u05b7\u05e4\u05bc\u05b0\u05e0\u05b4\u05d9\u05de\u05b4\u0594\u05d9\u05ea \u05e9\u05c1\u05b0\u05dc\u05b9\u05e9\u05c1\u05b8\u0596\u05d4 \u05d8\u05d5\u05bc\u05e8\u05b5\u05a3\u05d9 \u05d2\u05b8\u05d6\u05b4\u0591\u05d9\u05ea \u05d5\u05b0\u05d8\u0596\u05d5\u05bc\u05e8 \u05db\u05bc\u05b0\u05e8\u05bb\u05ea\u05b9\u05a5\u05ea \u05d0\u05b2\u05e8\u05b8\u05d6\u05b4\u05bd\u05d9\u05dd\u05c3"}, {"pk": 8937, "verse": 37, "text": "\u05d1\u05bc\u05b7\u05e9\u05c1\u05bc\u05b8\u05e0\u05b8\u05d4\u0599 \u05d4\u05b8\u05bd\u05e8\u05b0\u05d1\u05b4\u05d9\u05e2\u05b4\u0594\u05d9\u05ea \u05d9\u05bb\u05e1\u05bc\u05b7\u0596\u05d3 \u05d1\u05bc\u05b5\u05a3\u05d9\u05ea \u05d9\u05b0\u05d4\u05d5\u05b8\u0591\u05d4 \u05d1\u05bc\u05b0\u05d9\u05b6\u0596\u05e8\u05b7\u05d7 \u05d6\u05b4\u05bd\u05d5\u05c3"}, {"pk": 8938, "verse": 38, "text": "\u05d5\u05bc\u05d1\u05b7\u05e9\u05c1\u05bc\u05b8\u05e0\u05b8\u05d4\u05a9 \u05d4\u05b8\u05d0\u05b7\u05d7\u05b7\u05a8\u05ea \u05e2\u05b6\u05e9\u05c2\u05b0\u05e8\u05b5\u059c\u05d4 \u05d1\u05bc\u05b0\u05d9\u05b6\u05a3\u05e8\u05b7\u05d7 \u05d1\u05bc\u0597\u05d5\u05bc\u05dc \u05d4\u059a\u05d5\u05bc\u05d0 \u05d4\u05b7\u05d7\u05b9\u05a3\u05d3\u05b6\u05e9\u05c1 \u05d4\u05b7\u05e9\u05c1\u05bc\u05b0\u05de\u05b4\u05d9\u05e0\u05b4\u0594\u05d9 \u05db\u05bc\u05b8\u05dc\u05b8\u05a3\u05d4 \u05d4\u05b7\u05d1\u05bc\u05b7\u0594\u05d9\u05b4\u05ea \u05dc\u05b0\u05db\u05b8\u05dc\u05be\u05d3\u05bc\u05b0\u05d1\u05b8\u05e8\u05b8\u0596\u05d9\u05d5 \u05d5\u05bc\u05dc\u05b0\u05db\u05b8\u05dc\u05be [\u05de\u05b4\u05e9\u05c1\u05b0\u05e4\u05bc\u05b8\u05d8\u05b9\u05d5 \u05db] (\u05de\u05b4\u05e9\u05c1\u05b0\u05e4\u05bc\u05b8\u05d8\u05b8\u0591\u05d9\u05d5 \u05e7) \u05d5\u05b7\u05d9\u05bc\u05b4\u05d1\u05b0\u05e0\u05b5\u0596\u05d4\u05d5\u05bc \u05e9\u05c1\u05b6\u05a5\u05d1\u05b7\u05e2 \u05e9\u05c1\u05b8\u05e0\u05b4\u05bd\u05d9\u05dd\u05c3"}]