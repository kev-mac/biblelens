[{"pk": 2895908, "verse": 1, "text": "\u05d0 \u05d5\u05d9\u05d4\u05d9 \u05d1\u05e9\u05de\u05d5\u05e0\u05d9\u05dd \u05e9\u05e0\u05d4 \u05d5\u05d0\u05e8\u05d1\u05e2 \u05de\u05d0\u05d5\u05ea \u05e9\u05e0\u05d4 \u05dc\u05e6\u05d0\u05ea \u05d1\u05e0\u05d9 \u05d9\u05e9\u05e8\u05d0\u05dc \u05de\u05d0\u05e8\u05e5 \u05de\u05e6\u05e8\u05d9\u05dd \u05d1\u05e9\u05e0\u05d4 \u05d4\u05e8\u05d1\u05d9\u05e2\u05d9\u05ea \u05d1\u05d7\u05d3\u05e9 \u05d6\u05d5 \u05d4\u05d5\u05d0 \u05d4\u05d7\u05d3\u05e9 \u05d4\u05e9\u05e0\u05d9 \u05dc\u05de\u05dc\u05da \u05e9\u05dc\u05de\u05d4 \u05e2\u05dc \u05d9\u05e9\u05e8\u05d0\u05dc \u05d5\u05d9\u05d1\u05df \u05d4\u05d1\u05d9\u05ea \u05dc\u05d9\u05d4\u05d5\u05d4"}, {"pk": 2895909, "verse": 2, "text": "\u05d1 \u05d5\u05d4\u05d1\u05d9\u05ea \u05d0\u05e9\u05e8 \u05d1\u05e0\u05d4 \u05d4\u05de\u05dc\u05da \u05e9\u05dc\u05de\u05d4 \u05dc\u05d9\u05d4\u05d5\u05d4--\u05e9\u05e9\u05d9\u05dd \u05d0\u05de\u05d4 \u05d0\u05e8\u05db\u05d5 \u05d5\u05e2\u05e9\u05e8\u05d9\u05dd \u05e8\u05d7\u05d1\u05d5 \u05d5\u05e9\u05dc\u05e9\u05d9\u05dd \u05d0\u05de\u05d4 \u05e7\u05d5\u05de\u05ea\u05d5"}, {"pk": 2895910, "verse": 3, "text": "\u05d2 \u05d5\u05d4\u05d0\u05d5\u05dc\u05dd \u05e2\u05dc \u05e4\u05e0\u05d9 \u05d4\u05d9\u05db\u05dc \u05d4\u05d1\u05d9\u05ea--\u05e2\u05e9\u05e8\u05d9\u05dd \u05d0\u05de\u05d4 \u05d0\u05e8\u05db\u05d5 \u05e2\u05dc \u05e4\u05e0\u05d9 \u05e8\u05d7\u05d1 \u05d4\u05d1\u05d9\u05ea \u05e2\u05e9\u05e8 \u05d1\u05d0\u05de\u05d4 \u05e8\u05d7\u05d1\u05d5 \u05e2\u05dc \u05e4\u05e0\u05d9 \u05d4\u05d1\u05d9\u05ea"}, {"pk": 2895911, "verse": 4, "text": "\u05d3 \u05d5\u05d9\u05e2\u05e9 \u05dc\u05d1\u05d9\u05ea \u05d7\u05dc\u05d5\u05e0\u05d9 \u05e9\u05e7\u05e4\u05d9\u05dd \u05d0\u05d8\u05d5\u05de\u05d9\u05dd"}, {"pk": 2895912, "verse": 5, "text": "\u05d4 \u05d5\u05d9\u05d1\u05df \u05e2\u05dc \u05e7\u05d9\u05e8 \u05d4\u05d1\u05d9\u05ea \u05d9\u05e6\u05d5\u05e2 (\u05d9\u05e6\u05d9\u05e2) \u05e1\u05d1\u05d9\u05d1 \u05d0\u05ea \u05e7\u05d9\u05e8\u05d5\u05ea \u05d4\u05d1\u05d9\u05ea \u05e1\u05d1\u05d9\u05d1 \u05dc\u05d4\u05d9\u05db\u05dc \u05d5\u05dc\u05d3\u05d1\u05d9\u05e8 \u05d5\u05d9\u05e2\u05e9 \u05e6\u05dc\u05e2\u05d5\u05ea \u05e1\u05d1\u05d9\u05d1"}, {"pk": 2895913, "verse": 6, "text": "\u05d5 \u05d4\u05d9\u05e6\u05d5\u05e2 (\u05d4\u05d9\u05e6\u05d9\u05e2) \u05d4\u05ea\u05d7\u05ea\u05e0\u05d4 \u05d7\u05de\u05e9 \u05d1\u05d0\u05de\u05d4 \u05e8\u05d7\u05d1\u05d4 \u05d5\u05d4\u05ea\u05d9\u05db\u05e0\u05d4 \u05e9\u05e9 \u05d1\u05d0\u05de\u05d4 \u05e8\u05d7\u05d1\u05d4 \u05d5\u05d4\u05e9\u05dc\u05d9\u05e9\u05d9\u05ea \u05e9\u05d1\u05e2 \u05d1\u05d0\u05de\u05d4 \u05e8\u05d7\u05d1\u05d4\u00a0 \u05db\u05d9 \u05de\u05d2\u05e8\u05e2\u05d5\u05ea \u05e0\u05ea\u05df \u05dc\u05d1\u05d9\u05ea \u05e1\u05d1\u05d9\u05d1 \u05d7\u05d5\u05e6\u05d4 \u05dc\u05d1\u05dc\u05ea\u05d9 \u05d0\u05d7\u05d6 \u05d1\u05e7\u05d9\u05e8\u05d5\u05ea \u05d4\u05d1\u05d9\u05ea"}, {"pk": 2895914, "verse": 7, "text": "\u05d6 \u05d5\u05d4\u05d1\u05d9\u05ea \u05d1\u05d4\u05d1\u05e0\u05ea\u05d5--\u05d0\u05d1\u05df \u05e9\u05dc\u05de\u05d4 \u05de\u05e1\u05e2 \u05e0\u05d1\u05e0\u05d4 \u05d5\u05de\u05e7\u05d1\u05d5\u05ea \u05d5\u05d4\u05d2\u05e8\u05d6\u05df \u05db\u05dc \u05db\u05dc\u05d9 \u05d1\u05e8\u05d6\u05dc \u05dc\u05d0 \u05e0\u05e9\u05de\u05e2 \u05d1\u05d1\u05d9\u05ea \u05d1\u05d4\u05d1\u05e0\u05ea\u05d5"}, {"pk": 2895915, "verse": 8, "text": "\u05d7 \u05e4\u05ea\u05d7 \u05d4\u05e6\u05dc\u05e2 \u05d4\u05ea\u05d9\u05db\u05e0\u05d4 \u05d0\u05dc \u05db\u05ea\u05e3 \u05d4\u05d1\u05d9\u05ea \u05d4\u05d9\u05de\u05e0\u05d9\u05ea \u05d5\u05d1\u05dc\u05d5\u05dc\u05d9\u05dd \u05d9\u05e2\u05dc\u05d5 \u05e2\u05dc \u05d4\u05ea\u05d9\u05db\u05e0\u05d4 \u05d5\u05de\u05df \u05d4\u05ea\u05d9\u05db\u05e0\u05d4 \u05d0\u05dc \u05d4\u05e9\u05dc\u05e9\u05d9\u05dd"}, {"pk": 2895916, "verse": 9, "text": "\u05d8 \u05d5\u05d9\u05d1\u05df \u05d0\u05ea \u05d4\u05d1\u05d9\u05ea \u05d5\u05d9\u05db\u05dc\u05d4\u05d5 \u05d5\u05d9\u05e1\u05e4\u05df \u05d0\u05ea \u05d4\u05d1\u05d9\u05ea \u05d2\u05d1\u05d9\u05dd \u05d5\u05e9\u05d3\u05e8\u05ea \u05d1\u05d0\u05e8\u05d6\u05d9\u05dd"}, {"pk": 2895917, "verse": 10, "text": "\u05d9 \u05d5\u05d9\u05d1\u05df \u05d0\u05ea \u05d4\u05d9\u05e6\u05d5\u05e2 (\u05d4\u05d9\u05e6\u05d9\u05e2) \u05e2\u05dc \u05db\u05dc \u05d4\u05d1\u05d9\u05ea \u05d7\u05de\u05e9 \u05d0\u05de\u05d5\u05ea \u05e7\u05d5\u05de\u05ea\u05d5 \u05d5\u05d9\u05d0\u05d7\u05d6 \u05d0\u05ea \u05d4\u05d1\u05d9\u05ea \u05d1\u05e2\u05e6\u05d9 \u05d0\u05e8\u05d6\u05d9\u05dd\u00a0 {\u05e4}"}, {"pk": 2895918, "verse": 11, "text": "\u05d9\u05d0 \u05d5\u05d9\u05d4\u05d9 \u05d3\u05d1\u05e8 \u05d9\u05d4\u05d5\u05d4 \u05d0\u05dc \u05e9\u05dc\u05de\u05d4 \u05dc\u05d0\u05de\u05e8"}, {"pk": 2895919, "verse": 12, "text": "\u05d9\u05d1 \u05d4\u05d1\u05d9\u05ea \u05d4\u05d6\u05d4 \u05d0\u05e9\u05e8 \u05d0\u05ea\u05d4 \u05d1\u05e0\u05d4 \u05d0\u05dd \u05ea\u05dc\u05da \u05d1\u05d7\u05e7\u05ea\u05d9 \u05d5\u05d0\u05ea \u05de\u05e9\u05e4\u05d8\u05d9 \u05ea\u05e2\u05e9\u05d4 \u05d5\u05e9\u05de\u05e8\u05ea \u05d0\u05ea \u05db\u05dc \u05de\u05e6\u05d5\u05ea\u05d9 \u05dc\u05dc\u05db\u05ea \u05d1\u05d4\u05dd--\u05d5\u05d4\u05e7\u05de\u05ea\u05d9 \u05d0\u05ea \u05d3\u05d1\u05e8\u05d9 \u05d0\u05ea\u05da \u05d0\u05e9\u05e8 \u05d3\u05d1\u05e8\u05ea\u05d9 \u05d0\u05dc \u05d3\u05d5\u05d3 \u05d0\u05d1\u05d9\u05da"}, {"pk": 2895920, "verse": 13, "text": "\u05d9\u05d2 \u05d5\u05e9\u05db\u05e0\u05ea\u05d9 \u05d1\u05ea\u05d5\u05da \u05d1\u05e0\u05d9 \u05d9\u05e9\u05e8\u05d0\u05dc \u05d5\u05dc\u05d0 \u05d0\u05e2\u05d6\u05d1 \u05d0\u05ea \u05e2\u05de\u05d9 \u05d9\u05e9\u05e8\u05d0\u05dc\u00a0 {\u05e4}"}, {"pk": 2895921, "verse": 14, "text": "\u05d9\u05d3 \u05d5\u05d9\u05d1\u05df \u05e9\u05dc\u05de\u05d4 \u05d0\u05ea \u05d4\u05d1\u05d9\u05ea \u05d5\u05d9\u05db\u05dc\u05d4\u05d5"}, {"pk": 2895922, "verse": 15, "text": "\u05d8\u05d5 \u05d5\u05d9\u05d1\u05df \u05d0\u05ea \u05e7\u05d9\u05e8\u05d5\u05ea \u05d4\u05d1\u05d9\u05ea \u05de\u05d1\u05d9\u05ea\u05d4 \u05d1\u05e6\u05dc\u05e2\u05d5\u05ea \u05d0\u05e8\u05d6\u05d9\u05dd--\u05de\u05e7\u05e8\u05e7\u05e2 \u05d4\u05d1\u05d9\u05ea \u05e2\u05d3 \u05e7\u05d9\u05e8\u05d5\u05ea \u05d4\u05e1\u05e4\u05df \u05e6\u05e4\u05d4 \u05e2\u05e5 \u05de\u05d1\u05d9\u05ea \u05d5\u05d9\u05e6\u05e3 \u05d0\u05ea \u05e7\u05e8\u05e7\u05e2 \u05d4\u05d1\u05d9\u05ea \u05d1\u05e6\u05dc\u05e2\u05d5\u05ea \u05d1\u05e8\u05d5\u05e9\u05d9\u05dd"}, {"pk": 2895923, "verse": 16, "text": "\u05d8\u05d6 \u05d5\u05d9\u05d1\u05df \u05d0\u05ea \u05e2\u05e9\u05e8\u05d9\u05dd \u05d0\u05de\u05d4 \u05de\u05d9\u05e8\u05db\u05d5\u05ea\u05d9 (\u05de\u05d9\u05e8\u05db\u05ea\u05d9) \u05d4\u05d1\u05d9\u05ea \u05d1\u05e6\u05dc\u05e2\u05d5\u05ea \u05d0\u05e8\u05d6\u05d9\u05dd \u05de\u05df \u05d4\u05e7\u05e8\u05e7\u05e2 \u05e2\u05d3 \u05d4\u05e7\u05d9\u05e8\u05d5\u05ea \u05d5\u05d9\u05d1\u05df \u05dc\u05d5 \u05de\u05d1\u05d9\u05ea \u05dc\u05d3\u05d1\u05d9\u05e8 \u05dc\u05e7\u05d3\u05e9 \u05d4\u05e7\u05d3\u05e9\u05d9\u05dd"}, {"pk": 2895924, "verse": 17, "text": "\u05d9\u05d6 \u05d5\u05d0\u05e8\u05d1\u05e2\u05d9\u05dd \u05d1\u05d0\u05de\u05d4 \u05d4\u05d9\u05d4 \u05d4\u05d1\u05d9\u05ea--\u05d4\u05d5\u05d0 \u05d4\u05d4\u05d9\u05db\u05dc \u05dc\u05e4\u05e0\u05d9"}, {"pk": 2895925, "verse": 18, "text": "\u05d9\u05d7 \u05d5\u05d0\u05e8\u05d6 \u05d0\u05dc \u05d4\u05d1\u05d9\u05ea \u05e4\u05e0\u05d9\u05de\u05d4 \u05de\u05e7\u05dc\u05e2\u05ea \u05e4\u05e7\u05e2\u05d9\u05dd \u05d5\u05e4\u05d8\u05d5\u05e8\u05d9 \u05e6\u05e6\u05d9\u05dd\u00a0 \u05d4\u05db\u05dc \u05d0\u05e8\u05d6 \u05d0\u05d9\u05df \u05d0\u05d1\u05df \u05e0\u05e8\u05d0\u05d4"}, {"pk": 2895926, "verse": 19, "text": "\u05d9\u05d8 \u05d5\u05d3\u05d1\u05d9\u05e8 \u05d1\u05ea\u05d5\u05da \u05d4\u05d1\u05d9\u05ea \u05de\u05e4\u05e0\u05d9\u05de\u05d4 \u05d4\u05db\u05d9\u05df \u05dc\u05ea\u05ea\u05df \u05e9\u05dd \u05d0\u05ea \u05d0\u05e8\u05d5\u05df \u05d1\u05e8\u05d9\u05ea \u05d9\u05d4\u05d5\u05d4"}, {"pk": 2895927, "verse": 20, "text": "\u05db \u05d5\u05dc\u05e4\u05e0\u05d9 \u05d4\u05d3\u05d1\u05d9\u05e8 \u05e2\u05e9\u05e8\u05d9\u05dd \u05d0\u05de\u05d4 \u05d0\u05e8\u05da \u05d5\u05e2\u05e9\u05e8\u05d9\u05dd \u05d0\u05de\u05d4 \u05e8\u05d7\u05d1 \u05d5\u05e2\u05e9\u05e8\u05d9\u05dd \u05d0\u05de\u05d4 \u05e7\u05d5\u05de\u05ea\u05d5 \u05d5\u05d9\u05e6\u05e4\u05d4\u05d5 \u05d6\u05d4\u05d1 \u05e1\u05d2\u05d5\u05e8 \u05d5\u05d9\u05e6\u05e3 \u05de\u05d6\u05d1\u05d7 \u05d0\u05e8\u05d6"}, {"pk": 2895928, "verse": 21, "text": "\u05db\u05d0 \u05d5\u05d9\u05e6\u05e3 \u05e9\u05dc\u05de\u05d4 \u05d0\u05ea \u05d4\u05d1\u05d9\u05ea \u05de\u05e4\u05e0\u05d9\u05de\u05d4 \u05d6\u05d4\u05d1 \u05e1\u05d2\u05d5\u05e8 \u05d5\u05d9\u05e2\u05d1\u05e8 \u05d1\u05e8\u05ea\u05d9\u05e7\u05d5\u05ea (\u05d1\u05e8\u05ea\u05d5\u05e7\u05d5\u05ea) \u05d6\u05d4\u05d1 \u05dc\u05e4\u05e0\u05d9 \u05d4\u05d3\u05d1\u05d9\u05e8 \u05d5\u05d9\u05e6\u05e4\u05d4\u05d5 \u05d6\u05d4\u05d1"}, {"pk": 2895929, "verse": 22, "text": "\u05db\u05d1 \u05d5\u05d0\u05ea \u05db\u05dc \u05d4\u05d1\u05d9\u05ea \u05e6\u05e4\u05d4 \u05d6\u05d4\u05d1 \u05e2\u05d3 \u05ea\u05dd \u05db\u05dc \u05d4\u05d1\u05d9\u05ea \u05d5\u05db\u05dc \u05d4\u05de\u05d6\u05d1\u05d7 \u05d0\u05e9\u05e8 \u05dc\u05d3\u05d1\u05d9\u05e8 \u05e6\u05e4\u05d4 \u05d6\u05d4\u05d1"}, {"pk": 2895930, "verse": 23, "text": "\u05db\u05d2 \u05d5\u05d9\u05e2\u05e9 \u05d1\u05d3\u05d1\u05d9\u05e8 \u05e9\u05e0\u05d9 \u05db\u05e8\u05d5\u05d1\u05d9\u05dd \u05e2\u05e6\u05d9 \u05e9\u05de\u05df\u00a0 \u05e2\u05e9\u05e8 \u05d0\u05de\u05d5\u05ea \u05e7\u05d5\u05de\u05ea\u05d5"}, {"pk": 2895931, "verse": 24, "text": "\u05db\u05d3 \u05d5\u05d7\u05de\u05e9 \u05d0\u05de\u05d5\u05ea \u05db\u05e0\u05e3 \u05d4\u05db\u05e8\u05d5\u05d1 \u05d4\u05d0\u05d7\u05ea \u05d5\u05d7\u05de\u05e9 \u05d0\u05de\u05d5\u05ea \u05db\u05e0\u05e3 \u05d4\u05db\u05e8\u05d5\u05d1 \u05d4\u05e9\u05e0\u05d9\u05ea \u05e2\u05e9\u05e8 \u05d0\u05de\u05d5\u05ea \u05de\u05e7\u05e6\u05d5\u05ea \u05db\u05e0\u05e4\u05d9\u05d5 \u05d5\u05e2\u05d3 \u05e7\u05e6\u05d5\u05ea \u05db\u05e0\u05e4\u05d9\u05d5"}, {"pk": 2895932, "verse": 25, "text": "\u05db\u05d4 \u05d5\u05e2\u05e9\u05e8 \u05d1\u05d0\u05de\u05d4 \u05d4\u05db\u05e8\u05d5\u05d1 \u05d4\u05e9\u05e0\u05d9\u00a0 \u05de\u05d3\u05d4 \u05d0\u05d7\u05ea \u05d5\u05e7\u05e6\u05d1 \u05d0\u05d7\u05d3 \u05dc\u05e9\u05e0\u05d9 \u05d4\u05db\u05e8\u05d1\u05d9\u05dd"}, {"pk": 2895933, "verse": 26, "text": "\u05db\u05d5 \u05e7\u05d5\u05de\u05ea \u05d4\u05db\u05e8\u05d5\u05d1 \u05d4\u05d0\u05d7\u05d3 \u05e2\u05e9\u05e8 \u05d1\u05d0\u05de\u05d4 \u05d5\u05db\u05df \u05d4\u05db\u05e8\u05d5\u05d1 \u05d4\u05e9\u05e0\u05d9"}, {"pk": 2895934, "verse": 27, "text": "\u05db\u05d6 \u05d5\u05d9\u05ea\u05df \u05d0\u05ea \u05d4\u05db\u05e8\u05d5\u05d1\u05d9\u05dd \u05d1\u05ea\u05d5\u05da \u05d4\u05d1\u05d9\u05ea \u05d4\u05e4\u05e0\u05d9\u05de\u05d9 \u05d5\u05d9\u05e4\u05e8\u05e9\u05d5 \u05d0\u05ea \u05db\u05e0\u05e4\u05d9 \u05d4\u05db\u05e8\u05d1\u05d9\u05dd \u05d5\u05ea\u05d2\u05e2 \u05db\u05e0\u05e3 \u05d4\u05d0\u05d7\u05d3 \u05d1\u05e7\u05d9\u05e8 \u05d5\u05db\u05e0\u05e3 \u05d4\u05db\u05e8\u05d5\u05d1 \u05d4\u05e9\u05e0\u05d9 \u05e0\u05d2\u05e2\u05ea \u05d1\u05e7\u05d9\u05e8 \u05d4\u05e9\u05e0\u05d9 \u05d5\u05db\u05e0\u05e4\u05d9\u05d4\u05dd \u05d0\u05dc \u05ea\u05d5\u05da \u05d4\u05d1\u05d9\u05ea \u05e0\u05d2\u05e2\u05ea \u05db\u05e0\u05e3 \u05d0\u05dc \u05db\u05e0\u05e3"}, {"pk": 2895935, "verse": 28, "text": "\u05db\u05d7 \u05d5\u05d9\u05e6\u05e3 \u05d0\u05ea \u05d4\u05db\u05e8\u05d5\u05d1\u05d9\u05dd \u05d6\u05d4\u05d1"}, {"pk": 2895936, "verse": 29, "text": "\u05db\u05d8 \u05d5\u05d0\u05ea \u05db\u05dc \u05e7\u05d9\u05e8\u05d5\u05ea \u05d4\u05d1\u05d9\u05ea \u05de\u05e1\u05d1 \u05e7\u05dc\u05e2 \u05e4\u05ea\u05d5\u05d7\u05d9 \u05de\u05e7\u05dc\u05e2\u05d5\u05ea \u05db\u05e8\u05d5\u05d1\u05d9\u05dd \u05d5\u05ea\u05de\u05e8\u05ea \u05d5\u05e4\u05d8\u05d5\u05e8\u05d9 \u05e6\u05e6\u05d9\u05dd--\u05de\u05dc\u05e4\u05e0\u05d9\u05dd \u05d5\u05dc\u05d7\u05d9\u05e6\u05d5\u05df"}, {"pk": 2895937, "verse": 30, "text": "\u05dc \u05d5\u05d0\u05ea \u05e7\u05e8\u05e7\u05e2 \u05d4\u05d1\u05d9\u05ea \u05e6\u05e4\u05d4 \u05d6\u05d4\u05d1--\u05dc\u05e4\u05e0\u05d9\u05de\u05d4 \u05d5\u05dc\u05d7\u05d9\u05e6\u05d5\u05df"}, {"pk": 2895938, "verse": 31, "text": "\u05dc\u05d0 \u05d5\u05d0\u05ea \u05e4\u05ea\u05d7 \u05d4\u05d3\u05d1\u05d9\u05e8 \u05e2\u05e9\u05d4 \u05d3\u05dc\u05ea\u05d5\u05ea \u05e2\u05e6\u05d9 \u05e9\u05de\u05df \u05d4\u05d0\u05d9\u05dc \u05de\u05d6\u05d5\u05d6\u05d5\u05ea \u05d7\u05de\u05e9\u05d9\u05ea"}, {"pk": 2895939, "verse": 32, "text": "\u05dc\u05d1 \u05d5\u05e9\u05ea\u05d9 \u05d3\u05dc\u05ea\u05d5\u05ea \u05e2\u05e6\u05d9 \u05e9\u05de\u05df \u05d5\u05e7\u05dc\u05e2 \u05e2\u05dc\u05d9\u05d4\u05dd \u05de\u05e7\u05dc\u05e2\u05d5\u05ea \u05db\u05e8\u05d5\u05d1\u05d9\u05dd \u05d5\u05ea\u05de\u05e8\u05ea \u05d5\u05e4\u05d8\u05d5\u05e8\u05d9 \u05e6\u05e6\u05d9\u05dd \u05d5\u05e6\u05e4\u05d4 \u05d6\u05d4\u05d1 \u05d5\u05d9\u05e8\u05d3 \u05e2\u05dc \u05d4\u05db\u05e8\u05d5\u05d1\u05d9\u05dd \u05d5\u05e2\u05dc \u05d4\u05ea\u05de\u05e8\u05d5\u05ea \u05d0\u05ea \u05d4\u05d6\u05d4\u05d1"}, {"pk": 2895940, "verse": 33, "text": "\u05dc\u05d2 \u05d5\u05db\u05df \u05e2\u05e9\u05d4 \u05dc\u05e4\u05ea\u05d7 \u05d4\u05d4\u05d9\u05db\u05dc \u05de\u05d6\u05d5\u05d6\u05d5\u05ea \u05e2\u05e6\u05d9 \u05e9\u05de\u05df \u05de\u05d0\u05ea \u05e8\u05d1\u05e2\u05d9\u05ea"}, {"pk": 2895941, "verse": 34, "text": "\u05dc\u05d3 \u05d5\u05e9\u05ea\u05d9 \u05d3\u05dc\u05ea\u05d5\u05ea \u05e2\u05e6\u05d9 \u05d1\u05e8\u05d5\u05e9\u05d9\u05dd \u05e9\u05e0\u05d9 \u05e6\u05dc\u05e2\u05d9\u05dd \u05d4\u05d3\u05dc\u05ea \u05d4\u05d0\u05d7\u05ea \u05d2\u05dc\u05d9\u05dc\u05d9\u05dd \u05d5\u05e9\u05e0\u05d9 \u05e7\u05dc\u05e2\u05d9\u05dd \u05d4\u05d3\u05dc\u05ea \u05d4\u05e9\u05e0\u05d9\u05ea \u05d2\u05dc\u05d9\u05dc\u05d9\u05dd"}, {"pk": 2895942, "verse": 35, "text": "\u05dc\u05d4 \u05d5\u05e7\u05dc\u05e2 \u05db\u05e8\u05d5\u05d1\u05d9\u05dd \u05d5\u05ea\u05de\u05e8\u05d5\u05ea \u05d5\u05e4\u05d8\u05e8\u05d9 \u05e6\u05e6\u05d9\u05dd \u05d5\u05e6\u05e4\u05d4 \u05d6\u05d4\u05d1 \u05de\u05d9\u05e9\u05e8 \u05e2\u05dc \u05d4\u05de\u05d7\u05e7\u05d4"}, {"pk": 2895943, "verse": 36, "text": "\u05dc\u05d5 \u05d5\u05d9\u05d1\u05df \u05d0\u05ea \u05d4\u05d7\u05e6\u05e8 \u05d4\u05e4\u05e0\u05d9\u05de\u05d9\u05ea \u05e9\u05dc\u05e9\u05d4 \u05d8\u05d5\u05e8\u05d9 \u05d2\u05d6\u05d9\u05ea \u05d5\u05d8\u05d5\u05e8 \u05db\u05e8\u05ea\u05ea \u05d0\u05e8\u05d6\u05d9\u05dd"}, {"pk": 2895944, "verse": 37, "text": "\u05dc\u05d6 \u05d1\u05e9\u05e0\u05d4 \u05d4\u05e8\u05d1\u05d9\u05e2\u05d9\u05ea \u05d9\u05e1\u05d3 \u05d1\u05d9\u05ea \u05d9\u05d4\u05d5\u05d4--\u05d1\u05d9\u05e8\u05d7 \u05d6\u05d5"}, {"pk": 2895945, "verse": 38, "text": "\u05dc\u05d7 \u05d5\u05d1\u05e9\u05e0\u05d4 \u05d4\u05d0\u05d7\u05ea \u05e2\u05e9\u05e8\u05d4 \u05d1\u05d9\u05e8\u05d7 \u05d1\u05d5\u05dc \u05d4\u05d5\u05d0 \u05d4\u05d7\u05d3\u05e9 \u05d4\u05e9\u05de\u05d9\u05e0\u05d9 \u05db\u05dc\u05d4 \u05d4\u05d1\u05d9\u05ea \u05dc\u05db\u05dc \u05d3\u05d1\u05e8\u05d9\u05d5 \u05d5\u05dc\u05db\u05dc \u05de\u05e9\u05e4\u05d8\u05d5 \u05d5\u05d9\u05d1\u05e0\u05d4\u05d5 \u05e9\u05d1\u05e2 \u05e9\u05e0\u05d9\u05dd"}]