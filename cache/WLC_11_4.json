[{"pk": 8849, "verse": 1, "text": "\u05d5\u05b7\u05bd\u05d9\u05b0\u05d4\u05b4\u05d9\u0599 \u05d4\u05b7\u05de\u05bc\u05b6\u05a3\u05dc\u05b6\u05da\u05b0 \u05e9\u05c1\u05b0\u05dc\u05b9\u05de\u05b9\u0594\u05d4 \u05de\u05b6\u0596\u05dc\u05b6\u05da\u05b0 \u05e2\u05b7\u05dc\u05be\u05db\u05bc\u05b8\u05dc\u05be\u05d9\u05b4\u05e9\u05c2\u05b0\u05e8\u05b8\u05d0\u05b5\u05bd\u05dc\u05c3    \u05e1"}, {"pk": 8850, "verse": 2, "text": "\u05d5\u05b0\u05d0\u05b5\u05a5\u05dc\u05bc\u05b6\u05d4 \u05d4\u05b7\u05e9\u05c2\u05bc\u05b8\u05e8\u05b4\u0596\u05d9\u05dd \u05d0\u05b2\u05e9\u05c1\u05b6\u05e8\u05be\u05dc\u05b9\u0591\u05d5 \u05e2\u05b2\u05d6\u05b7\u05e8\u05b0\u05d9\u05b8\u05a5\u05d4\u05d5\u05bc \u05d1\u05b6\u05df\u05be\u05e6\u05b8\u05d3\u05b9\u0596\u05d5\u05e7 \u05d4\u05b7\u05db\u05bc\u05b9\u05d4\u05b5\u05bd\u05df\u05c3    \u05e1"}, {"pk": 8851, "verse": 3, "text": "\u05d0\u05b1\u05dc\u05b4\u05d9\u05d7\u05b9\u05a7\u05e8\u05b6\u05e3 \u05d5\u05b7\u05d0\u05b2\u05d7\u05b4\u05d9\u05bc\u05b8\u059b\u05d4 \u05d1\u05bc\u05b0\u05e0\u05b5\u05a5\u05d9 \u05e9\u05c1\u05b4\u05d9\u05e9\u05c1\u05b8\u0596\u05d0 \u05e1\u05b9\u05e4\u05b0\u05e8\u05b4\u0591\u05d9\u05dd \u05d9\u05b0\u05d4\u05b9\u05d5\u05e9\u05c1\u05b8\u05e4\u05b8\u05a5\u05d8 \u05d1\u05bc\u05b6\u05df\u05be\u05d0\u05b2\u05d7\u05b4\u05d9\u05dc\u0596\u05d5\u05bc\u05d3 \u05d4\u05b7\u05de\u05bc\u05b7\u05d6\u05b0\u05db\u05bc\u05b4\u05bd\u05d9\u05e8\u05c3"}, {"pk": 8852, "verse": 4, "text": "\u05d5\u05bc\u05d1\u05b0\u05e0\u05b8\u05d9\u05b8\u05a5\u05d4\u05d5\u05bc \u05d1\u05b6\u05df\u05be\u05d9\u05b0\u05d4\u05b9\u05d5\u05d9\u05b8\u05d3\u05b8\u0596\u05e2 \u05e2\u05b7\u05dc\u05be\u05d4\u05b7\u05e6\u05bc\u05b8\u05d1\u05b8\u0591\u05d0 \u05d5\u05b0\u05e6\u05b8\u05d3\u05b9\u05a5\u05d5\u05e7 \u05d5\u05b0\u05d0\u05b6\u05d1\u05b0\u05d9\u05b8\u05ea\u05b8\u0596\u05e8 \u05db\u05bc\u05b9\u05d4\u05b2\u05e0\u05b4\u05bd\u05d9\u05dd\u05c3    \u05e1"}, {"pk": 8853, "verse": 5, "text": "\u05d5\u05b7\u05e2\u05b2\u05d6\u05b7\u05e8\u05b0\u05d9\u05b8\u05a5\u05d4\u05d5\u05bc \u05d1\u05b6\u05df\u05be\u05e0\u05b8\u05ea\u05b8\u0596\u05df \u05e2\u05b7\u05dc\u05be\u05d4\u05b7\u05e0\u05bc\u05b4\u05e6\u05bc\u05b8\u05d1\u05b4\u0591\u05d9\u05dd \u05d5\u05b0\u05d6\u05b8\u05d1\u05a7\u05d5\u05bc\u05d3 \u05d1\u05bc\u05b6\u05df\u05be\u05e0\u05b8\u05ea\u05b8\u059b\u05df \u05db\u05bc\u05b9\u05d4\u05b5\u0596\u05df \u05e8\u05b5\u05e2\u05b6\u05a5\u05d4 \u05d4\u05b7\u05de\u05bc\u05b6\u05bd\u05dc\u05b6\u05da\u05b0\u05c3"}, {"pk": 8854, "verse": 6, "text": "\u05d5\u05b7\u05d0\u05b2\u05d7\u05b4\u05d9\u05e9\u05c1\u05b8\u0596\u05e8 \u05e2\u05b7\u05dc\u05be\u05d4\u05b7\u05d1\u05bc\u05b8\u0591\u05d9\u05b4\u05ea \u05d5\u05b7\u05d0\u05b2\u05d3\u05b9\u05e0\u05b4\u05d9\u05e8\u05b8\u05a5\u05dd \u05d1\u05bc\u05b6\u05df\u05be\u05e2\u05b7\u05d1\u05b0\u05d3\u05bc\u05b8\u0596\u05d0 \u05e2\u05b7\u05dc\u05be\u05d4\u05b7\u05de\u05bc\u05b7\u05bd\u05e1\u05c3    \u05e1"}, {"pk": 8855, "verse": 7, "text": "\u05d5\u05b0\u05dc\u05b4\u05e9\u05c1\u05b0\u05dc\u05b9\u05de\u05b9\u059e\u05d4 \u05e9\u05c1\u05b0\u05e0\u05b5\u05d9\u05dd\u05be\u05e2\u05b8\u05e9\u05c2\u05b8\u05a4\u05e8 \u05e0\u05b4\u05e6\u05bc\u05b8\u05d1\u05b4\u05d9\u05dd\u0599 \u05e2\u05b7\u05dc\u05be\u05db\u05bc\u05b8\u05dc\u05be\u05d9\u05b4\u05e9\u05c2\u05b0\u05e8\u05b8\u05d0\u05b5\u0594\u05dc \u05d5\u05b0\u05db\u05b4\u05dc\u05b0\u05db\u05bc\u05b0\u05dc\u05a5\u05d5\u05bc \u05d0\u05b6\u05ea\u05be\u05d4\u05b7\u05de\u05bc\u05b6\u0596\u05dc\u05b6\u05da\u05b0 \u05d5\u05b0\u05d0\u05b6\u05ea\u05be\u05d1\u05bc\u05b5\u05d9\u05ea\u05b9\u0591\u05d5 \u05d7\u05b9\u05a7\u05d3\u05b6\u05e9\u05c1 \u05d1\u05bc\u05b7\u05e9\u05c1\u05bc\u05b8\u05e0\u05b8\u059b\u05d4 \u05d9\u05b4\u05d4\u05b0\u05d9\u05b6\u05a5\u05d4 \u05e2\u05b7\u05dc\u05be [\u05d0\u05b6\u05d7\u05b8\u05d3 \u05db] (\u05d4\u05b8\u05d0\u05b6\u05d7\u05b8\u0596\u05d3 \u05e7) \u05dc\u05b0\u05db\u05b7\u05dc\u05b0\u05db\u05bc\u05b5\u05bd\u05dc\u05c3    \u05e1"}, {"pk": 8856, "verse": 8, "text": "\u05d5\u05b0\u05d0\u05b5\u05a3\u05dc\u05bc\u05b6\u05d4 \u05e9\u05c1\u05b0\u05de\u05b9\u05d5\u05ea\u05b8\u0594\u05dd \u05d1\u05bc\u05b6\u05df\u05be\u05d7\u0596\u05d5\u05bc\u05e8 \u05d1\u05bc\u05b0\u05d4\u05b7\u05a5\u05e8 \u05d0\u05b6\u05e4\u05b0\u05e8\u05b8\u05bd\u05d9\u05b4\u05dd\u05c3    \u05e1"}, {"pk": 8857, "verse": 9, "text": "\u05d1\u05bc\u05b6\u05df\u05be\u05d3\u05bc\u05b6\u059b\u05e7\u05b6\u05e8 \u05d1\u05bc\u05b0\u05de\u05b8\u05e7\u05b7\u05a5\u05e5 \u05d5\u05bc\u05d1\u05b0\u05e9\u05c1\u05b7\u05bd\u05e2\u05b7\u05dc\u05b0\u05d1\u05b4\u0596\u05d9\u05dd \u05d5\u05bc\u05d1\u05b5\u05a3\u05d9\u05ea \u05e9\u05c1\u05b8\u0591\u05de\u05b6\u05e9\u05c1 \u05d5\u05b0\u05d0\u05b5\u05d9\u05dc\u05b9\u0596\u05d5\u05df \u05d1\u05bc\u05b5\u05a5\u05d9\u05ea \u05d7\u05b8\u05e0\u05b8\u05bd\u05df\u05c3    \u05e1"}, {"pk": 8858, "verse": 10, "text": "\u05d1\u05bc\u05b6\u05df\u05be\u05d7\u05b6\u0596\u05e1\u05b6\u05d3 \u05d1\u05bc\u05b8\u05bd\u05d0\u05b2\u05e8\u05bb\u05d1\u05bc\u05b9\u0591\u05d5\u05ea \u05dc\u05b9\u05a5\u05d5 \u05e9\u05c2\u05b9\u05db\u05b9\u0596\u05d4 \u05d5\u05b0\u05db\u05b8\u05dc\u05be\u05d0\u05b6\u05a5\u05e8\u05b6\u05e5 \u05d7\u05b5\u05bd\u05e4\u05b6\u05e8\u05c3    \u05e1"}, {"pk": 8859, "verse": 11, "text": "\u05d1\u05bc\u05b6\u05df\u05be\u05d0\u05b2\u05d1\u05b4\u05bd\u05d9\u05e0\u05b8\u05d3\u05b8\u0596\u05d1 \u05db\u05bc\u05b8\u05dc\u05be\u05e0\u05b8\u05a3\u05e4\u05b7\u05ea \u05d3\u05bc\u05b9\u0591\u05d0\u05e8 \u05d8\u05b8\u05e4\u05b7\u05ea\u0599 \u05d1\u05bc\u05b7\u05ea\u05be\u05e9\u05c1\u05b0\u05dc\u05b9\u05de\u05b9\u0594\u05d4 \u05d4\u05b8\u05a5\u05d9\u05b0\u05ea\u05b8\u05d4 \u05dc\u05bc\u05b9\u0596\u05d5 \u05dc\u05b0\u05d0\u05b4\u05e9\u05c1\u05bc\u05b8\u05bd\u05d4\u05c3    \u05e1"}, {"pk": 8860, "verse": 12, "text": "\u05d1\u05bc\u05b7\u05bd\u05e2\u05b2\u05e0\u05b8\u05d0\u0599 \u05d1\u05bc\u05b6\u05df\u05be\u05d0\u05b2\u05d7\u05b4\u05d9\u05dc\u0594\u05d5\u05bc\u05d3 \u05ea\u05bc\u05b7\u05e2\u05b0\u05e0\u05b7\u0596\u05da\u05b0 \u05d5\u05bc\u05de\u05b0\u05d2\u05b4\u05d3\u05bc\u05b9\u0591\u05d5 \u05d5\u05b0\u05db\u05b8\u05dc\u05be\u05d1\u05bc\u05b5\u05a3\u05d9\u05ea \u05e9\u05c1\u05b0\u05d0\u05b8\u05a1\u05df \u05d0\u05b2\u05e9\u05c1\u05b6\u05e8\u05a9 \u05d0\u05b5\u05a8\u05e6\u05b6\u05dc \u05e6\u05b8\u05e8\u05b0\u05ea\u05b7\u059c\u05e0\u05b8\u05d4 \u05de\u05b4\u05ea\u05bc\u05b7\u05a3\u05d7\u05b7\u05ea \u05dc\u05b0\u05d9\u05b4\u05d6\u05b0\u05e8\u05b0\u05e2\u05b6\u0597\u05d0\u05dc \u05de\u05b4\u05d1\u05bc\u05b5\u05a4\u05d9\u05ea \u05e9\u05c1\u05b0\u05d0\u05b8\u05df\u0599 \u05e2\u05b7\u059a\u05d3 \u05d0\u05b8\u05d1\u05b5\u05a3\u05dc \u05de\u05b0\u05d7\u05b9\u05d5\u05dc\u05b8\u0594\u05d4 \u05e2\u05b7\u0596\u05d3 \u05de\u05b5\u05e2\u05b5\u05a5\u05d1\u05b6\u05e8 \u05dc\u05b0\u05d9\u05b8\u05e7\u05b0\u05de\u05b3\u05e2\u05b8\u05bd\u05dd\u05c3    \u05e1"}, {"pk": 8861, "verse": 13, "text": "\u05d1\u05bc\u05b6\u05df\u05be\u05d2\u05bc\u05b6\u0596\u05d1\u05b6\u05e8 \u05d1\u05bc\u05b0\u05e8\u05b8\u05de\u05b9\u05a3\u05ea \u05d2\u05bc\u05b4\u05dc\u05b0\u05e2\u05b8\u0591\u05d3 \u05dc\u05b9\u05a1\u05d5 \u05d7\u05b7\u05d5\u05bc\u05b9\u05ea\u05a9 \u05d9\u05b8\u05d0\u05b4\u05a8\u05d9\u05e8 \u05d1\u05bc\u05b6\u05df\u05be\u05de\u05b0\u05e0\u05b7\u05e9\u05c1\u05bc\u05b6\u059c\u05d4 \u05d0\u05b2\u05e9\u05c1\u05b6\u05a3\u05e8 \u05d1\u05bc\u05b7\u05d2\u05bc\u05b4\u05dc\u05b0\u05e2\u05b8\u0597\u05d3 \u05dc\u05b9\u059a\u05d5  \u05d7\u05b6\u05a4\u05d1\u05b6\u05dc \u05d0\u05b7\u05e8\u05b0\u05d2\u05bc\u05b9\u05d1\u0599 \u05d0\u05b2\u05e9\u05c1\u05b6\u05a3\u05e8 \u05d1\u05bc\u05b7\u05d1\u05bc\u05b8\u05e9\u05c1\u05b8\u0594\u05df \u05e9\u05c1\u05b4\u05e9\u05c1\u05bc\u05b4\u05d9\u05dd\u0599 \u05e2\u05b8\u05e8\u05b4\u05a3\u05d9\u05dd \u05d2\u05bc\u05b0\u05d3\u05b9\u05dc\u05b9\u0594\u05d5\u05ea \u05d7\u05b9\u05d5\u05de\u05b8\u0596\u05d4 \u05d5\u05bc\u05d1\u05b0\u05e8\u05b4\u05a5\u05d9\u05d7\u05b7 \u05e0\u05b0\u05d7\u05b9\u05bd\u05e9\u05c1\u05b6\u05ea\u05c3    \u05e1"}, {"pk": 8862, "verse": 14, "text": "\u05d0\u05b2\u05d7\u05b4\u05bd\u05d9\u05e0\u05b8\u05d3\u05b8\u05a5\u05d1 \u05d1\u05bc\u05b6\u05df\u05be\u05e2\u05b4\u05d3\u05bc\u05b9\u0596\u05d0 \u05de\u05b7\u05d7\u05b2\u05e0\u05b8\u05bd\u05d9\u05b0\u05de\u05b8\u05d4\u05c3"}, {"pk": 8863, "verse": 15, "text": "\u05d0\u05b2\u05d7\u05b4\u05d9\u05de\u05b7\u0596\u05e2\u05b7\u05e5 \u05d1\u05bc\u05b0\u05e0\u05b7\u05e4\u05b0\u05ea\u05bc\u05b8\u05dc\u05b4\u0591\u05d9 \u05d2\u05bc\u05b7\u05dd\u05be\u05d4\u0597\u05d5\u05bc\u05d0 \u05dc\u05b8\u05e7\u05b7\u059b\u05d7 \u05d0\u05b6\u05ea\u05be\u05d1\u05bc\u05b8\u05e9\u05c2\u05b0\u05de\u05b7\u05a5\u05ea \u05d1\u05bc\u05b7\u05ea\u05be\u05e9\u05c1\u05b0\u05dc\u05b9\u05de\u05b9\u0596\u05d4 \u05dc\u05b0\u05d0\u05b4\u05e9\u05c1\u05bc\u05b8\u05bd\u05d4\u05c3"}, {"pk": 8864, "verse": 16, "text": "\u05d1\u05bc\u05b7\u05bd\u05e2\u05b2\u05e0\u05b8\u05d0\u0599 \u05d1\u05bc\u05b6\u05df\u05be\u05d7\u05d5\u05bc\u05e9\u05c1\u05b8\u0594\u05d9 \u05d1\u05bc\u05b0\u05d0\u05b8\u05e9\u05c1\u05b5\u0596\u05e8 \u05d5\u05bc\u05d1\u05b0\u05e2\u05b8\u05dc\u05b9\u05bd\u05d5\u05ea\u05c3    \u05e1"}, {"pk": 8865, "verse": 17, "text": "\u05d9\u05b0\u05d4\u05b9\u05d5\u05e9\u05c1\u05b8\u05e4\u05b8\u05a5\u05d8 \u05d1\u05bc\u05b6\u05df\u05be\u05e4\u05bc\u05b8\u05e8\u0596\u05d5\u05bc\u05d7\u05b7 \u05d1\u05bc\u05b0\u05d9\u05b4\u05e9\u05c2\u05b8\u05e9\u05db\u05b8\u05bd\u05e8\u05c3    \u05e1"}, {"pk": 8866, "verse": 18, "text": "\u05e9\u05c1\u05b4\u05de\u05b0\u05e2\u05b4\u05a5\u05d9 \u05d1\u05b6\u05df\u05be\u05d0\u05b5\u05dc\u05b8\u0596\u05d0 \u05d1\u05bc\u05b0\u05d1\u05b4\u05e0\u05b0\u05d9\u05b8\u05de\u05b4\u05bd\u05df\u05c3    \u05e1"}, {"pk": 8867, "verse": 19, "text": "\u05d2\u05bc\u05b6\u05a5\u05d1\u05b6\u05e8 \u05d1\u05bc\u05b6\u05df\u05be\u05d0\u05bb\u05e8\u05b4\u0596\u05d9 \u05d1\u05bc\u05b0\u05d0\u05b6\u05a3\u05e8\u05b6\u05e5 \u05d2\u05bc\u05b4\u05dc\u05b0\u05e2\u05b8\u0591\u05d3 \u05d0\u05b6\u059c\u05e8\u05b6\u05e5 \u05e1\u05b4\u05d9\u05d7\u05b9\u05a3\u05d5\u05df \u05c0 \u05de\u05b6\u05a3\u05dc\u05b6\u05da\u05b0 \u05d4\u05b8\u05d0\u05b1\u05de\u05b9\u05e8\u05b4\u0597\u05d9 \u05d5\u05b0\u05e2\u05b9\u05d2\u0599 \u05de\u05b6\u05a3\u05dc\u05b6\u05da\u05b0 \u05d4\u05b7\u05d1\u05bc\u05b8\u05e9\u05c1\u05b8\u0594\u05df \u05d5\u05bc\u05e0\u05b0\u05e6\u05b4\u05a5\u05d9\u05d1 \u05d0\u05b6\u05d7\u05b8\u0596\u05d3 \u05d0\u05b2\u05e9\u05c1\u05b6\u05a5\u05e8 \u05d1\u05bc\u05b8\u05d0\u05b8\u05bd\u05e8\u05b6\u05e5\u05c3"}, {"pk": 8868, "verse": 20, "text": "\u05d9\u05b0\u05d4\u05d5\u05bc\u05d3\u05b8\u05a4\u05d4 \u05d5\u05b0\u05d9\u05b4\u05e9\u05c2\u05b0\u05e8\u05b8\u05d0\u05b5\u05dc\u0599 \u05e8\u05b7\u05d1\u05bc\u05b4\u0594\u05d9\u05dd \u05db\u05bc\u05b7\u05d7\u05b9\u05a5\u05d5\u05dc \u05d0\u05b2\u05e9\u05c1\u05b6\u05e8\u05be\u05e2\u05b7\u05dc\u05be\u05d4\u05b7\u05d9\u05bc\u05b8\u0596\u05dd \u05dc\u05b8\u05e8\u05b9\u0591\u05d1 \u05d0\u05b9\u05db\u05b0\u05dc\u05b4\u05a5\u05d9\u05dd \u05d5\u05b0\u05e9\u05c1\u05b9\u05ea\u05b4\u0596\u05d9\u05dd \u05d5\u05bc\u05e9\u05c2\u05b0\u05de\u05b5\u05d7\u05b4\u05bd\u05d9\u05dd\u05c3"}]