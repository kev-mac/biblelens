[{"pk": 2895946, "verse": 1, "text": "\u05d0 \u05d5\u05d0\u05ea \u05d1\u05d9\u05ea\u05d5 \u05d1\u05e0\u05d4 \u05e9\u05dc\u05de\u05d4 \u05e9\u05dc\u05e9 \u05e2\u05e9\u05e8\u05d4 \u05e9\u05e0\u05d4 \u05d5\u05d9\u05db\u05dc \u05d0\u05ea \u05db\u05dc \u05d1\u05d9\u05ea\u05d5"}, {"pk": 2895947, "verse": 2, "text": "\u05d1 \u05d5\u05d9\u05d1\u05df \u05d0\u05ea \u05d1\u05d9\u05ea \u05d9\u05e2\u05e8 \u05d4\u05dc\u05d1\u05e0\u05d5\u05df \u05de\u05d0\u05d4 \u05d0\u05de\u05d4 \u05d0\u05e8\u05db\u05d5 \u05d5\u05d7\u05de\u05e9\u05d9\u05dd \u05d0\u05de\u05d4 \u05e8\u05d7\u05d1\u05d5 \u05d5\u05e9\u05dc\u05e9\u05d9\u05dd \u05d0\u05de\u05d4 \u05e7\u05d5\u05de\u05ea\u05d5 \u05e2\u05dc \u05d0\u05e8\u05d1\u05e2\u05d4 \u05d8\u05d5\u05e8\u05d9 \u05e2\u05de\u05d5\u05d3\u05d9 \u05d0\u05e8\u05d6\u05d9\u05dd \u05d5\u05db\u05e8\u05ea\u05d5\u05ea \u05d0\u05e8\u05d6\u05d9\u05dd \u05e2\u05dc \u05d4\u05e2\u05de\u05d5\u05d3\u05d9\u05dd"}, {"pk": 2895948, "verse": 3, "text": "\u05d2 \u05d5\u05e1\u05e4\u05df \u05d1\u05d0\u05e8\u05d6 \u05de\u05de\u05e2\u05dc \u05e2\u05dc \u05d4\u05e6\u05dc\u05e2\u05d5\u05ea \u05d0\u05e9\u05e8 \u05e2\u05dc \u05d4\u05e2\u05de\u05d5\u05d3\u05d9\u05dd \u05d0\u05e8\u05d1\u05e2\u05d9\u05dd \u05d5\u05d7\u05de\u05e9\u05d4--\u05d7\u05de\u05e9\u05d4 \u05e2\u05e9\u05e8 \u05d4\u05d8\u05d5\u05e8"}, {"pk": 2895949, "verse": 4, "text": "\u05d3 \u05d5\u05e9\u05e7\u05e4\u05d9\u05dd \u05e9\u05dc\u05e9\u05d4 \u05d8\u05d5\u05e8\u05d9\u05dd \u05d5\u05de\u05d7\u05d6\u05d4 \u05d0\u05dc \u05de\u05d7\u05d6\u05d4 \u05e9\u05dc\u05e9 \u05e4\u05e2\u05de\u05d9\u05dd"}, {"pk": 2895950, "verse": 5, "text": "\u05d4 \u05d5\u05db\u05dc \u05d4\u05e4\u05ea\u05d7\u05d9\u05dd \u05d5\u05d4\u05de\u05d6\u05d5\u05d6\u05d5\u05ea \u05e8\u05d1\u05e2\u05d9\u05dd \u05e9\u05e7\u05e3 \u05d5\u05de\u05d5\u05dc \u05de\u05d7\u05d6\u05d4 \u05d0\u05dc \u05de\u05d7\u05d6\u05d4 \u05e9\u05dc\u05e9 \u05e4\u05e2\u05de\u05d9\u05dd"}, {"pk": 2895951, "verse": 6, "text": "\u05d5 \u05d5\u05d0\u05ea \u05d0\u05d5\u05dc\u05dd \u05d4\u05e2\u05de\u05d5\u05d3\u05d9\u05dd \u05e2\u05e9\u05d4 \u05d7\u05de\u05e9\u05d9\u05dd \u05d0\u05de\u05d4 \u05d0\u05e8\u05db\u05d5 \u05d5\u05e9\u05dc\u05e9\u05d9\u05dd \u05d0\u05de\u05d4 \u05e8\u05d7\u05d1\u05d5 \u05d5\u05d0\u05d5\u05dc\u05dd \u05e2\u05dc \u05e4\u05e0\u05d9\u05d4\u05dd \u05d5\u05e2\u05de\u05d3\u05d9\u05dd \u05d5\u05e2\u05d1 \u05e2\u05dc \u05e4\u05e0\u05d9\u05d4\u05dd"}, {"pk": 2895952, "verse": 7, "text": "\u05d6 \u05d5\u05d0\u05d5\u05dc\u05dd \u05d4\u05db\u05e1\u05d0 \u05d0\u05e9\u05e8 \u05d9\u05e9\u05e4\u05d8 \u05e9\u05dd \u05d0\u05dc\u05dd \u05d4\u05de\u05e9\u05e4\u05d8 \u05e2\u05e9\u05d4 \u05d5\u05e1\u05e4\u05d5\u05df \u05d1\u05d0\u05e8\u05d6 \u05de\u05d4\u05e7\u05e8\u05e7\u05e2 \u05e2\u05d3 \u05d4\u05e7\u05e8\u05e7\u05e2"}, {"pk": 2895953, "verse": 8, "text": "\u05d7 \u05d5\u05d1\u05d9\u05ea\u05d5 \u05d0\u05e9\u05e8 \u05d9\u05e9\u05d1 \u05e9\u05dd \u05d7\u05e6\u05e8 \u05d4\u05d0\u05d7\u05e8\u05ea \u05de\u05d1\u05d9\u05ea \u05dc\u05d0\u05d5\u05dc\u05dd \u05db\u05de\u05e2\u05e9\u05d4 \u05d4\u05d6\u05d4 \u05d4\u05d9\u05d4 \u05d5\u05d1\u05d9\u05ea \u05d9\u05e2\u05e9\u05d4 \u05dc\u05d1\u05ea \u05e4\u05e8\u05e2\u05d4 \u05d0\u05e9\u05e8 \u05dc\u05e7\u05d7 \u05e9\u05dc\u05de\u05d4 \u05db\u05d0\u05d5\u05dc\u05dd \u05d4\u05d6\u05d4"}, {"pk": 2895954, "verse": 9, "text": "\u05d8 \u05db\u05dc \u05d0\u05dc\u05d4 \u05d0\u05d1\u05e0\u05d9\u05dd \u05d9\u05e7\u05e8\u05ea \u05db\u05de\u05d3\u05d5\u05ea \u05d2\u05d6\u05d9\u05ea \u05de\u05d2\u05e8\u05e8\u05d5\u05ea \u05d1\u05de\u05d2\u05e8\u05d4 \u05de\u05d1\u05d9\u05ea \u05d5\u05de\u05d7\u05d5\u05e5 \u05d5\u05de\u05de\u05e1\u05d3 \u05e2\u05d3 \u05d4\u05d8\u05e4\u05d7\u05d5\u05ea \u05d5\u05de\u05d7\u05d5\u05e5 \u05e2\u05d3 \u05d4\u05d7\u05e6\u05e8 \u05d4\u05d2\u05d3\u05d5\u05dc\u05d4"}, {"pk": 2895955, "verse": 10, "text": "\u05d9 \u05d5\u05de\u05d9\u05e1\u05d3 \u05d0\u05d1\u05e0\u05d9\u05dd \u05d9\u05e7\u05e8\u05d5\u05ea \u05d0\u05d1\u05e0\u05d9\u05dd \u05d2\u05d3\u05dc\u05d5\u05ea--\u05d0\u05d1\u05e0\u05d9 \u05e2\u05e9\u05e8 \u05d0\u05de\u05d5\u05ea \u05d5\u05d0\u05d1\u05e0\u05d9 \u05e9\u05de\u05e0\u05d4 \u05d0\u05de\u05d5\u05ea"}, {"pk": 2895956, "verse": 11, "text": "\u05d9\u05d0 \u05d5\u05de\u05dc\u05de\u05e2\u05dc\u05d4 \u05d0\u05d1\u05e0\u05d9\u05dd \u05d9\u05e7\u05e8\u05d5\u05ea \u05db\u05de\u05d3\u05d5\u05ea \u05d2\u05d6\u05d9\u05ea--\u05d5\u05d0\u05e8\u05d6"}, {"pk": 2895957, "verse": 12, "text": "\u05d9\u05d1 \u05d5\u05d7\u05e6\u05e8 \u05d4\u05d2\u05d3\u05d5\u05dc\u05d4 \u05e1\u05d1\u05d9\u05d1 \u05e9\u05dc\u05e9\u05d4 \u05d8\u05d5\u05e8\u05d9\u05dd \u05d2\u05d6\u05d9\u05ea \u05d5\u05d8\u05d5\u05e8 \u05db\u05e8\u05ea\u05ea \u05d0\u05e8\u05d6\u05d9\u05dd \u05d5\u05dc\u05d7\u05e6\u05e8 \u05d1\u05d9\u05ea \u05d9\u05d4\u05d5\u05d4 \u05d4\u05e4\u05e0\u05d9\u05de\u05d9\u05ea \u05d5\u05dc\u05d0\u05dc\u05dd \u05d4\u05d1\u05d9\u05ea\u00a0 {\u05e4}"}, {"pk": 2895958, "verse": 13, "text": "\u05d9\u05d2 \u05d5\u05d9\u05e9\u05dc\u05d7 \u05d4\u05de\u05dc\u05da \u05e9\u05dc\u05de\u05d4 \u05d5\u05d9\u05e7\u05d7 \u05d0\u05ea \u05d7\u05d9\u05e8\u05dd \u05de\u05e6\u05e8"}, {"pk": 2895959, "verse": 14, "text": "\u05d9\u05d3 \u05d1\u05df \u05d0\u05e9\u05d4 \u05d0\u05dc\u05de\u05e0\u05d4 \u05d4\u05d5\u05d0 \u05de\u05de\u05d8\u05d4 \u05e0\u05e4\u05ea\u05dc\u05d9 \u05d5\u05d0\u05d1\u05d9\u05d5 \u05d0\u05d9\u05e9 \u05e6\u05e8\u05d9 \u05d7\u05e8\u05e9 \u05e0\u05d7\u05e9\u05ea \u05d5\u05d9\u05de\u05dc\u05d0 \u05d0\u05ea \u05d4\u05d7\u05db\u05de\u05d4 \u05d5\u05d0\u05ea \u05d4\u05ea\u05d1\u05d5\u05e0\u05d4 \u05d5\u05d0\u05ea \u05d4\u05d3\u05e2\u05ea \u05dc\u05e2\u05e9\u05d5\u05ea \u05db\u05dc \u05de\u05dc\u05d0\u05db\u05d4 \u05d1\u05e0\u05d7\u05e9\u05ea \u05d5\u05d9\u05d1\u05d5\u05d0 \u05d0\u05dc \u05d4\u05de\u05dc\u05da \u05e9\u05dc\u05de\u05d4 \u05d5\u05d9\u05e2\u05e9 \u05d0\u05ea \u05db\u05dc \u05de\u05dc\u05d0\u05db\u05ea\u05d5"}, {"pk": 2895960, "verse": 15, "text": "\u05d8\u05d5 \u05d5\u05d9\u05e6\u05e8 \u05d0\u05ea \u05e9\u05e0\u05d9 \u05d4\u05e2\u05de\u05d5\u05d3\u05d9\u05dd \u05e0\u05d7\u05e9\u05ea\u00a0 \u05e9\u05de\u05e0\u05d4 \u05e2\u05e9\u05e8\u05d4 \u05d0\u05de\u05d4 \u05e7\u05d5\u05de\u05ea \u05d4\u05e2\u05de\u05d5\u05d3 \u05d4\u05d0\u05d7\u05d3 \u05d5\u05d7\u05d5\u05d8 \u05e9\u05ea\u05d9\u05dd \u05e2\u05e9\u05e8\u05d4 \u05d0\u05de\u05d4 \u05d9\u05e1\u05d1 \u05d0\u05ea \u05d4\u05e2\u05de\u05d5\u05d3 \u05d4\u05e9\u05e0\u05d9"}, {"pk": 2895961, "verse": 16, "text": "\u05d8\u05d6 \u05d5\u05e9\u05ea\u05d9 \u05db\u05ea\u05e8\u05ea \u05e2\u05e9\u05d4 \u05dc\u05ea\u05ea \u05e2\u05dc \u05e8\u05d0\u05e9\u05d9 \u05d4\u05e2\u05de\u05d5\u05d3\u05d9\u05dd--\u05de\u05e6\u05e7 \u05e0\u05d7\u05e9\u05ea\u00a0 \u05d7\u05de\u05e9 \u05d0\u05de\u05d5\u05ea \u05e7\u05d5\u05de\u05ea \u05d4\u05db\u05ea\u05e8\u05ea \u05d4\u05d0\u05d7\u05ea \u05d5\u05d7\u05de\u05e9 \u05d0\u05de\u05d5\u05ea \u05e7\u05d5\u05de\u05ea \u05d4\u05db\u05ea\u05e8\u05ea \u05d4\u05e9\u05e0\u05d9\u05ea"}, {"pk": 2895962, "verse": 17, "text": "\u05d9\u05d6 \u05e9\u05d1\u05db\u05d9\u05dd \u05de\u05e2\u05e9\u05d4 \u05e9\u05d1\u05db\u05d4 \u05d2\u05d3\u05dc\u05d9\u05dd \u05de\u05e2\u05e9\u05d4 \u05e9\u05e8\u05e9\u05e8\u05d5\u05ea \u05dc\u05db\u05ea\u05e8\u05ea \u05d0\u05e9\u05e8 \u05e2\u05dc \u05e8\u05d0\u05e9 \u05d4\u05e2\u05de\u05d5\u05d3\u05d9\u05dd--\u05e9\u05d1\u05e2\u05d4 \u05dc\u05db\u05ea\u05e8\u05ea \u05d4\u05d0\u05d7\u05ea \u05d5\u05e9\u05d1\u05e2\u05d4 \u05dc\u05db\u05ea\u05e8\u05ea \u05d4\u05e9\u05e0\u05d9\u05ea"}, {"pk": 2895963, "verse": 18, "text": "\u05d9\u05d7 \u05d5\u05d9\u05e2\u05e9 \u05d0\u05ea \u05d4\u05e2\u05de\u05d5\u05d3\u05d9\u05dd \u05d5\u05e9\u05e0\u05d9 \u05d8\u05d5\u05e8\u05d9\u05dd \u05e1\u05d1\u05d9\u05d1 \u05e2\u05dc \u05d4\u05e9\u05d1\u05db\u05d4 \u05d4\u05d0\u05d7\u05ea \u05dc\u05db\u05e1\u05d5\u05ea \u05d0\u05ea \u05d4\u05db\u05ea\u05e8\u05ea \u05d0\u05e9\u05e8 \u05e2\u05dc \u05e8\u05d0\u05e9 \u05d4\u05e8\u05de\u05e0\u05d9\u05dd \u05d5\u05db\u05df \u05e2\u05e9\u05d4 \u05dc\u05db\u05ea\u05e8\u05ea \u05d4\u05e9\u05e0\u05d9\u05ea"}, {"pk": 2895964, "verse": 19, "text": "\u05d9\u05d8 \u05d5\u05db\u05ea\u05e8\u05ea \u05d0\u05e9\u05e8 \u05e2\u05dc \u05e8\u05d0\u05e9 \u05d4\u05e2\u05de\u05d5\u05d3\u05d9\u05dd--\u05de\u05e2\u05e9\u05d4 \u05e9\u05d5\u05e9\u05df \u05d1\u05d0\u05d5\u05dc\u05dd\u00a0 \u05d0\u05e8\u05d1\u05e2 \u05d0\u05de\u05d5\u05ea"}, {"pk": 2895965, "verse": 20, "text": "\u05db \u05d5\u05db\u05ea\u05e8\u05ea \u05e2\u05dc \u05e9\u05e0\u05d9 \u05d4\u05e2\u05de\u05d5\u05d3\u05d9\u05dd \u05d2\u05dd \u05de\u05de\u05e2\u05dc \u05de\u05dc\u05e2\u05de\u05ea \u05d4\u05d1\u05d8\u05df \u05d0\u05e9\u05e8 \u05dc\u05e2\u05d1\u05e8 \u05e9\u05d1\u05db\u05d4 (\u05d4\u05e9\u05d1\u05db\u05d4) \u05d5\u05d4\u05e8\u05de\u05d5\u05e0\u05d9\u05dd \u05de\u05d0\u05ea\u05d9\u05dd \u05d8\u05e8\u05d9\u05dd \u05e1\u05d1\u05d9\u05d1 \u05e2\u05dc \u05d4\u05db\u05ea\u05e8\u05ea \u05d4\u05e9\u05e0\u05d9\u05ea"}, {"pk": 2895966, "verse": 21, "text": "\u05db\u05d0 \u05d5\u05d9\u05e7\u05dd \u05d0\u05ea \u05d4\u05e2\u05de\u05d3\u05d9\u05dd \u05dc\u05d0\u05dc\u05dd \u05d4\u05d4\u05d9\u05db\u05dc \u05d5\u05d9\u05e7\u05dd \u05d0\u05ea \u05d4\u05e2\u05de\u05d5\u05d3 \u05d4\u05d9\u05de\u05e0\u05d9 \u05d5\u05d9\u05e7\u05e8\u05d0 \u05d0\u05ea \u05e9\u05de\u05d5 \u05d9\u05db\u05d9\u05df \u05d5\u05d9\u05e7\u05dd \u05d0\u05ea \u05d4\u05e2\u05de\u05d5\u05d3 \u05d4\u05e9\u05de\u05d0\u05dc\u05d9 \u05d5\u05d9\u05e7\u05e8\u05d0 \u05d0\u05ea \u05e9\u05de\u05d5 \u05d1\u05e2\u05d6"}, {"pk": 2895967, "verse": 22, "text": "\u05db\u05d1 \u05d5\u05e2\u05dc \u05e8\u05d0\u05e9 \u05d4\u05e2\u05de\u05d5\u05d3\u05d9\u05dd \u05de\u05e2\u05e9\u05d4 \u05e9\u05d5\u05e9\u05df \u05d5\u05ea\u05ea\u05dd \u05de\u05dc\u05d0\u05db\u05ea \u05d4\u05e2\u05de\u05d5\u05d3\u05d9\u05dd"}, {"pk": 2895968, "verse": 23, "text": "\u05db\u05d2 \u05d5\u05d9\u05e2\u05e9 \u05d0\u05ea \u05d4\u05d9\u05dd \u05de\u05d5\u05e6\u05e7\u00a0 \u05e2\u05e9\u05e8 \u05d1\u05d0\u05de\u05d4 \u05de\u05e9\u05e4\u05ea\u05d5 \u05e2\u05d3 \u05e9\u05e4\u05ea\u05d5 \u05e2\u05d2\u05dc \u05e1\u05d1\u05d9\u05d1 \u05d5\u05d7\u05de\u05e9 \u05d1\u05d0\u05de\u05d4 \u05e7\u05d5\u05de\u05ea\u05d5 \u05d5\u05e7\u05d5\u05d4 (\u05d5\u05e7\u05d5) \u05e9\u05dc\u05e9\u05d9\u05dd \u05d1\u05d0\u05de\u05d4 \u05d9\u05e1\u05d1 \u05d0\u05ea\u05d5 \u05e1\u05d1\u05d9\u05d1"}, {"pk": 2895969, "verse": 24, "text": "\u05db\u05d3 \u05d5\u05e4\u05e7\u05e2\u05d9\u05dd \u05de\u05ea\u05d7\u05ea \u05dc\u05e9\u05e4\u05ea\u05d5 \u05e1\u05d1\u05d9\u05d1 \u05e1\u05d1\u05d1\u05d9\u05dd \u05d0\u05ea\u05d5--\u05e2\u05e9\u05e8 \u05d1\u05d0\u05de\u05d4 \u05de\u05e7\u05e4\u05d9\u05dd \u05d0\u05ea \u05d4\u05d9\u05dd \u05e1\u05d1\u05d9\u05d1 \u05e9\u05e0\u05d9 \u05d8\u05d5\u05e8\u05d9\u05dd \u05d4\u05e4\u05e7\u05e2\u05d9\u05dd \u05d9\u05e6\u05e7\u05d9\u05dd \u05d1\u05d9\u05e6\u05e7\u05ea\u05d5"}, {"pk": 2895970, "verse": 25, "text": "\u05db\u05d4 \u05e2\u05de\u05d3 \u05e2\u05dc \u05e9\u05e0\u05d9 \u05e2\u05e9\u05e8 \u05d1\u05e7\u05e8 \u05e9\u05dc\u05e9\u05d4 \u05e4\u05e0\u05d9\u05dd \u05e6\u05e4\u05d5\u05e0\u05d4 \u05d5\u05e9\u05dc\u05e9\u05d4 \u05e4\u05e0\u05d9\u05dd \u05d9\u05de\u05d4 \u05d5\u05e9\u05dc\u05e9\u05d4 \u05e4\u05e0\u05d9\u05dd \u05e0\u05d2\u05d1\u05d4 \u05d5\u05e9\u05dc\u05e9\u05d4 \u05e4\u05e0\u05d9\u05dd \u05de\u05d6\u05e8\u05d7\u05d4 \u05d5\u05d4\u05d9\u05dd \u05e2\u05dc\u05d9\u05d4\u05dd \u05de\u05dc\u05de\u05e2\u05dc\u05d4 \u05d5\u05db\u05dc \u05d0\u05d7\u05e8\u05d9\u05d4\u05dd \u05d1\u05d9\u05ea\u05d4"}, {"pk": 2895971, "verse": 26, "text": "\u05db\u05d5 \u05d5\u05e2\u05d1\u05d9\u05d5 \u05d8\u05e4\u05d7 \u05d5\u05e9\u05e4\u05ea\u05d5 \u05db\u05de\u05e2\u05e9\u05d4 \u05e9\u05e4\u05ea \u05db\u05d5\u05e1 \u05e4\u05e8\u05d7 \u05e9\u05d5\u05e9\u05df \u05d0\u05dc\u05e4\u05d9\u05dd \u05d1\u05ea \u05d9\u05db\u05d9\u05dc\u00a0 {\u05e4}"}, {"pk": 2895972, "verse": 27, "text": "\u05db\u05d6 \u05d5\u05d9\u05e2\u05e9 \u05d0\u05ea \u05d4\u05de\u05db\u05e0\u05d5\u05ea \u05e2\u05e9\u05e8 \u05e0\u05d7\u05e9\u05ea\u00a0 \u05d0\u05e8\u05d1\u05e2 \u05d1\u05d0\u05de\u05d4 \u05d0\u05e8\u05da \u05d4\u05de\u05db\u05d5\u05e0\u05d4 \u05d4\u05d0\u05d7\u05ea \u05d5\u05d0\u05e8\u05d1\u05e2 \u05d1\u05d0\u05de\u05d4 \u05e8\u05d7\u05d1\u05d4 \u05d5\u05e9\u05dc\u05e9 \u05d1\u05d0\u05de\u05d4 \u05e7\u05d5\u05de\u05ea\u05d4"}, {"pk": 2895973, "verse": 28, "text": "\u05db\u05d7 \u05d5\u05d6\u05d4 \u05de\u05e2\u05e9\u05d4 \u05d4\u05de\u05db\u05d5\u05e0\u05d4 \u05de\u05e1\u05d2\u05e8\u05ea \u05dc\u05d4\u05dd \u05d5\u05de\u05e1\u05d2\u05e8\u05ea \u05d1\u05d9\u05df \u05d4\u05e9\u05dc\u05d1\u05d9\u05dd"}, {"pk": 2895974, "verse": 29, "text": "\u05db\u05d8 \u05d5\u05e2\u05dc \u05d4\u05de\u05e1\u05d2\u05e8\u05d5\u05ea \u05d0\u05e9\u05e8 \u05d1\u05d9\u05df \u05d4\u05e9\u05dc\u05d1\u05d9\u05dd \u05d0\u05e8\u05d9\u05d5\u05ea \u05d1\u05e7\u05e8 \u05d5\u05db\u05e8\u05d5\u05d1\u05d9\u05dd \u05d5\u05e2\u05dc \u05d4\u05e9\u05dc\u05d1\u05d9\u05dd \u05db\u05df \u05de\u05de\u05e2\u05dc \u05d5\u05de\u05ea\u05d7\u05ea \u05dc\u05d0\u05e8\u05d9\u05d5\u05ea \u05d5\u05dc\u05d1\u05e7\u05e8 \u05dc\u05d9\u05d5\u05ea \u05de\u05e2\u05e9\u05d4 \u05de\u05d5\u05e8\u05d3"}, {"pk": 2895975, "verse": 30, "text": "\u05dc \u05d5\u05d0\u05e8\u05d1\u05e2\u05d4 \u05d0\u05d5\u05e4\u05e0\u05d9 \u05e0\u05d7\u05e9\u05ea \u05dc\u05de\u05db\u05d5\u05e0\u05d4 \u05d4\u05d0\u05d7\u05ea \u05d5\u05e1\u05e8\u05e0\u05d9 \u05e0\u05d7\u05e9\u05ea \u05d5\u05d0\u05e8\u05d1\u05e2\u05d4 \u05e4\u05e2\u05de\u05ea\u05d9\u05d5 \u05db\u05ea\u05e4\u05ea \u05dc\u05d4\u05dd \u05de\u05ea\u05d7\u05ea \u05dc\u05db\u05d9\u05e8 \u05d4\u05db\u05ea\u05e4\u05d5\u05ea \u05d9\u05e6\u05e7\u05d5\u05ea \u05de\u05e2\u05d1\u05e8 \u05d0\u05d9\u05e9 \u05dc\u05d9\u05d5\u05ea"}, {"pk": 2895976, "verse": 31, "text": "\u05dc\u05d0 \u05d5\u05e4\u05d9\u05d4\u05d5 \u05de\u05d1\u05d9\u05ea \u05dc\u05db\u05ea\u05e8\u05ea \u05d5\u05de\u05e2\u05dc\u05d4 \u05d1\u05d0\u05de\u05d4 \u05d5\u05e4\u05d9\u05d4 \u05e2\u05d2\u05dc \u05de\u05e2\u05e9\u05d4 \u05db\u05df \u05d0\u05de\u05d4 \u05d5\u05d7\u05e6\u05d9 \u05d4\u05d0\u05de\u05d4 \u05d5\u05d2\u05dd \u05e2\u05dc \u05e4\u05d9\u05d4 \u05de\u05e7\u05dc\u05e2\u05d5\u05ea \u05d5\u05de\u05e1\u05d2\u05e8\u05ea\u05d9\u05d4\u05dd \u05de\u05e8\u05d1\u05e2\u05d5\u05ea \u05dc\u05d0 \u05e2\u05d2\u05dc\u05d5\u05ea"}, {"pk": 2895977, "verse": 32, "text": "\u05dc\u05d1 \u05d5\u05d0\u05e8\u05d1\u05e2\u05ea \u05d4\u05d0\u05d5\u05e4\u05e0\u05d9\u05dd \u05dc\u05de\u05ea\u05d7\u05ea \u05dc\u05de\u05e1\u05d2\u05e8\u05d5\u05ea \u05d5\u05d9\u05d3\u05d5\u05ea \u05d4\u05d0\u05d5\u05e4\u05e0\u05d9\u05dd \u05d1\u05de\u05db\u05d5\u05e0\u05d4 \u05d5\u05e7\u05d5\u05de\u05ea \u05d4\u05d0\u05d5\u05e4\u05df \u05d4\u05d0\u05d7\u05d3 \u05d0\u05de\u05d4 \u05d5\u05d7\u05e6\u05d9 \u05d4\u05d0\u05de\u05d4"}, {"pk": 2895978, "verse": 33, "text": "\u05dc\u05d2 \u05d5\u05de\u05e2\u05e9\u05d4 \u05d4\u05d0\u05d5\u05e4\u05e0\u05d9\u05dd \u05db\u05de\u05e2\u05e9\u05d4 \u05d0\u05d5\u05e4\u05df \u05d4\u05de\u05e8\u05db\u05d1\u05d4 \u05d9\u05d3\u05d5\u05ea\u05dd \u05d5\u05d2\u05d1\u05d9\u05d4\u05dd \u05d5\u05d7\u05e9\u05e7\u05d9\u05d4\u05dd \u05d5\u05d7\u05e9\u05e8\u05d9\u05d4\u05dd--\u05d4\u05db\u05dc \u05de\u05d5\u05e6\u05e7"}, {"pk": 2895979, "verse": 34, "text": "\u05dc\u05d3 \u05d5\u05d0\u05e8\u05d1\u05e2 \u05db\u05ea\u05e4\u05d5\u05ea--\u05d0\u05dc \u05d0\u05e8\u05d1\u05e2 \u05e4\u05e0\u05d5\u05ea \u05d4\u05de\u05db\u05e0\u05d4 \u05d4\u05d0\u05d7\u05ea \u05de\u05df \u05d4\u05de\u05db\u05e0\u05d4 \u05db\u05ea\u05e4\u05d9\u05d4"}, {"pk": 2895980, "verse": 35, "text": "\u05dc\u05d4 \u05d5\u05d1\u05e8\u05d0\u05e9 \u05d4\u05de\u05db\u05d5\u05e0\u05d4 \u05d7\u05e6\u05d9 \u05d4\u05d0\u05de\u05d4 \u05e7\u05d5\u05de\u05d4--\u05e2\u05d2\u05dc \u05e1\u05d1\u05d9\u05d1 \u05d5\u05e2\u05dc \u05e8\u05d0\u05e9 \u05d4\u05de\u05db\u05e0\u05d4 \u05d9\u05d3\u05ea\u05d9\u05d4 \u05d5\u05de\u05e1\u05d2\u05e8\u05ea\u05d9\u05d4 \u05de\u05de\u05e0\u05d4"}, {"pk": 2895981, "verse": 36, "text": "\u05dc\u05d5 \u05d5\u05d9\u05e4\u05ea\u05d7 \u05e2\u05dc \u05d4\u05dc\u05d7\u05ea \u05d9\u05d3\u05ea\u05d9\u05d4 \u05d5\u05e2\u05dc \u05d5\u05de\u05e1\u05d2\u05e8\u05ea\u05d9\u05d4 (\u05de\u05e1\u05d2\u05e8\u05ea\u05d9\u05d4) \u05db\u05e8\u05d5\u05d1\u05d9\u05dd \u05d0\u05e8\u05d9\u05d5\u05ea \u05d5\u05ea\u05de\u05e8\u05ea--\u05db\u05de\u05e2\u05e8 \u05d0\u05d9\u05e9 \u05d5\u05dc\u05d9\u05d5\u05ea \u05e1\u05d1\u05d9\u05d1"}, {"pk": 2895982, "verse": 37, "text": "\u05dc\u05d6 \u05db\u05d6\u05d0\u05ea \u05e2\u05e9\u05d4 \u05d0\u05ea \u05e2\u05e9\u05e8 \u05d4\u05de\u05db\u05e0\u05d5\u05ea\u00a0 \u05de\u05d5\u05e6\u05e7 \u05d0\u05d7\u05d3 \u05de\u05d3\u05d4 \u05d0\u05d7\u05ea \u05e7\u05e6\u05d1 \u05d0\u05d7\u05d3--\u05dc\u05db\u05dc\u05d4\u05e0\u05d4\u00a0 {\u05e1}"}, {"pk": 2895983, "verse": 38, "text": "\u05dc\u05d7 \u05d5\u05d9\u05e2\u05e9 \u05e2\u05e9\u05e8\u05d4 \u05db\u05d9\u05e8\u05d5\u05ea \u05e0\u05d7\u05e9\u05ea\u00a0 \u05d0\u05e8\u05d1\u05e2\u05d9\u05dd \u05d1\u05ea \u05d9\u05db\u05d9\u05dc \u05d4\u05db\u05d9\u05d5\u05e8 \u05d4\u05d0\u05d7\u05d3 \u05d0\u05e8\u05d1\u05e2 \u05d1\u05d0\u05de\u05d4 \u05d4\u05db\u05d9\u05d5\u05e8 \u05d4\u05d0\u05d7\u05d3--\u05db\u05d9\u05d5\u05e8 \u05d0\u05d7\u05d3 \u05e2\u05dc \u05d4\u05de\u05db\u05d5\u05e0\u05d4 \u05d4\u05d0\u05d7\u05ea \u05dc\u05e2\u05e9\u05e8 \u05d4\u05de\u05db\u05e0\u05d5\u05ea"}, {"pk": 2895984, "verse": 39, "text": "\u05dc\u05d8 \u05d5\u05d9\u05ea\u05df \u05d0\u05ea \u05d4\u05de\u05db\u05e0\u05d5\u05ea \u05d7\u05de\u05e9 \u05e2\u05dc \u05db\u05ea\u05e3 \u05d4\u05d1\u05d9\u05ea \u05de\u05d9\u05de\u05d9\u05df \u05d5\u05d7\u05de\u05e9 \u05e2\u05dc \u05db\u05ea\u05e3 \u05d4\u05d1\u05d9\u05ea \u05de\u05e9\u05de\u05d0\u05dc\u05d5 \u05d5\u05d0\u05ea \u05d4\u05d9\u05dd \u05e0\u05ea\u05df \u05de\u05db\u05ea\u05e3 \u05d4\u05d1\u05d9\u05ea \u05d4\u05d9\u05de\u05e0\u05d9\u05ea \u05e7\u05d3\u05de\u05d4--\u05de\u05de\u05d5\u05dc \u05e0\u05d2\u05d1\u00a0 {\u05e1}"}, {"pk": 2895985, "verse": 40, "text": "\u05de \u05d5\u05d9\u05e2\u05e9 \u05d7\u05d9\u05e8\u05d5\u05dd--\u05d0\u05ea \u05d4\u05db\u05d9\u05e8\u05d5\u05ea \u05d5\u05d0\u05ea \u05d4\u05d9\u05e2\u05d9\u05dd \u05d5\u05d0\u05ea \u05d4\u05de\u05d6\u05e8\u05e7\u05d5\u05ea \u05d5\u05d9\u05db\u05dc \u05d7\u05d9\u05e8\u05dd \u05dc\u05e2\u05e9\u05d5\u05ea \u05d0\u05ea \u05db\u05dc \u05d4\u05de\u05dc\u05d0\u05db\u05d4 \u05d0\u05e9\u05e8 \u05e2\u05e9\u05d4 \u05dc\u05de\u05dc\u05da \u05e9\u05dc\u05de\u05d4 \u05d1\u05d9\u05ea \u05d9\u05d4\u05d5\u05d4"}, {"pk": 2895986, "verse": 41, "text": "\u05de\u05d0 \u05e2\u05de\u05d3\u05d9\u05dd \u05e9\u05e0\u05d9\u05dd \u05d5\u05d2\u05dc\u05ea \u05d4\u05db\u05ea\u05e8\u05ea \u05d0\u05e9\u05e8 \u05e2\u05dc \u05e8\u05d0\u05e9 \u05d4\u05e2\u05de\u05d5\u05d3\u05d9\u05dd \u05e9\u05ea\u05d9\u05dd \u05d5\u05d4\u05e9\u05d1\u05db\u05d5\u05ea \u05e9\u05ea\u05d9\u05dd--\u05dc\u05db\u05e1\u05d5\u05ea \u05d0\u05ea \u05e9\u05ea\u05d9 \u05d2\u05dc\u05d5\u05ea \u05d4\u05db\u05ea\u05e8\u05ea \u05d0\u05e9\u05e8 \u05e2\u05dc \u05e8\u05d0\u05e9 \u05d4\u05e2\u05de\u05d5\u05d3\u05d9\u05dd"}, {"pk": 2895987, "verse": 42, "text": "\u05de\u05d1 \u05d5\u05d0\u05ea \u05d4\u05e8\u05de\u05e0\u05d9\u05dd \u05d0\u05e8\u05d1\u05e2 \u05de\u05d0\u05d5\u05ea \u05dc\u05e9\u05ea\u05d9 \u05d4\u05e9\u05d1\u05db\u05d5\u05ea--\u05e9\u05e0\u05d9 \u05d8\u05d5\u05e8\u05d9\u05dd \u05e8\u05de\u05e0\u05d9\u05dd \u05dc\u05e9\u05d1\u05db\u05d4 \u05d4\u05d0\u05d7\u05ea \u05dc\u05db\u05e1\u05d5\u05ea \u05d0\u05ea \u05e9\u05ea\u05d9 \u05d2\u05dc\u05d5\u05ea \u05d4\u05db\u05ea\u05e8\u05ea \u05d0\u05e9\u05e8 \u05e2\u05dc \u05e4\u05e0\u05d9 \u05d4\u05e2\u05de\u05d5\u05d3\u05d9\u05dd"}, {"pk": 2895988, "verse": 43, "text": "\u05de\u05d2 \u05d5\u05d0\u05ea \u05d4\u05de\u05db\u05e0\u05d5\u05ea \u05e2\u05e9\u05e8 \u05d5\u05d0\u05ea \u05d4\u05db\u05d9\u05e8\u05ea \u05e2\u05e9\u05e8\u05d4 \u05e2\u05dc \u05d4\u05de\u05db\u05e0\u05d5\u05ea"}, {"pk": 2895989, "verse": 44, "text": "\u05de\u05d3 \u05d5\u05d0\u05ea \u05d4\u05d9\u05dd \u05d4\u05d0\u05d7\u05d3 \u05d5\u05d0\u05ea \u05d4\u05d1\u05e7\u05e8 \u05e9\u05e0\u05d9\u05dd \u05e2\u05e9\u05e8 \u05ea\u05d7\u05ea \u05d4\u05d9\u05dd"}, {"pk": 2895990, "verse": 45, "text": "\u05de\u05d4 \u05d5\u05d0\u05ea \u05d4\u05e1\u05d9\u05e8\u05d5\u05ea \u05d5\u05d0\u05ea \u05d4\u05d9\u05e2\u05d9\u05dd \u05d5\u05d0\u05ea \u05d4\u05de\u05d6\u05e8\u05e7\u05d5\u05ea \u05d5\u05d0\u05ea \u05db\u05dc \u05d4\u05db\u05dc\u05d9\u05dd \u05d4\u05d0\u05d4\u05dc (\u05d4\u05d0\u05dc\u05d4) \u05d0\u05e9\u05e8 \u05e2\u05e9\u05d4 \u05d7\u05d9\u05e8\u05dd \u05dc\u05de\u05dc\u05da \u05e9\u05dc\u05de\u05d4 \u05d1\u05d9\u05ea \u05d9\u05d4\u05d5\u05d4--\u05e0\u05d7\u05e9\u05ea \u05de\u05de\u05e8\u05d8"}, {"pk": 2895991, "verse": 46, "text": "\u05de\u05d5 \u05d1\u05db\u05db\u05e8 \u05d4\u05d9\u05e8\u05d3\u05df \u05d9\u05e6\u05e7\u05dd \u05d4\u05de\u05dc\u05da \u05d1\u05de\u05e2\u05d1\u05d4 \u05d4\u05d0\u05d3\u05de\u05d4 \u05d1\u05d9\u05df \u05e1\u05db\u05d5\u05ea \u05d5\u05d1\u05d9\u05df \u05e6\u05e8\u05ea\u05df"}, {"pk": 2895992, "verse": 47, "text": "\u05de\u05d6 \u05d5\u05d9\u05e0\u05d7 \u05e9\u05dc\u05de\u05d4 \u05d0\u05ea \u05db\u05dc \u05d4\u05db\u05dc\u05d9\u05dd \u05de\u05e8\u05d1 \u05de\u05d0\u05d3 \u05de\u05d0\u05d3--\u05dc\u05d0 \u05e0\u05d7\u05e7\u05e8 \u05de\u05e9\u05e7\u05dc \u05d4\u05e0\u05d7\u05e9\u05ea"}, {"pk": 2895993, "verse": 48, "text": "\u05de\u05d7 \u05d5\u05d9\u05e2\u05e9 \u05e9\u05dc\u05de\u05d4--\u05d0\u05ea \u05db\u05dc \u05d4\u05db\u05dc\u05d9\u05dd \u05d0\u05e9\u05e8 \u05d1\u05d9\u05ea \u05d9\u05d4\u05d5\u05d4\u00a0 \u05d0\u05ea \u05de\u05d6\u05d1\u05d7 \u05d4\u05d6\u05d4\u05d1 \u05d5\u05d0\u05ea \u05d4\u05e9\u05dc\u05d7\u05df \u05d0\u05e9\u05e8 \u05e2\u05dc\u05d9\u05d5 \u05dc\u05d7\u05dd \u05d4\u05e4\u05e0\u05d9\u05dd \u05d6\u05d4\u05d1"}, {"pk": 2895994, "verse": 49, "text": "\u05de\u05d8 \u05d5\u05d0\u05ea \u05d4\u05de\u05e0\u05e8\u05d5\u05ea \u05d7\u05de\u05e9 \u05de\u05d9\u05de\u05d9\u05df \u05d5\u05d7\u05de\u05e9 \u05de\u05e9\u05de\u05d0\u05d5\u05dc \u05dc\u05e4\u05e0\u05d9 \u05d4\u05d3\u05d1\u05d9\u05e8--\u05d6\u05d4\u05d1 \u05e1\u05d2\u05d5\u05e8 \u05d5\u05d4\u05e4\u05e8\u05d7 \u05d5\u05d4\u05e0\u05e8\u05ea \u05d5\u05d4\u05de\u05dc\u05e7\u05d7\u05d9\u05dd \u05d6\u05d4\u05d1"}, {"pk": 2895995, "verse": 50, "text": "\u05e0 \u05d5\u05d4\u05e1\u05e4\u05d5\u05ea \u05d5\u05d4\u05de\u05d6\u05de\u05e8\u05d5\u05ea \u05d5\u05d4\u05de\u05d6\u05e8\u05e7\u05d5\u05ea \u05d5\u05d4\u05db\u05e4\u05d5\u05ea \u05d5\u05d4\u05de\u05d7\u05ea\u05d5\u05ea--\u05d6\u05d4\u05d1 \u05e1\u05d2\u05d5\u05e8 \u05d5\u05d4\u05e4\u05ea\u05d5\u05ea \u05dc\u05d3\u05dc\u05ea\u05d5\u05ea \u05d4\u05d1\u05d9\u05ea \u05d4\u05e4\u05e0\u05d9\u05de\u05d9 \u05dc\u05e7\u05d3\u05e9 \u05d4\u05e7\u05d3\u05e9\u05d9\u05dd \u05dc\u05d3\u05dc\u05ea\u05d9 \u05d4\u05d1\u05d9\u05ea \u05dc\u05d4\u05d9\u05db\u05dc--\u05d6\u05d4\u05d1\u00a0 {\u05e4}"}, {"pk": 2895996, "verse": 51, "text": "\u05e0\u05d0 \u05d5\u05ea\u05e9\u05dc\u05dd \u05db\u05dc \u05d4\u05de\u05dc\u05d0\u05db\u05d4 \u05d0\u05e9\u05e8 \u05e2\u05e9\u05d4 \u05d4\u05de\u05dc\u05da \u05e9\u05dc\u05de\u05d4 \u05d1\u05d9\u05ea \u05d9\u05d4\u05d5\u05d4 \u05d5\u05d9\u05d1\u05d0 \u05e9\u05dc\u05de\u05d4 \u05d0\u05ea \u05e7\u05d3\u05e9\u05d9 \u05d3\u05d5\u05d3 \u05d0\u05d1\u05d9\u05d5 \u05d0\u05ea \u05d4\u05db\u05e1\u05e3 \u05d5\u05d0\u05ea \u05d4\u05d6\u05d4\u05d1 \u05d5\u05d0\u05ea \u05d4\u05db\u05dc\u05d9\u05dd--\u05e0\u05ea\u05df \u05d1\u05d0\u05e6\u05e8\u05d5\u05ea \u05d1\u05d9\u05ea \u05d9\u05d4\u05d5\u05d4\u00a0 {\u05e4}"}]