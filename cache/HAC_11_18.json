[{"pk": 2896353, "verse": 1, "text": "\u05d0 \u05d5\u05d9\u05d4\u05d9 \u05d9\u05de\u05d9\u05dd \u05e8\u05d1\u05d9\u05dd \u05d5\u05d3\u05d1\u05e8 \u05d9\u05d4\u05d5\u05d4 \u05d4\u05d9\u05d4 \u05d0\u05dc \u05d0\u05dc\u05d9\u05d4\u05d5 \u05d1\u05e9\u05e0\u05d4 \u05d4\u05e9\u05dc\u05d9\u05e9\u05d9\u05ea \u05dc\u05d0\u05de\u05e8\u00a0 \u05dc\u05da \u05d4\u05e8\u05d0\u05d4 \u05d0\u05dc \u05d0\u05d7\u05d0\u05d1 \u05d5\u05d0\u05ea\u05e0\u05d4 \u05de\u05d8\u05e8 \u05e2\u05dc \u05e4\u05e0\u05d9 \u05d4\u05d0\u05d3\u05de\u05d4"}, {"pk": 2896354, "verse": 2, "text": "\u05d1 \u05d5\u05d9\u05dc\u05da \u05d0\u05dc\u05d9\u05d4\u05d5 \u05dc\u05d4\u05e8\u05d0\u05d5\u05ea \u05d0\u05dc \u05d0\u05d7\u05d0\u05d1 \u05d5\u05d4\u05e8\u05e2\u05d1 \u05d7\u05d6\u05e7 \u05d1\u05e9\u05de\u05e8\u05d5\u05df"}, {"pk": 2896355, "verse": 3, "text": "\u05d2 \u05d5\u05d9\u05e7\u05e8\u05d0 \u05d0\u05d7\u05d0\u05d1 \u05d0\u05dc \u05e2\u05d1\u05d3\u05d9\u05d4\u05d5 \u05d0\u05e9\u05e8 \u05e2\u05dc \u05d4\u05d1\u05d9\u05ea \u05d5\u05e2\u05d1\u05d3\u05d9\u05d4\u05d5 \u05d4\u05d9\u05d4 \u05d9\u05e8\u05d0 \u05d0\u05ea \u05d9\u05d4\u05d5\u05d4--\u05de\u05d0\u05d3"}, {"pk": 2896356, "verse": 4, "text": "\u05d3 \u05d5\u05d9\u05d4\u05d9 \u05d1\u05d4\u05db\u05e8\u05d9\u05ea \u05d0\u05d9\u05d6\u05d1\u05dc \u05d0\u05ea \u05e0\u05d1\u05d9\u05d0\u05d9 \u05d9\u05d4\u05d5\u05d4 \u05d5\u05d9\u05e7\u05d7 \u05e2\u05d1\u05d3\u05d9\u05d4\u05d5 \u05de\u05d0\u05d4 \u05e0\u05d1\u05d9\u05d0\u05d9\u05dd \u05d5\u05d9\u05d7\u05d1\u05d9\u05d0\u05dd \u05d7\u05de\u05e9\u05d9\u05dd \u05d0\u05d9\u05e9 \u05d1\u05de\u05e2\u05e8\u05d4 \u05d5\u05db\u05dc\u05db\u05dc\u05dd \u05dc\u05d7\u05dd \u05d5\u05de\u05d9\u05dd"}, {"pk": 2896357, "verse": 5, "text": "\u05d4 \u05d5\u05d9\u05d0\u05de\u05e8 \u05d0\u05d7\u05d0\u05d1 \u05d0\u05dc \u05e2\u05d1\u05d3\u05d9\u05d4\u05d5 \u05dc\u05da \u05d1\u05d0\u05e8\u05e5 \u05d0\u05dc \u05db\u05dc \u05de\u05e2\u05d9\u05e0\u05d9 \u05d4\u05de\u05d9\u05dd \u05d5\u05d0\u05dc \u05db\u05dc \u05d4\u05e0\u05d7\u05dc\u05d9\u05dd \u05d0\u05d5\u05dc\u05d9 \u05e0\u05de\u05e6\u05d0 \u05d7\u05e6\u05d9\u05e8 \u05d5\u05e0\u05d7\u05d9\u05d4 \u05e1\u05d5\u05e1 \u05d5\u05e4\u05e8\u05d3 \u05d5\u05dc\u05d5\u05d0 \u05e0\u05db\u05e8\u05d9\u05ea \u05de\u05d4\u05d1\u05d4\u05de\u05d4"}, {"pk": 2896358, "verse": 6, "text": "\u05d5 \u05d5\u05d9\u05d7\u05dc\u05e7\u05d5 \u05dc\u05d4\u05dd \u05d0\u05ea \u05d4\u05d0\u05e8\u05e5 \u05dc\u05e2\u05d1\u05e8 \u05d1\u05d4\u00a0 \u05d0\u05d7\u05d0\u05d1 \u05d4\u05dc\u05da \u05d1\u05d3\u05e8\u05da \u05d0\u05d7\u05d3 \u05dc\u05d1\u05d3\u05d5 \u05d5\u05e2\u05d1\u05d3\u05d9\u05d4\u05d5 \u05d4\u05dc\u05da \u05d1\u05d3\u05e8\u05da \u05d0\u05d7\u05d3 \u05dc\u05d1\u05d3\u05d5"}, {"pk": 2896359, "verse": 7, "text": "\u05d6 \u05d5\u05d9\u05d4\u05d9 \u05e2\u05d1\u05d3\u05d9\u05d4\u05d5 \u05d1\u05d3\u05e8\u05da \u05d5\u05d4\u05e0\u05d4 \u05d0\u05dc\u05d9\u05d4\u05d5 \u05dc\u05e7\u05e8\u05d0\u05ea\u05d5 \u05d5\u05d9\u05db\u05e8\u05d4\u05d5 \u05d5\u05d9\u05e4\u05dc \u05e2\u05dc \u05e4\u05e0\u05d9\u05d5 \u05d5\u05d9\u05d0\u05de\u05e8 \u05d4\u05d0\u05ea\u05d4 \u05d6\u05d4 \u05d0\u05d3\u05e0\u05d9 \u05d0\u05dc\u05d9\u05d4\u05d5"}, {"pk": 2896360, "verse": 8, "text": "\u05d7 \u05d5\u05d9\u05d0\u05de\u05e8 \u05dc\u05d5 \u05d0\u05e0\u05d9 \u05dc\u05da \u05d0\u05de\u05e8 \u05dc\u05d0\u05d3\u05e0\u05d9\u05da \u05d4\u05e0\u05d4 \u05d0\u05dc\u05d9\u05d4\u05d5"}, {"pk": 2896361, "verse": 9, "text": "\u05d8 \u05d5\u05d9\u05d0\u05de\u05e8 \u05de\u05d4 \u05d7\u05d8\u05d0\u05ea\u05d9\u00a0 \u05db\u05d9 \u05d0\u05ea\u05d4 \u05e0\u05ea\u05df \u05d0\u05ea \u05e2\u05d1\u05d3\u05da \u05d1\u05d9\u05d3 \u05d0\u05d7\u05d0\u05d1--\u05dc\u05d4\u05de\u05d9\u05ea\u05e0\u05d9"}, {"pk": 2896362, "verse": 10, "text": "\u05d9 \u05d7\u05d9 \u05d9\u05d4\u05d5\u05d4 \u05d0\u05dc\u05d4\u05d9\u05da \u05d0\u05dd \u05d9\u05e9 \u05d2\u05d5\u05d9 \u05d5\u05de\u05de\u05dc\u05db\u05d4 \u05d0\u05e9\u05e8 \u05dc\u05d0 \u05e9\u05dc\u05d7 \u05d0\u05d3\u05e0\u05d9 \u05e9\u05dd \u05dc\u05d1\u05e7\u05e9\u05da \u05d5\u05d0\u05de\u05e8\u05d5 \u05d0\u05d9\u05df \u05d5\u05d4\u05e9\u05d1\u05d9\u05e2 \u05d0\u05ea \u05d4\u05de\u05de\u05dc\u05db\u05d4 \u05d5\u05d0\u05ea \u05d4\u05d2\u05d5\u05d9 \u05db\u05d9 \u05dc\u05d0 \u05d9\u05de\u05e6\u05d0\u05db\u05d4"}, {"pk": 2896363, "verse": 11, "text": "\u05d9\u05d0 \u05d5\u05e2\u05ea\u05d4 \u05d0\u05ea\u05d4 \u05d0\u05de\u05e8\u00a0 \u05dc\u05da \u05d0\u05de\u05e8 \u05dc\u05d0\u05d3\u05e0\u05d9\u05da \u05d4\u05e0\u05d4 \u05d0\u05dc\u05d9\u05d4\u05d5"}, {"pk": 2896364, "verse": 12, "text": "\u05d9\u05d1 \u05d5\u05d4\u05d9\u05d4 \u05d0\u05e0\u05d9 \u05d0\u05dc\u05da \u05de\u05d0\u05ea\u05da \u05d5\u05e8\u05d5\u05d7 \u05d9\u05d4\u05d5\u05d4 \u05d9\u05e9\u05d0\u05da \u05e2\u05dc \u05d0\u05e9\u05e8 \u05dc\u05d0 \u05d0\u05d3\u05e2 \u05d5\u05d1\u05d0\u05ea\u05d9 \u05dc\u05d4\u05d2\u05d9\u05d3 \u05dc\u05d0\u05d7\u05d0\u05d1 \u05d5\u05dc\u05d0 \u05d9\u05de\u05e6\u05d0\u05da \u05d5\u05d4\u05e8\u05d2\u05e0\u05d9 \u05d5\u05e2\u05d1\u05d3\u05da \u05d9\u05e8\u05d0 \u05d0\u05ea \u05d9\u05d4\u05d5\u05d4 \u05de\u05e0\u05e2\u05e8\u05d9"}, {"pk": 2896365, "verse": 13, "text": "\u05d9\u05d2 \u05d4\u05dc\u05d0 \u05d4\u05d2\u05d3 \u05dc\u05d0\u05d3\u05e0\u05d9 \u05d0\u05ea \u05d0\u05e9\u05e8 \u05e2\u05e9\u05d9\u05ea\u05d9 \u05d1\u05d4\u05e8\u05d2 \u05d0\u05d9\u05d6\u05d1\u05dc \u05d0\u05ea \u05e0\u05d1\u05d9\u05d0\u05d9 \u05d9\u05d4\u05d5\u05d4 \u05d5\u05d0\u05d7\u05d1\u05d0 \u05de\u05e0\u05d1\u05d9\u05d0\u05d9 \u05d9\u05d4\u05d5\u05d4 \u05de\u05d0\u05d4 \u05d0\u05d9\u05e9 \u05d7\u05de\u05e9\u05d9\u05dd \u05d7\u05de\u05e9\u05d9\u05dd \u05d0\u05d9\u05e9 \u05d1\u05de\u05e2\u05e8\u05d4 \u05d5\u05d0\u05db\u05dc\u05db\u05dc\u05dd \u05dc\u05d7\u05dd \u05d5\u05de\u05d9\u05dd"}, {"pk": 2896366, "verse": 14, "text": "\u05d9\u05d3 \u05d5\u05e2\u05ea\u05d4 \u05d0\u05ea\u05d4 \u05d0\u05de\u05e8 \u05dc\u05da \u05d0\u05de\u05e8 \u05dc\u05d0\u05d3\u05e0\u05d9\u05da \u05d4\u05e0\u05d4 \u05d0\u05dc\u05d9\u05d4\u05d5 \u05d5\u05d4\u05e8\u05d2\u05e0\u05d9\u00a0 {\u05e1}"}, {"pk": 2896367, "verse": 15, "text": "\u05d8\u05d5 \u05d5\u05d9\u05d0\u05de\u05e8 \u05d0\u05dc\u05d9\u05d4\u05d5 \u05d7\u05d9 \u05d9\u05d4\u05d5\u05d4 \u05e6\u05d1\u05d0\u05d5\u05ea \u05d0\u05e9\u05e8 \u05e2\u05de\u05d3\u05ea\u05d9 \u05dc\u05e4\u05e0\u05d9\u05d5\u00a0 \u05db\u05d9 \u05d4\u05d9\u05d5\u05dd \u05d0\u05e8\u05d0\u05d4 \u05d0\u05dc\u05d9\u05d5"}, {"pk": 2896368, "verse": 16, "text": "\u05d8\u05d6 \u05d5\u05d9\u05dc\u05da \u05e2\u05d1\u05d3\u05d9\u05d4\u05d5 \u05dc\u05e7\u05e8\u05d0\u05ea \u05d0\u05d7\u05d0\u05d1 \u05d5\u05d9\u05d2\u05d3 \u05dc\u05d5 \u05d5\u05d9\u05dc\u05da \u05d0\u05d7\u05d0\u05d1 \u05dc\u05e7\u05e8\u05d0\u05ea \u05d0\u05dc\u05d9\u05d4\u05d5"}, {"pk": 2896369, "verse": 17, "text": "\u05d9\u05d6 \u05d5\u05d9\u05d4\u05d9 \u05db\u05e8\u05d0\u05d5\u05ea \u05d0\u05d7\u05d0\u05d1 \u05d0\u05ea \u05d0\u05dc\u05d9\u05d4\u05d5 \u05d5\u05d9\u05d0\u05de\u05e8 \u05d0\u05d7\u05d0\u05d1 \u05d0\u05dc\u05d9\u05d5 \u05d4\u05d0\u05ea\u05d4 \u05d6\u05d4 \u05e2\u05db\u05e8 \u05d9\u05e9\u05e8\u05d0\u05dc"}, {"pk": 2896370, "verse": 18, "text": "\u05d9\u05d7 \u05d5\u05d9\u05d0\u05de\u05e8 \u05dc\u05d0 \u05e2\u05db\u05e8\u05ea\u05d9 \u05d0\u05ea \u05d9\u05e9\u05e8\u05d0\u05dc \u05db\u05d9 \u05d0\u05dd \u05d0\u05ea\u05d4 \u05d5\u05d1\u05d9\u05ea \u05d0\u05d1\u05d9\u05da--\u05d1\u05e2\u05d6\u05d1\u05db\u05dd \u05d0\u05ea \u05de\u05e6\u05d5\u05ea \u05d9\u05d4\u05d5\u05d4 \u05d5\u05ea\u05dc\u05da \u05d0\u05d7\u05e8\u05d9 \u05d4\u05d1\u05e2\u05dc\u05d9\u05dd"}, {"pk": 2896371, "verse": 19, "text": "\u05d9\u05d8 \u05d5\u05e2\u05ea\u05d4 \u05e9\u05dc\u05d7 \u05e7\u05d1\u05e5 \u05d0\u05dc\u05d9 \u05d0\u05ea \u05db\u05dc \u05d9\u05e9\u05e8\u05d0\u05dc--\u05d0\u05dc \u05d4\u05e8 \u05d4\u05db\u05e8\u05de\u05dc \u05d5\u05d0\u05ea \u05e0\u05d1\u05d9\u05d0\u05d9 \u05d4\u05d1\u05e2\u05dc \u05d0\u05e8\u05d1\u05e2 \u05de\u05d0\u05d5\u05ea \u05d5\u05d7\u05de\u05e9\u05d9\u05dd \u05d5\u05e0\u05d1\u05d9\u05d0\u05d9 \u05d4\u05d0\u05e9\u05e8\u05d4 \u05d0\u05e8\u05d1\u05e2 \u05de\u05d0\u05d5\u05ea \u05d0\u05db\u05dc\u05d9 \u05e9\u05dc\u05d7\u05df \u05d0\u05d9\u05d6\u05d1\u05dc"}, {"pk": 2896372, "verse": 20, "text": "\u05db \u05d5\u05d9\u05e9\u05dc\u05d7 \u05d0\u05d7\u05d0\u05d1 \u05d1\u05db\u05dc \u05d1\u05e0\u05d9 \u05d9\u05e9\u05e8\u05d0\u05dc \u05d5\u05d9\u05e7\u05d1\u05e5 \u05d0\u05ea \u05d4\u05e0\u05d1\u05d9\u05d0\u05d9\u05dd \u05d0\u05dc \u05d4\u05e8 \u05d4\u05db\u05e8\u05de\u05dc"}, {"pk": 2896373, "verse": 21, "text": "\u05db\u05d0 \u05d5\u05d9\u05d2\u05e9 \u05d0\u05dc\u05d9\u05d4\u05d5 \u05d0\u05dc \u05db\u05dc \u05d4\u05e2\u05dd \u05d5\u05d9\u05d0\u05de\u05e8 \u05e2\u05d3 \u05de\u05ea\u05d9 \u05d0\u05ea\u05dd \u05e4\u05e1\u05d7\u05d9\u05dd \u05e2\u05dc \u05e9\u05ea\u05d9 \u05d4\u05e1\u05e2\u05e4\u05d9\u05dd--\u05d0\u05dd \u05d9\u05d4\u05d5\u05d4 \u05d4\u05d0\u05dc\u05d4\u05d9\u05dd \u05dc\u05db\u05d5 \u05d0\u05d7\u05e8\u05d9\u05d5 \u05d5\u05d0\u05dd \u05d4\u05d1\u05e2\u05dc \u05dc\u05db\u05d5 \u05d0\u05d7\u05e8\u05d9\u05d5 \u05d5\u05dc\u05d0 \u05e2\u05e0\u05d5 \u05d4\u05e2\u05dd \u05d0\u05ea\u05d5 \u05d3\u05d1\u05e8"}, {"pk": 2896374, "verse": 22, "text": "\u05db\u05d1 \u05d5\u05d9\u05d0\u05de\u05e8 \u05d0\u05dc\u05d9\u05d4\u05d5 \u05d0\u05dc \u05d4\u05e2\u05dd \u05d0\u05e0\u05d9 \u05e0\u05d5\u05ea\u05e8\u05ea\u05d9 \u05e0\u05d1\u05d9\u05d0 \u05dc\u05d9\u05d4\u05d5\u05d4 \u05dc\u05d1\u05d3\u05d9 \u05d5\u05e0\u05d1\u05d9\u05d0\u05d9 \u05d4\u05d1\u05e2\u05dc \u05d0\u05e8\u05d1\u05e2 \u05de\u05d0\u05d5\u05ea \u05d5\u05d7\u05de\u05e9\u05d9\u05dd \u05d0\u05d9\u05e9"}, {"pk": 2896375, "verse": 23, "text": "\u05db\u05d2 \u05d5\u05d9\u05ea\u05e0\u05d5 \u05dc\u05e0\u05d5 \u05e9\u05e0\u05d9\u05dd \u05e4\u05e8\u05d9\u05dd \u05d5\u05d9\u05d1\u05d7\u05e8\u05d5 \u05dc\u05d4\u05dd \u05d4\u05e4\u05e8 \u05d4\u05d0\u05d7\u05d3 \u05d5\u05d9\u05e0\u05ea\u05d7\u05d4\u05d5 \u05d5\u05d9\u05e9\u05d9\u05de\u05d5 \u05e2\u05dc \u05d4\u05e2\u05e6\u05d9\u05dd \u05d5\u05d0\u05e9 \u05dc\u05d0 \u05d9\u05e9\u05d9\u05de\u05d5 \u05d5\u05d0\u05e0\u05d9 \u05d0\u05e2\u05e9\u05d4 \u05d0\u05ea \u05d4\u05e4\u05e8 \u05d4\u05d0\u05d7\u05d3 \u05d5\u05e0\u05ea\u05ea\u05d9 \u05e2\u05dc \u05d4\u05e2\u05e6\u05d9\u05dd \u05d5\u05d0\u05e9 \u05dc\u05d0 \u05d0\u05e9\u05d9\u05dd"}, {"pk": 2896376, "verse": 24, "text": "\u05db\u05d3 \u05d5\u05e7\u05e8\u05d0\u05ea\u05dd \u05d1\u05e9\u05dd \u05d0\u05dc\u05d4\u05d9\u05db\u05dd \u05d5\u05d0\u05e0\u05d9 \u05d0\u05e7\u05e8\u05d0 \u05d1\u05e9\u05dd \u05d9\u05d4\u05d5\u05d4 \u05d5\u05d4\u05d9\u05d4 \u05d4\u05d0\u05dc\u05d4\u05d9\u05dd \u05d0\u05e9\u05e8 \u05d9\u05e2\u05e0\u05d4 \u05d1\u05d0\u05e9 \u05d4\u05d5\u05d0 \u05d4\u05d0\u05dc\u05d4\u05d9\u05dd \u05d5\u05d9\u05e2\u05df \u05db\u05dc \u05d4\u05e2\u05dd \u05d5\u05d9\u05d0\u05de\u05e8\u05d5 \u05d8\u05d5\u05d1 \u05d4\u05d3\u05d1\u05e8"}, {"pk": 2896377, "verse": 25, "text": "\u05db\u05d4 \u05d5\u05d9\u05d0\u05de\u05e8 \u05d0\u05dc\u05d9\u05d4\u05d5 \u05dc\u05e0\u05d1\u05d9\u05d0\u05d9 \u05d4\u05d1\u05e2\u05dc \u05d1\u05d7\u05e8\u05d5 \u05dc\u05db\u05dd \u05d4\u05e4\u05e8 \u05d4\u05d0\u05d7\u05d3 \u05d5\u05e2\u05e9\u05d5 \u05e8\u05d0\u05e9\u05e0\u05d4 \u05db\u05d9 \u05d0\u05ea\u05dd \u05d4\u05e8\u05d1\u05d9\u05dd \u05d5\u05e7\u05e8\u05d0\u05d5 \u05d1\u05e9\u05dd \u05d0\u05dc\u05d4\u05d9\u05db\u05dd \u05d5\u05d0\u05e9 \u05dc\u05d0 \u05ea\u05e9\u05d9\u05de\u05d5"}, {"pk": 2896378, "verse": 26, "text": "\u05db\u05d5 \u05d5\u05d9\u05e7\u05d7\u05d5 \u05d0\u05ea \u05d4\u05e4\u05e8 \u05d0\u05e9\u05e8 \u05e0\u05ea\u05df \u05dc\u05d4\u05dd \u05d5\u05d9\u05e2\u05e9\u05d5 \u05d5\u05d9\u05e7\u05e8\u05d0\u05d5 \u05d1\u05e9\u05dd \u05d4\u05d1\u05e2\u05dc \u05de\u05d4\u05d1\u05e7\u05e8 \u05d5\u05e2\u05d3 \u05d4\u05e6\u05d4\u05e8\u05d9\u05dd \u05dc\u05d0\u05de\u05e8 \u05d4\u05d1\u05e2\u05dc \u05e2\u05e0\u05e0\u05d5 \u05d5\u05d0\u05d9\u05df \u05e7\u05d5\u05dc \u05d5\u05d0\u05d9\u05df \u05e2\u05e0\u05d4 \u05d5\u05d9\u05e4\u05e1\u05d7\u05d5 \u05e2\u05dc \u05d4\u05de\u05d6\u05d1\u05d7 \u05d0\u05e9\u05e8 \u05e2\u05e9\u05d4"}, {"pk": 2896379, "verse": 27, "text": "\u05db\u05d6 \u05d5\u05d9\u05d4\u05d9 \u05d1\u05e6\u05d4\u05e8\u05d9\u05dd \u05d5\u05d9\u05d4\u05ea\u05dc \u05d1\u05d4\u05dd \u05d0\u05dc\u05d9\u05d4\u05d5 \u05d5\u05d9\u05d0\u05de\u05e8 \u05e7\u05e8\u05d0\u05d5 \u05d1\u05e7\u05d5\u05dc \u05d2\u05d3\u05d5\u05dc \u05db\u05d9 \u05d0\u05dc\u05d4\u05d9\u05dd \u05d4\u05d5\u05d0--\u05db\u05d9 \u05e9\u05d9\u05d7 \u05d5\u05db\u05d9 \u05e9\u05d9\u05d2 \u05dc\u05d5 \u05d5\u05db\u05d9 \u05d3\u05e8\u05da \u05dc\u05d5 \u05d0\u05d5\u05dc\u05d9 \u05d9\u05e9\u05df \u05d4\u05d5\u05d0 \u05d5\u05d9\u05e7\u05e5"}, {"pk": 2896380, "verse": 28, "text": "\u05db\u05d7 \u05d5\u05d9\u05e7\u05e8\u05d0\u05d5 \u05d1\u05e7\u05d5\u05dc \u05d2\u05d3\u05d5\u05dc \u05d5\u05d9\u05ea\u05d2\u05d3\u05d3\u05d5 \u05db\u05de\u05e9\u05e4\u05d8\u05dd \u05d1\u05d7\u05e8\u05d1\u05d5\u05ea \u05d5\u05d1\u05e8\u05de\u05d7\u05d9\u05dd--\u05e2\u05d3 \u05e9\u05e4\u05da \u05d3\u05dd \u05e2\u05dc\u05d9\u05d4\u05dd"}, {"pk": 2896381, "verse": 29, "text": "\u05db\u05d8 \u05d5\u05d9\u05d4\u05d9 \u05db\u05e2\u05d1\u05e8 \u05d4\u05e6\u05d4\u05e8\u05d9\u05dd \u05d5\u05d9\u05ea\u05e0\u05d1\u05d0\u05d5 \u05e2\u05d3 \u05dc\u05e2\u05dc\u05d5\u05ea \u05d4\u05de\u05e0\u05d7\u05d4 \u05d5\u05d0\u05d9\u05df \u05e7\u05d5\u05dc \u05d5\u05d0\u05d9\u05df \u05e2\u05e0\u05d4 \u05d5\u05d0\u05d9\u05df \u05e7\u05e9\u05d1"}, {"pk": 2896382, "verse": 30, "text": "\u05dc \u05d5\u05d9\u05d0\u05de\u05e8 \u05d0\u05dc\u05d9\u05d4\u05d5 \u05dc\u05db\u05dc \u05d4\u05e2\u05dd \u05d2\u05e9\u05d5 \u05d0\u05dc\u05d9 \u05d5\u05d9\u05d2\u05e9\u05d5 \u05db\u05dc \u05d4\u05e2\u05dd \u05d0\u05dc\u05d9\u05d5 \u05d5\u05d9\u05e8\u05e4\u05d0 \u05d0\u05ea \u05de\u05d6\u05d1\u05d7 \u05d9\u05d4\u05d5\u05d4 \u05d4\u05d4\u05e8\u05d5\u05e1"}, {"pk": 2896383, "verse": 31, "text": "\u05dc\u05d0 \u05d5\u05d9\u05e7\u05d7 \u05d0\u05dc\u05d9\u05d4\u05d5 \u05e9\u05ea\u05d9\u05dd \u05e2\u05e9\u05e8\u05d4 \u05d0\u05d1\u05e0\u05d9\u05dd \u05db\u05de\u05e1\u05e4\u05e8 \u05e9\u05d1\u05d8\u05d9 \u05d1\u05e0\u05d9 \u05d9\u05e2\u05e7\u05d1--\u05d0\u05e9\u05e8 \u05d4\u05d9\u05d4 \u05d3\u05d1\u05e8 \u05d9\u05d4\u05d5\u05d4 \u05d0\u05dc\u05d9\u05d5 \u05dc\u05d0\u05de\u05e8 \u05d9\u05e9\u05e8\u05d0\u05dc \u05d9\u05d4\u05d9\u05d4 \u05e9\u05de\u05da"}, {"pk": 2896384, "verse": 32, "text": "\u05dc\u05d1 \u05d5\u05d9\u05d1\u05e0\u05d4 \u05d0\u05ea \u05d4\u05d0\u05d1\u05e0\u05d9\u05dd \u05de\u05d6\u05d1\u05d7 \u05d1\u05e9\u05dd \u05d9\u05d4\u05d5\u05d4 \u05d5\u05d9\u05e2\u05e9 \u05ea\u05e2\u05dc\u05d4 \u05db\u05d1\u05d9\u05ea \u05e1\u05d0\u05ea\u05d9\u05dd \u05d6\u05e8\u05e2 \u05e1\u05d1\u05d9\u05d1 \u05dc\u05de\u05d6\u05d1\u05d7"}, {"pk": 2896385, "verse": 33, "text": "\u05dc\u05d2 \u05d5\u05d9\u05e2\u05e8\u05da \u05d0\u05ea \u05d4\u05e2\u05e6\u05d9\u05dd \u05d5\u05d9\u05e0\u05ea\u05d7 \u05d0\u05ea \u05d4\u05e4\u05e8 \u05d5\u05d9\u05e9\u05dd \u05e2\u05dc \u05d4\u05e2\u05e6\u05d9\u05dd"}, {"pk": 2896386, "verse": 34, "text": "\u05dc\u05d3 \u05d5\u05d9\u05d0\u05de\u05e8 \u05de\u05dc\u05d0\u05d5 \u05d0\u05e8\u05d1\u05e2\u05d4 \u05db\u05d3\u05d9\u05dd \u05de\u05d9\u05dd \u05d5\u05d9\u05e6\u05e7\u05d5 \u05e2\u05dc \u05d4\u05e2\u05dc\u05d4 \u05d5\u05e2\u05dc \u05d4\u05e2\u05e6\u05d9\u05dd \u05d5\u05d9\u05d0\u05de\u05e8 \u05e9\u05e0\u05d5 \u05d5\u05d9\u05e9\u05e0\u05d5 \u05d5\u05d9\u05d0\u05de\u05e8 \u05e9\u05dc\u05e9\u05d5 \u05d5\u05d9\u05e9\u05dc\u05e9\u05d5"}, {"pk": 2896387, "verse": 35, "text": "\u05dc\u05d4 \u05d5\u05d9\u05dc\u05db\u05d5 \u05d4\u05de\u05d9\u05dd \u05e1\u05d1\u05d9\u05d1 \u05dc\u05de\u05d6\u05d1\u05d7 \u05d5\u05d2\u05dd \u05d0\u05ea \u05d4\u05ea\u05e2\u05dc\u05d4 \u05de\u05dc\u05d0 \u05de\u05d9\u05dd"}, {"pk": 2896388, "verse": 36, "text": "\u05dc\u05d5 \u05d5\u05d9\u05d4\u05d9 \u05d1\u05e2\u05dc\u05d5\u05ea \u05d4\u05de\u05e0\u05d7\u05d4 \u05d5\u05d9\u05d2\u05e9 \u05d0\u05dc\u05d9\u05d4\u05d5 \u05d4\u05e0\u05d1\u05d9\u05d0 \u05d5\u05d9\u05d0\u05de\u05e8 \u05d9\u05d4\u05d5\u05d4 \u05d0\u05dc\u05d4\u05d9 \u05d0\u05d1\u05e8\u05d4\u05dd \u05d9\u05e6\u05d7\u05e7 \u05d5\u05d9\u05e9\u05e8\u05d0\u05dc \u05d4\u05d9\u05d5\u05dd \u05d9\u05d5\u05d3\u05e2 \u05db\u05d9 \u05d0\u05ea\u05d4 \u05d0\u05dc\u05d4\u05d9\u05dd \u05d1\u05d9\u05e9\u05e8\u05d0\u05dc \u05d5\u05d0\u05e0\u05d9 \u05e2\u05d1\u05d3\u05da \u05d5\u05d1\u05d3\u05d1\u05e8\u05d9\u05da (\u05d5\u05d1\u05d3\u05d1\u05e8\u05da) \u05e2\u05e9\u05d9\u05ea\u05d9 \u05d0\u05ea \u05db\u05dc \u05d4\u05d3\u05d1\u05e8\u05d9\u05dd \u05d4\u05d0\u05dc\u05d4"}, {"pk": 2896389, "verse": 37, "text": "\u05dc\u05d6 \u05e2\u05e0\u05e0\u05d9 \u05d9\u05d4\u05d5\u05d4 \u05e2\u05e0\u05e0\u05d9 \u05d5\u05d9\u05d3\u05e2\u05d5 \u05d4\u05e2\u05dd \u05d4\u05d6\u05d4 \u05db\u05d9 \u05d0\u05ea\u05d4 \u05d9\u05d4\u05d5\u05d4 \u05d4\u05d0\u05dc\u05d4\u05d9\u05dd \u05d5\u05d0\u05ea\u05d4 \u05d4\u05e1\u05d1\u05ea \u05d0\u05ea \u05dc\u05d1\u05dd \u05d0\u05d7\u05e8\u05e0\u05d9\u05ea"}, {"pk": 2896390, "verse": 38, "text": "\u05dc\u05d7 \u05d5\u05ea\u05e4\u05dc \u05d0\u05e9 \u05d9\u05d4\u05d5\u05d4 \u05d5\u05ea\u05d0\u05db\u05dc \u05d0\u05ea \u05d4\u05e2\u05dc\u05d4 \u05d5\u05d0\u05ea \u05d4\u05e2\u05e6\u05d9\u05dd \u05d5\u05d0\u05ea \u05d4\u05d0\u05d1\u05e0\u05d9\u05dd \u05d5\u05d0\u05ea \u05d4\u05e2\u05e4\u05e8 \u05d5\u05d0\u05ea \u05d4\u05de\u05d9\u05dd \u05d0\u05e9\u05e8 \u05d1\u05ea\u05e2\u05dc\u05d4 \u05dc\u05d7\u05db\u05d4"}, {"pk": 2896391, "verse": 39, "text": "\u05dc\u05d8 \u05d5\u05d9\u05e8\u05d0 \u05db\u05dc \u05d4\u05e2\u05dd \u05d5\u05d9\u05e4\u05dc\u05d5 \u05e2\u05dc \u05e4\u05e0\u05d9\u05d4\u05dd \u05d5\u05d9\u05d0\u05de\u05e8\u05d5--\u05d9\u05d4\u05d5\u05d4 \u05d4\u05d5\u05d0 \u05d4\u05d0\u05dc\u05d4\u05d9\u05dd \u05d9\u05d4\u05d5\u05d4 \u05d4\u05d5\u05d0 \u05d4\u05d0\u05dc\u05d4\u05d9\u05dd"}, {"pk": 2896392, "verse": 40, "text": "\u05de \u05d5\u05d9\u05d0\u05de\u05e8 \u05d0\u05dc\u05d9\u05d4\u05d5 \u05dc\u05d4\u05dd \u05ea\u05e4\u05e9\u05d5 \u05d0\u05ea \u05e0\u05d1\u05d9\u05d0\u05d9 \u05d4\u05d1\u05e2\u05dc \u05d0\u05d9\u05e9 \u05d0\u05dc \u05d9\u05de\u05dc\u05d8 \u05de\u05d4\u05dd--\u05d5\u05d9\u05ea\u05e4\u05e9\u05d5\u05dd \u05d5\u05d9\u05d5\u05e8\u05d3\u05dd \u05d0\u05dc\u05d9\u05d4\u05d5 \u05d0\u05dc \u05e0\u05d7\u05dc \u05e7\u05d9\u05e9\u05d5\u05df \u05d5\u05d9\u05e9\u05d7\u05d8\u05dd \u05e9\u05dd"}, {"pk": 2896393, "verse": 41, "text": "\u05de\u05d0 \u05d5\u05d9\u05d0\u05de\u05e8 \u05d0\u05dc\u05d9\u05d4\u05d5 \u05dc\u05d0\u05d7\u05d0\u05d1 \u05e2\u05dc\u05d4 \u05d0\u05db\u05dc \u05d5\u05e9\u05ea\u05d4\u00a0 \u05db\u05d9 \u05e7\u05d5\u05dc \u05d4\u05de\u05d5\u05df \u05d4\u05d2\u05e9\u05dd"}, {"pk": 2896394, "verse": 42, "text": "\u05de\u05d1 \u05d5\u05d9\u05e2\u05dc\u05d4 \u05d0\u05d7\u05d0\u05d1 \u05dc\u05d0\u05db\u05dc \u05d5\u05dc\u05e9\u05ea\u05d5\u05ea \u05d5\u05d0\u05dc\u05d9\u05d4\u05d5 \u05e2\u05dc\u05d4 \u05d0\u05dc \u05e8\u05d0\u05e9 \u05d4\u05db\u05e8\u05de\u05dc \u05d5\u05d9\u05d2\u05d4\u05e8 \u05d0\u05e8\u05e6\u05d4 \u05d5\u05d9\u05e9\u05dd \u05e4\u05e0\u05d9\u05d5 \u05d1\u05d9\u05df \u05d1\u05e8\u05db\u05d5"}, {"pk": 2896395, "verse": 43, "text": "\u05de\u05d2 \u05d5\u05d9\u05d0\u05de\u05e8 \u05d0\u05dc \u05e0\u05e2\u05e8\u05d5 \u05e2\u05dc\u05d4 \u05e0\u05d0 \u05d4\u05d1\u05d8 \u05d3\u05e8\u05da \u05d9\u05dd \u05d5\u05d9\u05e2\u05dc \u05d5\u05d9\u05d1\u05d8 \u05d5\u05d9\u05d0\u05de\u05e8 \u05d0\u05d9\u05df \u05de\u05d0\u05d5\u05de\u05d4 \u05d5\u05d9\u05d0\u05de\u05e8 \u05e9\u05d1 \u05e9\u05d1\u05e2 \u05e4\u05e2\u05de\u05d9\u05dd"}, {"pk": 2896396, "verse": 44, "text": "\u05de\u05d3 \u05d5\u05d9\u05d4\u05d9 \u05d1\u05e9\u05d1\u05e2\u05d9\u05ea \u05d5\u05d9\u05d0\u05de\u05e8 \u05d4\u05e0\u05d4 \u05e2\u05d1 \u05e7\u05d8\u05e0\u05d4 \u05db\u05db\u05e3 \u05d0\u05d9\u05e9 \u05e2\u05dc\u05d4 \u05de\u05d9\u05dd \u05d5\u05d9\u05d0\u05de\u05e8 \u05e2\u05dc\u05d4 \u05d0\u05de\u05e8 \u05d0\u05dc \u05d0\u05d7\u05d0\u05d1 \u05d0\u05e1\u05e8 \u05d5\u05e8\u05d3 \u05d5\u05dc\u05d0 \u05d9\u05e2\u05e6\u05e8\u05db\u05d4 \u05d4\u05d2\u05e9\u05dd"}, {"pk": 2896397, "verse": 45, "text": "\u05de\u05d4 \u05d5\u05d9\u05d4\u05d9 \u05e2\u05d3 \u05db\u05d4 \u05d5\u05e2\u05d3 \u05db\u05d4 \u05d5\u05d4\u05e9\u05de\u05d9\u05dd \u05d4\u05ea\u05e7\u05d3\u05e8\u05d5 \u05e2\u05d1\u05d9\u05dd \u05d5\u05e8\u05d5\u05d7 \u05d5\u05d9\u05d4\u05d9 \u05d2\u05e9\u05dd \u05d2\u05d3\u05d5\u05dc \u05d5\u05d9\u05e8\u05db\u05d1 \u05d0\u05d7\u05d0\u05d1 \u05d5\u05d9\u05dc\u05da \u05d9\u05d6\u05e8\u05e2\u05d0\u05dc\u05d4"}, {"pk": 2896398, "verse": 46, "text": "\u05de\u05d5 \u05d5\u05d9\u05d3 \u05d9\u05d4\u05d5\u05d4 \u05d4\u05d9\u05ea\u05d4 \u05d0\u05dc \u05d0\u05dc\u05d9\u05d4\u05d5 \u05d5\u05d9\u05e9\u05e0\u05e1 \u05de\u05ea\u05e0\u05d9\u05d5 \u05d5\u05d9\u05e8\u05e5 \u05dc\u05e4\u05e0\u05d9 \u05d0\u05d7\u05d0\u05d1 \u05e2\u05d3 \u05d1\u05d0\u05db\u05d4 \u05d9\u05d6\u05e8\u05e2\u05d0\u05dc\u05d4"}]