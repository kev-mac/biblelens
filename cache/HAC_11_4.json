[{"pk": 2895870, "verse": 1, "text": "\u05d0 \u05d5\u05d9\u05d4\u05d9 \u05d4\u05de\u05dc\u05da \u05e9\u05dc\u05de\u05d4 \u05de\u05dc\u05da \u05e2\u05dc \u05db\u05dc \u05d9\u05e9\u05e8\u05d0\u05dc\u00a0 {\u05e1}"}, {"pk": 2895871, "verse": 2, "text": "\u05d1 \u05d5\u05d0\u05dc\u05d4 \u05d4\u05e9\u05e8\u05d9\u05dd \u05d0\u05e9\u05e8 \u05dc\u05d5\u00a0 \u05e2\u05d6\u05e8\u05d9\u05d4\u05d5 \u05d1\u05df \u05e6\u05d3\u05d5\u05e7 \u05d4\u05db\u05d4\u05df\u00a0 {\u05e1}"}, {"pk": 2895872, "verse": 3, "text": "\u05d2 \u05d0\u05dc\u05d9\u05d7\u05e8\u05e3 \u05d5\u05d0\u05d7\u05d9\u05d4 \u05d1\u05e0\u05d9 \u05e9\u05d9\u05e9\u05d0 \u05e1\u05e4\u05e8\u05d9\u05dd\u00a0 {\u05e1}\u00a0 \u05d9\u05d4\u05d5\u05e9\u05e4\u05d8 \u05d1\u05df \u05d0\u05d7\u05d9\u05dc\u05d5\u05d3 \u05d4\u05de\u05d6\u05db\u05d9\u05e8\u00a0 {\u05e1}"}, {"pk": 2895873, "verse": 4, "text": "\u05d3 \u05d5\u05d1\u05e0\u05d9\u05d4\u05d5 \u05d1\u05df \u05d9\u05d4\u05d5\u05d9\u05d3\u05e2 \u05e2\u05dc \u05d4\u05e6\u05d1\u05d0\u00a0 {\u05e1}\u00a0 \u05d5\u05e6\u05d3\u05d5\u05e7 \u05d5\u05d0\u05d1\u05d9\u05ea\u05e8 \u05db\u05d4\u05e0\u05d9\u05dd\u00a0 {\u05e1}"}, {"pk": 2895874, "verse": 5, "text": "\u05d4 \u05d5\u05e2\u05d6\u05e8\u05d9\u05d4\u05d5 \u05d1\u05df \u05e0\u05ea\u05df \u05e2\u05dc \u05d4\u05e0\u05e6\u05d1\u05d9\u05dd\u00a0 {\u05e1}\u00a0 \u05d5\u05d6\u05d1\u05d5\u05d3 \u05d1\u05df \u05e0\u05ea\u05df \u05db\u05d4\u05df \u05e8\u05e2\u05d4 \u05d4\u05de\u05dc\u05da\u00a0 {\u05e1}"}, {"pk": 2895875, "verse": 6, "text": "\u05d5 \u05d5\u05d0\u05d7\u05d9\u05e9\u05e8 \u05e2\u05dc \u05d4\u05d1\u05d9\u05ea\u00a0 {\u05e1}\u00a0 \u05d5\u05d0\u05d3\u05e0\u05d9\u05e8\u05dd \u05d1\u05df \u05e2\u05d1\u05d3\u05d0 \u05e2\u05dc \u05d4\u05de\u05e1\u00a0 {\u05e1}"}, {"pk": 2895876, "verse": 7, "text": "\u05d6 \u05d5\u05dc\u05e9\u05dc\u05de\u05d4 \u05e9\u05e0\u05d9\u05dd \u05e2\u05e9\u05e8 \u05e0\u05e6\u05d1\u05d9\u05dd \u05e2\u05dc \u05db\u05dc \u05d9\u05e9\u05e8\u05d0\u05dc \u05d5\u05db\u05dc\u05db\u05dc\u05d5 \u05d0\u05ea \u05d4\u05de\u05dc\u05da \u05d5\u05d0\u05ea \u05d1\u05d9\u05ea\u05d5\u00a0 \u05d7\u05d3\u05e9 \u05d1\u05e9\u05e0\u05d4 \u05d9\u05d4\u05d9\u05d4 \u05e2\u05dc \u05d0\u05d7\u05d3 (\u05d4\u05d0\u05d7\u05d3) \u05dc\u05db\u05dc\u05db\u05dc\u00a0 {\u05e1}"}, {"pk": 2895877, "verse": 8, "text": "\u05d7 \u05d5\u05d0\u05dc\u05d4 \u05e9\u05de\u05d5\u05ea\u05dd \u05d1\u05df \u05d7\u05d5\u05e8 \u05d1\u05d4\u05e8 \u05d0\u05e4\u05e8\u05d9\u05dd\u00a0 {\u05e1}"}, {"pk": 2895878, "verse": 9, "text": "\u05d8 \u05d1\u05df \u05d3\u05e7\u05e8 \u05d1\u05de\u05e7\u05e5 \u05d5\u05d1\u05e9\u05e2\u05dc\u05d1\u05d9\u05dd \u05d5\u05d1\u05d9\u05ea \u05e9\u05de\u05e9 \u05d5\u05d0\u05d9\u05dc\u05d5\u05df \u05d1\u05d9\u05ea \u05d7\u05e0\u05df\u00a0 {\u05e1}"}, {"pk": 2895879, "verse": 10, "text": "\u05d9 \u05d1\u05df \u05d7\u05e1\u05d3 \u05d1\u05d0\u05e8\u05d1\u05d5\u05ea \u05dc\u05d5 \u05e9\u05db\u05d4 \u05d5\u05db\u05dc \u05d0\u05e8\u05e5 \u05d7\u05e4\u05e8\u00a0 {\u05e1}"}, {"pk": 2895880, "verse": 11, "text": "\u05d9\u05d0 \u05d1\u05df \u05d0\u05d1\u05d9\u05e0\u05d3\u05d1 \u05db\u05dc \u05e0\u05e4\u05ea \u05d3\u05d0\u05e8 \u05d8\u05e4\u05ea \u05d1\u05ea \u05e9\u05dc\u05de\u05d4 \u05d4\u05d9\u05ea\u05d4 \u05dc\u05d5 \u05dc\u05d0\u05e9\u05d4\u00a0 {\u05e1}"}, {"pk": 2895881, "verse": 12, "text": "\u05d9\u05d1 \u05d1\u05e2\u05e0\u05d0 \u05d1\u05df \u05d0\u05d7\u05d9\u05dc\u05d5\u05d3 \u05ea\u05e2\u05e0\u05da \u05d5\u05de\u05d2\u05d3\u05d5 \u05d5\u05db\u05dc \u05d1\u05d9\u05ea \u05e9\u05d0\u05df \u05d0\u05e9\u05e8 \u05d0\u05e6\u05dc \u05e6\u05e8\u05ea\u05e0\u05d4 \u05de\u05ea\u05d7\u05ea \u05dc\u05d9\u05d6\u05e8\u05e2\u05d0\u05dc \u05de\u05d1\u05d9\u05ea \u05e9\u05d0\u05df \u05e2\u05d3 \u05d0\u05d1\u05dc \u05de\u05d7\u05d5\u05dc\u05d4 \u05e2\u05d3 \u05de\u05e2\u05d1\u05e8 \u05dc\u05d9\u05e7\u05de\u05e2\u05dd\u00a0 {\u05e1}"}, {"pk": 2895882, "verse": 13, "text": "\u05d9\u05d2 \u05d1\u05df \u05d2\u05d1\u05e8 \u05d1\u05e8\u05de\u05ea \u05d2\u05dc\u05e2\u05d3 \u05dc\u05d5 \u05d7\u05d5\u05ea \u05d9\u05d0\u05d9\u05e8 \u05d1\u05df \u05de\u05e0\u05e9\u05d4 \u05d0\u05e9\u05e8 \u05d1\u05d2\u05dc\u05e2\u05d3 \u05dc\u05d5 \u05d7\u05d1\u05dc \u05d0\u05e8\u05d2\u05d1 \u05d0\u05e9\u05e8 \u05d1\u05d1\u05e9\u05df--\u05e9\u05e9\u05d9\u05dd \u05e2\u05e8\u05d9\u05dd \u05d2\u05d3\u05dc\u05d5\u05ea \u05d7\u05d5\u05de\u05d4 \u05d5\u05d1\u05e8\u05d9\u05d7 \u05e0\u05d7\u05e9\u05ea\u00a0 {\u05e1}"}, {"pk": 2895883, "verse": 14, "text": "\u05d9\u05d3 \u05d0\u05d7\u05d9\u05e0\u05d3\u05d1 \u05d1\u05df \u05e2\u05d3\u05d0 \u05de\u05d7\u05e0\u05d9\u05de\u05d4\u00a0 {\u05e1}"}, {"pk": 2895884, "verse": 15, "text": "\u05d8\u05d5 \u05d0\u05d7\u05d9\u05de\u05e2\u05e5 \u05d1\u05e0\u05e4\u05ea\u05dc\u05d9 \u05d2\u05dd \u05d4\u05d5\u05d0 \u05dc\u05e7\u05d7 \u05d0\u05ea \u05d1\u05e9\u05de\u05ea \u05d1\u05ea \u05e9\u05dc\u05de\u05d4--\u05dc\u05d0\u05e9\u05d4\u00a0 {\u05e1}"}, {"pk": 2895885, "verse": 16, "text": "\u05d8\u05d6 \u05d1\u05e2\u05e0\u05d0 \u05d1\u05df \u05d7\u05d5\u05e9\u05d9 \u05d1\u05d0\u05e9\u05e8 \u05d5\u05d1\u05e2\u05dc\u05d5\u05ea\u00a0 {\u05e1}"}, {"pk": 2895886, "verse": 17, "text": "\u05d9\u05d6 \u05d9\u05d4\u05d5\u05e9\u05e4\u05d8 \u05d1\u05df \u05e4\u05e8\u05d5\u05d7 \u05d1\u05d9\u05e9\u05e9\u05db\u05e8\u00a0 {\u05e1}"}, {"pk": 2895887, "verse": 18, "text": "\u05d9\u05d7 \u05e9\u05de\u05e2\u05d9 \u05d1\u05df \u05d0\u05dc\u05d0 \u05d1\u05d1\u05e0\u05d9\u05de\u05df\u00a0 {\u05e1}"}, {"pk": 2895888, "verse": 19, "text": "\u05d9\u05d8 \u05d2\u05d1\u05e8 \u05d1\u05df \u05d0\u05e8\u05d9 \u05d1\u05d0\u05e8\u05e5 \u05d2\u05dc\u05e2\u05d3--\u05d0\u05e8\u05e5 \u05e1\u05d9\u05d7\u05d5\u05df \u05de\u05dc\u05da \u05d4\u05d0\u05de\u05e8\u05d9 \u05d5\u05e2\u05d2 \u05de\u05dc\u05da \u05d4\u05d1\u05e9\u05df \u05d5\u05e0\u05e6\u05d9\u05d1 \u05d0\u05d7\u05d3 \u05d0\u05e9\u05e8 \u05d1\u05d0\u05e8\u05e5"}, {"pk": 2895889, "verse": 20, "text": "\u05db \u05d9\u05d4\u05d5\u05d3\u05d4 \u05d5\u05d9\u05e9\u05e8\u05d0\u05dc \u05e8\u05d1\u05d9\u05dd \u05db\u05d7\u05d5\u05dc \u05d0\u05e9\u05e8 \u05e2\u05dc \u05d4\u05d9\u05dd \u05dc\u05e8\u05d1 \u05d0\u05db\u05dc\u05d9\u05dd \u05d5\u05e9\u05ea\u05d9\u05dd \u05d5\u05e9\u05de\u05d7\u05d9\u05dd"}]