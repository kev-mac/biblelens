[{"pk": 2896492, "verse": 1, "text": "\u05d0 \u05d5\u05d9\u05e9\u05d1\u05d5 \u05e9\u05dc\u05e9 \u05e9\u05e0\u05d9\u05dd\u00a0 \u05d0\u05d9\u05df \u05de\u05dc\u05d7\u05de\u05d4 \u05d1\u05d9\u05df \u05d0\u05e8\u05dd \u05d5\u05d1\u05d9\u05df \u05d9\u05e9\u05e8\u05d0\u05dc\u00a0 {\u05e4}"}, {"pk": 2896493, "verse": 2, "text": "\u05d1 \u05d5\u05d9\u05d4\u05d9 \u05d1\u05e9\u05e0\u05d4 \u05d4\u05e9\u05dc\u05d9\u05e9\u05d9\u05ea \u05d5\u05d9\u05e8\u05d3 \u05d9\u05d4\u05d5\u05e9\u05e4\u05d8 \u05de\u05dc\u05da \u05d9\u05d4\u05d5\u05d3\u05d4 \u05d0\u05dc \u05de\u05dc\u05da \u05d9\u05e9\u05e8\u05d0\u05dc"}, {"pk": 2896494, "verse": 3, "text": "\u05d2 \u05d5\u05d9\u05d0\u05de\u05e8 \u05de\u05dc\u05da \u05d9\u05e9\u05e8\u05d0\u05dc \u05d0\u05dc \u05e2\u05d1\u05d3\u05d9\u05d5 \u05d4\u05d9\u05d3\u05e2\u05ea\u05dd \u05db\u05d9 \u05dc\u05e0\u05d5 \u05e8\u05de\u05ea \u05d2\u05dc\u05e2\u05d3 \u05d5\u05d0\u05e0\u05d7\u05e0\u05d5 \u05de\u05d7\u05e9\u05d9\u05dd--\u05de\u05e7\u05d7\u05ea \u05d0\u05ea\u05d4 \u05de\u05d9\u05d3 \u05de\u05dc\u05da \u05d0\u05e8\u05dd"}, {"pk": 2896495, "verse": 4, "text": "\u05d3 \u05d5\u05d9\u05d0\u05de\u05e8 \u05d0\u05dc \u05d9\u05d4\u05d5\u05e9\u05e4\u05d8 \u05d4\u05ea\u05dc\u05da \u05d0\u05ea\u05d9 \u05dc\u05de\u05dc\u05d7\u05de\u05d4 \u05e8\u05de\u05ea \u05d2\u05dc\u05e2\u05d3 \u05d5\u05d9\u05d0\u05de\u05e8 \u05d9\u05d4\u05d5\u05e9\u05e4\u05d8 \u05d0\u05dc \u05de\u05dc\u05da \u05d9\u05e9\u05e8\u05d0\u05dc \u05db\u05de\u05d5\u05e0\u05d9 \u05db\u05de\u05d5\u05da \u05db\u05e2\u05de\u05d9 \u05db\u05e2\u05de\u05da \u05db\u05e1\u05d5\u05e1\u05d9 \u05db\u05e1\u05d5\u05e1\u05d9\u05da"}, {"pk": 2896496, "verse": 5, "text": "\u05d4 \u05d5\u05d9\u05d0\u05de\u05e8 \u05d9\u05d4\u05d5\u05e9\u05e4\u05d8 \u05d0\u05dc \u05de\u05dc\u05da \u05d9\u05e9\u05e8\u05d0\u05dc\u00a0 \u05d3\u05e8\u05e9 \u05e0\u05d0 \u05db\u05d9\u05d5\u05dd \u05d0\u05ea \u05d3\u05d1\u05e8 \u05d9\u05d4\u05d5\u05d4"}, {"pk": 2896497, "verse": 6, "text": "\u05d5 \u05d5\u05d9\u05e7\u05d1\u05e5 \u05de\u05dc\u05da \u05d9\u05e9\u05e8\u05d0\u05dc \u05d0\u05ea \u05d4\u05e0\u05d1\u05d9\u05d0\u05d9\u05dd \u05db\u05d0\u05e8\u05d1\u05e2 \u05de\u05d0\u05d5\u05ea \u05d0\u05d9\u05e9 \u05d5\u05d9\u05d0\u05de\u05e8 \u05d0\u05dc\u05d4\u05dd \u05d4\u05d0\u05dc\u05da \u05e2\u05dc \u05e8\u05de\u05ea \u05d2\u05dc\u05e2\u05d3 \u05dc\u05de\u05dc\u05d7\u05de\u05d4 \u05d0\u05dd \u05d0\u05d7\u05d3\u05dc \u05d5\u05d9\u05d0\u05de\u05e8\u05d5 \u05e2\u05dc\u05d4 \u05d5\u05d9\u05ea\u05df \u05d0\u05d3\u05e0\u05d9 \u05d1\u05d9\u05d3 \u05d4\u05de\u05dc\u05da"}, {"pk": 2896498, "verse": 7, "text": "\u05d6 \u05d5\u05d9\u05d0\u05de\u05e8 \u05d9\u05d4\u05d5\u05e9\u05e4\u05d8 \u05d4\u05d0\u05d9\u05df \u05e4\u05d4 \u05e0\u05d1\u05d9\u05d0 \u05dc\u05d9\u05d4\u05d5\u05d4 \u05e2\u05d5\u05d3 \u05d5\u05e0\u05d3\u05e8\u05e9\u05d4 \u05de\u05d0\u05ea\u05d5"}, {"pk": 2896499, "verse": 8, "text": "\u05d7 \u05d5\u05d9\u05d0\u05de\u05e8 \u05de\u05dc\u05da \u05d9\u05e9\u05e8\u05d0\u05dc \u05d0\u05dc \u05d9\u05d4\u05d5\u05e9\u05e4\u05d8 \u05e2\u05d5\u05d3 \u05d0\u05d9\u05e9 \u05d0\u05d7\u05d3 \u05dc\u05d3\u05e8\u05e9 \u05d0\u05ea \u05d9\u05d4\u05d5\u05d4 \u05de\u05d0\u05ea\u05d5 \u05d5\u05d0\u05e0\u05d9 \u05e9\u05e0\u05d0\u05ea\u05d9\u05d5 \u05db\u05d9 \u05dc\u05d0 \u05d9\u05ea\u05e0\u05d1\u05d0 \u05e2\u05dc\u05d9 \u05d8\u05d5\u05d1 \u05db\u05d9 \u05d0\u05dd \u05e8\u05e2--\u05de\u05d9\u05db\u05d9\u05d4\u05d5 \u05d1\u05df \u05d9\u05de\u05dc\u05d4 \u05d5\u05d9\u05d0\u05de\u05e8 \u05d9\u05d4\u05d5\u05e9\u05e4\u05d8 \u05d0\u05dc \u05d9\u05d0\u05de\u05e8 \u05d4\u05de\u05dc\u05da \u05db\u05df"}, {"pk": 2896500, "verse": 9, "text": "\u05d8 \u05d5\u05d9\u05e7\u05e8\u05d0 \u05de\u05dc\u05da \u05d9\u05e9\u05e8\u05d0\u05dc \u05d0\u05dc \u05e1\u05e8\u05d9\u05e1 \u05d0\u05d7\u05d3 \u05d5\u05d9\u05d0\u05de\u05e8 \u05de\u05d4\u05e8\u05d4 \u05de\u05d9\u05db\u05d9\u05d4\u05d5 \u05d1\u05df \u05d9\u05de\u05dc\u05d4"}, {"pk": 2896501, "verse": 10, "text": "\u05d9 \u05d5\u05de\u05dc\u05da \u05d9\u05e9\u05e8\u05d0\u05dc \u05d5\u05d9\u05d4\u05d5\u05e9\u05e4\u05d8 \u05de\u05dc\u05da \u05d9\u05d4\u05d5\u05d3\u05d4 \u05d9\u05e9\u05d1\u05d9\u05dd \u05d0\u05d9\u05e9 \u05e2\u05dc \u05db\u05e1\u05d0\u05d5 \u05de\u05dc\u05d1\u05e9\u05d9\u05dd \u05d1\u05d2\u05d3\u05d9\u05dd \u05d1\u05d2\u05e8\u05df \u05e4\u05ea\u05d7 \u05e9\u05e2\u05e8 \u05e9\u05de\u05e8\u05d5\u05df \u05d5\u05db\u05dc \u05d4\u05e0\u05d1\u05d9\u05d0\u05d9\u05dd--\u05de\u05ea\u05e0\u05d1\u05d0\u05d9\u05dd \u05dc\u05e4\u05e0\u05d9\u05d4\u05dd"}, {"pk": 2896502, "verse": 11, "text": "\u05d9\u05d0 \u05d5\u05d9\u05e2\u05e9 \u05dc\u05d5 \u05e6\u05d3\u05e7\u05d9\u05d4 \u05d1\u05df \u05db\u05e0\u05e2\u05e0\u05d4 \u05e7\u05e8\u05e0\u05d9 \u05d1\u05e8\u05d6\u05dc \u05d5\u05d9\u05d0\u05de\u05e8 \u05db\u05d4 \u05d0\u05de\u05e8 \u05d9\u05d4\u05d5\u05d4 \u05d1\u05d0\u05dc\u05d4 \u05ea\u05e0\u05d2\u05d7 \u05d0\u05ea \u05d0\u05e8\u05dd \u05e2\u05d3 \u05db\u05dc\u05ea\u05dd"}, {"pk": 2896503, "verse": 12, "text": "\u05d9\u05d1 \u05d5\u05db\u05dc \u05d4\u05e0\u05d1\u05d0\u05d9\u05dd--\u05e0\u05d1\u05d0\u05d9\u05dd \u05db\u05df \u05dc\u05d0\u05de\u05e8\u00a0 \u05e2\u05dc\u05d4 \u05e8\u05de\u05ea \u05d2\u05dc\u05e2\u05d3 \u05d5\u05d4\u05e6\u05dc\u05d7 \u05d5\u05e0\u05ea\u05df \u05d9\u05d4\u05d5\u05d4 \u05d1\u05d9\u05d3 \u05d4\u05de\u05dc\u05da"}, {"pk": 2896504, "verse": 13, "text": "\u05d9\u05d2 \u05d5\u05d4\u05de\u05dc\u05d0\u05da \u05d0\u05e9\u05e8 \u05d4\u05dc\u05da \u05dc\u05e7\u05e8\u05d0 \u05de\u05d9\u05db\u05d9\u05d4\u05d5 \u05d3\u05d1\u05e8 \u05d0\u05dc\u05d9\u05d5 \u05dc\u05d0\u05de\u05e8 \u05d4\u05e0\u05d4 \u05e0\u05d0 \u05d3\u05d1\u05e8\u05d9 \u05d4\u05e0\u05d1\u05d9\u05d0\u05d9\u05dd \u05e4\u05d4 \u05d0\u05d7\u05d3 \u05d8\u05d5\u05d1 \u05d0\u05dc \u05d4\u05de\u05dc\u05da \u05d9\u05d4\u05d9 \u05e0\u05d0 \u05d3\u05d1\u05e8\u05d9\u05da (\u05d3\u05d1\u05e8\u05da) \u05db\u05d3\u05d1\u05e8 \u05d0\u05d7\u05d3 \u05de\u05d4\u05dd--\u05d5\u05d3\u05d1\u05e8\u05ea \u05d8\u05d5\u05d1"}, {"pk": 2896505, "verse": 14, "text": "\u05d9\u05d3 \u05d5\u05d9\u05d0\u05de\u05e8 \u05de\u05d9\u05db\u05d9\u05d4\u05d5\u00a0 \u05d7\u05d9 \u05d9\u05d4\u05d5\u05d4--\u05db\u05d9 \u05d0\u05ea \u05d0\u05e9\u05e8 \u05d9\u05d0\u05de\u05e8 \u05d9\u05d4\u05d5\u05d4 \u05d0\u05dc\u05d9 \u05d0\u05ea\u05d5 \u05d0\u05d3\u05d1\u05e8"}, {"pk": 2896506, "verse": 15, "text": "\u05d8\u05d5 \u05d5\u05d9\u05d1\u05d5\u05d0 \u05d0\u05dc \u05d4\u05de\u05dc\u05da \u05d5\u05d9\u05d0\u05de\u05e8 \u05d4\u05de\u05dc\u05da \u05d0\u05dc\u05d9\u05d5 \u05de\u05d9\u05db\u05d9\u05d4\u05d5 \u05d4\u05e0\u05dc\u05da \u05d0\u05dc \u05e8\u05de\u05ea \u05d2\u05dc\u05e2\u05d3 \u05dc\u05de\u05dc\u05d7\u05de\u05d4 \u05d0\u05dd \u05e0\u05d7\u05d3\u05dc \u05d5\u05d9\u05d0\u05de\u05e8 \u05d0\u05dc\u05d9\u05d5 \u05e2\u05dc\u05d4 \u05d5\u05d4\u05e6\u05dc\u05d7 \u05d5\u05e0\u05ea\u05df \u05d9\u05d4\u05d5\u05d4 \u05d1\u05d9\u05d3 \u05d4\u05de\u05dc\u05da"}, {"pk": 2896507, "verse": 16, "text": "\u05d8\u05d6 \u05d5\u05d9\u05d0\u05de\u05e8 \u05d0\u05dc\u05d9\u05d5 \u05d4\u05de\u05dc\u05da \u05e2\u05d3 \u05db\u05de\u05d4 \u05e4\u05e2\u05de\u05d9\u05dd \u05d0\u05e0\u05d9 \u05de\u05e9\u05d1\u05d9\u05e2\u05da\u00a0 \u05d0\u05e9\u05e8 \u05dc\u05d0 \u05ea\u05d3\u05d1\u05e8 \u05d0\u05dc\u05d9 \u05e8\u05e7 \u05d0\u05de\u05ea--\u05d1\u05e9\u05dd \u05d9\u05d4\u05d5\u05d4"}, {"pk": 2896508, "verse": 17, "text": "\u05d9\u05d6 \u05d5\u05d9\u05d0\u05de\u05e8 \u05e8\u05d0\u05d9\u05ea\u05d9 \u05d0\u05ea \u05db\u05dc \u05d9\u05e9\u05e8\u05d0\u05dc \u05e0\u05e4\u05e6\u05d9\u05dd \u05d0\u05dc \u05d4\u05d4\u05e8\u05d9\u05dd \u05db\u05e6\u05d0\u05df \u05d0\u05e9\u05e8 \u05d0\u05d9\u05df \u05dc\u05d4\u05dd \u05e8\u05e2\u05d4 \u05d5\u05d9\u05d0\u05de\u05e8 \u05d9\u05d4\u05d5\u05d4 \u05dc\u05d0 \u05d0\u05d3\u05e0\u05d9\u05dd \u05dc\u05d0\u05dc\u05d4 \u05d9\u05e9\u05d5\u05d1\u05d5 \u05d0\u05d9\u05e9 \u05dc\u05d1\u05d9\u05ea\u05d5 \u05d1\u05e9\u05dc\u05d5\u05dd"}, {"pk": 2896509, "verse": 18, "text": "\u05d9\u05d7 \u05d5\u05d9\u05d0\u05de\u05e8 \u05de\u05dc\u05da \u05d9\u05e9\u05e8\u05d0\u05dc \u05d0\u05dc \u05d9\u05d4\u05d5\u05e9\u05e4\u05d8\u00a0 \u05d4\u05dc\u05d5\u05d0 \u05d0\u05de\u05e8\u05ea\u05d9 \u05d0\u05dc\u05d9\u05da \u05dc\u05d5\u05d0 \u05d9\u05ea\u05e0\u05d1\u05d0 \u05e2\u05dc\u05d9 \u05d8\u05d5\u05d1 \u05db\u05d9 \u05d0\u05dd \u05e8\u05e2\u00a0 {\u05e1}"}, {"pk": 2896510, "verse": 19, "text": "\u05d9\u05d8 \u05d5\u05d9\u05d0\u05de\u05e8 \u05dc\u05db\u05df \u05e9\u05de\u05e2 \u05d3\u05d1\u05e8 \u05d9\u05d4\u05d5\u05d4 \u05e8\u05d0\u05d9\u05ea\u05d9 \u05d0\u05ea \u05d9\u05d4\u05d5\u05d4 \u05d9\u05e9\u05d1 \u05e2\u05dc \u05db\u05e1\u05d0\u05d5 \u05d5\u05db\u05dc \u05e6\u05d1\u05d0 \u05d4\u05e9\u05de\u05d9\u05dd \u05e2\u05de\u05d3 \u05e2\u05dc\u05d9\u05d5 \u05de\u05d9\u05de\u05d9\u05e0\u05d5 \u05d5\u05de\u05e9\u05de\u05d0\u05dc\u05d5"}, {"pk": 2896511, "verse": 20, "text": "\u05db \u05d5\u05d9\u05d0\u05de\u05e8 \u05d9\u05d4\u05d5\u05d4 \u05de\u05d9 \u05d9\u05e4\u05ea\u05d4 \u05d0\u05ea \u05d0\u05d7\u05d0\u05d1 \u05d5\u05d9\u05e2\u05dc \u05d5\u05d9\u05e4\u05dc \u05d1\u05e8\u05de\u05ea \u05d2\u05dc\u05e2\u05d3 \u05d5\u05d9\u05d0\u05de\u05e8 \u05d6\u05d4 \u05d1\u05db\u05d4 \u05d5\u05d6\u05d4 \u05d0\u05de\u05e8 \u05d1\u05db\u05d4"}, {"pk": 2896512, "verse": 21, "text": "\u05db\u05d0 \u05d5\u05d9\u05e6\u05d0 \u05d4\u05e8\u05d5\u05d7 \u05d5\u05d9\u05e2\u05de\u05d3 \u05dc\u05e4\u05e0\u05d9 \u05d9\u05d4\u05d5\u05d4 \u05d5\u05d9\u05d0\u05de\u05e8 \u05d0\u05e0\u05d9 \u05d0\u05e4\u05ea\u05e0\u05d5 \u05d5\u05d9\u05d0\u05de\u05e8 \u05d9\u05d4\u05d5\u05d4 \u05d0\u05dc\u05d9\u05d5 \u05d1\u05de\u05d4"}, {"pk": 2896513, "verse": 22, "text": "\u05db\u05d1 \u05d5\u05d9\u05d0\u05de\u05e8 \u05d0\u05e6\u05d0 \u05d5\u05d4\u05d9\u05d9\u05ea\u05d9 \u05e8\u05d5\u05d7 \u05e9\u05e7\u05e8 \u05d1\u05e4\u05d9 \u05db\u05dc \u05e0\u05d1\u05d9\u05d0\u05d9\u05d5 \u05d5\u05d9\u05d0\u05de\u05e8 \u05ea\u05e4\u05ea\u05d4 \u05d5\u05d2\u05dd \u05ea\u05d5\u05db\u05dc--\u05e6\u05d0 \u05d5\u05e2\u05e9\u05d4 \u05db\u05df"}, {"pk": 2896514, "verse": 23, "text": "\u05db\u05d2 \u05d5\u05e2\u05ea\u05d4 \u05d4\u05e0\u05d4 \u05e0\u05ea\u05df \u05d9\u05d4\u05d5\u05d4 \u05e8\u05d5\u05d7 \u05e9\u05e7\u05e8 \u05d1\u05e4\u05d9 \u05db\u05dc \u05e0\u05d1\u05d9\u05d0\u05d9\u05da \u05d0\u05dc\u05d4 \u05d5\u05d9\u05d4\u05d5\u05d4 \u05d3\u05d1\u05e8 \u05e2\u05dc\u05d9\u05da \u05e8\u05e2\u05d4"}, {"pk": 2896515, "verse": 24, "text": "\u05db\u05d3 \u05d5\u05d9\u05d2\u05e9 \u05e6\u05d3\u05e7\u05d9\u05d4\u05d5 \u05d1\u05df \u05db\u05e0\u05e2\u05e0\u05d4 \u05d5\u05d9\u05db\u05d4 \u05d0\u05ea \u05de\u05d9\u05db\u05d9\u05d4\u05d5 \u05e2\u05dc \u05d4\u05dc\u05d7\u05d9 \u05d5\u05d9\u05d0\u05de\u05e8 \u05d0\u05d9 \u05d6\u05d4 \u05e2\u05d1\u05e8 \u05e8\u05d5\u05d7 \u05d9\u05d4\u05d5\u05d4 \u05de\u05d0\u05ea\u05d9 \u05dc\u05d3\u05d1\u05e8 \u05d0\u05d5\u05ea\u05da"}, {"pk": 2896516, "verse": 25, "text": "\u05db\u05d4 \u05d5\u05d9\u05d0\u05de\u05e8 \u05de\u05d9\u05db\u05d9\u05d4\u05d5 \u05d4\u05e0\u05da \u05e8\u05d0\u05d4 \u05d1\u05d9\u05d5\u05dd \u05d4\u05d4\u05d5\u05d0 \u05d0\u05e9\u05e8 \u05ea\u05d1\u05d0 \u05d7\u05d3\u05e8 \u05d1\u05d7\u05d3\u05e8 \u05dc\u05d4\u05d7\u05d1\u05d4"}, {"pk": 2896517, "verse": 26, "text": "\u05db\u05d5 \u05d5\u05d9\u05d0\u05de\u05e8 \u05de\u05dc\u05da \u05d9\u05e9\u05e8\u05d0\u05dc \u05e7\u05d7 \u05d0\u05ea \u05de\u05d9\u05db\u05d9\u05d4\u05d5 \u05d5\u05d4\u05e9\u05d9\u05d1\u05d4\u05d5 \u05d0\u05dc \u05d0\u05de\u05df \u05e9\u05e8 \u05d4\u05e2\u05d9\u05e8 \u05d5\u05d0\u05dc \u05d9\u05d5\u05d0\u05e9 \u05d1\u05df \u05d4\u05de\u05dc\u05da"}, {"pk": 2896518, "verse": 27, "text": "\u05db\u05d6 \u05d5\u05d0\u05de\u05e8\u05ea \u05db\u05d4 \u05d0\u05de\u05e8 \u05d4\u05de\u05dc\u05da \u05e9\u05d9\u05de\u05d5 \u05d0\u05ea \u05d6\u05d4 \u05d1\u05d9\u05ea \u05d4\u05db\u05dc\u05d0 \u05d5\u05d4\u05d0\u05db\u05dc\u05d4\u05d5 \u05dc\u05d7\u05dd \u05dc\u05d7\u05e5 \u05d5\u05de\u05d9\u05dd \u05dc\u05d7\u05e5 \u05e2\u05d3 \u05d1\u05d0\u05d9 \u05d1\u05e9\u05dc\u05d5\u05dd"}, {"pk": 2896519, "verse": 28, "text": "\u05db\u05d7 \u05d5\u05d9\u05d0\u05de\u05e8 \u05de\u05d9\u05db\u05d9\u05d4\u05d5--\u05d0\u05dd \u05e9\u05d5\u05d1 \u05ea\u05e9\u05d5\u05d1 \u05d1\u05e9\u05dc\u05d5\u05dd \u05dc\u05d0 \u05d3\u05d1\u05e8 \u05d9\u05d4\u05d5\u05d4 \u05d1\u05d9 \u05d5\u05d9\u05d0\u05de\u05e8 \u05e9\u05de\u05e2\u05d5 \u05e2\u05de\u05d9\u05dd \u05db\u05dc\u05dd"}, {"pk": 2896520, "verse": 29, "text": "\u05db\u05d8 \u05d5\u05d9\u05e2\u05dc \u05de\u05dc\u05da \u05d9\u05e9\u05e8\u05d0\u05dc \u05d5\u05d9\u05d4\u05d5\u05e9\u05e4\u05d8 \u05de\u05dc\u05da \u05d9\u05d4\u05d5\u05d3\u05d4 \u05e8\u05de\u05ea \u05d2\u05dc\u05e2\u05d3"}, {"pk": 2896521, "verse": 30, "text": "\u05dc \u05d5\u05d9\u05d0\u05de\u05e8 \u05de\u05dc\u05da \u05d9\u05e9\u05e8\u05d0\u05dc \u05d0\u05dc \u05d9\u05d4\u05d5\u05e9\u05e4\u05d8 \u05d4\u05ea\u05d7\u05e4\u05e9 \u05d5\u05d1\u05d0 \u05d1\u05de\u05dc\u05d7\u05de\u05d4 \u05d5\u05d0\u05ea\u05d4 \u05dc\u05d1\u05e9 \u05d1\u05d2\u05d3\u05d9\u05da \u05d5\u05d9\u05ea\u05d7\u05e4\u05e9 \u05de\u05dc\u05da \u05d9\u05e9\u05e8\u05d0\u05dc \u05d5\u05d9\u05d1\u05d5\u05d0 \u05d1\u05de\u05dc\u05d7\u05de\u05d4"}, {"pk": 2896522, "verse": 31, "text": "\u05dc\u05d0 \u05d5\u05de\u05dc\u05da \u05d0\u05e8\u05dd \u05e6\u05d5\u05d4 \u05d0\u05ea \u05e9\u05e8\u05d9 \u05d4\u05e8\u05db\u05d1 \u05d0\u05e9\u05e8 \u05dc\u05d5 \u05e9\u05dc\u05e9\u05d9\u05dd \u05d5\u05e9\u05e0\u05d9\u05dd \u05dc\u05d0\u05de\u05e8 \u05dc\u05d0 \u05ea\u05dc\u05d7\u05de\u05d5 \u05d0\u05ea \u05e7\u05d8\u05df \u05d5\u05d0\u05ea \u05d2\u05d3\u05d5\u05dc\u00a0 \u05db\u05d9 \u05d0\u05dd \u05d0\u05ea \u05de\u05dc\u05da \u05d9\u05e9\u05e8\u05d0\u05dc \u05dc\u05d1\u05d3\u05d5"}, {"pk": 2896523, "verse": 32, "text": "\u05dc\u05d1 \u05d5\u05d9\u05d4\u05d9 \u05db\u05e8\u05d0\u05d5\u05ea \u05e9\u05e8\u05d9 \u05d4\u05e8\u05db\u05d1 \u05d0\u05ea \u05d9\u05d4\u05d5\u05e9\u05e4\u05d8 \u05d5\u05d4\u05de\u05d4 \u05d0\u05de\u05e8\u05d5 \u05d0\u05da \u05de\u05dc\u05da \u05d9\u05e9\u05e8\u05d0\u05dc \u05d4\u05d5\u05d0 \u05d5\u05d9\u05e1\u05e8\u05d5 \u05e2\u05dc\u05d9\u05d5 \u05dc\u05d4\u05dc\u05d7\u05dd \u05d5\u05d9\u05d6\u05e2\u05e7 \u05d9\u05d4\u05d5\u05e9\u05e4\u05d8"}, {"pk": 2896524, "verse": 33, "text": "\u05dc\u05d2 \u05d5\u05d9\u05d4\u05d9 \u05db\u05e8\u05d0\u05d5\u05ea \u05e9\u05e8\u05d9 \u05d4\u05e8\u05db\u05d1 \u05db\u05d9 \u05dc\u05d0 \u05de\u05dc\u05da \u05d9\u05e9\u05e8\u05d0\u05dc \u05d4\u05d5\u05d0 \u05d5\u05d9\u05e9\u05d5\u05d1\u05d5 \u05de\u05d0\u05d7\u05e8\u05d9\u05d5"}, {"pk": 2896525, "verse": 34, "text": "\u05dc\u05d3 \u05d5\u05d0\u05d9\u05e9 \u05de\u05e9\u05da \u05d1\u05e7\u05e9\u05ea \u05dc\u05ea\u05de\u05d5 \u05d5\u05d9\u05db\u05d4 \u05d0\u05ea \u05de\u05dc\u05da \u05d9\u05e9\u05e8\u05d0\u05dc \u05d1\u05d9\u05df \u05d4\u05d3\u05d1\u05e7\u05d9\u05dd \u05d5\u05d1\u05d9\u05df \u05d4\u05e9\u05e8\u05d9\u05df \u05d5\u05d9\u05d0\u05de\u05e8 \u05dc\u05e8\u05db\u05d1\u05d5 \u05d4\u05e4\u05da \u05d9\u05d3\u05da \u05d5\u05d4\u05d5\u05e6\u05d9\u05d0\u05e0\u05d9 \u05de\u05df \u05d4\u05de\u05d7\u05e0\u05d4--\u05db\u05d9 \u05d4\u05d7\u05dc\u05d9\u05ea\u05d9"}, {"pk": 2896526, "verse": 35, "text": "\u05dc\u05d4 \u05d5\u05ea\u05e2\u05dc\u05d4 \u05d4\u05de\u05dc\u05d7\u05de\u05d4 \u05d1\u05d9\u05d5\u05dd \u05d4\u05d4\u05d5\u05d0 \u05d5\u05d4\u05de\u05dc\u05da \u05d4\u05d9\u05d4 \u05de\u05e2\u05de\u05d3 \u05d1\u05de\u05e8\u05db\u05d1\u05d4 \u05e0\u05db\u05d7 \u05d0\u05e8\u05dd \u05d5\u05d9\u05de\u05ea \u05d1\u05e2\u05e8\u05d1 \u05d5\u05d9\u05e6\u05e7 \u05d3\u05dd \u05d4\u05de\u05db\u05d4 \u05d0\u05dc \u05d7\u05d9\u05e7 \u05d4\u05e8\u05db\u05d1"}, {"pk": 2896527, "verse": 36, "text": "\u05dc\u05d5 \u05d5\u05d9\u05e2\u05d1\u05e8 \u05d4\u05e8\u05e0\u05d4 \u05d1\u05de\u05d7\u05e0\u05d4 \u05db\u05d1\u05d0 \u05d4\u05e9\u05de\u05e9 \u05dc\u05d0\u05de\u05e8\u00a0 \u05d0\u05d9\u05e9 \u05d0\u05dc \u05e2\u05d9\u05e8\u05d5 \u05d5\u05d0\u05d9\u05e9 \u05d0\u05dc \u05d0\u05e8\u05e6\u05d5"}, {"pk": 2896528, "verse": 37, "text": "\u05dc\u05d6 \u05d5\u05d9\u05de\u05ea \u05d4\u05de\u05dc\u05da \u05d5\u05d9\u05d1\u05d5\u05d0 \u05e9\u05de\u05e8\u05d5\u05df \u05d5\u05d9\u05e7\u05d1\u05e8\u05d5 \u05d0\u05ea \u05d4\u05de\u05dc\u05da \u05d1\u05e9\u05de\u05e8\u05d5\u05df"}, {"pk": 2896529, "verse": 38, "text": "\u05dc\u05d7 \u05d5\u05d9\u05e9\u05d8\u05e3 \u05d0\u05ea \u05d4\u05e8\u05db\u05d1 \u05e2\u05dc \u05d1\u05e8\u05db\u05ea \u05e9\u05de\u05e8\u05d5\u05df \u05d5\u05d9\u05dc\u05e7\u05d5 \u05d4\u05db\u05dc\u05d1\u05d9\u05dd \u05d0\u05ea \u05d3\u05de\u05d5 \u05d5\u05d4\u05d6\u05e0\u05d5\u05ea \u05e8\u05d7\u05e6\u05d5--\u05db\u05d3\u05d1\u05e8 \u05d9\u05d4\u05d5\u05d4 \u05d0\u05e9\u05e8 \u05d3\u05d1\u05e8"}, {"pk": 2896530, "verse": 39, "text": "\u05dc\u05d8 \u05d5\u05d9\u05ea\u05e8 \u05d3\u05d1\u05e8\u05d9 \u05d0\u05d7\u05d0\u05d1 \u05d5\u05db\u05dc \u05d0\u05e9\u05e8 \u05e2\u05e9\u05d4 \u05d5\u05d1\u05d9\u05ea \u05d4\u05e9\u05df \u05d0\u05e9\u05e8 \u05d1\u05e0\u05d4 \u05d5\u05db\u05dc \u05d4\u05e2\u05e8\u05d9\u05dd \u05d0\u05e9\u05e8 \u05d1\u05e0\u05d4\u00a0 \u05d4\u05dc\u05d5\u05d0 \u05d4\u05dd \u05db\u05ea\u05d5\u05d1\u05d9\u05dd \u05e2\u05dc \u05e1\u05e4\u05e8 \u05d3\u05d1\u05e8\u05d9 \u05d4\u05d9\u05de\u05d9\u05dd--\u05dc\u05de\u05dc\u05db\u05d9 \u05d9\u05e9\u05e8\u05d0\u05dc"}, {"pk": 2896531, "verse": 40, "text": "\u05de \u05d5\u05d9\u05e9\u05db\u05d1 \u05d0\u05d7\u05d0\u05d1 \u05e2\u05dd \u05d0\u05d1\u05ea\u05d9\u05d5 \u05d5\u05d9\u05de\u05dc\u05da \u05d0\u05d7\u05d6\u05d9\u05d4\u05d5 \u05d1\u05e0\u05d5 \u05ea\u05d7\u05ea\u05d9\u05d5\u00a0 {\u05e4}"}, {"pk": 2896532, "verse": 41, "text": "\u05de\u05d0 \u05d5\u05d9\u05d4\u05d5\u05e9\u05e4\u05d8 \u05d1\u05df \u05d0\u05e1\u05d0 \u05de\u05dc\u05da \u05e2\u05dc \u05d9\u05d4\u05d5\u05d3\u05d4--\u05d1\u05e9\u05e0\u05ea \u05d0\u05e8\u05d1\u05e2 \u05dc\u05d0\u05d7\u05d0\u05d1 \u05de\u05dc\u05da \u05d9\u05e9\u05e8\u05d0\u05dc"}, {"pk": 2896533, "verse": 42, "text": "\u05de\u05d1 \u05d9\u05d4\u05d5\u05e9\u05e4\u05d8 \u05d1\u05df \u05e9\u05dc\u05e9\u05d9\u05dd \u05d5\u05d7\u05de\u05e9 \u05e9\u05e0\u05d4 \u05d1\u05de\u05dc\u05db\u05d5 \u05d5\u05e2\u05e9\u05e8\u05d9\u05dd \u05d5\u05d7\u05de\u05e9 \u05e9\u05e0\u05d4 \u05de\u05dc\u05da \u05d1\u05d9\u05e8\u05d5\u05e9\u05dc\u05dd \u05d5\u05e9\u05dd \u05d0\u05de\u05d5 \u05e2\u05d6\u05d5\u05d1\u05d4 \u05d1\u05ea \u05e9\u05dc\u05d7\u05d9"}, {"pk": 2896534, "verse": 43, "text": "\u05de\u05d2 \u05d5\u05d9\u05dc\u05da \u05d1\u05db\u05dc \u05d3\u05e8\u05da \u05d0\u05e1\u05d0 \u05d0\u05d1\u05d9\u05d5--\u05dc\u05d0 \u05e1\u05e8 \u05de\u05de\u05e0\u05d5\u00a0 \u05dc\u05e2\u05e9\u05d5\u05ea \u05d4\u05d9\u05e9\u05e8 \u05d1\u05e2\u05d9\u05e0\u05d9 \u05d9\u05d4\u05d5\u05d4"}, {"pk": 2896535, "verse": 44, "text": "\u05de\u05d3 \u05d0\u05da \u05d4\u05d1\u05de\u05d5\u05ea \u05dc\u05d0 \u05e1\u05e8\u05d5\u00a0 \u05e2\u05d5\u05d3 \u05d4\u05e2\u05dd \u05de\u05d6\u05d1\u05d7\u05d9\u05dd \u05d5\u05de\u05e7\u05d8\u05e8\u05d9\u05dd \u05d1\u05d1\u05de\u05d5\u05ea"}, {"pk": 2896536, "verse": 45, "text": "\u05de\u05d4 \u05d5\u05d9\u05e9\u05dc\u05dd \u05d9\u05d4\u05d5\u05e9\u05e4\u05d8 \u05e2\u05dd \u05de\u05dc\u05da \u05d9\u05e9\u05e8\u05d0\u05dc"}, {"pk": 2896537, "verse": 46, "text": "\u05de\u05d5 \u05d5\u05d9\u05ea\u05e8 \u05d3\u05d1\u05e8\u05d9 \u05d9\u05d4\u05d5\u05e9\u05e4\u05d8 \u05d5\u05d2\u05d1\u05d5\u05e8\u05ea\u05d5 \u05d0\u05e9\u05e8 \u05e2\u05e9\u05d4 \u05d5\u05d0\u05e9\u05e8 \u05e0\u05dc\u05d7\u05dd\u00a0 \u05d4\u05dc\u05d0 \u05d4\u05dd \u05db\u05ea\u05d5\u05d1\u05d9\u05dd \u05e2\u05dc \u05e1\u05e4\u05e8 \u05d3\u05d1\u05e8\u05d9 \u05d4\u05d9\u05de\u05d9\u05dd--\u05dc\u05de\u05dc\u05db\u05d9 \u05d9\u05d4\u05d5\u05d3\u05d4"}, {"pk": 2896538, "verse": 47, "text": "\u05de\u05d6 \u05d5\u05d9\u05ea\u05e8 \u05d4\u05e7\u05d3\u05e9 \u05d0\u05e9\u05e8 \u05e0\u05e9\u05d0\u05e8 \u05d1\u05d9\u05de\u05d9 \u05d0\u05e1\u05d0 \u05d0\u05d1\u05d9\u05d5--\u05d1\u05e2\u05e8 \u05de\u05df \u05d4\u05d0\u05e8\u05e5"}, {"pk": 2896539, "verse": 48, "text": "\u05de\u05d7 \u05d5\u05de\u05dc\u05da \u05d0\u05d9\u05df \u05d1\u05d0\u05d3\u05d5\u05dd \u05e0\u05e6\u05d1 \u05de\u05dc\u05da"}, {"pk": 2896540, "verse": 49, "text": "\u05de\u05d8 \u05d9\u05d4\u05d5\u05e9\u05e4\u05d8 \u05e2\u05e9\u05e8 (\u05e2\u05e9\u05d4) \u05d0\u05e0\u05d9\u05d5\u05ea \u05ea\u05e8\u05e9\u05d9\u05e9 \u05dc\u05dc\u05db\u05ea \u05d0\u05e4\u05d9\u05e8\u05d4 \u05dc\u05d6\u05d4\u05d1--\u05d5\u05dc\u05d0 \u05d4\u05dc\u05da\u00a0 \u05db\u05d9 \u05e0\u05e9\u05d1\u05e8\u05d4 (\u05e0\u05e9\u05d1\u05e8\u05d5) \u05d0\u05e0\u05d9\u05d5\u05ea \u05d1\u05e2\u05e6\u05d9\u05d5\u05df \u05d2\u05d1\u05e8"}, {"pk": 2896541, "verse": 50, "text": "\u05e0 \u05d0\u05d6 \u05d0\u05de\u05e8 \u05d0\u05d7\u05d6\u05d9\u05d4\u05d5 \u05d1\u05df \u05d0\u05d7\u05d0\u05d1 \u05d0\u05dc \u05d9\u05d4\u05d5\u05e9\u05e4\u05d8 \u05d9\u05dc\u05db\u05d5 \u05e2\u05d1\u05d3\u05d9 \u05e2\u05dd \u05e2\u05d1\u05d3\u05d9\u05da \u05d1\u05d0\u05e0\u05d9\u05d5\u05ea \u05d5\u05dc\u05d0 \u05d0\u05d1\u05d4 \u05d9\u05d4\u05d5\u05e9\u05e4\u05d8"}, {"pk": 2896542, "verse": 51, "text": "\u05e0\u05d0 \u05d5\u05d9\u05e9\u05db\u05d1 \u05d9\u05d4\u05d5\u05e9\u05e4\u05d8 \u05e2\u05dd \u05d0\u05d1\u05ea\u05d9\u05d5 \u05d5\u05d9\u05e7\u05d1\u05e8 \u05e2\u05dd \u05d0\u05d1\u05ea\u05d9\u05d5 \u05d1\u05e2\u05d9\u05e8 \u05d3\u05d5\u05d3 \u05d0\u05d1\u05d9\u05d5 \u05d5\u05d9\u05de\u05dc\u05da \u05d9\u05d4\u05d5\u05e8\u05dd \u05d1\u05e0\u05d5 \u05ea\u05d7\u05ea\u05d9\u05d5\u00a0 {\u05e1}"}, {"pk": 2896543, "verse": 52, "text": "\u05e0\u05d1 \u05d0\u05d7\u05d6\u05d9\u05d4\u05d5 \u05d1\u05df \u05d0\u05d7\u05d0\u05d1 \u05de\u05dc\u05da \u05e2\u05dc \u05d9\u05e9\u05e8\u05d0\u05dc \u05d1\u05e9\u05de\u05e8\u05d5\u05df \u05d1\u05e9\u05e0\u05ea \u05e9\u05d1\u05e2 \u05e2\u05e9\u05e8\u05d4 \u05dc\u05d9\u05d4\u05d5\u05e9\u05e4\u05d8 \u05de\u05dc\u05da \u05d9\u05d4\u05d5\u05d3\u05d4 \u05d5\u05d9\u05de\u05dc\u05da \u05e2\u05dc \u05d9\u05e9\u05e8\u05d0\u05dc \u05e9\u05e0\u05ea\u05d9\u05dd"}, {"pk": 2896544, "verse": 53, "text": "\u05e0\u05d2 \u05d5\u05d9\u05e2\u05e9 \u05d4\u05e8\u05e2 \u05d1\u05e2\u05d9\u05e0\u05d9 \u05d9\u05d4\u05d5\u05d4 \u05d5\u05d9\u05dc\u05da \u05d1\u05d3\u05e8\u05da \u05d0\u05d1\u05d9\u05d5 \u05d5\u05d1\u05d3\u05e8\u05da \u05d0\u05de\u05d5 \u05d5\u05d1\u05d3\u05e8\u05da \u05d9\u05e8\u05d1\u05e2\u05dd \u05d1\u05df \u05e0\u05d1\u05d8 \u05d0\u05e9\u05e8 \u05d4\u05d7\u05d8\u05d9\u05d0 \u05d0\u05ea \u05d9\u05e9\u05e8\u05d0\u05dc [ (I Kings 22:54) \u05e0\u05d3 \u05d5\u05d9\u05e2\u05d1\u05d3 \u05d0\u05ea \u05d4\u05d1\u05e2\u05dc \u05d5\u05d9\u05e9\u05ea\u05d7\u05d5\u05d4 \u05dc\u05d5 \u05d5\u05d9\u05db\u05e2\u05e1 \u05d0\u05ea \u05d9\u05d4\u05d5\u05d4 \u05d0\u05dc\u05d4\u05d9 \u05d9\u05e9\u05e8\u05d0\u05dc \u05db\u05db\u05dc \u05d0\u05e9\u05e8 \u05e2\u05e9\u05d4 \u05d0\u05d1\u05d9\u05d5 ]"}]