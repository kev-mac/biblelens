[{"pk": 2896091, "verse": 1, "text": "\u05d0 \u05d5\u05de\u05dc\u05db\u05ea \u05e9\u05d1\u05d0 \u05e9\u05de\u05e2\u05ea \u05d0\u05ea \u05e9\u05de\u05e2 \u05e9\u05dc\u05de\u05d4--\u05dc\u05e9\u05dd \u05d9\u05d4\u05d5\u05d4 \u05d5\u05ea\u05d1\u05d0 \u05dc\u05e0\u05e1\u05ea\u05d5 \u05d1\u05d7\u05d9\u05d3\u05d5\u05ea"}, {"pk": 2896092, "verse": 2, "text": "\u05d1 \u05d5\u05ea\u05d1\u05d0 \u05d9\u05e8\u05d5\u05e9\u05dc\u05de\u05d4 \u05d1\u05d7\u05d9\u05dc \u05db\u05d1\u05d3 \u05de\u05d0\u05d3 \u05d2\u05de\u05dc\u05d9\u05dd \u05e0\u05e9\u05d0\u05d9\u05dd \u05d1\u05e9\u05de\u05d9\u05dd \u05d5\u05d6\u05d4\u05d1 \u05e8\u05d1 \u05de\u05d0\u05d3 \u05d5\u05d0\u05d1\u05df \u05d9\u05e7\u05e8\u05d4 \u05d5\u05ea\u05d1\u05d0 \u05d0\u05dc \u05e9\u05dc\u05de\u05d4 \u05d5\u05ea\u05d3\u05d1\u05e8 \u05d0\u05dc\u05d9\u05d5 \u05d0\u05ea \u05db\u05dc \u05d0\u05e9\u05e8 \u05d4\u05d9\u05d4 \u05e2\u05dd \u05dc\u05d1\u05d1\u05d4"}, {"pk": 2896093, "verse": 3, "text": "\u05d2 \u05d5\u05d9\u05d2\u05d3 \u05dc\u05d4 \u05e9\u05dc\u05de\u05d4 \u05d0\u05ea \u05db\u05dc \u05d3\u05d1\u05e8\u05d9\u05d4\u00a0 \u05dc\u05d0 \u05d4\u05d9\u05d4 \u05d3\u05d1\u05e8 \u05e0\u05e2\u05dc\u05dd \u05de\u05df \u05d4\u05de\u05dc\u05da \u05d0\u05e9\u05e8 \u05dc\u05d0 \u05d4\u05d2\u05d9\u05d3 \u05dc\u05d4"}, {"pk": 2896094, "verse": 4, "text": "\u05d3 \u05d5\u05ea\u05e8\u05d0 \u05de\u05dc\u05db\u05ea \u05e9\u05d1\u05d0 \u05d0\u05ea \u05db\u05dc \u05d7\u05db\u05de\u05ea \u05e9\u05dc\u05de\u05d4 \u05d5\u05d4\u05d1\u05d9\u05ea \u05d0\u05e9\u05e8 \u05d1\u05e0\u05d4"}, {"pk": 2896095, "verse": 5, "text": "\u05d4 \u05d5\u05de\u05d0\u05db\u05dc \u05e9\u05dc\u05d7\u05e0\u05d5 \u05d5\u05de\u05d5\u05e9\u05d1 \u05e2\u05d1\u05d3\u05d9\u05d5 \u05d5\u05de\u05e2\u05de\u05d3 \u05de\u05e9\u05e8\u05ea\u05d5 \u05d5\u05de\u05dc\u05d1\u05e9\u05d9\u05d4\u05dd \u05d5\u05de\u05e9\u05e7\u05d9\u05d5 \u05d5\u05e2\u05dc\u05ea\u05d5 \u05d0\u05e9\u05e8 \u05d9\u05e2\u05dc\u05d4 \u05d1\u05d9\u05ea \u05d9\u05d4\u05d5\u05d4 \u05d5\u05dc\u05d0 \u05d4\u05d9\u05d4 \u05d1\u05d4 \u05e2\u05d5\u05d3 \u05e8\u05d5\u05d7"}, {"pk": 2896096, "verse": 6, "text": "\u05d5 \u05d5\u05ea\u05d0\u05de\u05e8 \u05d0\u05dc \u05d4\u05de\u05dc\u05da \u05d0\u05de\u05ea \u05d4\u05d9\u05d4 \u05d4\u05d3\u05d1\u05e8 \u05d0\u05e9\u05e8 \u05e9\u05de\u05e2\u05ea\u05d9 \u05d1\u05d0\u05e8\u05e6\u05d9--\u05e2\u05dc \u05d3\u05d1\u05e8\u05d9\u05da \u05d5\u05e2\u05dc \u05d7\u05db\u05de\u05ea\u05da"}, {"pk": 2896097, "verse": 7, "text": "\u05d6 \u05d5\u05dc\u05d0 \u05d4\u05d0\u05de\u05e0\u05ea\u05d9 \u05dc\u05d3\u05d1\u05e8\u05d9\u05dd \u05e2\u05d3 \u05d0\u05e9\u05e8 \u05d1\u05d0\u05ea\u05d9 \u05d5\u05ea\u05e8\u05d0\u05d9\u05e0\u05d4 \u05e2\u05d9\u05e0\u05d9 \u05d5\u05d4\u05e0\u05d4 \u05dc\u05d0 \u05d4\u05d2\u05d3 \u05dc\u05d9 \u05d4\u05d7\u05e6\u05d9\u00a0 \u05d4\u05d5\u05e1\u05e4\u05ea \u05d7\u05db\u05de\u05d4 \u05d5\u05d8\u05d5\u05d1 \u05d0\u05dc \u05d4\u05e9\u05de\u05d5\u05e2\u05d4 \u05d0\u05e9\u05e8 \u05e9\u05de\u05e2\u05ea\u05d9"}, {"pk": 2896098, "verse": 8, "text": "\u05d7 \u05d0\u05e9\u05e8\u05d9 \u05d0\u05e0\u05e9\u05d9\u05da \u05d0\u05e9\u05e8\u05d9 \u05e2\u05d1\u05d3\u05d9\u05da \u05d0\u05dc\u05d4 \u05d4\u05e2\u05de\u05d3\u05d9\u05dd \u05dc\u05e4\u05e0\u05d9\u05da \u05ea\u05de\u05d9\u05d3 \u05d4\u05e9\u05de\u05e2\u05d9\u05dd \u05d0\u05ea \u05d7\u05db\u05de\u05ea\u05da"}, {"pk": 2896099, "verse": 9, "text": "\u05d8 \u05d9\u05d4\u05d9 \u05d9\u05d4\u05d5\u05d4 \u05d0\u05dc\u05d4\u05d9\u05da \u05d1\u05e8\u05d5\u05da \u05d0\u05e9\u05e8 \u05d7\u05e4\u05e5 \u05d1\u05da \u05dc\u05ea\u05ea\u05da \u05e2\u05dc \u05db\u05e1\u05d0 \u05d9\u05e9\u05e8\u05d0\u05dc--\u05d1\u05d0\u05d4\u05d1\u05ea \u05d9\u05d4\u05d5\u05d4 \u05d0\u05ea \u05d9\u05e9\u05e8\u05d0\u05dc \u05dc\u05e2\u05dc\u05dd \u05d5\u05d9\u05e9\u05d9\u05de\u05da \u05dc\u05de\u05dc\u05da \u05dc\u05e2\u05e9\u05d5\u05ea \u05de\u05e9\u05e4\u05d8 \u05d5\u05e6\u05d3\u05e7\u05d4"}, {"pk": 2896100, "verse": 10, "text": "\u05d9 \u05d5\u05ea\u05ea\u05df \u05dc\u05de\u05dc\u05da \u05de\u05d0\u05d4 \u05d5\u05e2\u05e9\u05e8\u05d9\u05dd \u05db\u05db\u05e8 \u05d6\u05d4\u05d1 \u05d5\u05d1\u05e9\u05de\u05d9\u05dd \u05d4\u05e8\u05d1\u05d4 \u05de\u05d0\u05d3--\u05d5\u05d0\u05d1\u05df \u05d9\u05e7\u05e8\u05d4 \u05dc\u05d0 \u05d1\u05d0 \u05db\u05d1\u05e9\u05dd \u05d4\u05d4\u05d5\u05d0 \u05e2\u05d5\u05d3 \u05dc\u05e8\u05d1 \u05d0\u05e9\u05e8 \u05e0\u05ea\u05e0\u05d4 \u05de\u05dc\u05db\u05ea \u05e9\u05d1\u05d0 \u05dc\u05de\u05dc\u05da \u05e9\u05dc\u05de\u05d4"}, {"pk": 2896101, "verse": 11, "text": "\u05d9\u05d0 \u05d5\u05d2\u05dd \u05d0\u05e0\u05d9 \u05d7\u05d9\u05e8\u05dd \u05d0\u05e9\u05e8 \u05e0\u05e9\u05d0 \u05d6\u05d4\u05d1 \u05de\u05d0\u05d5\u05e4\u05d9\u05e8\u00a0 \u05d4\u05d1\u05d9\u05d0 \u05de\u05d0\u05e4\u05d9\u05e8 \u05e2\u05e6\u05d9 \u05d0\u05dc\u05de\u05d2\u05d9\u05dd \u05d4\u05e8\u05d1\u05d4 \u05de\u05d0\u05d3--\u05d5\u05d0\u05d1\u05df \u05d9\u05e7\u05e8\u05d4"}, {"pk": 2896102, "verse": 12, "text": "\u05d9\u05d1 \u05d5\u05d9\u05e2\u05e9 \u05d4\u05de\u05dc\u05da \u05d0\u05ea \u05e2\u05e6\u05d9 \u05d4\u05d0\u05dc\u05de\u05d2\u05d9\u05dd \u05de\u05e1\u05e2\u05d3 \u05dc\u05d1\u05d9\u05ea \u05d9\u05d4\u05d5\u05d4 \u05d5\u05dc\u05d1\u05d9\u05ea \u05d4\u05de\u05dc\u05da \u05d5\u05db\u05e0\u05e8\u05d5\u05ea \u05d5\u05e0\u05d1\u05dc\u05d9\u05dd \u05dc\u05e9\u05e8\u05d9\u05dd \u05dc\u05d0 \u05d1\u05d0 \u05db\u05df \u05e2\u05e6\u05d9 \u05d0\u05dc\u05de\u05d2\u05d9\u05dd \u05d5\u05dc\u05d0 \u05e0\u05e8\u05d0\u05d4 \u05e2\u05d3 \u05d4\u05d9\u05d5\u05dd \u05d4\u05d6\u05d4"}, {"pk": 2896103, "verse": 13, "text": "\u05d9\u05d2 \u05d5\u05d4\u05de\u05dc\u05da \u05e9\u05dc\u05de\u05d4 \u05e0\u05ea\u05df \u05dc\u05de\u05dc\u05db\u05ea \u05e9\u05d1\u05d0 \u05d0\u05ea \u05db\u05dc \u05d7\u05e4\u05e6\u05d4 \u05d0\u05e9\u05e8 \u05e9\u05d0\u05dc\u05d4 \u05de\u05dc\u05d1\u05d3 \u05d0\u05e9\u05e8 \u05e0\u05ea\u05df \u05dc\u05d4 \u05db\u05d9\u05d3 \u05d4\u05de\u05dc\u05da \u05e9\u05dc\u05de\u05d4 \u05d5\u05ea\u05e4\u05df \u05d5\u05ea\u05dc\u05da \u05dc\u05d0\u05e8\u05e6\u05d4 \u05d4\u05d9\u05d0 \u05d5\u05e2\u05d1\u05d3\u05d9\u05d4\u00a0 {\u05e4}"}, {"pk": 2896104, "verse": 14, "text": "\u05d9\u05d3 \u05d5\u05d9\u05d4\u05d9 \u05de\u05e9\u05e7\u05dc \u05d4\u05d6\u05d4\u05d1 \u05d0\u05e9\u05e8 \u05d1\u05d0 \u05dc\u05e9\u05dc\u05de\u05d4 \u05d1\u05e9\u05e0\u05d4 \u05d0\u05d7\u05ea--\u05e9\u05e9 \u05de\u05d0\u05d5\u05ea \u05e9\u05e9\u05d9\u05dd \u05d5\u05e9\u05e9 \u05db\u05db\u05e8 \u05d6\u05d4\u05d1"}, {"pk": 2896105, "verse": 15, "text": "\u05d8\u05d5 \u05dc\u05d1\u05d3 \u05de\u05d0\u05e0\u05e9\u05d9 \u05d4\u05ea\u05e8\u05d9\u05dd \u05d5\u05de\u05e1\u05d7\u05e8 \u05d4\u05e8\u05db\u05dc\u05d9\u05dd \u05d5\u05db\u05dc \u05de\u05dc\u05db\u05d9 \u05d4\u05e2\u05e8\u05d1 \u05d5\u05e4\u05d7\u05d5\u05ea \u05d4\u05d0\u05e8\u05e5"}, {"pk": 2896106, "verse": 16, "text": "\u05d8\u05d6 \u05d5\u05d9\u05e2\u05e9 \u05d4\u05de\u05dc\u05da \u05e9\u05dc\u05de\u05d4 \u05de\u05d0\u05ea\u05d9\u05dd \u05e6\u05e0\u05d4 \u05d6\u05d4\u05d1 \u05e9\u05d7\u05d5\u05d8 \u05e9\u05e9 \u05de\u05d0\u05d5\u05ea \u05d6\u05d4\u05d1 \u05d9\u05e2\u05dc\u05d4 \u05e2\u05dc \u05d4\u05e6\u05e0\u05d4 \u05d4\u05d0\u05d7\u05ea"}, {"pk": 2896107, "verse": 17, "text": "\u05d9\u05d6 \u05d5\u05e9\u05dc\u05e9 \u05de\u05d0\u05d5\u05ea \u05de\u05d2\u05e0\u05d9\u05dd \u05d6\u05d4\u05d1 \u05e9\u05d7\u05d5\u05d8--\u05e9\u05dc\u05e9\u05ea \u05de\u05e0\u05d9\u05dd \u05d6\u05d4\u05d1 \u05d9\u05e2\u05dc\u05d4 \u05e2\u05dc \u05d4\u05de\u05d2\u05df \u05d4\u05d0\u05d7\u05ea \u05d5\u05d9\u05ea\u05e0\u05dd \u05d4\u05de\u05dc\u05da \u05d1\u05d9\u05ea \u05d9\u05e2\u05e8 \u05d4\u05dc\u05d1\u05e0\u05d5\u05df\u00a0 {\u05e4}"}, {"pk": 2896108, "verse": 18, "text": "\u05d9\u05d7 \u05d5\u05d9\u05e2\u05e9 \u05d4\u05de\u05dc\u05da \u05db\u05e1\u05d0 \u05e9\u05df \u05d2\u05d3\u05d5\u05dc \u05d5\u05d9\u05e6\u05e4\u05d4\u05d5 \u05d6\u05d4\u05d1 \u05de\u05d5\u05e4\u05d6"}, {"pk": 2896109, "verse": 19, "text": "\u05d9\u05d8 \u05e9\u05e9 \u05de\u05e2\u05dc\u05d5\u05ea \u05dc\u05db\u05e1\u05d4 \u05d5\u05e8\u05d0\u05e9 \u05e2\u05d2\u05dc \u05dc\u05db\u05e1\u05d4 \u05de\u05d0\u05d7\u05e8\u05d9\u05d5 \u05d5\u05d9\u05d3\u05ea \u05de\u05d6\u05d4 \u05d5\u05de\u05d6\u05d4 \u05d0\u05dc \u05de\u05e7\u05d5\u05dd \u05d4\u05e9\u05d1\u05ea \u05d5\u05e9\u05e0\u05d9\u05dd \u05d0\u05e8\u05d9\u05d5\u05ea \u05e2\u05de\u05d3\u05d9\u05dd \u05d0\u05e6\u05dc \u05d4\u05d9\u05d3\u05d5\u05ea"}, {"pk": 2896110, "verse": 20, "text": "\u05db \u05d5\u05e9\u05e0\u05d9\u05dd \u05e2\u05e9\u05e8 \u05d0\u05e8\u05d9\u05d9\u05dd \u05e2\u05de\u05d3\u05d9\u05dd \u05e9\u05dd \u05e2\u05dc \u05e9\u05e9 \u05d4\u05de\u05e2\u05dc\u05d5\u05ea--\u05de\u05d6\u05d4 \u05d5\u05de\u05d6\u05d4 \u05dc\u05d0 \u05e0\u05e2\u05e9\u05d4 \u05db\u05df \u05dc\u05db\u05dc \u05de\u05de\u05dc\u05db\u05d5\u05ea"}, {"pk": 2896111, "verse": 21, "text": "\u05db\u05d0 \u05d5\u05db\u05dc \u05db\u05dc\u05d9 \u05de\u05e9\u05e7\u05d4 \u05d4\u05de\u05dc\u05da \u05e9\u05dc\u05de\u05d4 \u05d6\u05d4\u05d1 \u05d5\u05db\u05dc \u05db\u05dc\u05d9 \u05d1\u05d9\u05ea \u05d9\u05e2\u05e8 \u05d4\u05dc\u05d1\u05e0\u05d5\u05df \u05d6\u05d4\u05d1 \u05e1\u05d2\u05d5\u05e8\u00a0 \u05d0\u05d9\u05df \u05db\u05e1\u05e3 \u05dc\u05d0 \u05e0\u05d7\u05e9\u05d1 \u05d1\u05d9\u05de\u05d9 \u05e9\u05dc\u05de\u05d4--\u05dc\u05de\u05d0\u05d5\u05de\u05d4"}, {"pk": 2896112, "verse": 22, "text": "\u05db\u05d1 \u05db\u05d9 \u05d0\u05e0\u05d9 \u05ea\u05e8\u05e9\u05d9\u05e9 \u05dc\u05de\u05dc\u05da \u05d1\u05d9\u05dd \u05e2\u05dd \u05d0\u05e0\u05d9 \u05d7\u05d9\u05e8\u05dd \u05d0\u05d7\u05ea \u05dc\u05e9\u05dc\u05e9 \u05e9\u05e0\u05d9\u05dd \u05ea\u05d1\u05d5\u05d0 \u05d0\u05e0\u05d9 \u05ea\u05e8\u05e9\u05d9\u05e9 \u05e0\u05e9\u05d0\u05ea \u05d6\u05d4\u05d1 \u05d5\u05db\u05e1\u05e3 \u05e9\u05e0\u05d4\u05d1\u05d9\u05dd \u05d5\u05e7\u05e4\u05d9\u05dd \u05d5\u05ea\u05db\u05d9\u05d9\u05dd"}, {"pk": 2896113, "verse": 23, "text": "\u05db\u05d2 \u05d5\u05d9\u05d2\u05d3\u05dc \u05d4\u05de\u05dc\u05da \u05e9\u05dc\u05de\u05d4 \u05de\u05db\u05dc \u05de\u05dc\u05db\u05d9 \u05d4\u05d0\u05e8\u05e5--\u05dc\u05e2\u05e9\u05e8 \u05d5\u05dc\u05d7\u05db\u05de\u05d4"}, {"pk": 2896114, "verse": 24, "text": "\u05db\u05d3 \u05d5\u05db\u05dc \u05d4\u05d0\u05e8\u05e5--\u05de\u05d1\u05e7\u05e9\u05d9\u05dd \u05d0\u05ea \u05e4\u05e0\u05d9 \u05e9\u05dc\u05de\u05d4\u00a0 \u05dc\u05e9\u05de\u05e2 \u05d0\u05ea \u05d7\u05db\u05de\u05ea\u05d5 \u05d0\u05e9\u05e8 \u05e0\u05ea\u05df \u05d0\u05dc\u05d4\u05d9\u05dd \u05d1\u05dc\u05d1\u05d5"}, {"pk": 2896115, "verse": 25, "text": "\u05db\u05d4 \u05d5\u05d4\u05de\u05d4 \u05de\u05d1\u05d0\u05d9\u05dd \u05d0\u05d9\u05e9 \u05de\u05e0\u05d7\u05ea\u05d5 \u05db\u05dc\u05d9 \u05db\u05e1\u05e3 \u05d5\u05db\u05dc\u05d9 \u05d6\u05d4\u05d1 \u05d5\u05e9\u05dc\u05de\u05d5\u05ea \u05d5\u05e0\u05e9\u05e7 \u05d5\u05d1\u05e9\u05de\u05d9\u05dd \u05e1\u05d5\u05e1\u05d9\u05dd \u05d5\u05e4\u05e8\u05d3\u05d9\u05dd--\u05d3\u05d1\u05e8 \u05e9\u05e0\u05d4 \u05d1\u05e9\u05e0\u05d4\u00a0 {\u05e1}"}, {"pk": 2896116, "verse": 26, "text": "\u05db\u05d5 \u05d5\u05d9\u05d0\u05e1\u05e3 \u05e9\u05dc\u05de\u05d4 \u05e8\u05db\u05d1 \u05d5\u05e4\u05e8\u05e9\u05d9\u05dd \u05d5\u05d9\u05d4\u05d9 \u05dc\u05d5 \u05d0\u05dc\u05e3 \u05d5\u05d0\u05e8\u05d1\u05e2 \u05de\u05d0\u05d5\u05ea \u05e8\u05db\u05d1 \u05d5\u05e9\u05e0\u05d9\u05dd \u05e2\u05e9\u05e8 \u05d0\u05dc\u05e3 \u05e4\u05e8\u05e9\u05d9\u05dd \u05d5\u05d9\u05e0\u05d7\u05dd \u05d1\u05e2\u05e8\u05d9 \u05d4\u05e8\u05db\u05d1 \u05d5\u05e2\u05dd \u05d4\u05de\u05dc\u05da \u05d1\u05d9\u05e8\u05d5\u05e9\u05dc\u05dd"}, {"pk": 2896117, "verse": 27, "text": "\u05db\u05d6 \u05d5\u05d9\u05ea\u05df \u05d4\u05de\u05dc\u05da \u05d0\u05ea \u05d4\u05db\u05e1\u05e3 \u05d1\u05d9\u05e8\u05d5\u05e9\u05dc\u05dd \u05db\u05d0\u05d1\u05e0\u05d9\u05dd \u05d5\u05d0\u05ea \u05d4\u05d0\u05e8\u05d6\u05d9\u05dd \u05e0\u05ea\u05df \u05db\u05e9\u05e7\u05de\u05d9\u05dd \u05d0\u05e9\u05e8 \u05d1\u05e9\u05e4\u05dc\u05d4--\u05dc\u05e8\u05d1"}, {"pk": 2896118, "verse": 28, "text": "\u05db\u05d7 \u05d5\u05de\u05d5\u05e6\u05d0 \u05d4\u05e1\u05d5\u05e1\u05d9\u05dd \u05d0\u05e9\u05e8 \u05dc\u05e9\u05dc\u05de\u05d4 \u05de\u05de\u05e6\u05e8\u05d9\u05dd \u05d5\u05de\u05e7\u05d5\u05d4--\u05e1\u05d7\u05e8\u05d9 \u05d4\u05de\u05dc\u05da \u05d9\u05e7\u05d7\u05d5 \u05de\u05e7\u05d5\u05d4 \u05d1\u05de\u05d7\u05d9\u05e8"}, {"pk": 2896119, "verse": 29, "text": "\u05db\u05d8 \u05d5\u05ea\u05e2\u05dc\u05d4 \u05d5\u05ea\u05e6\u05d0 \u05de\u05e8\u05db\u05d1\u05d4 \u05de\u05de\u05e6\u05e8\u05d9\u05dd \u05d1\u05e9\u05e9 \u05de\u05d0\u05d5\u05ea \u05db\u05e1\u05e3 \u05d5\u05e1\u05d5\u05e1 \u05d1\u05d7\u05de\u05e9\u05d9\u05dd \u05d5\u05de\u05d0\u05d4 \u05d5\u05db\u05df \u05dc\u05db\u05dc \u05de\u05dc\u05db\u05d9 \u05d4\u05d7\u05ea\u05d9\u05dd \u05d5\u05dc\u05de\u05dc\u05db\u05d9 \u05d0\u05e8\u05dd--\u05d1\u05d9\u05d3\u05dd \u05d9\u05e6\u05d0\u05d5\u00a0 {\u05e4}"}]