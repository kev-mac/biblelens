[{"pk": 2895743, "verse": 1, "text": "\u05d0 \u05d5\u05d4\u05de\u05dc\u05da \u05d3\u05d5\u05d3 \u05d6\u05e7\u05df \u05d1\u05d0 \u05d1\u05d9\u05de\u05d9\u05dd \u05d5\u05d9\u05db\u05e1\u05d4\u05d5 \u05d1\u05d1\u05d2\u05d3\u05d9\u05dd \u05d5\u05dc\u05d0 \u05d9\u05d7\u05dd \u05dc\u05d5"}, {"pk": 2895744, "verse": 2, "text": "\u05d1 \u05d5\u05d9\u05d0\u05de\u05e8\u05d5 \u05dc\u05d5 \u05e2\u05d1\u05d3\u05d9\u05d5 \u05d9\u05d1\u05e7\u05e9\u05d5 \u05dc\u05d0\u05d3\u05e0\u05d9 \u05d4\u05de\u05dc\u05da \u05e0\u05e2\u05e8\u05d4 \u05d1\u05ea\u05d5\u05dc\u05d4 \u05d5\u05e2\u05de\u05d3\u05d4 \u05dc\u05e4\u05e0\u05d9 \u05d4\u05de\u05dc\u05da \u05d5\u05ea\u05d4\u05d9 \u05dc\u05d5 \u05e1\u05db\u05e0\u05ea \u05d5\u05e9\u05db\u05d1\u05d4 \u05d1\u05d7\u05d9\u05e7\u05da \u05d5\u05d7\u05dd \u05dc\u05d0\u05d3\u05e0\u05d9 \u05d4\u05de\u05dc\u05da"}, {"pk": 2895745, "verse": 3, "text": "\u05d2 \u05d5\u05d9\u05d1\u05e7\u05e9\u05d5 \u05e0\u05e2\u05e8\u05d4 \u05d9\u05e4\u05d4 \u05d1\u05db\u05dc \u05d2\u05d1\u05d5\u05dc \u05d9\u05e9\u05e8\u05d0\u05dc \u05d5\u05d9\u05de\u05e6\u05d0\u05d5 \u05d0\u05ea \u05d0\u05d1\u05d9\u05e9\u05d2 \u05d4\u05e9\u05d5\u05e0\u05de\u05d9\u05ea \u05d5\u05d9\u05d1\u05d0\u05d5 \u05d0\u05ea\u05d4 \u05dc\u05de\u05dc\u05da"}, {"pk": 2895746, "verse": 4, "text": "\u05d3 \u05d5\u05d4\u05e0\u05e2\u05e8\u05d4 \u05d9\u05e4\u05d4 \u05e2\u05d3 \u05de\u05d0\u05d3 \u05d5\u05ea\u05d4\u05d9 \u05dc\u05de\u05dc\u05da \u05e1\u05db\u05e0\u05ea \u05d5\u05ea\u05e9\u05e8\u05ea\u05d4\u05d5 \u05d5\u05d4\u05de\u05dc\u05da \u05dc\u05d0 \u05d9\u05d3\u05e2\u05d4"}, {"pk": 2895747, "verse": 5, "text": "\u05d4 \u05d5\u05d0\u05d3\u05e0\u05d9\u05d4 \u05d1\u05df \u05d7\u05d2\u05d9\u05ea \u05de\u05ea\u05e0\u05e9\u05d0 \u05dc\u05d0\u05de\u05e8 \u05d0\u05e0\u05d9 \u05d0\u05de\u05dc\u05da \u05d5\u05d9\u05e2\u05e9 \u05dc\u05d5 \u05e8\u05db\u05d1 \u05d5\u05e4\u05e8\u05e9\u05d9\u05dd \u05d5\u05d7\u05de\u05e9\u05d9\u05dd \u05d0\u05d9\u05e9 \u05e8\u05e6\u05d9\u05dd \u05dc\u05e4\u05e0\u05d9\u05d5"}, {"pk": 2895748, "verse": 6, "text": "\u05d5 \u05d5\u05dc\u05d0 \u05e2\u05e6\u05d1\u05d5 \u05d0\u05d1\u05d9\u05d5 \u05de\u05d9\u05de\u05d9\u05d5 \u05dc\u05d0\u05de\u05e8 \u05de\u05d3\u05d5\u05e2 \u05db\u05db\u05d4 \u05e2\u05e9\u05d9\u05ea \u05d5\u05d2\u05dd \u05d4\u05d5\u05d0 \u05d8\u05d5\u05d1 \u05ea\u05d0\u05e8 \u05de\u05d0\u05d3 \u05d5\u05d0\u05ea\u05d5 \u05d9\u05dc\u05d3\u05d4 \u05d0\u05d7\u05e8\u05d9 \u05d0\u05d1\u05e9\u05dc\u05d5\u05dd"}, {"pk": 2895749, "verse": 7, "text": "\u05d6 \u05d5\u05d9\u05d4\u05d9\u05d5 \u05d3\u05d1\u05e8\u05d9\u05d5--\u05e2\u05dd \u05d9\u05d5\u05d0\u05d1 \u05d1\u05df \u05e6\u05e8\u05d5\u05d9\u05d4 \u05d5\u05e2\u05dd \u05d0\u05d1\u05d9\u05ea\u05e8 \u05d4\u05db\u05d4\u05df \u05d5\u05d9\u05e2\u05d6\u05e8\u05d5 \u05d0\u05d7\u05e8\u05d9 \u05d0\u05d3\u05e0\u05d9\u05d4"}, {"pk": 2895750, "verse": 8, "text": "\u05d7 \u05d5\u05e6\u05d3\u05d5\u05e7 \u05d4\u05db\u05d4\u05df \u05d5\u05d1\u05e0\u05d9\u05d4\u05d5 \u05d1\u05df \u05d9\u05d4\u05d5\u05d9\u05d3\u05e2 \u05d5\u05e0\u05ea\u05df \u05d4\u05e0\u05d1\u05d9\u05d0 \u05d5\u05e9\u05de\u05e2\u05d9 \u05d5\u05e8\u05e2\u05d9 \u05d5\u05d4\u05d2\u05d1\u05d5\u05e8\u05d9\u05dd \u05d0\u05e9\u05e8 \u05dc\u05d3\u05d5\u05d3--\u05dc\u05d0 \u05d4\u05d9\u05d5 \u05e2\u05dd \u05d0\u05d3\u05e0\u05d9\u05d4\u05d5"}, {"pk": 2895751, "verse": 9, "text": "\u05d8 \u05d5\u05d9\u05d6\u05d1\u05d7 \u05d0\u05d3\u05e0\u05d9\u05d4\u05d5 \u05e6\u05d0\u05df \u05d5\u05d1\u05e7\u05e8 \u05d5\u05de\u05e8\u05d9\u05d0 \u05e2\u05dd \u05d0\u05d1\u05df \u05d4\u05d6\u05d7\u05dc\u05ea \u05d0\u05e9\u05e8 \u05d0\u05e6\u05dc \u05e2\u05d9\u05df \u05e8\u05d2\u05dc \u05d5\u05d9\u05e7\u05e8\u05d0 \u05d0\u05ea \u05db\u05dc \u05d0\u05d7\u05d9\u05d5 \u05d1\u05e0\u05d9 \u05d4\u05de\u05dc\u05da \u05d5\u05dc\u05db\u05dc \u05d0\u05e0\u05e9\u05d9 \u05d9\u05d4\u05d5\u05d3\u05d4 \u05e2\u05d1\u05d3\u05d9 \u05d4\u05de\u05dc\u05da"}, {"pk": 2895752, "verse": 10, "text": "\u05d9 \u05d5\u05d0\u05ea \u05e0\u05ea\u05df \u05d4\u05e0\u05d1\u05d9\u05d0 \u05d5\u05d1\u05e0\u05d9\u05d4\u05d5 \u05d5\u05d0\u05ea \u05d4\u05d2\u05d1\u05d5\u05e8\u05d9\u05dd \u05d5\u05d0\u05ea \u05e9\u05dc\u05de\u05d4 \u05d0\u05d7\u05d9\u05d5--\u05dc\u05d0 \u05e7\u05e8\u05d0"}, {"pk": 2895753, "verse": 11, "text": "\u05d9\u05d0 \u05d5\u05d9\u05d0\u05de\u05e8 \u05e0\u05ea\u05df \u05d0\u05dc \u05d1\u05ea \u05e9\u05d1\u05e2 \u05d0\u05dd \u05e9\u05dc\u05de\u05d4 \u05dc\u05d0\u05de\u05e8 \u05d4\u05dc\u05d5\u05d0 \u05e9\u05de\u05e2\u05ea \u05db\u05d9 \u05de\u05dc\u05da \u05d0\u05d3\u05e0\u05d9\u05d4\u05d5 \u05d1\u05df \u05d7\u05d2\u05d9\u05ea \u05d5\u05d0\u05d3\u05e0\u05d9\u05e0\u05d5 \u05d3\u05d5\u05d3 \u05dc\u05d0 \u05d9\u05d3\u05e2"}, {"pk": 2895754, "verse": 12, "text": "\u05d9\u05d1 \u05d5\u05e2\u05ea\u05d4 \u05dc\u05db\u05d9 \u05d0\u05d9\u05e2\u05e6\u05da \u05e0\u05d0 \u05e2\u05e6\u05d4\u00a0 \u05d5\u05de\u05dc\u05d8\u05d9 \u05d0\u05ea \u05e0\u05e4\u05e9\u05da \u05d5\u05d0\u05ea \u05e0\u05e4\u05e9 \u05d1\u05e0\u05da \u05e9\u05dc\u05de\u05d4"}, {"pk": 2895755, "verse": 13, "text": "\u05d9\u05d2 \u05dc\u05db\u05d9 \u05d5\u05d1\u05d0\u05d9 \u05d0\u05dc \u05d4\u05de\u05dc\u05da \u05d3\u05d5\u05d3 \u05d5\u05d0\u05de\u05e8\u05ea \u05d0\u05dc\u05d9\u05d5 \u05d4\u05dc\u05d0 \u05d0\u05ea\u05d4 \u05d0\u05d3\u05e0\u05d9 \u05d4\u05de\u05dc\u05da \u05e0\u05e9\u05d1\u05e2\u05ea \u05dc\u05d0\u05de\u05ea\u05da \u05dc\u05d0\u05de\u05e8 \u05db\u05d9 \u05e9\u05dc\u05de\u05d4 \u05d1\u05e0\u05da \u05d9\u05de\u05dc\u05da \u05d0\u05d7\u05e8\u05d9 \u05d5\u05d4\u05d5\u05d0 \u05d9\u05e9\u05d1 \u05e2\u05dc \u05db\u05e1\u05d0\u05d9 \u05d5\u05de\u05d3\u05d5\u05e2 \u05de\u05dc\u05da \u05d0\u05d3\u05e0\u05d9\u05d4\u05d5"}, {"pk": 2895756, "verse": 14, "text": "\u05d9\u05d3 \u05d4\u05e0\u05d4 \u05e2\u05d5\u05d3\u05da \u05de\u05d3\u05d1\u05e8\u05ea \u05e9\u05dd--\u05e2\u05dd \u05d4\u05de\u05dc\u05da \u05d5\u05d0\u05e0\u05d9 \u05d0\u05d1\u05d5\u05d0 \u05d0\u05d7\u05e8\u05d9\u05da \u05d5\u05de\u05dc\u05d0\u05ea\u05d9 \u05d0\u05ea \u05d3\u05d1\u05e8\u05d9\u05da"}, {"pk": 2895757, "verse": 15, "text": "\u05d8\u05d5 \u05d5\u05ea\u05d1\u05d0 \u05d1\u05ea \u05e9\u05d1\u05e2 \u05d0\u05dc \u05d4\u05de\u05dc\u05da \u05d4\u05d7\u05d3\u05e8\u05d4 \u05d5\u05d4\u05de\u05dc\u05da \u05d6\u05e7\u05df \u05de\u05d0\u05d3 \u05d5\u05d0\u05d1\u05d9\u05e9\u05d2 \u05d4\u05e9\u05d5\u05e0\u05de\u05d9\u05ea \u05de\u05e9\u05e8\u05ea \u05d0\u05ea \u05d4\u05de\u05dc\u05da"}, {"pk": 2895758, "verse": 16, "text": "\u05d8\u05d6 \u05d5\u05ea\u05e7\u05d3 \u05d1\u05ea \u05e9\u05d1\u05e2 \u05d5\u05ea\u05e9\u05ea\u05d7\u05d5 \u05dc\u05de\u05dc\u05da \u05d5\u05d9\u05d0\u05de\u05e8 \u05d4\u05de\u05dc\u05da \u05de\u05d4 \u05dc\u05da"}, {"pk": 2895759, "verse": 17, "text": "\u05d9\u05d6 \u05d5\u05ea\u05d0\u05de\u05e8 \u05dc\u05d5 \u05d0\u05d3\u05e0\u05d9 \u05d0\u05ea\u05d4 \u05e0\u05e9\u05d1\u05e2\u05ea \u05d1\u05d9\u05d4\u05d5\u05d4 \u05d0\u05dc\u05d4\u05d9\u05da \u05dc\u05d0\u05de\u05ea\u05da \u05db\u05d9 \u05e9\u05dc\u05de\u05d4 \u05d1\u05e0\u05da \u05d9\u05de\u05dc\u05da \u05d0\u05d7\u05e8\u05d9 \u05d5\u05d4\u05d5\u05d0 \u05d9\u05e9\u05d1 \u05e2\u05dc \u05db\u05e1\u05d0\u05d9"}, {"pk": 2895760, "verse": 18, "text": "\u05d9\u05d7 \u05d5\u05e2\u05ea\u05d4 \u05d4\u05e0\u05d4 \u05d0\u05d3\u05e0\u05d9\u05d4 \u05de\u05dc\u05da \u05d5\u05e2\u05ea\u05d4 \u05d0\u05d3\u05e0\u05d9 \u05d4\u05de\u05dc\u05da \u05dc\u05d0 \u05d9\u05d3\u05e2\u05ea"}, {"pk": 2895761, "verse": 19, "text": "\u05d9\u05d8 \u05d5\u05d9\u05d6\u05d1\u05d7 \u05e9\u05d5\u05e8 \u05d5\u05de\u05e8\u05d9\u05d0 \u05d5\u05e6\u05d0\u05df \u05dc\u05e8\u05d1\u00a0 {\u05e4} \u00a0 \u05d5\u05d9\u05e7\u05e8\u05d0 \u05dc\u05db\u05dc \u05d1\u05e0\u05d9 \u05d4\u05de\u05dc\u05da \u05d5\u05dc\u05d0\u05d1\u05d9\u05ea\u05e8 \u05d4\u05db\u05d4\u05df \u05d5\u05dc\u05d9\u05d0\u05d1 \u05e9\u05e8 \u05d4\u05e6\u05d1\u05d0 \u05d5\u05dc\u05e9\u05dc\u05de\u05d4 \u05e2\u05d1\u05d3\u05da \u05dc\u05d0 \u05e7\u05e8\u05d0"}, {"pk": 2895762, "verse": 20, "text": "\u05db \u05d5\u05d0\u05ea\u05d4 \u05d0\u05d3\u05e0\u05d9 \u05d4\u05de\u05dc\u05da \u05e2\u05d9\u05e0\u05d9 \u05db\u05dc \u05d9\u05e9\u05e8\u05d0\u05dc \u05e2\u05dc\u05d9\u05da\u00a0 \u05dc\u05d4\u05d2\u05d9\u05d3 \u05dc\u05d4\u05dd--\u05de\u05d9 \u05d9\u05e9\u05d1 \u05e2\u05dc \u05db\u05e1\u05d0 \u05d0\u05d3\u05e0\u05d9 \u05d4\u05de\u05dc\u05da \u05d0\u05d7\u05e8\u05d9\u05d5"}, {"pk": 2895763, "verse": 21, "text": "\u05db\u05d0 \u05d5\u05d4\u05d9\u05d4 \u05db\u05e9\u05db\u05d1 \u05d0\u05d3\u05e0\u05d9 \u05d4\u05de\u05dc\u05da \u05e2\u05dd \u05d0\u05d1\u05ea\u05d9\u05d5 \u05d5\u05d4\u05d9\u05d9\u05ea\u05d9 \u05d0\u05e0\u05d9 \u05d5\u05d1\u05e0\u05d9 \u05e9\u05dc\u05de\u05d4--\u05d7\u05d8\u05d0\u05d9\u05dd"}, {"pk": 2895764, "verse": 22, "text": "\u05db\u05d1 \u05d5\u05d4\u05e0\u05d4 \u05e2\u05d5\u05d3\u05e0\u05d4 \u05de\u05d3\u05d1\u05e8\u05ea \u05e2\u05dd \u05d4\u05de\u05dc\u05da \u05d5\u05e0\u05ea\u05df \u05d4\u05e0\u05d1\u05d9\u05d0 \u05d1\u05d0"}, {"pk": 2895765, "verse": 23, "text": "\u05db\u05d2 \u05d5\u05d9\u05d2\u05d9\u05d3\u05d5 \u05dc\u05de\u05dc\u05da \u05dc\u05d0\u05de\u05e8 \u05d4\u05e0\u05d4 \u05e0\u05ea\u05df \u05d4\u05e0\u05d1\u05d9\u05d0 \u05d5\u05d9\u05d1\u05d0 \u05dc\u05e4\u05e0\u05d9 \u05d4\u05de\u05dc\u05da \u05d5\u05d9\u05e9\u05ea\u05d7\u05d5 \u05dc\u05de\u05dc\u05da \u05e2\u05dc \u05d0\u05e4\u05d9\u05d5 \u05d0\u05e8\u05e6\u05d4"}, {"pk": 2895766, "verse": 24, "text": "\u05db\u05d3 \u05d5\u05d9\u05d0\u05de\u05e8 \u05e0\u05ea\u05df \u05d0\u05d3\u05e0\u05d9 \u05d4\u05de\u05dc\u05da \u05d0\u05ea\u05d4 \u05d0\u05de\u05e8\u05ea \u05d0\u05d3\u05e0\u05d9\u05d4\u05d5 \u05d9\u05de\u05dc\u05da \u05d0\u05d7\u05e8\u05d9 \u05d5\u05d4\u05d5\u05d0 \u05d9\u05e9\u05d1 \u05e2\u05dc \u05db\u05e1\u05d0\u05d9"}, {"pk": 2895767, "verse": 25, "text": "\u05db\u05d4 \u05db\u05d9 \u05d9\u05e8\u05d3 \u05d4\u05d9\u05d5\u05dd \u05d5\u05d9\u05d6\u05d1\u05d7 \u05e9\u05d5\u05e8 \u05d5\u05de\u05e8\u05d9\u05d0 \u05d5\u05e6\u05d0\u05df \u05dc\u05e8\u05d1 \u05d5\u05d9\u05e7\u05e8\u05d0 \u05dc\u05db\u05dc \u05d1\u05e0\u05d9 \u05d4\u05de\u05dc\u05da \u05d5\u05dc\u05e9\u05e8\u05d9 \u05d4\u05e6\u05d1\u05d0 \u05d5\u05dc\u05d0\u05d1\u05d9\u05ea\u05e8 \u05d4\u05db\u05d4\u05df \u05d5\u05d4\u05e0\u05dd \u05d0\u05db\u05dc\u05d9\u05dd \u05d5\u05e9\u05ea\u05d9\u05dd \u05dc\u05e4\u05e0\u05d9\u05d5 \u05d5\u05d9\u05d0\u05de\u05e8\u05d5 \u05d9\u05d7\u05d9 \u05d4\u05de\u05dc\u05da \u05d0\u05d3\u05e0\u05d9\u05d4\u05d5"}, {"pk": 2895768, "verse": 26, "text": "\u05db\u05d5 \u05d5\u05dc\u05d9 \u05d0\u05e0\u05d9 \u05e2\u05d1\u05d3\u05da \u05d5\u05dc\u05e6\u05d3\u05e7 \u05d4\u05db\u05d4\u05df \u05d5\u05dc\u05d1\u05e0\u05d9\u05d4\u05d5 \u05d1\u05df \u05d9\u05d4\u05d5\u05d9\u05d3\u05e2 \u05d5\u05dc\u05e9\u05dc\u05de\u05d4 \u05e2\u05d1\u05d3\u05da--\u05dc\u05d0 \u05e7\u05e8\u05d0"}, {"pk": 2895769, "verse": 27, "text": "\u05db\u05d6 \u05d0\u05dd \u05de\u05d0\u05ea \u05d0\u05d3\u05e0\u05d9 \u05d4\u05de\u05dc\u05da \u05e0\u05d4\u05d9\u05d4 \u05d4\u05d3\u05d1\u05e8 \u05d4\u05d6\u05d4 \u05d5\u05dc\u05d0 \u05d4\u05d5\u05d3\u05e2\u05ea \u05d0\u05ea \u05e2\u05d1\u05d3\u05d9\u05da (\u05e2\u05d1\u05d3\u05da) \u05de\u05d9 \u05d9\u05e9\u05d1 \u05e2\u05dc \u05db\u05e1\u05d0 \u05d0\u05d3\u05e0\u05d9 \u05d4\u05de\u05dc\u05da \u05d0\u05d7\u05e8\u05d9\u05d5\u00a0 {\u05e1}"}, {"pk": 2895770, "verse": 28, "text": "\u05db\u05d7 \u05d5\u05d9\u05e2\u05df \u05d4\u05de\u05dc\u05da \u05d3\u05d5\u05d3 \u05d5\u05d9\u05d0\u05de\u05e8 \u05e7\u05e8\u05d0\u05d5 \u05dc\u05d9 \u05dc\u05d1\u05ea \u05e9\u05d1\u05e2 \u05d5\u05ea\u05d1\u05d0 \u05dc\u05e4\u05e0\u05d9 \u05d4\u05de\u05dc\u05da \u05d5\u05ea\u05e2\u05de\u05d3 \u05dc\u05e4\u05e0\u05d9 \u05d4\u05de\u05dc\u05da"}, {"pk": 2895771, "verse": 29, "text": "\u05db\u05d8 \u05d5\u05d9\u05e9\u05d1\u05e2 \u05d4\u05de\u05dc\u05da \u05d5\u05d9\u05d0\u05de\u05e8\u00a0 \u05d7\u05d9 \u05d9\u05d4\u05d5\u05d4 \u05d0\u05e9\u05e8 \u05e4\u05d3\u05d4 \u05d0\u05ea \u05e0\u05e4\u05e9\u05d9 \u05de\u05db\u05dc \u05e6\u05e8\u05d4"}, {"pk": 2895772, "verse": 30, "text": "\u05dc \u05db\u05d9 \u05db\u05d0\u05e9\u05e8 \u05e0\u05e9\u05d1\u05e2\u05ea\u05d9 \u05dc\u05da \u05d1\u05d9\u05d4\u05d5\u05d4 \u05d0\u05dc\u05d4\u05d9 \u05d9\u05e9\u05e8\u05d0\u05dc \u05dc\u05d0\u05de\u05e8 \u05db\u05d9 \u05e9\u05dc\u05de\u05d4 \u05d1\u05e0\u05da \u05d9\u05de\u05dc\u05da \u05d0\u05d7\u05e8\u05d9 \u05d5\u05d4\u05d5\u05d0 \u05d9\u05e9\u05d1 \u05e2\u05dc \u05db\u05e1\u05d0\u05d9 \u05ea\u05d7\u05ea\u05d9\u00a0 \u05db\u05d9 \u05db\u05df \u05d0\u05e2\u05e9\u05d4 \u05d4\u05d9\u05d5\u05dd \u05d4\u05d6\u05d4"}, {"pk": 2895773, "verse": 31, "text": "\u05dc\u05d0 \u05d5\u05ea\u05e7\u05d3 \u05d1\u05ea \u05e9\u05d1\u05e2 \u05d0\u05e4\u05d9\u05dd \u05d0\u05e8\u05e5 \u05d5\u05ea\u05e9\u05ea\u05d7\u05d5 \u05dc\u05de\u05dc\u05da \u05d5\u05ea\u05d0\u05de\u05e8--\u05d9\u05d7\u05d9 \u05d0\u05d3\u05e0\u05d9 \u05d4\u05de\u05dc\u05da \u05d3\u05d5\u05d3 \u05dc\u05e2\u05dc\u05dd\u00a0 {\u05e4}"}, {"pk": 2895774, "verse": 32, "text": "\u05dc\u05d1 \u05d5\u05d9\u05d0\u05de\u05e8 \u05d4\u05de\u05dc\u05da \u05d3\u05d5\u05d3 \u05e7\u05e8\u05d0\u05d5 \u05dc\u05d9 \u05dc\u05e6\u05d3\u05d5\u05e7 \u05d4\u05db\u05d4\u05df \u05d5\u05dc\u05e0\u05ea\u05df \u05d4\u05e0\u05d1\u05d9\u05d0 \u05d5\u05dc\u05d1\u05e0\u05d9\u05d4\u05d5 \u05d1\u05df \u05d9\u05d4\u05d5\u05d9\u05d3\u05e2 \u05d5\u05d9\u05d1\u05d0\u05d5 \u05dc\u05e4\u05e0\u05d9 \u05d4\u05de\u05dc\u05da"}, {"pk": 2895775, "verse": 33, "text": "\u05dc\u05d2 \u05d5\u05d9\u05d0\u05de\u05e8 \u05d4\u05de\u05dc\u05da \u05dc\u05d4\u05dd \u05e7\u05d7\u05d5 \u05e2\u05de\u05db\u05dd \u05d0\u05ea \u05e2\u05d1\u05d3\u05d9 \u05d0\u05d3\u05e0\u05d9\u05db\u05dd \u05d5\u05d4\u05e8\u05db\u05d1\u05ea\u05dd \u05d0\u05ea \u05e9\u05dc\u05de\u05d4 \u05d1\u05e0\u05d9 \u05e2\u05dc \u05d4\u05e4\u05e8\u05d3\u05d4 \u05d0\u05e9\u05e8 \u05dc\u05d9 \u05d5\u05d4\u05d5\u05e8\u05d3\u05ea\u05dd \u05d0\u05ea\u05d5 \u05d0\u05dc \u05d2\u05d7\u05d5\u05df"}, {"pk": 2895776, "verse": 34, "text": "\u05dc\u05d3 \u05d5\u05de\u05e9\u05d7 \u05d0\u05ea\u05d5 \u05e9\u05dd \u05e6\u05d3\u05d5\u05e7 \u05d4\u05db\u05d4\u05df \u05d5\u05e0\u05ea\u05df \u05d4\u05e0\u05d1\u05d9\u05d0 \u05dc\u05de\u05dc\u05da--\u05e2\u05dc \u05d9\u05e9\u05e8\u05d0\u05dc \u05d5\u05ea\u05e7\u05e2\u05ea\u05dd \u05d1\u05e9\u05d5\u05e4\u05e8 \u05d5\u05d0\u05de\u05e8\u05ea\u05dd \u05d9\u05d7\u05d9 \u05d4\u05de\u05dc\u05da \u05e9\u05dc\u05de\u05d4"}, {"pk": 2895777, "verse": 35, "text": "\u05dc\u05d4 \u05d5\u05e2\u05dc\u05d9\u05ea\u05dd \u05d0\u05d7\u05e8\u05d9\u05d5 \u05d5\u05d1\u05d0 \u05d5\u05d9\u05e9\u05d1 \u05e2\u05dc \u05db\u05e1\u05d0\u05d9 \u05d5\u05d4\u05d5\u05d0 \u05d9\u05de\u05dc\u05da \u05ea\u05d7\u05ea\u05d9 \u05d5\u05d0\u05ea\u05d5 \u05e6\u05d5\u05d9\u05ea\u05d9 \u05dc\u05d4\u05d9\u05d5\u05ea \u05e0\u05d2\u05d9\u05d3 \u05e2\u05dc \u05d9\u05e9\u05e8\u05d0\u05dc \u05d5\u05e2\u05dc \u05d9\u05d4\u05d5\u05d3\u05d4"}, {"pk": 2895778, "verse": 36, "text": "\u05dc\u05d5 \u05d5\u05d9\u05e2\u05df \u05d1\u05e0\u05d9\u05d4\u05d5 \u05d1\u05df \u05d9\u05d4\u05d5\u05d9\u05d3\u05e2 \u05d0\u05ea \u05d4\u05de\u05dc\u05da \u05d5\u05d9\u05d0\u05de\u05e8 \u05d0\u05de\u05df\u00a0 \u05db\u05df \u05d9\u05d0\u05de\u05e8 \u05d9\u05d4\u05d5\u05d4 \u05d0\u05dc\u05d4\u05d9 \u05d0\u05d3\u05e0\u05d9 \u05d4\u05de\u05dc\u05da"}, {"pk": 2895779, "verse": 37, "text": "\u05dc\u05d6 \u05db\u05d0\u05e9\u05e8 \u05d4\u05d9\u05d4 \u05d9\u05d4\u05d5\u05d4 \u05e2\u05dd \u05d0\u05d3\u05e0\u05d9 \u05d4\u05de\u05dc\u05da \u05db\u05df \u05d9\u05d4\u05d9 (\u05d9\u05d4\u05d9\u05d4) \u05e2\u05dd \u05e9\u05dc\u05de\u05d4 \u05d5\u05d9\u05d2\u05d3\u05dc \u05d0\u05ea \u05db\u05e1\u05d0\u05d5 \u05de\u05db\u05e1\u05d0 \u05d0\u05d3\u05e0\u05d9 \u05d4\u05de\u05dc\u05da \u05d3\u05d5\u05d3"}, {"pk": 2895780, "verse": 38, "text": "\u05dc\u05d7 \u05d5\u05d9\u05e8\u05d3 \u05e6\u05d3\u05d5\u05e7 \u05d4\u05db\u05d4\u05df \u05d5\u05e0\u05ea\u05df \u05d4\u05e0\u05d1\u05d9\u05d0 \u05d5\u05d1\u05e0\u05d9\u05d4\u05d5 \u05d1\u05df \u05d9\u05d4\u05d5\u05d9\u05d3\u05e2 \u05d5\u05d4\u05db\u05e8\u05ea\u05d9 \u05d5\u05d4\u05e4\u05dc\u05ea\u05d9 \u05d5\u05d9\u05e8\u05db\u05d1\u05d5 \u05d0\u05ea \u05e9\u05dc\u05de\u05d4 \u05e2\u05dc \u05e4\u05e8\u05d3\u05ea \u05d4\u05de\u05dc\u05da \u05d3\u05d5\u05d3 \u05d5\u05d9\u05dc\u05db\u05d5 \u05d0\u05ea\u05d5 \u05e2\u05dc \u05d2\u05d7\u05d5\u05df"}, {"pk": 2895781, "verse": 39, "text": "\u05dc\u05d8 \u05d5\u05d9\u05e7\u05d7 \u05e6\u05d3\u05d5\u05e7 \u05d4\u05db\u05d4\u05df \u05d0\u05ea \u05e7\u05e8\u05df \u05d4\u05e9\u05de\u05df \u05de\u05df \u05d4\u05d0\u05d4\u05dc \u05d5\u05d9\u05de\u05e9\u05d7 \u05d0\u05ea \u05e9\u05dc\u05de\u05d4 \u05d5\u05d9\u05ea\u05e7\u05e2\u05d5 \u05d1\u05e9\u05d5\u05e4\u05e8 \u05d5\u05d9\u05d0\u05de\u05e8\u05d5 \u05db\u05dc \u05d4\u05e2\u05dd \u05d9\u05d7\u05d9 \u05d4\u05de\u05dc\u05da \u05e9\u05dc\u05de\u05d4"}, {"pk": 2895782, "verse": 40, "text": "\u05de \u05d5\u05d9\u05e2\u05dc\u05d5 \u05db\u05dc \u05d4\u05e2\u05dd \u05d0\u05d7\u05e8\u05d9\u05d5 \u05d5\u05d4\u05e2\u05dd \u05de\u05d7\u05dc\u05dc\u05d9\u05dd \u05d1\u05d7\u05dc\u05dc\u05d9\u05dd \u05d5\u05e9\u05de\u05d7\u05d9\u05dd \u05e9\u05de\u05d7\u05d4 \u05d2\u05d3\u05d5\u05dc\u05d4 \u05d5\u05ea\u05d1\u05e7\u05e2 \u05d4\u05d0\u05e8\u05e5 \u05d1\u05e7\u05d5\u05dc\u05dd"}, {"pk": 2895783, "verse": 41, "text": "\u05de\u05d0 \u05d5\u05d9\u05e9\u05de\u05e2 \u05d0\u05d3\u05e0\u05d9\u05d4\u05d5 \u05d5\u05db\u05dc \u05d4\u05e7\u05e8\u05d0\u05d9\u05dd \u05d0\u05e9\u05e8 \u05d0\u05ea\u05d5 \u05d5\u05d4\u05dd \u05db\u05dc\u05d5 \u05dc\u05d0\u05db\u05dc \u05d5\u05d9\u05e9\u05de\u05e2 \u05d9\u05d5\u05d0\u05d1 \u05d0\u05ea \u05e7\u05d5\u05dc \u05d4\u05e9\u05d5\u05e4\u05e8 \u05d5\u05d9\u05d0\u05de\u05e8 \u05de\u05d3\u05d5\u05e2 \u05e7\u05d5\u05dc \u05d4\u05e7\u05e8\u05d9\u05d4 \u05d4\u05d5\u05de\u05d4"}, {"pk": 2895784, "verse": 42, "text": "\u05de\u05d1 \u05e2\u05d5\u05d3\u05e0\u05d5 \u05de\u05d3\u05d1\u05e8 \u05d5\u05d4\u05e0\u05d4 \u05d9\u05d5\u05e0\u05ea\u05df \u05d1\u05df \u05d0\u05d1\u05d9\u05ea\u05e8 \u05d4\u05db\u05d4\u05df \u05d1\u05d0 \u05d5\u05d9\u05d0\u05de\u05e8 \u05d0\u05d3\u05e0\u05d9\u05d4\u05d5 \u05d1\u05d0 \u05db\u05d9 \u05d0\u05d9\u05e9 \u05d7\u05d9\u05dc \u05d0\u05ea\u05d4 \u05d5\u05d8\u05d5\u05d1 \u05ea\u05d1\u05e9\u05e8"}, {"pk": 2895785, "verse": 43, "text": "\u05de\u05d2 \u05d5\u05d9\u05e2\u05df \u05d9\u05d5\u05e0\u05ea\u05df \u05d5\u05d9\u05d0\u05de\u05e8 \u05dc\u05d0\u05d3\u05e0\u05d9\u05d4\u05d5\u00a0 \u05d0\u05d1\u05dc \u05d0\u05d3\u05e0\u05d9\u05e0\u05d5 \u05d4\u05de\u05dc\u05da \u05d3\u05d5\u05d3 \u05d4\u05de\u05dc\u05d9\u05da \u05d0\u05ea \u05e9\u05dc\u05de\u05d4"}, {"pk": 2895786, "verse": 44, "text": "\u05de\u05d3 \u05d5\u05d9\u05e9\u05dc\u05d7 \u05d0\u05ea\u05d5 \u05d4\u05de\u05dc\u05da \u05d0\u05ea \u05e6\u05d3\u05d5\u05e7 \u05d4\u05db\u05d4\u05df \u05d5\u05d0\u05ea \u05e0\u05ea\u05df \u05d4\u05e0\u05d1\u05d9\u05d0 \u05d5\u05d1\u05e0\u05d9\u05d4\u05d5 \u05d1\u05df \u05d9\u05d4\u05d5\u05d9\u05d3\u05e2 \u05d5\u05d4\u05db\u05e8\u05ea\u05d9 \u05d5\u05d4\u05e4\u05dc\u05ea\u05d9 \u05d5\u05d9\u05e8\u05db\u05d1\u05d5 \u05d0\u05ea\u05d5 \u05e2\u05dc \u05e4\u05e8\u05d3\u05ea \u05d4\u05de\u05dc\u05da"}, {"pk": 2895787, "verse": 45, "text": "\u05de\u05d4 \u05d5\u05d9\u05de\u05e9\u05d7\u05d5 \u05d0\u05ea\u05d5 \u05e6\u05d3\u05d5\u05e7 \u05d4\u05db\u05d4\u05df \u05d5\u05e0\u05ea\u05df \u05d4\u05e0\u05d1\u05d9\u05d0 \u05dc\u05de\u05dc\u05da \u05d1\u05d2\u05d7\u05d5\u05df \u05d5\u05d9\u05e2\u05dc\u05d5 \u05de\u05e9\u05dd \u05e9\u05de\u05d7\u05d9\u05dd \u05d5\u05ea\u05d4\u05dd \u05d4\u05e7\u05e8\u05d9\u05d4 \u05d4\u05d5\u05d0 \u05d4\u05e7\u05d5\u05dc \u05d0\u05e9\u05e8 \u05e9\u05de\u05e2\u05ea\u05dd"}, {"pk": 2895788, "verse": 46, "text": "\u05de\u05d5 \u05d5\u05d2\u05dd \u05d9\u05e9\u05d1 \u05e9\u05dc\u05de\u05d4 \u05e2\u05dc \u05db\u05e1\u05d0 \u05d4\u05de\u05dc\u05d5\u05db\u05d4"}, {"pk": 2895789, "verse": 47, "text": "\u05de\u05d6 \u05d5\u05d2\u05dd \u05d1\u05d0\u05d5 \u05e2\u05d1\u05d3\u05d9 \u05d4\u05de\u05dc\u05da \u05dc\u05d1\u05e8\u05da \u05d0\u05ea \u05d0\u05d3\u05e0\u05d9\u05e0\u05d5 \u05d4\u05de\u05dc\u05da \u05d3\u05d5\u05d3 \u05dc\u05d0\u05de\u05e8 \u05d9\u05d9\u05d8\u05d1 \u05d0\u05dc\u05d4\u05d9\u05da (\u05d0\u05dc\u05d4\u05d9\u05dd) \u05d0\u05ea \u05e9\u05dd \u05e9\u05dc\u05de\u05d4 \u05de\u05e9\u05de\u05da \u05d5\u05d9\u05d2\u05d3\u05dc \u05d0\u05ea \u05db\u05e1\u05d0\u05d5 \u05de\u05db\u05e1\u05d0\u05da \u05d5\u05d9\u05e9\u05ea\u05d7\u05d5 \u05d4\u05de\u05dc\u05da \u05e2\u05dc \u05d4\u05de\u05e9\u05db\u05d1"}, {"pk": 2895790, "verse": 48, "text": "\u05de\u05d7 \u05d5\u05d2\u05dd \u05db\u05db\u05d4 \u05d0\u05de\u05e8 \u05d4\u05de\u05dc\u05da\u00a0 \u05d1\u05e8\u05d5\u05da \u05d9\u05d4\u05d5\u05d4 \u05d0\u05dc\u05d4\u05d9 \u05d9\u05e9\u05e8\u05d0\u05dc \u05d0\u05e9\u05e8 \u05e0\u05ea\u05df \u05d4\u05d9\u05d5\u05dd \u05d9\u05e9\u05d1 \u05e2\u05dc \u05db\u05e1\u05d0\u05d9--\u05d5\u05e2\u05d9\u05e0\u05d9 \u05e8\u05d0\u05d5\u05ea"}, {"pk": 2895791, "verse": 49, "text": "\u05de\u05d8 \u05d5\u05d9\u05d7\u05e8\u05d3\u05d5 \u05d5\u05d9\u05e7\u05de\u05d5 \u05db\u05dc \u05d4\u05e7\u05e8\u05d0\u05d9\u05dd \u05d0\u05e9\u05e8 \u05dc\u05d0\u05d3\u05e0\u05d9\u05d4\u05d5 \u05d5\u05d9\u05dc\u05db\u05d5 \u05d0\u05d9\u05e9 \u05dc\u05d3\u05e8\u05db\u05d5"}, {"pk": 2895792, "verse": 50, "text": "\u05e0 \u05d5\u05d0\u05d3\u05e0\u05d9\u05d4\u05d5 \u05d9\u05e8\u05d0 \u05de\u05e4\u05e0\u05d9 \u05e9\u05dc\u05de\u05d4 \u05d5\u05d9\u05e7\u05dd \u05d5\u05d9\u05dc\u05da \u05d5\u05d9\u05d7\u05d6\u05e7 \u05d1\u05e7\u05e8\u05e0\u05d5\u05ea \u05d4\u05de\u05d6\u05d1\u05d7"}, {"pk": 2895793, "verse": 51, "text": "\u05e0\u05d0 \u05d5\u05d9\u05d2\u05d3 \u05dc\u05e9\u05dc\u05de\u05d4 \u05dc\u05d0\u05de\u05e8 \u05d4\u05e0\u05d4 \u05d0\u05d3\u05e0\u05d9\u05d4\u05d5 \u05d9\u05e8\u05d0 \u05d0\u05ea \u05d4\u05de\u05dc\u05da \u05e9\u05dc\u05de\u05d4 \u05d5\u05d4\u05e0\u05d4 \u05d0\u05d7\u05d6 \u05d1\u05e7\u05e8\u05e0\u05d5\u05ea \u05d4\u05de\u05d6\u05d1\u05d7 \u05dc\u05d0\u05de\u05e8 \u05d9\u05e9\u05d1\u05e2 \u05dc\u05d9 \u05db\u05d9\u05d5\u05dd \u05d4\u05de\u05dc\u05da \u05e9\u05dc\u05de\u05d4 \u05d0\u05dd \u05d9\u05de\u05d9\u05ea \u05d0\u05ea \u05e2\u05d1\u05d3\u05d5 \u05d1\u05d7\u05e8\u05d1"}, {"pk": 2895794, "verse": 52, "text": "\u05e0\u05d1 \u05d5\u05d9\u05d0\u05de\u05e8 \u05e9\u05dc\u05de\u05d4--\u05d0\u05dd \u05d9\u05d4\u05d9\u05d4 \u05dc\u05d1\u05df \u05d7\u05d9\u05dc \u05dc\u05d0 \u05d9\u05e4\u05dc \u05de\u05e9\u05e2\u05e8\u05ea\u05d5 \u05d0\u05e8\u05e6\u05d4 \u05d5\u05d0\u05dd \u05e8\u05e2\u05d4 \u05ea\u05de\u05e6\u05d0 \u05d1\u05d5 \u05d5\u05de\u05ea"}, {"pk": 2895795, "verse": 53, "text": "\u05e0\u05d2 \u05d5\u05d9\u05e9\u05dc\u05d7 \u05d4\u05de\u05dc\u05da \u05e9\u05dc\u05de\u05d4 \u05d5\u05d9\u05d5\u05e8\u05d3\u05d4\u05d5 \u05de\u05e2\u05dc \u05d4\u05de\u05d6\u05d1\u05d7 \u05d5\u05d9\u05d1\u05d0 \u05d5\u05d9\u05e9\u05ea\u05d7\u05d5 \u05dc\u05de\u05dc\u05da \u05e9\u05dc\u05de\u05d4 \u05d5\u05d9\u05d0\u05de\u05e8 \u05dc\u05d5 \u05e9\u05dc\u05de\u05d4 \u05dc\u05da \u05dc\u05d1\u05d9\u05ea\u05da\u00a0 {\u05e4}"}]