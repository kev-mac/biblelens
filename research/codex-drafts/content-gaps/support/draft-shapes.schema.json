{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Supplemental shapes for this draft batch. Repository runtime validators remain authoritative.",
  "definitions": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "mode",
        "ref",
        "appliesTo",
        "title",
        "status",
        "summary",
        "text",
        "reasoning",
        "scope",
        "sources",
        "refs",
        "checked",
        "tags",
        "witness",
        "languageContext",
        "sides"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "mode": {
          "const": "contradictions"
        },
        "ref": {
          "type": "string",
          "pattern": "^.+ [1-9][0-9]*:[1-9][0-9]*$"
        },
        "appliesTo": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^.+ [1-9][0-9]*:[1-9][0-9]*$"
          }
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "Context"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "reasoning": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "label",
              "url"
            ],
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "pattern": "^https://"
              }
            }
          }
        },
        "refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "book",
              "chapter",
              "verse",
              "label"
            ],
            "additionalProperties": false,
            "properties": {
              "book": {
                "type": "integer",
                "minimum": 0,
                "maximum": 65
              },
              "chapter": {
                "type": "integer",
                "minimum": 1
              },
              "verse": {
                "type": "integer",
                "minimum": 1
              },
              "label": {
                "type": "string",
                "pattern": "^.+ [1-9][0-9]*:[1-9][0-9]*$"
              }
            }
          }
        },
        "checked": {
          "const": "2026-10-26"
        },
        "tags": {
          "const": [
            "T"
          ]
        },
        "witness": {
          "const": "Septuagint"
        },
        "languageContext": {
          "type": "string",
          "minLength": 1
        },
        "sides": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "label",
              "ref",
              "quote"
            ],
            "additionalProperties": false,
            "properties": {
              "label": {
                "enum": [
                  "A",
                  "B"
                ]
              },
              "ref": {
                "type": "string",
                "pattern": "^.+ [1-9][0-9]*:[1-9][0-9]*$"
              },
              "quote": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "timeline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "evidence_id",
        "traditional_date",
        "reviewed",
        "review_status",
        "discrepancy_kind",
        "additional_sources"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "traditional_date": {
          "type": "string",
          "minLength": 1
        },
        "reviewed": {
          "const": "2026-10-26"
        },
        "review_status": {
          "type": "string",
          "minLength": 1
        },
        "discrepancy_kind": {
          "type": "null"
        },
        "additional_sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "label",
              "url"
            ],
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "pattern": "^https://"
              }
            }
          }
        }
      }
    }
  }
}
